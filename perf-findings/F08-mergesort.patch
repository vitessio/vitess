+
+package engine
+
+import (
+	"fmt"
+	"testing"
+
+	"vitess.io/vitess/go/sqltypes"
+)
+
+// BenchmarkMergeSort merges `shards` sorted streams of `rows` rows each, which
+// every shard sends in results of `chunk` rows.
+func BenchmarkMergeSort(b *testing.B) {
+	fields := sqltypes.MakeTestFields("id|col", "int64|varchar")
+	for _, shards := range []int{4, 16} {
+		for _, chunk := range []int{1, 256} {
+			const rows = 10000
+			prims := make([]StreamExecutor, 0, shards)
+			for s := range shards {
+				sr := &shardResult{results: []*sqltypes.Result{{Fields: fields}}}
+				var qr *sqltypes.Result
+				for i := range rows {
+					if qr == nil {
+						qr = &sqltypes.Result{}
+						sr.results = append(sr.results, qr)
+					}
+					qr.Rows = append(qr.Rows, []sqltypes.Value{sqltypes.NewInt64(int64(i*shards + s)), sqltypes.NewVarChar("abcdefgh")})
+					if len(qr.Rows) == chunk {
+						qr = nil
+					}
+				}
+				prims = append(prims, sr)
+			}
+			run := func(b *testing.B, exec func(callback func(*sqltypes.Result) error) error) {
+				b.ReportAllocs()
+				for b.Loop() {
+					n := 0
+					err := exec(func(qr *sqltypes.Result) error {
+						n += len(qr.Rows)
+						return nil
+					})
+					if err != nil {
+						b.Fatal(err)
+					}
+					if n != shards*rows {
+						b.Fatalf("got %d rows, want %d", n, shards*rows)
+					}
+				}
+				b.ReportMetric(float64(b.Elapsed().Nanoseconds())/float64(b.N*shards*rows), "ns/row")
+			}
+			name := fmt.Sprintf("shards=%d/chunk=%d", shards, chunk)
+			b.Run("impl=old/"+name, func(b *testing.B) {
+				ms := &mergeSortOld{Primitives: prims, OrderBy: int64OrderBy}
+				run(b, func(cb func(*sqltypes.Result) error) error {
+					return ms.TryStreamExecute(b.Context(), &noopVCursor{}, nil, true, cb)
+				})
+			})
+			b.Run("impl=new/"+name, func(b *testing.B) {
+				ms := &MergeSort{Primitives: prims, OrderBy: int64OrderBy}
+				run(b, func(cb func(*sqltypes.Result) error) error {
+					return ms.TryStreamExecute(b.Context(), &noopVCursor{}, nil, true, cb)
+				})
+			})
+		}
+	}
+}
diff --git a/go/vt/vtgate/engine/merge_sort_old_bench_test.go b/go/vt/vtgate/engine/merge_sort_old_bench_test.go
new file mode 100644
index 0000000..5f5bd7d
--- /dev/null
+++ b/go/vt/vtgate/engine/merge_sort_old_bench_test.go
@@ -0,0 +1,211 @@
+/*
+Copyright 2026 The Vitess Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
