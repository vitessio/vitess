+// coalesceRowResults appends qr to results, merging its rows into the last
+// result if both only contain rows. MergeSort batches rows depending on the
+// timing of its input streams, so tests compare the coalesced rows.
+func coalesceRowResults(results []*sqltypes.Result, qr *sqltypes.Result) []*sqltypes.Result {
+	if len(results) > 0 && len(qr.Fields) == 0 && len(results[len(results)-1].Fields) == 0 {
+		last := results[len(results)-1]
+		last.Rows = append(last.Rows, qr.Rows...)
+		return results
+	}
+	return append(results, qr)
+}
+
+// reusingShardResult streams rows through a single result whose rows slice
+// is reused after each callback returns, like vttablet's pooled stream
+// results do when vtgate and vttablet run in the same process.
+type reusingShardResult struct {
+	shardRoute
+
+	fields []*querypb.Field
+	ids    []int64
+	chunk  int
+}
+
+func (sr *reusingShardResult) StreamExecute(_ context.Context, _ VCursor, _ map[string]*querypb.BindVariable, _ bool, _ bool, callback func(*sqltypes.Result) error) error {
+	if err := callback(&sqltypes.Result{Fields: sr.fields}); err != nil {
+		return err
+	}
+	qr := &sqltypes.Result{Rows: make([][]sqltypes.Value, 0, sr.chunk)}
+	for i, id := range sr.ids {
+		qr.Rows = append(qr.Rows, []sqltypes.Value{sqltypes.NewInt64(id)})
+		if len(qr.Rows) == sr.chunk || i == len(sr.ids)-1 {
+			if err := callback(qr); err != nil {
+				return err
+			}
+			// Overwrite the rows slice in place, as a pooled result would be.
+			for j := range qr.Rows {
+				qr.Rows[j] = []sqltypes.Value{sqltypes.NewInt64(-1)}
+			}
+			qr.Rows = qr.Rows[:0]
+		}
+	}
+	return nil
+}
+
+var int64OrderBy = evalengine.Comparison{{Col: 0, WeightStringCol: -1, Type: evalengine.NewType(sqltypes.Int64, collations.Unknown)}}
+
+// TestMergeSortManyRows tests that a large number of rows from several shards,
+// sent in chunks whose rows slice is reused by the sender, are merged in order
+// and are returned in results of at most mergeSortBatchSize rows.
+func TestMergeSortManyRows(t *testing.T) {
+	fields := sqltypes.MakeTestFields("id", "int64")
+	const shards, rowsPerShard = 5, 1000
+	prims := make([]StreamExecutor, 0, shards)
+	for s := range shards {
+		ids := make([]int64, 0, rowsPerShard)
+		for i := range rowsPerShard {
+			ids = append(ids, int64(i*shards+s))
+		}
+		prims = append(prims, &reusingShardResult{fields: fields, ids: ids, chunk: 37 + s})
+	}
+	ms := MergeSort{Primitives: prims, OrderBy: int64OrderBy}
+
+	var got []int64
+	err := ms.TryStreamExecute(t.Context(), &noopVCursor{}, nil, true, func(qr *sqltypes.Result) error {
+		require.LessOrEqual(t, len(qr.Rows), mergeSortBatchSize)
+		for _, row := range qr.Rows {
+			v, err := row[0].ToInt64()
+			require.NoError(t, err)
+			got = append(got, v)
+		}
+		return nil
+	})
+	require.NoError(t, err)
+	require.Len(t, got, shards*rowsPerShard)
+	for i, v := range got {
+		require.EqualValues(t, i, v)
+	}
+}
+
+// blockingShardResult sends each of its rows in a separate result. Before
+// sending a row after the first, it waits until the consumer of the merged
+// stream has received the previous row.
+type blockingShardResult struct {
+	shardRoute
+
+	fields []*querypb.Field
+	ids    []int64
+	seen   func(id int64) chan struct{}
+}
+
+func (sr *blockingShardResult) StreamExecute(ctx context.Context, _ VCursor, _ map[string]*querypb.BindVariable, _ bool, _ bool, callback func(*sqltypes.Result) error) error {
+	if err := callback(&sqltypes.Result{Fields: sr.fields}); err != nil {
+		return err
+	}
+	for i, id := range sr.ids {
+		if i > 0 {
+			select {
+			case <-sr.seen(sr.ids[i-1]):
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+		}
+		if err := callback(&sqltypes.Result{Rows: [][]sqltypes.Value{{sqltypes.NewInt64(id)}}}); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// TestMergeSortFlushesBeforeWaiting tests that MergeSort sends the rows it has
+// merged so far before it waits for more rows from a shard, so that a slow
+// shard doesn't hold back rows that can already be returned.
+func TestMergeSortFlushesBeforeWaiting(t *testing.T) {
+	fields := sqltypes.MakeTestFields("id", "int64")
+	var mu sync.Mutex
+	seenCh := map[int64]chan struct{}{}
+	seen := func(id int64) chan struct{} {
+		mu.Lock()
+		defer mu.Unlock()
+		ch, ok := seenCh[id]
+		if !ok {
+			ch = make(chan struct{})
+			seenCh[id] = ch
+		}
+		return ch
+	}
+	ms := MergeSort{
+		Primitives: []StreamExecutor{
+			&blockingShardResult{fields: fields, ids: []int64{1, 3, 5}, seen: seen},
+			&blockingShardResult{fields: fields, ids: []int64{2, 4, 6}, seen: seen},
+		},
+		OrderBy: int64OrderBy,
+	}
+
+	ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
+	defer cancel()
+	var got []int64
+	err := ms.TryStreamExecute(ctx, &noopVCursor{}, nil, false, func(qr *sqltypes.Result) error {
+		for _, row := range qr.Rows {
+			v, err := row[0].ToInt64()
+			require.NoError(t, err)
+			got = append(got, v)
+			close(seen(v))
+		}
+		return nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, []int64{1, 2, 3, 4, 5, 6}, got)
+}
+
+// TestMergeSortStopsOnCallbackError tests that MergeSort stops as soon as the
+// callback returns an error, e.g. io.EOF from a Limit that has enough rows.
+func TestMergeSortStopsOnCallbackError(t *testing.T) {
+	fields := sqltypes.MakeTestFields("id", "int64")
+	ids := make([]int64, 10*mergeSortBatchSize)
+	for i := range ids {
+		ids[i] = int64(i)
+	}
+	ms := MergeSort{
+		Primitives: []StreamExecutor{&reusingShardResult{fields: fields, ids: ids, chunk: 100}},
+		OrderBy:    int64OrderBy,
+	}
+	calls := 0
+	err := ms.TryStreamExecute(t.Context(), &noopVCursor{}, nil, false, func(qr *sqltypes.Result) error {
+		calls++
+		return io.EOF
+	})
+	require.ErrorIs(t, err, io.EOF)
+	require.Equal(t, 1, calls)
+}
