+#!/bin/bash
+# see profile.sh
+name=$1; MODE=$2; THR=$3; OUT=$4
+C=/home/vt/perf/H2/c.sh
+case $MODE in
+  ps) ARGS=(oltp_point_select --db-ps-mode=auto) ;;
+  text) ARGS=(oltp_point_select --db-ps-mode=disable) ;;
+  range1000) ARGS=(/home/vt/perf/H2/range1000.lua --db-ps-mode=disable) ;;
+  rw) ARGS=(oltp_read_write --db-ps-mode=auto) ;;
+esac
+$C sb oltp_point_select --threads=8 --time=5 --db-ps-mode=auto run >/dev/null 2>&1
+ctx() { # voluntary+involuntary context switches summed over all threads of a pid
+  local s=0
+  for f in /proc/"$1"/task/*/status; do
+    s=$((s + $(awk '/^voluntary_ctxt_switches|^nonvoluntary_ctxt_switches/ {x+=$2} END {print x+0}' "$f" 2>/dev/null)))
+  done
+  echo $s
+}
+pids=$($C pids)
+gate=$(echo "$pids" | awk '/^vtgate/ {print $2}')
+t0=$(echo "$pids" | awk '/^vttablet_100/ {print $2}')
+t1=$(echo "$pids" | awk '/^vttablet_101/ {print $2}')
+$C sb "${ARGS[@]}" --threads="$THR" --time=25 --report-interval=0 run >"$OUT/$name-$MODE-$THR.sb" 2>&1 &
+sb=$!
+sleep 5
+g0=$(ctx "$gate"); a0=$(( $(ctx "$t0") + $(ctx "$t1") ))
+curl -s -o "$OUT/$name-$MODE-$THR-vtgate.pprof" "http://localhost:40001/debug/pprof/profile?seconds=15" &
+curl -s -o "$OUT/$name-$MODE-$THR-tablet.pprof" "http://localhost:40100/debug/pprof/profile?seconds=15" &
+wait %2 %3 2>/dev/null
+g1=$(ctx "$gate"); a1=$(( $(ctx "$t0") + $(ctx "$t1") ))
+wait $sb
+qps=$(awk '/queries:/ && /per sec/ {gsub(/[()]/,""); print $3; exit}' "$OUT/$name-$MODE-$THR.sb")
+awk -v q="$qps" -v g=$((g1 - g0)) -v a=$((a1 - a0)) -v n="$name" -v m="$MODE" -v t="$THR" \
+  'BEGIN { printf "%s %s thr=%s qps=%s vtgate_cs/q=%.2f tablets_cs/q=%.2f (15s window)\n", n, m, t, q, g/(q*15), a/(q*15) }' | tee -a "$OUT/ctxsw.txt"
