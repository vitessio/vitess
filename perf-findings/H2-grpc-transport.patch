+#!/bin/bash
+# ab.sh ROUNDS "MODES" CFG1 CFG2 [CFG3...]
+#   MODES: space separated list of MODE:THREADS, e.g. "ps:8 text:8 ps:32"
+#   CFGn:  path to a shell snippet that sets BIN / GATE_ENV / TABLET_ENV / VTGATE_EXTRA_FLAGS / VTTABLET_EXTRA_FLAGS
+# For every round and config: restart vtgate+vttablets with that config (OUTSIDE the bench lock, so the daemons
+# never inherit its fd), then in one `flock -o` section: warm up 5s and run each mode for $TIME (default 12s).
+set -u
+ROUNDS=$1; MODES=$2; shift 2
+TIME=${TIME:-12}
+for r in $(seq 1 "$ROUNDS"); do
+  for cfg in "$@"; do
+    name=$(basename "$cfg" .cfg)
+    (
+      unset BIN GATE_ENV TABLET_ENV VTGATE_EXTRA_FLAGS VTTABLET_EXTRA_FLAGS
+      # shellcheck disable=SC1090
+      source "$cfg"
+      export BIN GATE_ENV TABLET_ENV VTGATE_EXTRA_FLAGS VTTABLET_EXTRA_FLAGS
+      /home/vt/perf/H2/c.sh restart >/dev/null 2>&1
+    )
+    flock -o /home/vt/perf/bench.lock /home/vt/perf/H2/runmodes.sh "r$r-$name" "$MODES" "$TIME"
+    sleep 3
+  done
+done
