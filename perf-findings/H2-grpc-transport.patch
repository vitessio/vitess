@@ -0,0 +1,27 @@
+#!/bin/bash
+# run.sh GMP DUR "modes" "concs" [extra server flags]
+# Starts a server with GOMAXPROCS=GMP (both server and client use GMP; "def" = unset), runs each mode x conc.
+cd "$(dirname "$0")"
+GMP=$1; DUR=${2:-3s}; MODES=${3:-"unary unary-sw bidi bidi-sw pool-sw mux1-sw mux4-sw tcpmux1 tcppool"}; CONCS=${4:-"1 8 64"}
+envs=()
+[[ $GMP != def ]] && envs=(GOMAXPROCS=$GMP)
+run_srv() {
+  env "${envs[@]}" ./h2mb server -grpc 127.0.0.1:40901 -tcp 127.0.0.1:40902 "$@" >srv.log 2>&1 &
+  SPID=$!
+  sleep 0.5
+}
+echo "# $(date +%T) gmp=$GMP $(uptime)"
+for m in $MODES; do
+  base=${m%-sw}; sw=""; [[ $m == *-sw ]] && sw=-sw
+  k=1
+  case $base in
+    mux*) k=${base#mux}; base=mux ;;
+    tcpmux*) k=${base#tcpmux}; base=tcpmux ;;
+  esac
+  run_srv $sw
+  for c in $CONCS; do
+    env "${envs[@]}" timeout 60 ./h2mb client -label "$m" -mode $base -k $k $sw -c $c -d $DUR -spid $SPID -grpc 127.0.0.1:40901 -tcp 127.0.0.1:40902
+  done
+  kill $SPID; wait $SPID 2>/dev/null
+done
+echo "# $(date +%T) end $(uptime)"
diff --git a/perf-findings/harness/H2/mbagg.py b/perf-findings/harness/H2/mbagg.py
new file mode 100644
index 0000000000..d39983a3cf
--- /dev/null
+++ b/perf-findings/harness/H2/mbagg.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""mbagg.py FILES...: median per (label, c, gmp) of the h2mb client lines; one table per gmp."""
+import re
+import statistics
+import sys
+from collections import defaultdict, OrderedDict
+
+pat = re.compile(r'^(\S+)\t(\S+)\tc=(\d+)\tgmp=(\d+)\tqps=(\S+)\tavg=(\S+)\tp50=(\S+)\tp99=(\S+)\tcli_us/op=(\S+)\tsrv_us/op=(\S+)')
+data = defaultdict(list)
+labels = OrderedDict()
+gmps = OrderedDict()
+for fn in sys.argv[1:]:
+    for line in open(fn):
+        m = pat.match(line.rstrip('\n'))
+        if not m:
+            continue
+        label, c, gmp = m.group(1), int(m.group(3)), int(m.group(4))
+        data[(label, c, gmp)].append([float(x) for x in m.group(5, 6, 7, 8, 9, 10)])
+        labels[label] = 1
+        gmps[gmp] = 1
+
+for gmp in sorted(gmps):
+    print(f"\n#### GOMAXPROCS={gmp} (median of rounds; latency µs; CPU µs per call)\n")
+    print("| design | c=1 lat | c=1 cli/srv CPU | c=8 lat | c=8 cli/srv CPU | c=64 lat | c=64 cli/srv CPU | c=64 QPS | n |")
+    print("|---|---|---|---|---|---|---|---|---|")
+    for label in labels:
+        cells = []
+        n = 0
+        qps64 = ""
+        for c in (1, 8, 64):
+            vs = data.get((label, c, gmp))
+            if not vs:
+                cells += ["", ""]
+                continue
+            n = len(vs)
+            med = [statistics.median(v[i] for v in vs) for i in range(6)]
+            cells.append(f"{med[1]:.0f}")
+            cells.append(f"{med[4]:.0f} / {med[5]:.0f}")
+            if c == 64:
+                qps64 = f"{med[0] / 1000:.0f}k"
+        print(f"| {label} | " + " | ".join(cells) + f" | {qps64} | {n} |")
