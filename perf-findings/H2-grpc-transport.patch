index 0000000000..a36dcd6bbf
--- /dev/null
+++ b/perf-findings/harness/H2/mb/h2mb.go.txt
@@ -0,0 +1,587 @@
+// h2mb: transport microbenchmark for the vtgate->vttablet Execute hop.
+//
+//	h2mb server -grpc :P -tcp :Q [-sw] [-workers N]
+//	h2mb client -mode unary|bidi|pool|mux|tcpmux|tcppool -c N -d 3s -spid PID [-sw] [-k streams]
+//
+// Every design marshals a realistic point-select ExecuteRequest on the client, unmarshals it on
+// the server, marshals a realistic 1-row ExecuteResponse, and unmarshals it on the client.
+package main
+
+import (
+	"bufio"
+	"context"
+	"encoding/binary"
+	"flag"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"runtime"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/encoding"
+
+	querypb "vitess.io/vitess/go/vt/proto/query"
+	topodatapb "vitess.io/vitess/go/vt/proto/topodata"
+	vtrpcpb "vitess.io/vitess/go/vt/proto/vtrpc"
+)
+
+// ---------------------------------------------------------------- messages
+
+func mkRequest(id int64) *querypb.ExecuteRequest {
+	return &querypb.ExecuteRequest{
+		EffectiveCallerId: &vtrpcpb.CallerID{Principal: "root", Component: "vtgate"},
+		ImmediateCallerId: &querypb.VTGateCallerID{Username: "root"},
+		Target:            &querypb.Target{Keyspace: "sbtest", Shard: "-80", TabletType: topodatapb.TabletType_PRIMARY, Cell: "zone1"},
+		Query: &querypb.BoundQuery{
+			Sql: "select c from sbtest1 where id = :vtg1 /* INT64 */",
+			BindVariables: map[string]*querypb.BindVariable{
+				"vtg1": {Type: querypb.Type_INT64, Value: []byte(strconv.FormatInt(id, 10))},
+			},
+		},
+		Options: &querypb.ExecuteOptions{IncludedFields: querypb.ExecuteOptions_TYPE_AND_NAME, Workload: querypb.ExecuteOptions_OLTP},
+	}
+}
+
+var respTemplate = &querypb.ExecuteResponse{Result: &querypb.QueryResult{
+	Fields: []*querypb.Field{{
+		Name: "c", Type: querypb.Type_CHAR, Table: "sbtest1", OrgTable: "sbtest1", Database: "vt_sbtest",
+		OrgName: "c", ColumnLength: 480, Charset: 255, Flags: 4097,
+	}},
+	Rows: []*querypb.Row{{
+		Lengths: []int64{120},
+		Values:  []byte(strings.Repeat("83868641912-28773972837-60736120486-75162659906-27563526494-20381887404-41576422241-93426793964-563", 1)[:99] + strings.Repeat("x", 21)),
+	}},
+}}
+
+// serverProcess is the server-side "work": decode the request and encode a response.
+func serverProcess(in []byte) []byte {
+	var req querypb.ExecuteRequest
+	if err := req.UnmarshalVT(in); err != nil {
+		panic(err)
+	}
+	out, err := respTemplate.MarshalVT()
+	if err != nil {
+		panic(err)
+	}
+	return out
+}
+
+func clientDecode(b []byte) {
+	var resp querypb.ExecuteResponse
+	if err := resp.UnmarshalVT(b); err != nil {
+		panic(err)
+	}
+	if len(resp.Result.Rows) != 1 {
+		panic("bad response")
+	}
+}
+
+// ---------------------------------------------------------------- raw codec
+
+type frame struct{ b []byte }
+
+type rawCodec struct{}
+
+func (rawCodec) Marshal(v any) ([]byte, error) { return v.(*frame).b, nil }
+func (rawCodec) Unmarshal(data []byte, v any) error {
+	f := v.(*frame)
+	f.b = append(f.b[:0], data...)
+	return nil
+}
+func (rawCodec) Name() string { return "h2raw" }
+
+func init() { encoding.RegisterCodec(rawCodec{}) }
+
+// ---------------------------------------------------------------- server
+
+var (
+	unaryDesc = grpc.MethodDesc{MethodName: "Unary", Handler: func(srv any, ctx context.Context, dec func(any) error, _ grpc.UnaryServerInterceptor) (any, error) {
+		var f frame
+		if err := dec(&f); err != nil {
+			return nil, err
+		}
+		return &frame{b: serverProcess(f.b)}, nil
+	}}
+	bidiStreamDesc = grpc.StreamDesc{StreamName: "Bidi", ServerStreams: true, ClientStreams: true, Handler: func(srv any, st grpc.ServerStream) error {
+		var f frame
+		for {
+			if err := st.RecvMsg(&f); err != nil {
+				if err == io.EOF {
+					return nil
+				}
+				return err
+			}
+			if err := st.SendMsg(&frame{b: serverProcess(f.b)}); err != nil {
+				return err
+			}
+		}
+	}}
+	// Mux: first 8 bytes of each message are a request id, echoed in the response. In-order per stream.
+	muxStreamDesc = grpc.StreamDesc{StreamName: "Mux", ServerStreams: true, ClientStreams: true, Handler: func(srv any, st grpc.ServerStream) error {
+		var f frame
+		for {
+			if err := st.RecvMsg(&f); err != nil {
+				if err == io.EOF {
+					return nil
+				}
+				return err
+			}
+			out := serverProcess(f.b[8:])
+			b := make([]byte, 8+len(out))
+			copy(b, f.b[:8])
+			copy(b[8:], out)
+			if err := st.SendMsg(&frame{b: b}); err != nil {
+				return err
+			}
+		}
+	}}
+	serviceDesc = grpc.ServiceDesc{
+		ServiceName: "h2.Bench",
+		HandlerType: (*any)(nil),
+		Methods:     []grpc.MethodDesc{unaryDesc},
+		Streams:     []grpc.StreamDesc{bidiStreamDesc, muxStreamDesc},
+	}
+)
+
+func runServer(args []string) {
+	fs := flag.NewFlagSet("server", flag.ExitOnError)
+	gaddr := fs.String("grpc", ":0", "")
+	taddr := fs.String("tcp", ":0", "")
+	sw := fs.Bool("sw", false, "static flow-control windows (no BDP pings)")
+	workers := fs.Int("workers", -1, "NumStreamWorkers (-1 = GOMAXPROCS like vttablet)")
+	_ = fs.Parse(args)
+
+	opts := []grpc.ServerOption{grpc.ForceServerCodec(rawCodec{})}
+	if *workers < 0 {
+		*workers = runtime.GOMAXPROCS(0)
+	}
+	if *workers > 0 {
+		opts = append(opts, grpc.NumStreamWorkers(uint32(*workers)))
+	}
+	if *sw {
+		opts = append(opts, grpc.InitialWindowSize(1<<20), grpc.InitialConnWindowSize(8<<20))
+	}
+	s := grpc.NewServer(opts...)
+	s.RegisterService(&serviceDesc, struct{}{})
+	gl, err := net.Listen("tcp", *gaddr)
+	if err != nil {
+		panic(err)
+	}
+	go func() { _ = s.Serve(gl) }()
+
+	tl, err := net.Listen("tcp", *taddr)
+	if err != nil {
+		panic(err)
+	}
+	go func() {
+		for {
+			c, err := tl.Accept()
+			if err != nil {
+				return
+			}
+			go serveTCP(c)
+		}
+	}()
+	fmt.Printf("server pid %d grpc %s tcp %s gomaxprocs %d\n", os.Getpid(), gl.Addr(), tl.Addr(), runtime.GOMAXPROCS(0))
+	select {}
+}
+
+// TCP framing: [4 byte little-endian length of rest][8 byte id][payload]
+func serveTCP(c net.Conn) {
+	defer c.Close()
+	r := bufio.NewReaderSize(c, 16<<10)
+	w := bufio.NewWriterSize(c, 16<<10)
+	var hdr [12]byte
+	var buf []byte
+	for {
+		if _, err := io.ReadFull(r, hdr[:]); err != nil {
+			return
+		}
+		n := int(binary.LittleEndian.Uint32(hdr[:4])) - 8
+		buf = slices.Grow(buf[:0], n)[:n]
+		if _, err := io.ReadFull(r, buf); err != nil {
+			return
+		}
+		out := serverProcess(buf)
+		binary.LittleEndian.PutUint32(hdr[:4], uint32(len(out)+8))
+		_, _ = w.Write(hdr[:])
+		_, _ = w.Write(out)
+		if r.Buffered() == 0 {
+			if err := w.Flush(); err != nil {
+				return
+			}
+		}
+	}
+}
+
+// ---------------------------------------------------------------- client
+
+type caller interface {
+	call(ctx context.Context, req []byte) []byte
+}
+
+type unaryCaller struct{ cc *grpc.ClientConn }
+
+func (u *unaryCaller) call(ctx context.Context, req []byte) []byte {
+	var out frame
+	if err := u.cc.Invoke(ctx, "/h2.Bench/Unary", &frame{b: req}, &out); err != nil {
+		panic(err)
+	}
+	return out.b
+}
+
+type streamCaller struct {
+	st  grpc.ClientStream
+	out frame
+}
+
+func newStream(cc *grpc.ClientConn, desc *grpc.StreamDesc, method string) grpc.ClientStream {
+	st, err := cc.NewStream(context.Background(), desc, method)
+	if err != nil {
+		panic(err)
+	}
+	return st
+}
+
+func (s *streamCaller) call(ctx context.Context, req []byte) []byte {
+	if err := s.st.SendMsg(&frame{b: req}); err != nil {
+		panic(err)
+	}
+	if err := s.st.RecvMsg(&s.out); err != nil {
+		panic(err)
+	}
+	return s.out.b
+}
+
+// poolCaller: exclusive checkout of a bidi stream per call.
+type poolCaller struct {
+	cc   *grpc.ClientConn
+	idle chan *streamCaller
+}
+
+func (p *poolCaller) call(ctx context.Context, req []byte) []byte {
+	var s *streamCaller
+	select {
+	case s = <-p.idle:
+	default:
+		s = &streamCaller{st: newStream(p.cc, &bidiStreamDesc, "/h2.Bench/Bidi")}
+	}
+	out := s.call(ctx, req)
+	p.idle <- s
+	return out
+}
+
+// muxCaller: K shared streams, request ids, one reader goroutine per stream dispatching responses.
+type muxStream struct {
+	mu      sync.Mutex
+	st      grpc.ClientStream
+	pending sync.Map // id -> chan []byte
+}
+
+type muxCaller struct {
+	streams []*muxStream
+	next    atomic.Uint64
+}
+
+func newMux(cc *grpc.ClientConn, k int) *muxCaller {
+	m := &muxCaller{}
+	for range k {
+		ms := &muxStream{st: newStream(cc, &muxStreamDesc, "/h2.Bench/Mux")}
+		go func() {
+			var f frame
+			for {
+				if err := ms.st.RecvMsg(&f); err != nil {
+					return
+				}
+				id := binary.LittleEndian.Uint64(f.b[:8])
+				ch, _ := ms.pending.LoadAndDelete(id)
+				ch.(chan []byte) <- append([]byte(nil), f.b[8:]...)
+			}
+		}()
+		m.streams = append(m.streams, ms)
+	}
+	return m
+}
+
+var chPool = sync.Pool{New: func() any { return make(chan []byte, 1) }}
+
+func (m *muxCaller) call(ctx context.Context, req []byte) []byte {
+	id := m.next.Add(1)
+	ms := m.streams[id%uint64(len(m.streams))]
+	ch := chPool.Get().(chan []byte)
+	ms.pending.Store(id, ch)
+	b := make([]byte, 8+len(req))
+	binary.LittleEndian.PutUint64(b, id)
+	copy(b[8:], req)
+	ms.mu.Lock()
+	err := ms.st.SendMsg(&frame{b: b})
+	ms.mu.Unlock()
+	if err != nil {
+		panic(err)
+	}
+	out := <-ch
+	chPool.Put(ch)
+	return out
+}
+
+// tcpMux: K TCP connections, writer mutex, reader goroutine per connection.
+type tcpMuxConn struct {
+	mu      sync.Mutex
+	w       *bufio.Writer
+	pending sync.Map
+}
+
+type tcpMuxCaller struct {
+	conns []*tcpMuxConn
+	next  atomic.Uint64
+}
+
+func newTCPMux(addr string, k int) *tcpMuxCaller {
+	m := &tcpMuxCaller{}
+	for range k {
+		c, err := net.Dial("tcp", addr)
+		if err != nil {
+			panic(err)
+		}
+		tc := &tcpMuxConn{w: bufio.NewWriterSize(c, 16<<10)}
+		go func() {
+			r := bufio.NewReaderSize(c, 16<<10)
+			var hdr [12]byte
+			for {
+				if _, err := io.ReadFull(r, hdr[:]); err != nil {
+					return
+				}
+				n := int(binary.LittleEndian.Uint32(hdr[:4])) - 8
+				buf := make([]byte, n)
+				if _, err := io.ReadFull(r, buf); err != nil {
+					return
+				}
+				id := binary.LittleEndian.Uint64(hdr[4:])
+				ch, _ := tc.pending.LoadAndDelete(id)
+				ch.(chan []byte) <- buf
+			}
+		}()
+		m.conns = append(m.conns, tc)
+	}
+	return m
+}
+
+func (m *tcpMuxCaller) call(ctx context.Context, req []byte) []byte {
+	id := m.next.Add(1)
+	tc := m.conns[id%uint64(len(m.conns))]
+	ch := chPool.Get().(chan []byte)
+	tc.pending.Store(id, ch)
+	var hdr [12]byte
+	binary.LittleEndian.PutUint32(hdr[:4], uint32(len(req)+8))
+	binary.LittleEndian.PutUint64(hdr[4:], id)
+	tc.mu.Lock()
+	_, _ = tc.w.Write(hdr[:])
+	_, _ = tc.w.Write(req)
+	err := tc.w.Flush()
+	tc.mu.Unlock()
+	if err != nil {
+		panic(err)
+	}
+	out := <-ch
+	chPool.Put(ch)
+	return out
+}
+
+// tcpPool: exclusive checkout of a TCP connection per call, request/response inline.
+type tcpConn struct {
+	c   net.Conn
+	r   *bufio.Reader
+	w   *bufio.Writer
+	buf []byte
+}
+
+type tcpPoolCaller struct {
+	addr string
+	idle chan *tcpConn
+}
+
+func (p *tcpPoolCaller) call(ctx context.Context, req []byte) []byte {
+	var tc *tcpConn
+	select {
+	case tc = <-p.idle:
+	default:
+		c, err := net.Dial("tcp", p.addr)
+		if err != nil {
+			panic(err)
+		}
+		tc = &tcpConn{c: c, r: bufio.NewReaderSize(c, 16<<10), w: bufio.NewWriterSize(c, 16<<10)}
+	}
+	var hdr [12]byte
+	binary.LittleEndian.PutUint32(hdr[:4], uint32(len(req)+8))
+	_, _ = tc.w.Write(hdr[:])
+	_, _ = tc.w.Write(req)
+	if err := tc.w.Flush(); err != nil {
+		panic(err)
+	}
+	if _, err := io.ReadFull(tc.r, hdr[:]); err != nil {
+		panic(err)
+	}
+	n := int(binary.LittleEndian.Uint32(hdr[:4])) - 8
+	tc.buf = slices.Grow(tc.buf[:0], n)[:n]
+	if _, err := io.ReadFull(tc.r, tc.buf); err != nil {
+		panic(err)
+	}
+	out := tc.buf
+	p.idle <- tc
+	return out
+}
+
+func procCPU(pid int) time.Duration {
+	b, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+	if err != nil {
+		panic(err)
+	}
+	s := string(b)
+	f := strings.Fields(s[strings.LastIndexByte(s, ')')+2:])
+	u, _ := strconv.ParseInt(f[11], 10, 64)
+	st, _ := strconv.ParseInt(f[12], 10, 64)
+	return time.Duration(u+st) * 10 * time.Millisecond // CLK_TCK=100
+}
+
+func selfCPU() time.Duration {
+	var ru syscall.Rusage
+	_ = syscall.Getrusage(syscall.RUSAGE_SELF, &ru)
+	return time.Duration(ru.Utime.Nano() + ru.Stime.Nano())
+}
+
+func runClient(args []string) {
+	fs := flag.NewFlagSet("client", flag.ExitOnError)
+	mode := fs.String("mode", "unary", "")
+	conc := fs.Int("c", 1, "")
+	dur := fs.Duration("d", 3*time.Second, "")
+	gaddr := fs.String("grpc", "127.0.0.1:41901", "")
+	taddr := fs.String("tcp", "127.0.0.1:41902", "")
+	spid := fs.Int("spid", 0, "server pid")
+	sw := fs.Bool("sw", false, "static windows")
+	k := fs.Int("k", 1, "shared streams/conns for mux modes")
+	label := fs.String("label", "", "")
+	_ = fs.Parse(args)
+
+	dopts := []grpc.DialOption{grpc.WithTransportCredentials(insecure.NewCredentials()), grpc.WithDefaultCallOptions(grpc.ForceCodec(rawCodec{}))}
+	if *sw {
+		dopts = append(dopts, grpc.WithInitialWindowSize(1<<20), grpc.WithInitialConnWindowSize(8<<20))
+	}
+	var cc *grpc.ClientConn
+	if !strings.HasPrefix(*mode, "tcp") {
+		var err error
+		cc, err = grpc.NewClient(*gaddr, dopts...)
+		if err != nil {
+			panic(err)
+		}
+	}
+
+	callers := make([]caller, *conc)
+	switch *mode {
+	case "unary":
+		u := &unaryCaller{cc: cc}
+		for i := range callers {
+			callers[i] = u
+		}
+	case "bidi":
+		for i := range callers {
+			callers[i] = &streamCaller{st: newStream(cc, &bidiStreamDesc, "/h2.Bench/Bidi")}
+		}
+	case "pool":
+		p := &poolCaller{cc: cc, idle: make(chan *streamCaller, 1024)}
+		for i := range callers {
+			callers[i] = p
+		}
+	case "mux":
+		m := newMux(cc, *k)
+		for i := range callers {
+			callers[i] = m
+		}
+	case "tcpmux":
+		m := newTCPMux(*taddr, *k)
+		for i := range callers {
+			callers[i] = m
+		}
+	case "tcppool":
+		p := &tcpPoolCaller{addr: *taddr, idle: make(chan *tcpConn, 1024)}
+		for i := range callers {
+			callers[i] = p
+		}
+	default:
+		panic("mode")
+	}
+
+	var stop atomic.Bool
+	var measuring atomic.Bool
+	lats := make([][]time.Duration, *conc)
+	var wg sync.WaitGroup
+	for i := range *conc {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			ctx := context.Background()
+			l := make([]time.Duration, 0, 1<<16)
+			id := int64(i * 1000000)
+			for !stop.Load() {
+				id++
+				req, _ := mkRequest(id).MarshalVT()
+				t0 := time.Now()
+				out := callers[i].call(ctx, req)
+				clientDecode(out)
+				if measuring.Load() {
+					l = append(l, time.Since(t0))
+				}
+			}
+			lats[i] = l
+		}()
+	}
+	time.Sleep(500 * time.Millisecond) // warm-up
+	c0, s0, t0 := selfCPU(), procCPU(*spid), time.Now()
+	measuring.Store(true)
+	time.Sleep(*dur)
+	measuring.Store(false)
+	c1, s1, t1 := selfCPU(), procCPU(*spid), time.Now()
+	stop.Store(true)
+	wg.Wait()
+
+	var all []time.Duration
+	for _, l := range lats {
+		all = append(all, l...)
+	}
+	slices.Sort(all)
+	n := len(all)
+	var sum time.Duration
+	for _, d := range all {
+		sum += d
+	}
+	el := t1.Sub(t0).Seconds()
+	us := func(d time.Duration) float64 { return float64(d.Nanoseconds()) / 1e3 }
+	fmt.Printf("%s\t%s\tc=%d\tgmp=%d\tqps=%.0f\tavg=%.1f\tp50=%.1f\tp99=%.1f\tcli_us/op=%.1f\tsrv_us/op=%.1f\n",
+		*label, *mode, *conc, runtime.GOMAXPROCS(0), float64(n)/el, us(sum)/float64(n), us(all[n/2]), us(all[n*99/100]),
+		us(c1-c0)/float64(n), us(s1-s0)/float64(n))
+}
+
+func main() {
+	if len(os.Args) > 1 && os.Args[1] == "sizes" {
+		fmt.Println("req", mkRequest(12345).SizeVT(), "resp", respTemplate.SizeVT())
+		return
+	}
+	if len(os.Args) < 2 {
+		fmt.Println("usage: h2mb server|client ...")
+		os.Exit(2)
+	}
+	switch os.Args[1] {
+	case "server":
+		runServer(os.Args[2:])
+	case "client":
+		runClient(os.Args[2:])
+	}
+}
