+// ExecuteStream is part of the queryservice.QueryServer interface. It serves
+// a sequence of Execute calls on one stream, one at a time and in order. An
+// error of one call is sent in its response and the stream stays usable.
+func (q *query) ExecuteStream(stream queryservicepb.Query_ExecuteStreamServer) (err error) {
+	defer q.server.HandlePanic(&err)
+	streamCtx := callinfo.GRPCCallInfo(stream.Context())
+	for {
+		request, err := stream.Recv()
+		if err != nil {
+			if err == io.EOF {
+				return nil
+			}
+			return err
+		}
+		if err := stream.Send(q.executeOnStream(streamCtx, request)); err != nil {
+			return err
+		}
+	}
+}
+
+func (q *query) executeOnStream(streamCtx context.Context, streamRequest *querypb.ExecuteStreamRequest) *querypb.ExecuteStreamResponse {
+	request := streamRequest.Request
+	if request == nil || request.Query == nil {
+		return &querypb.ExecuteStreamResponse{Error: vterrors.ToVTRPC(vterrors.New(vtrpcpb.Code_INVALID_ARGUMENT, "ExecuteStream: request without a query"))}
+	}
+	ctx := streamCtx
+	if streamRequest.TimeoutNs > 0 {
+		var cancel context.CancelFunc
+		ctx, cancel = context.WithTimeout(ctx, time.Duration(streamRequest.TimeoutNs))
+		defer cancel()
+	}
+	ctx = callerid.NewContext(ctx, request.EffectiveCallerId, request.ImmediateCallerId)
+	if request.ReservedConnKeepAlive {
+		ctx = queryservice.ContextWithReservedConnKeepAlive(ctx, request.ReservedConnKeepAliveIds)
+	}
+	if request.ReservedConnActivityRefresh {
+		ctx = queryservice.ContextWithReservedConnActivityRefresh(ctx)
+	}
+	result, err := q.server.Execute(ctx, nil, request.Target, request.Query.Sql, request.Query.BindVariables, request.TransactionId, request.ReservedId, request.Options)
+	if err != nil {
+		return &querypb.ExecuteStreamResponse{Error: vterrors.ToVTRPC(err)}
+	}
+	return &querypb.ExecuteStreamResponse{Result: sqltypes.ResultToProto3(result)}
+}
+
