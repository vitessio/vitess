+// ExecuteStreamRequest is one Execute call on an ExecuteStream stream.
+message ExecuteStreamRequest {
+  ExecuteRequest request = 1;
+  // timeout_ns is the time the caller had left before its deadline when it sent
+  // the request, in nanoseconds. Zero means no deadline. A stream outlives its
+  // calls, so the per-call deadline cannot travel as the gRPC deadline.
+  int64 timeout_ns = 2;
+}
+
+// ExecuteStreamResponse is the reply to one ExecuteStreamRequest.
+message ExecuteStreamResponse {
+  // result is set if the call succeeded.
+  QueryResult result = 1;
+  // error is set if the call failed. The stream stays usable.
+  vtrpc.RPCError error = 2;
+}
+
