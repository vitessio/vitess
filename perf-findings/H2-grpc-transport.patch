+limitations under the License.
+*/
+
+package grpctabletconn
+
+import (
+	"context"
+	"errors"
+	"io"
+	"sync/atomic"
+	"time"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+
+	"vitess.io/vitess/go/sqltypes"
+	"vitess.io/vitess/go/vt/vterrors"
+	"vitess.io/vitess/go/vt/vttablet/tabletconn"
+
+	querypb "vitess.io/vitess/go/vt/proto/query"
+	queryservicepb "vitess.io/vitess/go/vt/proto/queryservice"
+	vtrpcpb "vitess.io/vitess/go/vt/proto/vtrpc"
+)
+
+// executeStreamPoolSize is the number of idle ExecuteStream streams kept per
+// tablet. 0 disables the ExecuteStream path: Execute uses the unary RPC.
+var executeStreamPoolSize = 0
+
+// executeStream is one long-lived ExecuteStream stream. A stream carries one
+// call at a time; it is checked out of the pool for the duration of a call.
+type executeStream struct {
+	stream queryservicepb.Query_ExecuteStreamClient
+	// cancel ends the stream. It is called when the stream is discarded, and
+	// when the caller's context is done while a call is in flight.
+	cancel context.CancelFunc
+}
+
+// executeStreamPool keeps idle ExecuteStream streams to one tablet.
+type executeStreamPool struct {
+	idle chan *executeStream
+	// unsupportedUntil is set (in Unix nanoseconds) when the tablet answers
+	// Unimplemented: it is older than this client, so Execute uses the unary
+	// RPC until then. The tablet may be upgraded behind the same address, so
+	// ExecuteStream is tried again afterwards.
+	unsupportedUntil atomic.Int64
+}
+
+// executeStreamReprobeInterval is how long Execute uses the unary RPC after a
+// tablet answered that it does not implement ExecuteStream.
+const executeStreamReprobeInterval = time.Minute
+
+func (p *executeStreamPool) usable() bool {
+	until := p.unsupportedUntil.Load()
+	return until == 0 || time.Now().UnixNano() > until
+}
+
+func newExecuteStreamPool(size int) *executeStreamPool {
+	return &executeStreamPool{idle: make(chan *executeStream, size)}
+}
+
+func (p *executeStreamPool) get(c queryservicepb.QueryClient) (*executeStream, error) {
+	select {
+	case s := <-p.idle:
+		return s, nil
+	default:
+	}
+	// The stream must outlive the call that opens it, so it does not use the
+	// caller's context.
+	ctx, cancel := context.WithCancel(context.Background())
+	stream, err := c.ExecuteStream(ctx)
+	if err != nil {
+		cancel()
+		return nil, err
+	}
+	return &executeStream{stream: stream, cancel: cancel}, nil
+}
+
+func (p *executeStreamPool) put(s *executeStream) {
+	select {
+	case p.idle <- s:
+	default:
+		s.cancel()
+	}
+}
+
+// close ends all idle streams.
+func (p *executeStreamPool) close() {
+	for {
+		select {
+		case s := <-p.idle:
+			s.cancel()
+		default:
+			return
+		}
+	}
+}
+
+// executeOnStream runs req on a pooled ExecuteStream stream. ok is false if
+// the tablet does not implement ExecuteStream; the query was not executed then
+// and the caller must use the unary RPC.
+func (conn *gRPCQueryClient) executeOnStream(ctx context.Context, req *querypb.ExecuteRequest) (result *sqltypes.Result, err error, ok bool) {
+	sreq := &querypb.ExecuteStreamRequest{Request: req}
+	if deadline, hasDeadline := ctx.Deadline(); hasDeadline {
+		timeout := time.Until(deadline)
+		if timeout <= 0 {
+			return nil, vterrors.Errorf(vtrpcpb.Code_DEADLINE_EXCEEDED, "vttablet: %v", context.DeadlineExceeded), true
+		}
+		sreq.TimeoutNs = int64(timeout)
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, vterrors.Errorf(vtrpcpb.Code_CANCELED, "vttablet: %v", err), true
+	}
+
+	var (
+		s        *executeStream
+		resp     *querypb.ExecuteStreamResponse
+		sent     bool
+		canceled bool
+	)
+	// An idle stream may have been ended by the tablet (e.g. on shutdown) or by
+	// a broken connection. A Send that fails did not deliver the request, so it
+	// is retried once on a new stream.
+	for attempt := 0; attempt < 2; attempt++ {
+		s, err = conn.streams.get(conn.c)
+		if err != nil {
+			return nil, tabletconn.ErrorFromGRPC(err), true
+		}
+		resp, sent, canceled, err = s.call(ctx, sreq)
+		if err == nil || sent || canceled {
+			break
+		}
+		s.cancel()
+	}
+	if canceled {
+		s.cancel()
+		code := vtrpcpb.Code_CANCELED
+		if errors.Is(ctx.Err(), context.DeadlineExceeded) {
+			code = vtrpcpb.Code_DEADLINE_EXCEEDED
+		}
+		return nil, vterrors.Errorf(code, "vttablet: %v", ctx.Err()), true
+	}
+	if err != nil {
+		s.cancel()
+		if status.Code(err) == codes.Unimplemented {
+			conn.streams.unsupportedUntil.Store(time.Now().Add(executeStreamReprobeInterval).UnixNano())
+			return nil, nil, false
+		}
+		if err == io.EOF {
+			return nil, vterrors.Errorf(vtrpcpb.Code_UNAVAILABLE, "vttablet: ExecuteStream ended by the tablet"), true
+		}
+		return nil, tabletconn.ErrorFromGRPC(err), true
+	}
+	conn.streams.put(s)
+	if resp.Error != nil {
+		// Produce the same error (code and text) as the unary Execute path,
+		// which carries the error as a gRPC status.
+		return nil, tabletconn.ErrorFromGRPC(vterrors.ToGRPC(vterrors.New(resp.Error.Code, resp.Error.Message))), true
+	}
+	return sqltypes.Proto3ToResult(resp.Result), nil, true
+}
+
+// call sends one request on the stream and waits for its reply. sent is true
+// if the request was handed to the transport. canceled is true if ctx was done
+// before the reply arrived; the stream has been ended then.
+func (s *executeStream) call(ctx context.Context, req *querypb.ExecuteStreamRequest) (resp *querypb.ExecuteStreamResponse, sent, canceled bool, err error) {
+	// If the caller gives up, end the stream: the tablet then cancels the
+	// query, as it does when a unary call is canceled. The stream is not
+	// reused because its reply may still be in flight.
+	stop := context.AfterFunc(ctx, s.cancel)
+	err = s.stream.Send(req)
+	if err == nil {
+		sent = true
+		resp, err = s.stream.Recv()
+	}
+	return resp, sent, !stop(), err
+}
diff --git a/go/vt/vttablet/grpctabletconn/execute_stream_test.go b/go/vt/vttablet/grpctabletconn/execute_stream_test.go
