+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package grpcqueryservice
+
+// PROTOTYPE (perf investigation H2): a minimal non-gRPC transport for Execute.
+//
+// vtgate keeps a pool of plain TCP connections per tablet; each connection
+// carries one call at a time: [4-byte little-endian length][ExecuteStreamRequest]
+// in, [4-byte length][ExecuteStreamResponse] out. The connection's goroutine
+// reads the request, executes it inline and writes the response, so a call
+// costs no goroutine hand-offs besides the network poller. This is how the
+// MySQL protocol works, and it is the floor the gRPC-based ExecuteStream is
+// compared with. No TLS, no auth, no cancellation of a running query when the
+// client goes away: this is for measurement only.
+
+import (
+	"bufio"
+	"context"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"net"
+	"slices"
+
+	"github.com/spf13/pflag"
+
+	"vitess.io/vitess/go/vt/log"
+	"vitess.io/vitess/go/vt/servenv"
+	"vitess.io/vitess/go/vt/utils"
+	"vitess.io/vitess/go/vt/vterrors"
+	"vitess.io/vitess/go/vt/vttablet/queryservice"
+
+	querypb "vitess.io/vitess/go/vt/proto/query"
+)
+
+// rawExecutePortOffset: if positive, serve raw Execute on the gRPC port plus this offset.
+var rawExecutePortOffset = 0
+
+func init() {
+	servenv.OnParseFor("vttablet", func(fs *pflag.FlagSet) {
+		utils.SetFlagIntVar(fs, &rawExecutePortOffset, "queryserver-raw-execute-port-offset", rawExecutePortOffset, "(prototype) if positive, serve Execute over plain framed TCP on the gRPC port plus this offset")
+	})
+}
+
+func startRawExecute(server queryservice.QueryService) {
+	if rawExecutePortOffset <= 0 || servenv.GRPCPort() == 0 {
+		return
+	}
+	addr := fmt.Sprintf(":%d", servenv.GRPCPort()+rawExecutePortOffset)
+	l, err := net.Listen("tcp", addr)
+	if err != nil {
+		log.Error(fmt.Sprintf("raw execute: cannot listen on %s: %v", addr, err))
+		return
+	}
+	log.Info(fmt.Sprintf("raw execute: listening on %s", addr))
+	q := &query{server: server}
+	go func() {
+		for {
+			c, err := l.Accept()
+			if err != nil {
+				return
+			}
+			go q.serveRawExecute(c)
+		}
+	}()
+}
+
+func (q *query) serveRawExecute(c net.Conn) {
+	defer c.Close()
+	r := bufio.NewReaderSize(c, 16*1024)
+	w := bufio.NewWriterSize(c, 16*1024)
+	ctx := context.Background()
+	var (
+		hdr [4]byte
+		in  []byte
+		out []byte
+	)
+	for {
+		if _, err := io.ReadFull(r, hdr[:]); err != nil {
+			return
+		}
+		n := int(binary.LittleEndian.Uint32(hdr[:]))
+		in = slices.Grow(in[:0], n)[:n]
+		if _, err := io.ReadFull(r, in); err != nil {
+			return
+		}
+		req := &querypb.ExecuteStreamRequest{}
+		if err := req.UnmarshalVT(in); err != nil {
+			return
+		}
+		resp := q.executeRaw(ctx, req)
+		size := resp.SizeVT()
+		out = slices.Grow(out[:0], 4+size)[:4+size]
+		binary.LittleEndian.PutUint32(out, uint32(size))
+		if _, err := resp.MarshalToSizedBufferVT(out[4:]); err != nil {
+			return
+		}
+		if _, err := w.Write(out); err != nil {
+			return
+		}
+		if err := w.Flush(); err != nil {
+			return
+		}
+	}
+}
+
+func (q *query) executeRaw(ctx context.Context, req *querypb.ExecuteStreamRequest) (resp *querypb.ExecuteStreamResponse) {
+	var err error
+	defer func() {
+		if err != nil {
+			resp = &querypb.ExecuteStreamResponse{Error: vterrors.ToVTRPC(err)}
+		}
+	}()
+	defer q.server.HandlePanic(&err)
+	return q.executeOnStream(ctx, req)
+}
