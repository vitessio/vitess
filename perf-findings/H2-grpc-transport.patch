+++ b/perf-findings/harness/H2/bench.sh
@@ -0,0 +1,35 @@
+#!/bin/bash
+# bench.sh MODE THREADS TIME [LABEL]
+#   MODE: ps (point select, prepared) | text (point select, text) | range1000 (1000-row read, text) | rw (oltp_read_write, prepared)
+#         olap-ps / olap-range1000: same, with the vtgate session in OLAP (streaming) workload via VTGATE_EXTRA_FLAGS
+# Prints one line: label mode threads qps avg p95 p99 cpu_us/query per process (vtgate, tablets sum, mysqld sum) + load
+set -u
+MODE=$1; THREADS=$2; TIME=$3; LABEL=${4:-run}
+C=/home/vt/perf/H2/c.sh
+case $MODE in
+  ps) ARGS=(oltp_point_select --db-ps-mode=auto) ;;
+  text) ARGS=(oltp_point_select --db-ps-mode=disable) ;;
+  range1000) ARGS=(/home/vt/perf/H2/range1000.lua --db-ps-mode=disable) ;;
+  rw) ARGS=(oltp_read_write --db-ps-mode=auto) ;;
+  *) echo "bad mode $MODE" >&2; exit 2 ;;
+esac
+before=$($C cpu)
+out=$($C sb "${ARGS[@]}" --threads="$THREADS" --time="$TIME" --histogram=on --report-interval=0 run 2>&1)
+after=$($C cpu)
+load=$(cut -d' ' -f1 /proc/loadavg)
+q=$(echo "$out" | awk '/queries:/ && /per sec/ {gsub(/[()]/,""); print $2; exit}')
+qps=$(echo "$out" | awk '/queries:/ && /per sec/ {gsub(/[()]/,""); print $3; exit}')
+errs=$(echo "$out" | awk '/ignored errors:/ {print $3; exit}')
+avg=$(echo "$out" | awk '/avg:/ {print $2; exit}')
+pcts=$(echo "$out" | awk '
+  /Latency histogram/ {h=1; next}
+  h && /\|/ { v=$1; c=$NF; if (c ~ /^[0-9]+$/) { vals[n]=v; cnt[n]=c; tot+=c; n++ } }
+  h && /^$/ && n>0 {h=0}
+  END { s=0; p95=""; p99="";
+        for (i=0;i<n;i++){ s+=cnt[i]; if (p95=="" && s>=0.95*tot) p95=vals[i]; if (p99=="" && s>=0.99*tot) p99=vals[i]; }
+        printf "%s %s", p95, p99 }')
+if [[ -z $q || $q == 0 ]]; then echo "$LABEL $MODE FAILED: $(echo "$out" | tail -5)"; exit 1; fi
+cpu=$(paste <(echo "$before") <(echo "$after") | awk -v q="$q" '
+  { d=($4-$2)*1e6/q; if ($1 ~ /^vtgate/) g=d; else if ($1 ~ /^vttablet/) t+=d; else if ($1 ~ /^mysqld/) m+=d }
+  END { printf "vtgate=%.0f tablets=%.0f mysqld=%.0f", g, t, m }')
+printf "%-14s %-9s thr=%-3s qps=%-8s avg=%-6s p95=%-6s p99=%-6s %s err=%s load=%s\n" "$LABEL" "$MODE" "$THREADS" "$qps" "$avg" $pcts "$cpu" "${errs:-0}" "$load"
