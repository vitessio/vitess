+#!/bin/bash
+# shutdown-test.sh CFG : restart with CFG, run 5s of point selects (idle pooled streams remain), then SIGTERM tablet 101
+# while vtgate stays up, and report how long the tablet takes to exit.
+cfg=$1
+(
+  unset BIN GATE_ENV TABLET_ENV VTGATE_EXTRA_FLAGS VTTABLET_EXTRA_FLAGS
+  # shellcheck disable=SC1090
+  source "$cfg"
+  export BIN GATE_ENV TABLET_ENV VTGATE_EXTRA_FLAGS VTTABLET_EXTRA_FLAGS
+  /home/vt/perf/H2/c.sh restart >/dev/null 2>&1
+)
+flock -o /home/vt/perf/bench.lock /home/vt/perf/H2/c.sh sb oltp_point_select --threads=8 --time=5 --db-ps-mode=auto run >/dev/null 2>&1
+pid=$(/home/vt/perf/H2/c.sh pids | awk '/^vttablet_101/ {print $2}')
+start=$(date +%s.%N)
+kill -TERM "$pid"
+for _ in $(seq 1 1200); do kill -0 "$pid" 2>/dev/null || break; sleep 0.05; done
+end=$(date +%s.%N)
+alive=no; kill -0 "$pid" 2>/dev/null && alive=yes
+echo "$(basename "$cfg" .cfg): tablet 101 exit after $(echo "$end - $start" | bc) s (still alive: $alive)"
+grep -E 'gRPC server stopped|graceful stop|onterm|timed out' /home/vt/perf/c40000/logs/vttablet_101.log | tail -4
