diff --git a/go/vt/vttablet/grpcqueryservice/rawexec.go b/go/vt/vttablet/grpcqueryservice/rawexec.go
new file mode 100644
index 0000000000..4600184928
--- /dev/null
+++ b/go/vt/vttablet/grpcqueryservice/rawexec.go
@@ -0,0 +1,130 @@
+/*
