+
+package grpctabletconn
+
+import (
+	"context"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+
+	"vitess.io/vitess/go/sqltypes"
+	"vitess.io/vitess/go/vt/grpcclient"
+	"vitess.io/vitess/go/vt/vterrors"
+	"vitess.io/vitess/go/vt/vttablet/grpcqueryservice"
+	"vitess.io/vitess/go/vt/vttablet/queryservice"
+	"vitess.io/vitess/go/vt/vttablet/tabletconntest"
+
+	querypb "vitess.io/vitess/go/vt/proto/query"
+	queryservicepb "vitess.io/vitess/go/vt/proto/queryservice"
+	topodatapb "vitess.io/vitess/go/vt/proto/topodata"
+	vtrpcpb "vitess.io/vitess/go/vt/proto/vtrpc"
+)
+
+func withExecuteStreamPool(t *testing.T, size int) {
+	old := executeStreamPoolSize
+	executeStreamPoolSize = size
+	t.Cleanup(func() { executeStreamPoolSize = old })
+}
+
+func listenAndServe(t *testing.T, register func(*grpc.Server)) *topodatapb.Tablet {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	server := grpc.NewServer()
+	register(server)
+	go server.Serve(listener)
+	t.Cleanup(server.Stop)
+	return &topodatapb.Tablet{
+		Keyspace: tabletconntest.TestTarget.Keyspace,
+		Shard:    tabletconntest.TestTarget.Shard,
+		Type:     tabletconntest.TestTarget.TabletType,
+		Alias:    tabletconntest.TestAlias,
+		Hostname: listener.Addr().(*net.TCPAddr).IP.String(),
+		PortMap:  map[string]int32{"grpc": int32(listener.Addr().(*net.TCPAddr).Port)},
+	}
+}
+
+func dial(t *testing.T, tablet *topodatapb.Tablet) *gRPCQueryClient {
+	qs, err := DialTablet(t.Context(), tablet, grpcclient.FailFast(false))
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = qs.Close(context.Background()) })
+	return qs.(*gRPCQueryClient)
+}
+
+// TestGRPCTabletConnExecuteStream runs the tablet conn test suite with Execute
+// sent over pooled ExecuteStream streams: results, caller ids, errors and
+// panics must look exactly as they do over the unary RPC.
+func TestGRPCTabletConnExecuteStream(t *testing.T) {
+	withExecuteStreamPool(t, 4)
+	service := tabletconntest.CreateFakeServer(t)
+	tablet := listenAndServe(t, func(s *grpc.Server) { grpcqueryservice.Register(s, service) })
+	tabletconntest.TestSuite(t.Context(), t, protocolName, tablet, service, nil)
+}
+
+// executeProbe is a QueryService whose Execute reports what it saw in its
+// context, and blocks until released or cancelled when asked to.
+type executeProbe struct {
+	queryservice.QueryService
+	started  chan struct{}
+	canceled chan struct{}
+}
+
+func (p *executeProbe) Execute(ctx context.Context, _ queryservice.Session, _ *querypb.Target, sql string, _ map[string]*querypb.BindVariable, _, _ int64, _ *querypb.ExecuteOptions) (*sqltypes.Result, error) {
+	switch sql {
+	case "deadline":
+		deadline, ok := ctx.Deadline()
+		if !ok {
+			return nil, vterrors.New(vtrpcpb.Code_FAILED_PRECONDITION, "no deadline")
+		}
+		return sqltypes.MakeTestResult(sqltypes.MakeTestFields("remaining", "int64"), time.Until(deadline).Round(time.Second).String()), nil
+	case "block":
+		close(p.started)
+		<-ctx.Done()
+		close(p.canceled)
+		return nil, ctx.Err()
+	case "fail":
+		return nil, vterrors.New(vtrpcpb.Code_ALREADY_EXISTS, "Duplicate entry '1' for key 'PRIMARY' (errno 1062) (sqlstate 23000)")
+	}
+	return sqltypes.MakeTestResult(sqltypes.MakeTestFields("sql", "varchar"), sql), nil
+}
+
+func (p *executeProbe) HandlePanic(*error) {}
+
+// TestExecuteStreamReusesStreams checks that consecutive calls share one stream,
+// and that an error reply leaves the stream usable.
+func TestExecuteStreamReusesStreams(t *testing.T) {
+	withExecuteStreamPool(t, 4)
+	probe := &executeProbe{}
+	conn := dial(t, listenAndServe(t, func(s *grpc.Server) { grpcqueryservice.Register(s, probe) }))
+
+	for i := range 5 {
+		qr, err := conn.Execute(t.Context(), nil, tabletconntest.TestTarget, "q", nil, 0, 0, nil)
+		require.NoError(t, err, "call %d", i)
+		assert.Equal(t, "q", qr.Rows[0][0].ToString())
+		_, err = conn.Execute(t.Context(), nil, tabletconntest.TestTarget, "fail", nil, 0, 0, nil)
+		require.Error(t, err)
+		assert.Equal(t, vtrpcpb.Code_ALREADY_EXISTS, vterrors.Code(err))
+		assert.Len(t, conn.streams.idle, 1, "call %d did not return its stream to the pool", i)
+	}
+}
+
+// TestExecuteStreamErrorMatchesUnary checks that an error reply produces the
+// same error text as the unary RPC does.
+func TestExecuteStreamErrorMatchesUnary(t *testing.T) {
+	probe := &executeProbe{}
+	tablet := listenAndServe(t, func(s *grpc.Server) { grpcqueryservice.Register(s, probe) })
+	unary := dial(t, tablet)
+	_, unaryErr := unary.Execute(t.Context(), nil, tabletconntest.TestTarget, "fail", nil, 0, 0, nil)
+	require.Error(t, unaryErr)
+
+	withExecuteStreamPool(t, 4)
+	stream := dial(t, tablet)
+	_, streamErr := stream.Execute(t.Context(), nil, tabletconntest.TestTarget, "fail", nil, 0, 0, nil)
+	require.Error(t, streamErr)
+	assert.Equal(t, unaryErr.Error(), streamErr.Error())
+	assert.Equal(t, vterrors.Code(unaryErr), vterrors.Code(streamErr))
+}
+
+// TestExecuteStreamDeadline checks that the caller's deadline reaches the
+// tablet although the stream itself has none.
+func TestExecuteStreamDeadline(t *testing.T) {
+	withExecuteStreamPool(t, 4)
+	probe := &executeProbe{}
+	conn := dial(t, listenAndServe(t, func(s *grpc.Server) { grpcqueryservice.Register(s, probe) }))
+
+	ctx, cancel := context.WithTimeout(t.Context(), time.Minute)
+	defer cancel()
+	qr, err := conn.Execute(ctx, nil, tabletconntest.TestTarget, "deadline", nil, 0, 0, nil)
+	require.NoError(t, err)
+	assert.Equal(t, "1m0s", qr.Rows[0][0].ToString())
+
+	_, err = conn.Execute(t.Context(), nil, tabletconntest.TestTarget, "deadline", nil, 0, 0, nil)
+	require.Error(t, err)
+	assert.Equal(t, vtrpcpb.Code_FAILED_PRECONDITION, vterrors.Code(err))
+}
+
+// TestExecuteStreamCancel checks that cancelling the caller's context cancels
+// the query on the tablet, and that the stream is not reused.
+func TestExecuteStreamCancel(t *testing.T) {
+	withExecuteStreamPool(t, 4)
+	probe := &executeProbe{started: make(chan struct{}), canceled: make(chan struct{})}
+	conn := dial(t, listenAndServe(t, func(s *grpc.Server) { grpcqueryservice.Register(s, probe) }))
+
+	ctx, cancel := context.WithCancel(t.Context())
+	errc := make(chan error, 1)
+	go func() {
+		_, err := conn.Execute(ctx, nil, tabletconntest.TestTarget, "block", nil, 0, 0, nil)
+		errc <- err
+	}()
+	<-probe.started
+	cancel()
+	err := <-errc
+	require.Error(t, err)
+	assert.Equal(t, vtrpcpb.Code_CANCELED, vterrors.Code(err))
+	select {
+	case <-probe.canceled:
+	case <-time.After(30 * time.Second):
+		t.Fatal("the tablet's query was not cancelled")
+	}
+	assert.Empty(t, conn.streams.idle)
+
+	qr, err := conn.Execute(t.Context(), nil, tabletconntest.TestTarget, "after", nil, 0, 0, nil)
+	require.NoError(t, err)
+	assert.Equal(t, "after", qr.Rows[0][0].ToString())
+}
+
+// unaryOnlyServer is a tablet that predates ExecuteStream.
+type unaryOnlyServer struct {
+	queryservicepb.UnimplementedQueryServer
+	calls int
+}
+
+func (s *unaryOnlyServer) Execute(_ context.Context, req *querypb.ExecuteRequest) (*querypb.ExecuteResponse, error) {
+	s.calls++
+	qr := sqltypes.MakeTestResult(sqltypes.MakeTestFields("sql", "varchar"), req.Query.Sql)
+	return &querypb.ExecuteResponse{Result: sqltypes.ResultToProto3(qr)}, nil
+}
+
+// TestExecuteStreamFallsBackToUnary checks that a tablet without ExecuteStream
+// gets unary calls, and that each query is executed exactly once.
+func TestExecuteStreamFallsBackToUnary(t *testing.T) {
+	withExecuteStreamPool(t, 4)
+	server := &unaryOnlyServer{}
+	conn := dial(t, listenAndServe(t, func(s *grpc.Server) { queryservicepb.RegisterQueryServer(s, server) }))
+
+	for i := range 3 {
+		qr, err := conn.Execute(t.Context(), nil, tabletconntest.TestTarget, "q", nil, 0, 0, nil)
+		require.NoError(t, err, "call %d", i)
+		assert.Equal(t, "q", qr.Rows[0][0].ToString())
+	}
+	assert.Equal(t, 3, server.calls)
+	assert.False(t, conn.streams.usable())
+}
diff --git a/go/vt/vttablet/grpctabletconn/rawexec.go b/go/vt/vttablet/grpctabletconn/rawexec.go
