+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package grpctabletconn
+
+// PROTOTYPE (perf investigation H2): client side of the plain framed TCP
+// transport for Execute (see grpcqueryservice/rawexec.go). A pool of TCP
+// connections per tablet; each call checks out a connection, writes the
+// request and reads the response in the caller's goroutine. For measurement
+// only: no TLS, no auth.
+
+import (
+	"bufio"
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"slices"
+	"strconv"
+	"time"
+
+	"vitess.io/vitess/go/sqltypes"
+	"vitess.io/vitess/go/vt/vterrors"
+	"vitess.io/vitess/go/vt/vttablet/tabletconn"
+
+	querypb "vitess.io/vitess/go/vt/proto/query"
+	vtrpcpb "vitess.io/vitess/go/vt/proto/vtrpc"
+)
+
+// rawExecutePortOffset: if positive, send Execute calls over plain framed TCP to
+// the tablet's gRPC port plus this offset.
+var rawExecutePortOffset = 0
+
+type rawExecConn struct {
+	c   net.Conn
+	r   *bufio.Reader
+	w   *bufio.Writer
+	buf []byte
+}
+
+type rawExecPool struct {
+	addr string
+	idle chan *rawExecConn
+}
+
+func newRawExecPool(host string, grpcPort int32, size int) *rawExecPool {
+	return &rawExecPool{
+		addr: net.JoinHostPort(host, strconv.Itoa(int(grpcPort)+rawExecutePortOffset)),
+		idle: make(chan *rawExecConn, size),
+	}
+}
+
+func (p *rawExecPool) get(ctx context.Context) (*rawExecConn, error) {
+	select {
+	case c := <-p.idle:
+		return c, nil
+	default:
+	}
+	var d net.Dialer
+	c, err := d.DialContext(ctx, "tcp", p.addr)
+	if err != nil {
+		return nil, err
+	}
+	if tc, ok := c.(*net.TCPConn); ok {
+		_ = tc.SetNoDelay(true)
+	}
+	return &rawExecConn{c: c, r: bufio.NewReaderSize(c, 16*1024), w: bufio.NewWriterSize(c, 16*1024)}, nil
+}
+
+func (p *rawExecPool) put(c *rawExecConn) {
+	select {
+	case p.idle <- c:
+	default:
+		c.c.Close()
+	}
+}
+
+func (p *rawExecPool) close() {
+	for {
+		select {
+		case c := <-p.idle:
+			c.c.Close()
+		default:
+			return
+		}
+	}
+}
+
+func (c *rawExecConn) call(req *querypb.ExecuteStreamRequest) (*querypb.ExecuteStreamResponse, error) {
+	size := req.SizeVT()
+	c.buf = slices.Grow(c.buf[:0], 4+size)[:4+size]
+	binary.LittleEndian.PutUint32(c.buf, uint32(size))
+	if _, err := req.MarshalToSizedBufferVT(c.buf[4:]); err != nil {
+		return nil, err
+	}
+	if _, err := c.w.Write(c.buf); err != nil {
+		return nil, err
+	}
+	if err := c.w.Flush(); err != nil {
+		return nil, err
+	}
+	var hdr [4]byte
+	if _, err := io.ReadFull(c.r, hdr[:]); err != nil {
+		return nil, err
+	}
+	n := int(binary.LittleEndian.Uint32(hdr[:]))
+	c.buf = slices.Grow(c.buf[:0], n)[:n]
+	if _, err := io.ReadFull(c.r, c.buf); err != nil {
+		return nil, err
+	}
+	resp := &querypb.ExecuteStreamResponse{}
+	if err := resp.UnmarshalVT(c.buf); err != nil {
+		return nil, err
+	}
+	return resp, nil
+}
+
+func (conn *gRPCQueryClient) executeRaw(ctx context.Context, req *querypb.ExecuteRequest) (*sqltypes.Result, error) {
+	sreq := &querypb.ExecuteStreamRequest{Request: req}
+	if deadline, ok := ctx.Deadline(); ok {
+		timeout := time.Until(deadline)
+		if timeout <= 0 {
+			return nil, vterrors.Errorf(vtrpcpb.Code_DEADLINE_EXCEEDED, "vttablet: %v", context.DeadlineExceeded)
+		}
+		sreq.TimeoutNs = int64(timeout)
+	}
+	c, err := conn.raw.get(ctx)
+	if err != nil {
+		return nil, vterrors.Errorf(vtrpcpb.Code_UNAVAILABLE, "vttablet: %v", err)
+	}
+	// If the caller gives up, unblock the read and drop the connection.
+	stop := context.AfterFunc(ctx, func() { _ = c.c.SetDeadline(time.Now()) })
+	resp, err := c.call(sreq)
+	if !stop() {
+		c.c.Close()
+		code := vtrpcpb.Code_CANCELED
+		if errors.Is(ctx.Err(), context.DeadlineExceeded) {
+			code = vtrpcpb.Code_DEADLINE_EXCEEDED
+		}
+		return nil, vterrors.Errorf(code, "vttablet: %v", ctx.Err())
+	}
+	if err != nil {
+		c.c.Close()
+		return nil, vterrors.Errorf(vtrpcpb.Code_UNAVAILABLE, "vttablet: %v", err)
+	}
+	conn.raw.put(c)
+	if resp.Error != nil {
+		return nil, tabletconn.ErrorFromVTRPC(resp.Error)
+	}
+	return sqltypes.Proto3ToResult(resp.Result), nil
+}
