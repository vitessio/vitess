new file mode 100644
index 0000000000..24903deef8
--- /dev/null
+++ b/perf-findings/harness/H2/agg.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""agg.py FILE [BASECFG]: aggregate bench.sh lines (label rN-cfg) into a markdown table of means per (mode, thr, cfg)."""
+import re
+import sys
+from collections import defaultdict, OrderedDict
+
+fn = sys.argv[1]
+basecfg = sys.argv[2] if len(sys.argv) > 2 else None
+rows = defaultdict(list)
+order = OrderedDict()
+cfgs = OrderedDict()
+pat = re.compile(r'^r(\d+)-(\S+)\s+(\S+)\s+thr=(\d+)\s+qps=(\S+)\s+avg=(\S+)\s+p95=(\S+)\s+p99=(\S+)\s+vtgate=(\d+)\s+tablets=(\d+)\s+mysqld=(\d+)\s+err=(\S+)\s+load=(\S+)')
+for line in open(fn):
+    m = pat.match(line.strip())
+    if not m:
+        continue
+    r, cfg, mode, thr = m.group(1), m.group(2), m.group(3), int(m.group(4))
+    vals = [float(x) for x in m.group(5, 6, 7, 8, 9, 10, 11, 13)]
+    rows[(mode, thr, cfg)].append(vals)
+    order[(mode, thr)] = 1
+    cfgs[cfg] = 1
+if basecfg is None:
+    basecfg = next(iter(cfgs))
+
+
+def mean(xs):
+    return sum(xs) / len(xs)
+
+
+print("| mode | thr | config | n | QPS | avg ms | p95 ms | p99 ms | vtgate µs/q | tablets µs/q | mysqld µs/q | load |")
+print("|---|---|---|---|---|---|---|---|---|---|---|---|")
+for (mode, thr) in order:
+    base = rows.get((mode, thr, basecfg))
+    bm = [mean([v[i] for v in base]) for i in range(8)] if base else None
+    for cfg in cfgs:
+        vs = rows.get((mode, thr, cfg))
+        if not vs:
+            continue
+        mm = [mean([v[i] for v in vs]) for i in range(8)]
+        cells = []
+        for i in range(7):
+            s = f"{mm[i]:.0f}" if i in (0, 4, 5, 6) else f"{mm[i]:.2f}"
+            if bm and cfg != basecfg and bm[i]:
+                s += f" ({(mm[i] / bm[i] - 1) * 100:+.1f}%)"
+            if i in (4, 5):
+                lo = min(v[i] for v in vs)
+                hi = max(v[i] for v in vs)
+                s += f" [{lo:.0f}–{hi:.0f}]"
+            cells.append(s)
+        print(f"| {mode} | {thr} | {cfg} | {len(vs)} | " + " | ".join(cells) + f" | {mm[7]:.1f} |")
