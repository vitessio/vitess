+#!/bin/bash
+# shares.sh BINARY PROFILE...: print the cumulative share of interesting stages
+BINARY=$1; shift
+for f in "$@"; do
+  echo "== $f"
+  go tool pprof -top -cum -nodecount=400 "$BINARY" "$f" 2>/dev/null | grep -E "Total samples|findRunnable$|gcBgMarkWorker$|runtime.mallocgc$|Codec..Unmarshal$|Conn..writeRows|Parser..Parse2$|sqlparser.Normalize$|http2Client..reader$|loopyWriter..run$|executeMultiShard.func1$|SortResult$|linux.Syscall6$|grpc.newClientStream$|fetchOrCreatePlan$|probeTable..exists$|memclrNoHeapPointers$|MergeSort..TryStreamExecute$|proto3ToRows$|OrderedAggregate..execute$|RoutingParameters..in$" | cut -c1-150
+done
