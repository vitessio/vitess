+#!/bin/bash
+# prof.sh OUTDIR NAME KIND SHAPE [args...]   KIND=profile|allocs|heap
+# Runs a 25s bench of SHAPE and captures a 15s KIND profile from vtgate and tablet 100.
+set -u
+OUT=$1; NAME=$2; KIND=$3; SHAPE=$4; shift 4
+mkdir -p "$OUT"
+/home/vt/perf/P3/bench.sh "prof-$NAME" 8 25 "$SHAPE" "$@" > "$OUT/$NAME-bench-$KIND.txt" &
+sleep 6
+curl -s -o "$OUT/$NAME-vtgate-$KIND.pprof" "http://localhost:40001/debug/pprof/$KIND?seconds=15" &
+curl -s -o "$OUT/$NAME-tablet-$KIND.pprof" "http://localhost:40100/debug/pprof/$KIND?seconds=15" &
+wait
+cat "$OUT/$NAME-bench-$KIND.txt"
