+
+	"vitess.io/vitess/go/sqltypes"
+	querypb "vitess.io/vitess/go/vt/proto/query"
+)
+
+func init() {
+	// The fakePrimitive used by most join tests hands out its results in call
+	// order and is not safe for concurrent use. Tests that exercise concurrent
+	// RHS execution set JoinRHSConcurrency themselves.
+	JoinRHSConcurrency = 1
+}
+
+func setJoinRHSConcurrency(t *testing.T, n int) {
+	old := JoinRHSConcurrency
+	JoinRHSConcurrency = n
+	t.Cleanup(func() { JoinRHSConcurrency = old })
+}
+
+// bindVarRHS is a join RHS whose result depends only on the "bv" bind variable,
+// so it returns the same results in any execution order. It returns "bv"
+// times one row, or an error for bv == failOn. Every execution waits until
+// waitFor executions are in flight at once (or until the context is done), so
+// a test using it only finishes quickly if the join runs its RHS concurrently.
+type bindVarRHS struct {
+	fakePrimitive
+	waitFor int
+	failOn  int64
+
+	mu       sync.Mutex
+	inFlight int
+	maxSeen  int
+	arrived  chan struct{}
+	closed   bool
+	calls    atomic.Int64
+}
+
+func newBindVarRHS(waitFor int) *bindVarRHS {
+	return &bindVarRHS{waitFor: waitFor, failOn: -1, arrived: make(chan struct{})}
+}
+
+var bindVarRHSFields = sqltypes.MakeTestFields("rcol", "int64")
+
+func (f *bindVarRHS) TryExecute(ctx context.Context, vcursor VCursor, bindVars map[string]*querypb.BindVariable, wantfields bool) (*sqltypes.Result, error) {
+	f.calls.Add(1)
+	f.mu.Lock()
+	f.inFlight++
+	f.maxSeen = max(f.maxSeen, f.inFlight)
+	if f.inFlight == f.waitFor && !f.closed {
+		close(f.arrived)
+		f.closed = true
+	}
+	f.mu.Unlock()
+	defer func() {
+		f.mu.Lock()
+		f.inFlight--
+		f.mu.Unlock()
+	}()
+
+	if f.waitFor > 1 {
+		select {
+		case <-f.arrived:
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-time.After(30 * time.Second):
+			return nil, errors.New("RHS executions did not run concurrently")
+		}
+	}
+
+	n, err := strconv.ParseInt(string(bindVars["bv"].Value), 10, 64)
+	if err != nil {
+		return nil, err
+	}
+	if n == f.failOn {
+		return nil, fmt.Errorf("rhs failed for %d", n)
+	}
+	result := &sqltypes.Result{}
+	if wantfields {
+		result.Fields = bindVarRHSFields
+	}
+	for i := range n {
+		result.Rows = append(result.Rows, sqltypes.Row{sqltypes.NewInt64(n*10 + i)})
+	}
+	return result, nil
+}
+
+func joinConcurrentLHS(n int) *fakePrimitive {
+	var rows []string
+	for i := range n {
+		rows = append(rows, strconv.Itoa(i))
+	}
+	return &fakePrimitive{
+		results: []*sqltypes.Result{
+			sqltypes.MakeTestResult(sqltypes.MakeTestFields("lcol", "int64"), rows...),
+		},
+	}
+}
+
+func TestJoinExecuteConcurrentRHS(t *testing.T) {
+	setJoinRHSConcurrency(t, 4)
+	for _, opcode := range []JoinOpcode{InnerJoin, LeftJoin} {
+		t.Run(opcode.String(), func(t *testing.T) {
+			rhs := newBindVarRHS(4)
+			jn := &Join{
+				Opcode: opcode,
+				Left:   joinConcurrentLHS(6),
+				Right:  rhs,
+				Cols:   []int{-1, 1},
+				Vars:   map[string]int{"bv": 0},
+			}
+			r, err := jn.TryExecute(t.Context(), &noopVCursor{}, map[string]*querypb.BindVariable{}, true)
+			require.NoError(t, err)
+			assert.EqualValues(t, 6, rhs.calls.Load())
+			assert.Equal(t, 4, rhs.maxSeen, "RHS executions should run concurrently, up to JoinRHSConcurrency")
+
+			// the output keeps the LHS row order
+			want := []string{}
+			if opcode == LeftJoin {
+				want = append(want, "0|null")
+			}
+			for l := 1; l < 6; l++ {
+				for i := range l {
+					want = append(want, fmt.Sprintf("%d|%d", l, l*10+i))
+				}
+			}
+			expectResult(t, r, sqltypes.MakeTestResult(sqltypes.MakeTestFields("lcol|rcol", "int64|int64"), want...))
+		})
+	}
+}
+
+func TestJoinExecuteConcurrentRHSError(t *testing.T) {
+	setJoinRHSConcurrency(t, 4)
+	rhs := newBindVarRHS(1)
+	rhs.failOn = 3
+	jn := &Join{
+		Opcode: InnerJoin,
+		Left:   joinConcurrentLHS(10),
+		Right:  rhs,
+		Cols:   []int{-1, 1},
+		Vars:   map[string]int{"bv": 0},
+	}
+	_, err := jn.TryExecute(t.Context(), &noopVCursor{}, map[string]*querypb.BindVariable{}, true)
+	require.ErrorContains(t, err, "rhs failed for 3")
+}
+
+func TestJoinExecuteConcurrentRHSMaxMemoryRows(t *testing.T) {
+	setJoinRHSConcurrency(t, 4)
+	saveMax := testMaxMemoryRows
+	testMaxMemoryRows = 5
+	t.Cleanup(func() { testMaxMemoryRows = saveMax })
+
+	jn := &Join{
+		Opcode: InnerJoin,
+		Left:   joinConcurrentLHS(10),
+		Right:  newBindVarRHS(1),
+		Cols:   []int{-1, 1},
+		Vars:   map[string]int{"bv": 0},
+	}
+	_, err := jn.TryExecute(t.Context(), &noopVCursor{}, map[string]*querypb.BindVariable{}, true)
+	require.ErrorContains(t, err, "in-memory row count exceeded allowed limit of 5")
+}
+
+func TestJoinExecuteSequentialInTransaction(t *testing.T) {
+	setJoinRHSConcurrency(t, 4)
+	rhs := newBindVarRHS(1)
+	jn := &Join{
+		Opcode: InnerJoin,
+		Left:   joinConcurrentLHS(6),
+		Right:  rhs,
+		Cols:   []int{-1, 1},
+		Vars:   map[string]int{"bv": 0},
+	}
+	_, err := jn.TryExecute(t.Context(), &noopVCursor{inTx: true}, map[string]*querypb.BindVariable{}, true)
+	require.NoError(t, err)
+	assert.EqualValues(t, 6, rhs.calls.Load())
+	assert.Equal(t, 1, rhs.maxSeen, "RHS executions inside a transaction must not run concurrently")
+}
diff --git a/go/vt/vtgate/evalengine/api_compare.go b/go/vt/vtgate/evalengine/api_compare.go
index 70629cc..0c9a888 100644
--- a/go/vt/vtgate/evalengine/api_compare.go
+++ b/go/vt/vtgate/evalengine/api_compare.go
@@ -305,11 +305,89 @@ func (cmp Comparison) SortResult(out *sqltypes.Result) (err error) {
 }
 
 func (cmp Comparison) Sort(out []sqltypes.Row) {
+	if cmp.mergeRuns(out) {
+		return
+	}
 	slices.SortFunc(out, func(a, b sqltypes.Row) int {
 		return cmp.Compare(a, b)
 	})
 }
 
+// maxMergeRuns is the largest number of ascending runs for which Sort merges
+// the runs instead of sorting from scratch.
+const maxMergeRuns = 64
+
+// mergeRuns sorts out if it consists of at most maxMergeRuns ascending runs,
+// and reports whether it did. A scatter query with an ORDER BY returns rows
+// that are already sorted within each shard, and the shard results are
+// concatenated, so the input usually has one run per shard. Merging k runs
+// takes n-1 comparisons to find them plus about n*log2(k) comparisons to merge,
+// instead of about n*log2(n) for a full sort. The merge is stable. Random input
+// is detected after about 2*maxMergeRuns comparisons.
+func (cmp Comparison) mergeRuns(out []sqltypes.Row) bool {
+	n := len(out)
+	if n < 2 {
+		return true
+	}
+	var boundsBuf [maxMergeRuns + 1]int
+	bounds := append(boundsBuf[:0], 0)
+	for i := 1; i < n; i++ {
+		if cmp.Compare(out[i-1], out[i]) > 0 {
+			if len(bounds) == maxMergeRuns {
+				return false
+			}
+			bounds = append(bounds, i)
+		}
+	}
+	if len(bounds) == 1 {
+		// already sorted
+		return true
+	}
+	bounds = append(bounds, n)
+
+	src, dst := out, make([]sqltypes.Row, n)
+	for len(bounds) > 2 {
+		next := 0
+		for i := 0; i+1 < len(bounds); i += 2 {
+			lo, mid := bounds[i], bounds[i+1]
+			if i+2 < len(bounds) {
+				hi := bounds[i+2]
+				cmp.merge(dst[lo:hi], src[lo:mid], src[mid:hi])
+			} else {
+				copy(dst[lo:mid], src[lo:mid])
+			}
+			// bounds is rewritten in place: every pass keeps every other boundary.
+			bounds[next] = lo
+			next++
+		}
+		bounds[next] = n
+		bounds = bounds[:next+1]
+		src, dst = dst, src
+	}
+	if &src[0] != &out[0] {
+		copy(out, src)
+	}
+	return true
+}
+
+// merge merges the sorted slices a and b into dst, which must have room for
+// len(a)+len(b) rows. Rows from a come first among equal rows.
+func (cmp Comparison) merge(dst, a, b []sqltypes.Row) {
+	i, j, k := 0, 0, 0
+	for i < len(a) && j < len(b) {
+		if cmp.Compare(b[j], a[i]) < 0 {
+			dst[k] = b[j]
+			j++
+		} else {
+			dst[k] = a[i]
+			i++
+		}
+		k++
+	}
+	k += copy(dst[k:], a[i:])
+	copy(dst[k:], b[j:])
+}
+
 type Sorter struct {
 	Compare Comparison
 	Limit   int
