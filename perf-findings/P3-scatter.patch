+#!/bin/bash
+# ab.sh ROUNDS "SHAPES" CFG1 CFG2 [CFG3...]
+#   SHAPES: space separated names from suite.sh's table (regex anchors added), e.g. "big10k_olap grp_high10k"
+#   CFGn:   path to a shell snippet that sets BIN / GATE_ENV / TABLET_ENV / VTGATE_EXTRA_FLAGS / VTTABLET_EXTRA_FLAGS
+# For every round and config: restart vtgate+vttablets with that config, warm up, run each shape for $TIME (default 15s).
+set -u
+ROUNDS=$1; SHAPES=$2; shift 2
+TIME=${TIME:-15}
+THR=${THR:-8}
+filter="^($(echo "$SHAPES" | tr ' ' '|'))$"
+for r in $(seq "${FIRST_ROUND:-1}" "$ROUNDS"); do
+  for cfg in "$@"; do
+    name=$(basename "$cfg" .cfg)
+    (
+      unset BIN GATE_ENV TABLET_ENV VTGATE_EXTRA_FLAGS VTTABLET_EXTRA_FLAGS
+      # shellcheck disable=SC1090
+      source "$cfg"
+      export BIN GATE_ENV TABLET_ENV VTGATE_EXTRA_FLAGS VTTABLET_EXTRA_FLAGS
+      # retry: a listener port can collide with an ephemeral port of another connection
+      for _ in 1 2 3; do
+        /home/vt/perf/P3/c.sh restart >/dev/null 2>&1
+        mysql -h 127.0.0.1 -P 40003 -u root -e 'select 1' sbtest >/dev/null 2>&1 && break
+        echo "restart failed, retrying" >&2
+      done
+    )
+    /home/vt/perf/P3/bench.sh warm 8 4 krange --width=100 >/dev/null 2>&1
+    /home/vt/perf/P3/suite.sh "r$r-$name" "$THR" "$TIME" "$filter"
+  done
+done
