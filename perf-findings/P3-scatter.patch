+#!/bin/bash
+# bench.sh LABEL THREADS TIME SHAPE [extra sysbench args...]
+#   SHAPE: a p3.lua shape name (text protocol), or sb:<builtin> for a built-in sysbench test (e.g. sb:oltp_read_only)
+# Prints one line: label shape threads qps avg p95 p99 cpu_us/query per process (vtgate, tablets sum, mysqld sum) + load
+set -u
+LABEL=$1; THREADS=$2; TIME=$3; SHAPE=$4; shift 4
+C=/home/vt/perf/P3/c.sh
+if [[ $SHAPE == sb:* ]]; then
+  TEST=${SHAPE#sb:}
+else
+  TEST="/home/vt/perf/P3/lua/p3.lua --shape=$SHAPE"
+fi
+before=$($C cpu)
+# shellcheck disable=SC2086
+out=$($C sb $TEST --threads="$THREADS" --time="$TIME" --histogram=on --report-interval=0 "$@" run 2>&1)
+after=$($C cpu)
+load=$(cut -d' ' -f1 /proc/loadavg)
+q=$(echo "$out" | awk '/queries:/ && /per sec/ {gsub(/[()]/,""); print $2; exit}')
+qps=$(echo "$out" | awk '/queries:/ && /per sec/ {gsub(/[()]/,""); print $3; exit}')
+avg=$(echo "$out" | awk '/avg:/ {print $2; exit}')
+errs=$(echo "$out" | awk '/ignored errors:/ {print $3; exit}')
+if [[ -z $q ]]; then echo "$LABEL $SHAPE FAILED: $(echo "$out" | grep -iE 'error|fatal' | head -3)"; exit 1; fi
+pcts=$(echo "$out" | awk '
+  /Latency histogram/ {h=1; next}
+  h && /\|/ { v=$1; c=$NF; if (c ~ /^[0-9]+$/) { vals[n]=v; cnt[n]=c; tot+=c; n++ } }
+  h && /^$/ && n>0 {h=0}
+  END { s=0; p95=""; p99="";
+        for (i=0;i<n;i++){ s+=cnt[i]; if (p95=="" && s>=0.95*tot) p95=vals[i]; if (p99=="" && s>=0.99*tot) p99=vals[i]; }
+        if (p95=="") p95="0"; if (p99=="") p99=vals[n-1]; if (p99=="") p99="0";
+        printf "%s %s", p95, p99 }')
+cpu=$(paste <(echo "$before") <(echo "$after") | awk -v q="$q" '
+  { d=($4-$2)*1e6/q; if ($1 ~ /^vtgate/) g=d; else if ($1 ~ /^vttablet/) t+=d; else if ($1 ~ /^mysqld/) m+=d }
+  END { printf "vtgate=%.0f tablets=%.0f mysqld=%.0f", g, t, m }')
+printf "%-14s %-14s thr=%-3s qps=%-9s avg=%-7s p95=%-7s p99=%-7s %s load=%s\n" "$LABEL" "$SHAPE" "$THREADS" "$qps" "$avg" $pcts "$cpu" "$load"
