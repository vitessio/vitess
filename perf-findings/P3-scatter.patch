+#!/bin/bash
+# suite.sh LABEL [THREADS] [TIME] [FILTER]: run all P3 shapes once, one line each.
+LABEL=$1; THR=${2:-8}; TIME=${3:-20}; FILTER=${4:-.}
+B=/home/vt/perf/P3/bench.sh
+while read -r name shape args; do
+  [[ -z $name || $name == \#* ]] && continue
+  [[ $name =~ $FILTER ]] || continue
+  # shellcheck disable=SC2086
+  $B "$LABEL" "$THR" "$TIME" "$shape" $args | sed "s/^\(\S*\s*\)\S*/\1$name/"
+done <<'EOF'
+krange100       krange      --width=100
+krange_ord100   krange_ord  --width=100
+krange_lim10    krange_lim  --width=100 --limit=10
+krange_lim100   krange_lim  --width=1000 --limit=100
+idrange_ordc100 idrange_ordc --width=100
+count1k         count       --width=1000
+grp_low10k      grp_low     --width=10000
+grp_high10k     grp_high    --width=10000
+grp_c10k        grp_c       --width=10000
+distinct_k10k   distinct_k  --width=10000
+cnt_dist10k     cnt_distinct --width=10000
+ord_agg_lim10k  ord_agg_lim --width=10000
+in10            inlist      --width=10
+in100           inlist      --width=100
+in1000          inlist      --width=1000
+insert100       insert      --width=100
+join_x10        join_x      --width=10
+join_push100    join_push   --width=100
+big10k          big         --width=10000
+big10k_olap     big         --width=10000 --olap=on
+big100k_olap    big         --width=100000 --olap=on
+bigord10k_olap  big_ord     --width=10000 --olap=on
+ro_ranges       sb:oltp_read_only --point-selects=0 --skip_trx=on
+EOF
