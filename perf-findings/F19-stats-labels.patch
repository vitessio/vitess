+
+package stats
+
+import (
+	"strconv"
+	"testing"
+	"time"
+)
+
+var multiLabelBenchKeys = map[int][]string{
+	2: {"Execute", "commerce"},
+	3: {"Execute", "commerce", "PRIMARY"},
+	4: {"Execute", "commerce", "-80", "PRIMARY"},
+}
+
+func multiLabelBenchLabels(n int) []string {
+	labels := make([]string, n)
+	for i := range labels {
+		labels[i] = "l" + strconv.Itoa(i)
+	}
+	return labels
+}
+
+func BenchmarkCountersWithMultiLabelsAdd(b *testing.B) {
+	for _, n := range []int{2, 3, 4} {
+		key := multiLabelBenchKeys[n]
+		labels := multiLabelBenchLabels(n)
+		b.Run(strconv.Itoa(n)+"labels", func(b *testing.B) {
+			c := NewCountersWithMultiLabels("", "help", labels)
+			c.Add(key, 1)
+			b.ReportAllocs()
+			for b.Loop() {
+				c.Add(key, 1)
+			}
+		})
+		b.Run(strconv.Itoa(n)+"labels-parallel", func(b *testing.B) {
+			c := NewCountersWithMultiLabels("", "help", labels)
+			c.Add(key, 1)
+			b.ReportAllocs()
+			b.RunParallel(func(pb *testing.PB) {
+				for pb.Next() {
+					c.Add(key, 1)
+				}
+			})
+		})
+	}
+}
+
+func BenchmarkMultiTimingsAdd(b *testing.B) {
+	for _, n := range []int{2, 3, 4} {
+		key := multiLabelBenchKeys[n]
+		labels := multiLabelBenchLabels(n)
+		b.Run(strconv.Itoa(n)+"labels", func(b *testing.B) {
+			mt := NewMultiTimings("", "help", labels)
+			mt.Add(key, time.Millisecond)
+			b.ReportAllocs()
+			for b.Loop() {
+				mt.Add(key, time.Millisecond)
+			}
+		})
+		b.Run(strconv.Itoa(n)+"labels-parallel", func(b *testing.B) {
+			mt := NewMultiTimings("", "help", labels)
+			mt.Add(key, time.Millisecond)
+			b.ReportAllocs()
+			b.RunParallel(func(pb *testing.PB) {
+				for pb.Next() {
+					mt.Add(key, time.Millisecond)
+				}
+			})
+		})
+	}
+}
