+
+package stats
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestAppendSafeJoinedLabelsMatchesReference(t *testing.T) {
+	reference := func(labels []string, combined []bool) string {
+		parts := make([]string, len(labels))
+		for i, l := range labels {
+			if combined != nil && combined[i] {
+				parts[i] = StatsAllStr
+			} else {
+				parts[i] = strings.ReplaceAll(l, ".", "_")
+			}
+		}
+		return strings.Join(parts, ".")
+	}
+	values := []string{"", ".", "..", "a", "a.", ".a", "a..b", "foo.bar.baz", "PRIMARY", "-80", strings.Repeat("x.", 100)}
+	for _, a := range values {
+		for _, b := range values {
+			for _, c := range values {
+				labels := []string{a, b, c}
+				for _, combined := range [][]bool{nil, {false, false, false}, {true, false, true}, {false, true, false}} {
+					want := reference(labels, combined)
+					assert.Equal(t, want, safeJoinLabels(labels, combined))
+					var buf [labelKeyBufSize]byte
+					assert.Equal(t, want, string(appendSafeJoinedLabels(buf[:0], labels, combined)))
+					// Appending must not clobber existing content of dst.
+					assert.Equal(t, "prefix"+want, string(appendSafeJoinedLabels([]byte("prefix"), labels, combined)))
+				}
+			}
+		}
+	}
+}
+
+func TestMultiLabelUpdatesDoNotAllocate(t *testing.T) {
+	clearStats()
+	key := []string{"Execute", "commerce", "PRIMARY"}
+	c := NewCountersWithMultiLabels("", "help", []string{"a", "b", "c"})
+	g := NewGaugesWithMultiLabels("", "help", []string{"a", "b", "c"})
+	mt := NewMultiTimings("", "help", []string{"a", "b", "c"})
+	c.Add(key, 1)
+	g.Set(key, 1)
+	mt.Add(key, time.Millisecond)
+
+	assert.Zero(t, testing.AllocsPerRun(100, func() { c.Add(key, 1) }))
+	assert.Zero(t, testing.AllocsPerRun(100, func() { c.Reset(key) }))
+	assert.Zero(t, testing.AllocsPerRun(100, func() { g.Set(key, 2) }))
+	assert.Zero(t, testing.AllocsPerRun(100, func() { mt.Add(key, time.Millisecond) }))
+
+	assert.Equal(t, map[string]int64{"Execute.commerce.PRIMARY": 0}, c.Counts())
+	assert.Equal(t, map[string]int64{"Execute.commerce.PRIMARY": 2}, g.Counts())
+	assert.Equal(t, int64(102), mt.Counts()["Execute.commerce.PRIMARY"])
+}
+
+func TestMultiLabelLongKeys(t *testing.T) {
+	clearStats()
+	long := strings.Repeat("k.", labelKeyBufSize)
+	key := []string{long, "commerce", long}
+	safe := strings.ReplaceAll(long, ".", "_")
+	want := safe + ".commerce." + safe
+	c := NewCountersWithMultiLabels("", "help", []string{"a", "b", "c"})
+	mt := NewMultiTimings("", "help", []string{"a", "b", "c"})
+	c.Add(key, 1)
+	c.Add(key, 2)
+	mt.Add(key, time.Millisecond)
+	mt.Record(key, time.Now())
+	assert.Equal(t, map[string]int64{want: 3}, c.Counts())
+	assert.Equal(t, int64(2), mt.Counts()[want])
+}
+
+func TestMultiTimingsTimerHook(t *testing.T) {
+	clearStats()
+	type call struct{ stat, name string }
+	var calls []call
+	RegisterTimerHook(func(stat, name string, _ int64, _ *Timings) {
+		calls = append(calls, call{stat, name})
+	})
+	t.Cleanup(func() { RegisterTimerHook(nil) })
+
+	mt := NewMultiTimings("multiTimingsHook", "help", []string{"a", "b"})
+	mt.Add([]string{"x.y", "z"}, time.Millisecond)
+	mt.Record([]string{"x.y", "z"}, time.Now())
+	assert.Equal(t, []call{{"multiTimingsHook", "x_y.z"}, {"multiTimingsHook", "x_y.z"}}, calls)
+	assert.Equal(t, int64(2), mt.Counts()["x_y.z"])
+}
