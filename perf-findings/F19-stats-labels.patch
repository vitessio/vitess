+
+// addBytes is like Add, but takes the name as a byte slice. Looking up an
+// existing histogram does not allocate; the name is only copied into a
+// string when a new histogram is created or a statsd timer hook needs it.
+// name is not retained.
+func (t *Timings) addBytes(name []byte, elapsed time.Duration) {
+	if t.labelCombined || (defaultStatsdHook.timerHook != nil && t.name != "") {
+		t.Add(string(name), elapsed)
+		return
+	}
+	t.mu.RLock()
+	hist, ok := t.histograms[string(name)]
+	t.mu.RUnlock()
+
+	if !ok {
+		hist = t.createHistogram(string(name))
+	}
+	t.record(hist, elapsed)
+}
+
+// createHistogram returns the histogram for name, creating it under the
+// write lock unless another goroutine already did.
+func (t *Timings) createHistogram(name string) *Histogram {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	hist, ok := t.histograms[name]
+	if !ok {
+		hist = NewGenericHistogram("", "", bucketCutoffs, bucketLabels, "Count", "Time")
+		t.histograms[name] = hist
+	}
+	return hist
+}
 
