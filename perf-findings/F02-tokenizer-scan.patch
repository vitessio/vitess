+package sqlparser
+
+import (
+	"math/rand/v2"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// tokenizerFragments are the building blocks for the random inputs of the
+// tokenizer equivalence tests. They are chosen to exercise the scan loops
+// around their edge cases: string delimiters, doubled delimiters, escape
+// sequences (including \% and \_), backtick identifiers, all comment styles,
+// versioned comments that are and are not satisfied, and nested comments.
+var tokenizerFragments = []string{
+	"'", "\"", "`", "``", "''", "\"\"", "\\", "\\'", "\\\"", "\\\\", "\\%", "\\_", "\\n", "\\0", "\\Z", "\\x",
+	"/*", "*/", "*", "/", "/*!", "/*!50000", "/*!90000", "/*!8", "/*+", "--", "-- ", "#", "//",
+	"\n", "\r", "\t", " ", "  ", ";",
+	"select", "from", "where", "a", "abc", "_x", "$y", "1", "12.5", "0x1F", "x'", "b'", "N'", "n'",
+	"@", "@@", ":", ":a", "?", "=", "<=>", "->>", "(", ")", ",", ".",
+	"\x00", "\x80", "\xff", "é", "\x7f",
+}
+
+func randomTokenizerInput(r *rand.Rand, maxFragments int) string {
+	var sb strings.Builder
+	n := r.IntN(maxFragments)
+	for range n {
+		if r.IntN(8) == 0 {
+			// A run of plain text, so that the bulk scanning paths see
+			// more than a handful of bytes at a time.
+			sb.WriteString(strings.Repeat("abcdefghij", r.IntN(10)))
+			continue
+		}
+		sb.WriteString(tokenizerFragments[r.IntN(len(tokenizerFragments))])
+	}
+	return sb.String()
+}
+
+type scannedToken struct {
+	typ                int
+	val                string
+	pos                int
+	inVersionedComment bool
+}
+
+// scanAllTokens scans the whole input with both the current tokenizer and the
+// byte-at-a-time reference copy in token_ref_test.go.
+func scanAllTokens(t testing.TB, parser *Parser, sql string, skipSpecialComments bool) (got, want []scannedToken) {
+	newTkn := parser.NewStringTokenizer(sql)
+	newTkn.SkipSpecialComments = skipSpecialComments
+	oldTkn := (*oldTokenizer)(parser.NewStringTokenizer(sql))
+	oldTkn.SkipSpecialComments = skipSpecialComments
+
+	// Every Scan call advances Pos by at least one byte unless it returns 0,
+	// so this bound is only reached if the tokenizer stops making progress.
+	limit := 2*len(sql) + 4
+	for i := 0; ; i++ {
+		require.Less(t, i, limit, "tokenizer does not terminate on %q", sql)
+		typ, val := newTkn.Scan()
+		got = append(got, scannedToken{typ, val, newTkn.Pos, newTkn.inVersionedComment})
+		oTyp, oVal := oldTkn.Scan()
+		want = append(want, scannedToken{oTyp, oVal, oldTkn.Pos, oldTkn.inVersionedComment})
+		if typ == 0 || oTyp == 0 {
+			return got, want
+		}
+	}
+}
+
+func requireSameTokens(t testing.TB, parser *Parser, sql string) {
+	for _, skip := range []bool{false, true} {
+		got, want := scanAllTokens(t, parser, sql, skip)
+		require.Equal(t, want, got, "input %q (SkipSpecialComments=%v)", sql, skip)
+	}
+}
+
+// TestTokenizerEquivalence checks that the tokenizer produces the same tokens,
+// values and positions as the byte-at-a-time reference implementation on
+// random SQL-like inputs.
+func TestTokenizerEquivalence(t *testing.T) {
+	parser := NewTestParser()
+	r := rand.New(rand.NewPCG(0x5eed, 0xc0ffee))
+	for range 50000 {
+		requireSameTokens(t, parser, randomTokenizerInput(r, 24))
+	}
+}
+
+// TestTokenizerEquivalenceLongTokens checks the bulk scanning paths on long
+// strings, identifiers and comments, with escape sequences and delimiters at
+// every offset.
+func TestTokenizerEquivalenceLongTokens(t *testing.T) {
+	parser := NewTestParser()
+	body := strings.Repeat("0123456789abcdef", 6)
+	for _, special := range []string{"\\'", "\\\"", "\\\\", "\\%", "\\n", "''", "\"\"", "``", "*", "*/", "/*", "\n", "'", "\"", "`", "\\"} {
+		for i := 0; i <= len(body); i += 3 {
+			s := body[:i] + special + body[i:]
+			for _, sql := range []string{
+				"select '" + s + "' from t",
+				"select '" + s + "\\'" + s + "' from t",
+				"select \"" + s + "\" from t",
+				"select `" + s + "` from t",
+				"select 1 /* " + s + " */ from t",
+				"select 1 /*!90000 " + s + " */ from t",
+				"select 1 -- " + s + "\nfrom t",
+				"select 1 # " + s,
+				"select '" + s,
+				"select \"" + s,
+				"select `" + s,
+				"select /* " + s,
+			} {
+				requireSameTokens(t, parser, sql)
+			}
+		}
+	}
+}
+
+// FuzzTokenizerEquivalence is the fuzzing version of TestTokenizerEquivalence.
+func FuzzTokenizerEquivalence(f *testing.F) {
+	for _, seed := range []string{
+		"select 'abc', \"d\\\"ef\", `g``h` from t -- c\n where a = 'it''s' # x",
+		"select 'a\\%b\\_c\\nd' /* comment */ from t",
+		"select /*!50000 1 */, /*!90000 2 /* nested */ 3 */ 4",
+		"select 'unterminated",
+		"select 'unterminated\\",
+		"select \"abc\\",
+		"select `unterminated",
+		"select 1 /* unterminated",
+		"select /*!90000 unterminated",
+		"select /*!90000 x /* y",
+		"select /*!50000 x",
+		"select ``",
+		"select ````",
+		"select '''",
+		"select \"\"\"\"",
+		"-- ",
+		"--",
+		"#",
+		"/**/",
+		"/*/",
+		"/*!*/",
+		"/*!90000**/ 1",
+		"/*!90000/**/*/ 1",
+		"/*!90000 /* a */*/ 1",
+	} {
+		f.Add(seed)
+	}
+	parser := NewTestParser()
+	f.Fuzz(func(t *testing.T, sql string) {
+		requireSameTokens(t, parser, sql)
+	})
+}
