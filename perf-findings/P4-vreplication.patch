index 0000000..298a57d
--- /dev/null
+++ b/perf-findings/P4-scripts/srcrestart.sh
@@ -0,0 +1,31 @@
+#!/bin/bash
+# Restart the source vttablet under a light write load and measure how long the target streams take to
+# catch up again with the source position as of the moment the source vttablet was serving again.
+# Usage: srcrestart.sh LABEL
+LABEL=$1
+D=/home/vt/perf/P4
+OUT=$D/out/rs-$LABEL
+mkdir -p "$OUT"
+SSOCK=/home/vt/perf/c40000/vt_0000000100/mysql.sock
+T1=/home/vt/perf/c40000/vt_0000000101/mysql.sock
+T2=/home/vt/perf/c40000/vt_0000000102/mysql.sock
+q() { mysql -N -S "$1" -u vt_dba -e "$2" 2>/dev/null; }
+sysbench --db-driver=mysql --mysql-socket=$SSOCK --mysql-user=vt_dba --mysql-db=vt_src --tables=4 --table-size=500000 \
+  --threads=2 --rate=100 --time=150 --rand-type=uniform oltp_write_only run >"$OUT/sysbench" 2>&1 &
+sp=$!
+sleep 3
+t0=$(date +%s.%N)
+if [[ ${MODE:-src} == all ]]; then "$D/c.sh" restart-tablets >/dev/null 2>&1; else "$D/c.sh" restart-tablet 0 >/dev/null 2>&1; fi
+t1=$(date +%s.%N)
+srcgtid=$(q $SSOCK "select @@global.gtid_executed" | tr -d '\n')
+while :; do
+  r1=$(q $T1 "select gtid_subset('$srcgtid', substring(pos, 9)) from _vt.vreplication where workflow='wf'")
+  r2=$(q $T2 "select gtid_subset('$srcgtid', substring(pos, 9)) from _vt.vreplication where workflow='wf'")
+  [[ $r1 == 1 && $r2 == 1 ]] && break
+  [[ $(echo "$(date +%s.%N) - $t0 > 140" | bc) == 1 ]] && { echo "timeout"; break; }
+  sleep 0.2
+done
+t2=$(date +%s.%N)
+kill $sp 2>/dev/null
+wait $sp 2>/dev/null
+echo "$LABEL restart=$(echo "$t1 - $t0" | bc)s caught_up_after_restart=$(echo "$t2 - $t1" | bc)s total=$(echo "$t2 - $t0" | bc)s"
