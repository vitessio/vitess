+#!/bin/bash
+# Alternate MoveTables copy runs over (binary, MoveTables flags) configurations.
+# Usage: abmix.sh ROUNDS PREFIX "label|bin|mt flags" ...
+ROUNDS=$1
+PREFIX=$2
+shift 2
+D=/home/vt/perf/P4
+cur=""
+for r in $(seq 1 "$ROUNDS"); do
+  for cfg in "$@"; do
+    IFS='|' read -r label bin flags <<<"$cfg"
+    if [[ $bin != "$cur" ]]; then
+      BIN=$bin "$D/c.sh" restart-tablets >/dev/null 2>&1
+      sleep 5
+      cur=$bin
+    fi
+    MT_FLAGS="$flags" "$D/mt.sh" "$PREFIX-$label-r$r" 0 >/dev/null
+    grep -v vtgate "$D/out/$PREFIX-$label-r$r/summary" | tr '\n' ' ' | tr -s ' '
+    echo
+    "$D/mtcancel.sh" >/dev/null 2>&1
+    sleep 2
+  done
+done
