index 0000000..f24938a
--- /dev/null
+++ b/perf-findings/P4-scripts/catchup.sh
@@ -0,0 +1,42 @@
+#!/bin/bash
+# Measure the vplayer drain rate: stop the workflow, write N sysbench transactions on the source (directly
+# to its mysqld), restart the workflow and time until both target streams have reached the source GTID position.
+# Usage: catchup.sh LABEL [EVENTS] [SB_TEST]     Env: PROF=seconds to capture pprof of source and target -80.
+LABEL=$1
+EVENTS=${2:-40000}
+SBTEST=${3:-oltp_write_only}
+D=/home/vt/perf/P4
+OUT=$D/out/cu-$LABEL
+mkdir -p "$OUT"
+SSOCK=/home/vt/perf/c40000/vt_0000000100/mysql.sock
+T1=/home/vt/perf/c40000/vt_0000000101/mysql.sock
+T2=/home/vt/perf/c40000/vt_0000000102/mysql.sock
+q() { mysql -N -S "$1" -u vt_dba -e "$2" 2>/dev/null; }
+VC="$D/c.sh vtctldclient"
+
+$VC Workflow --keyspace dst stop --workflow wf >/dev/null
+sleep 1
+"$D/c.sh" cpu >"$OUT/cpug0"
+sysbench --db-driver=mysql --mysql-socket=$SSOCK --mysql-user=vt_dba --mysql-db=vt_src --tables=4 --table-size=500000 \
+  --threads=8 --events="$EVENTS" --time=0 --rand-type=uniform "$SBTEST" run >"$OUT/sysbench" 2>&1
+srcgtid=$(q $SSOCK "select @@global.gtid_executed" | tr -d '\n')
+"$D/c.sh" cpu >"$OUT/cpu0"
+t0=$(date +%s.%N)
+$VC Workflow --keyspace dst start --workflow wf >/dev/null
+if [[ ${PROF:-0} -gt 0 ]]; then
+  curl -s -o "$OUT/src.pprof" "http://localhost:40100/debug/pprof/profile?seconds=$PROF" &
+  curl -s -o "$OUT/dst1.pprof" "http://localhost:40101/debug/pprof/profile?seconds=$PROF" &
+fi
+while :; do
+  r1=$(q $T1 "select gtid_subset('$srcgtid', substring(pos, 9)) from _vt.vreplication where workflow='wf'")
+  r2=$(q $T2 "select gtid_subset('$srcgtid', substring(pos, 9)) from _vt.vreplication where workflow='wf'")
+  [[ $r1 == 1 && $r2 == 1 ]] && break
+  sleep 0.1
+done
+t1=$(date +%s.%N)
+"$D/c.sh" cpu >"$OUT/cpu1"
+wait
+dur=$(echo "$t1 - $t0" | bc)
+echo "$LABEL events=$EVENTS dur=${dur}s trx/s=$(echo "$EVENTS / $dur" | bc) gen: $(grep -o 'transactions:.*' "$OUT/sysbench") load: $(uptime | sed 's/.*average: //')" | tee "$OUT/summary"
+paste -d' ' "$OUT/cpu0" "$OUT/cpu1" | awk -v r="$EVENTS" '{d=$4-$2; printf "  %-14s %7.2f s  %6.1f us/trx\n", $1, d, d*1e6/r}' | tee -a "$OUT/summary"
+echo "  source mysqld CPU to generate: $(paste -d' ' "$OUT/cpug0" "$OUT/cpu0" | awk -v r="$EVENTS" '$1=="mysqld_100"{printf "%.1f us/trx", ($4-$2)*1e6/r}')" | tee -a "$OUT/summary"
