+const (
+	// EventQueueSize is the buffer size of the channels that hand binlog
+	// events from the goroutine reading them to their consumer. Handing each
+	// event over an unbuffered channel costs a goroutine switch per event,
+	// which was a large part of the vstreamer's CPU usage at high event rates.
+	EventQueueSize = 16
+
+	// largeEventSize is the size above which SendEvent waits for the queue to
+	// be empty before queueing an event, so that queued events use at most
+	// about EventQueueSize*largeEventSize bytes plus one large event.
+	largeEventSize = 64 * 1024
+
+	// largeEventWaitInterval is how often SendEvent checks whether the queue is
+	// empty before queueing a large event.
+	largeEventWaitInterval = 100 * time.Microsecond
+)
+
+// SendEvent queues ev on ch, a channel with a buffer of EventQueueSize, unless
+// ctx is done first. Large events are only queued once ch is empty, so that ch
+// holds at most one of them. It returns false if ctx is done.
+func SendEvent(ctx context.Context, ch chan<- mysql.BinlogEvent, ev mysql.BinlogEvent) bool {
+	if len(ev.Bytes()) > largeEventSize {
+		for len(ch) > 0 {
+			select {
+			case <-ctx.Done():
+				return false
+			case <-time.After(largeEventWaitInterval):
+			}
+		}
+	}
+	select {
+	case ch <- ev:
+		return true
+	case <-ctx.Done():
+		return false
+	}
+}
