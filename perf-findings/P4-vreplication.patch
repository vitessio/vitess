@@ -0,0 +1,19 @@
+#!/bin/bash
+# Time a MoveTables SwitchTraffic / ReverseTraffic under a light write load and report the client-visible write gap.
+# Usage: switch.sh LABEL switchtraffic|reversetraffic [extra flags]
+LABEL=$1
+ACTION=$2
+shift 2
+D=/home/vt/perf/P4
+OUT=$D/out/sw-$LABEL
+mkdir -p "$OUT"
+"$D/prober" -dsn "root@tcp(127.0.0.1:40003)/src?timeout=2s&readTimeout=60s&writeTimeout=60s" -threads 4 -interval 10ms \
+  -duration 14s -table-size 500000 -out "$OUT/events" >"$OUT/prober" 2>&1 &
+pp=$!
+sleep 5
+t0=$(date +%s.%N)
+"$D/c.sh" vtctldclient MoveTables --workflow wf --target-keyspace dst "$ACTION" "$@" >"$OUT/switch.log" 2>&1
+rc=$?
+t1=$(date +%s.%N)
+wait $pp
+echo "$LABEL $ACTION rc=$rc cmd=$(echo "$t1 - $t0" | bc)s $(grep -o 'max gap.*=[0-9.]*[mµ]*s' "$OUT/prober") $(grep -o 'err=[0-9]*' "$OUT/prober" | head -1)"
