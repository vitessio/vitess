@@ -0,0 +1,22 @@
+#!/bin/bash
+# Alternate blocks of ReverseTraffic/SwitchTraffic pairs between vttablet binaries.
+# Usage: swab.sh ROUNDS PAIRS "label|bin" ...   (workflow must currently be in the switched state)
+ROUNDS=$1
+PAIRS=$2
+shift 2
+D=/home/vt/perf/P4
+for r in $(seq 1 "$ROUNDS"); do
+  for cfg in "$@"; do
+    label=${cfg%%|*}
+    bin=${cfg#*|}
+    BIN=$bin "$D/c.sh" restart-tablets >/dev/null 2>&1
+    # vreplication streams need a while to find their source tablets after a restart.
+    sleep 60
+    for p in $(seq 1 "$PAIRS"); do
+      "$D/switch.sh" "$label-r$r-$p" reversetraffic
+      sleep 3
+      "$D/switch.sh" "$label-r$r-$p" switchtraffic
+      sleep 3
+    done
+  done
+done
