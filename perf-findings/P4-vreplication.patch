+package binlog
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"vitess.io/vitess/go/mysql"
+)
+
+// TestSendEventQueuesSmallEvents checks that small events are queued without
+// waiting for the consumer, up to EventQueueSize.
+func TestSendEventQueuesSmallEvents(t *testing.T) {
+	ch := make(chan mysql.BinlogEvent, EventQueueSize)
+	for range EventQueueSize {
+		require.True(t, SendEvent(t.Context(), ch, mysql.NewMysql56BinlogEvent(make([]byte, 100))))
+	}
+	assert.Len(t, ch, EventQueueSize)
+
+	// The queue is full: SendEvent returns false once ctx is done.
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	assert.False(t, SendEvent(ctx, ch, mysql.NewMysql56BinlogEvent(make([]byte, 100))))
+}
+
+// TestSendEventQueuesLargeEventsAlone checks that a large event is only
+// queued once the queue is empty, which bounds the memory used by queued events.
+func TestSendEventQueuesLargeEventsAlone(t *testing.T) {
+	ch := make(chan mysql.BinlogEvent, EventQueueSize)
+	small := mysql.NewMysql56BinlogEvent(make([]byte, 100))
+	large := mysql.NewMysql56BinlogEvent(make([]byte, largeEventSize+1))
+	require.True(t, SendEvent(t.Context(), ch, small))
+
+	sent := make(chan bool, 1)
+	go func() {
+		sent <- SendEvent(t.Context(), ch, large)
+	}()
+	assert.Never(t, func() bool { return len(ch) > 1 }, 100*time.Millisecond, 5*time.Millisecond)
+
+	assert.Equal(t, small, <-ch)
+	select {
+	case ok := <-sent:
+		assert.True(t, ok)
+	case <-time.After(30 * time.Second):
+		require.FailNow(t, "large event was not queued once the queue was empty")
+	}
+	assert.Equal(t, large, <-ch)
+
+	// A large event waiting for the queue to drain gives up when ctx is done.
+	require.True(t, SendEvent(t.Context(), ch, small))
+	ctx, cancel := context.WithCancel(t.Context())
+	go func() {
+		sent <- SendEvent(ctx, ch, large)
+	}()
+	cancel()
+	select {
+	case ok := <-sent:
+		assert.False(t, ok)
+	case <-time.After(30 * time.Second):
+		require.FailNow(t, "SendEvent did not return after ctx was canceled")
+	}
+	assert.Len(t, ch, 1)
+}
