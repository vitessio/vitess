+#!/bin/bash
+# Alternate MoveTables copy runs between vttablet binary directories.
+# Usage: abbin.sh ROUNDS PREFIX "label1|/bin/dir1" "label2|/bin/dir2" ...
+# Env: MT_FLAGS (passed to mt.sh), TABLES_ARG (tables list for mt.sh, optional)
+ROUNDS=$1
+PREFIX=$2
+shift 2
+D=/home/vt/perf/P4
+for r in $(seq 1 "$ROUNDS"); do
+  for cfg in "$@"; do
+    label=${cfg%%|*}
+    bin=${cfg#*|}
+    BIN=$bin "$D/c.sh" restart-tablets >/dev/null 2>&1
+    sleep 3
+    "$D/mt.sh" "$PREFIX-$label-r$r" 0 | head -1
+    "$D/mtcancel.sh" >/dev/null 2>&1
+    sleep 2
+  done
+done
