diff --git a/perf-findings/P4-scripts/oddl.sh b/perf-findings/P4-scripts/oddl.sh
new file mode 100755
index 0000000..84368f2
--- /dev/null
+++ b/perf-findings/P4-scripts/oddl.sh
@@ -0,0 +1,34 @@
+#!/bin/bash
+# Run one Online DDL (vitess strategy) on src.sbtest1 under a light write load; report the migration timeline
+# and the client-visible write gap during cut-over.
+# Usage: oddl.sh LABEL [ALTER]
+LABEL=$1
+ALTER=${2:-"alter table sbtest1 engine=innodb"}
+D=/home/vt/perf/P4
+OUT=$D/out/oddl-$LABEL
+mkdir -p "$OUT"
+S=/home/vt/perf/c40000/vt_0000000100/mysql.sock
+q() { mysql -N -S "$S" -u vt_dba -e "$1" 2>/dev/null; }
+"$D/prober2" -table "${PTABLE:-sbtest1}" -dsn "root@tcp(127.0.0.1:40003)/src?timeout=2s&readTimeout=60s&writeTimeout=60s" -threads 4 -interval 10ms \
+  -duration 600s -table-size ${PSIZE:-500000} -out "$OUT/events" >"$OUT/prober" 2>&1 &
+pp=$!
+if [[ ${OTHER:-0} == 1 ]]; then
+  "$D/prober2" -dsn "root@tcp(127.0.0.1:40003)/src?timeout=2s&readTimeout=60s&writeTimeout=60s" -threads 2 -interval 10ms \
+    -duration 600s -table sbtest2 -table-size 500000 >"$OUT/prober2" 2>&1 &
+  pp2=$!
+fi
+sleep 2
+t0=$(date +%s.%N)
+uuid=$("$D/c.sh" vtctldclient ApplySchema --ddl-strategy "vitess" --sql "$ALTER" src 2>&1 | tail -1)
+while :; do
+  st=$(q "select migration_status from _vt.schema_migrations where migration_uuid='$uuid'")
+  [[ $st == complete || $st == failed || $st == cancelled ]] && break
+  sleep 0.2
+done
+t1=$(date +%s.%N)
+sleep 2
+kill -INT $pp
+wait $pp
+[[ -n ${pp2:-} ]] && kill -INT $pp2 && wait $pp2
+q "select concat_ws(' ', 'requested', requested_timestamp, 'started', started_timestamp, 'ready', ready_to_complete_timestamp, 'cutover_attempts', cutover_attempts, 'completed', completed_timestamp, 'rows', rows_copied) from _vt.schema_migrations where migration_uuid='$uuid'" >"$OUT/timeline"
+echo "$LABEL $st total=$(echo "$t1 - $t0" | bc)s $(cat "$OUT/timeline") | $(grep -o 'max gap.*=[0-9.]*[mµ]*s' "$OUT/prober") $(grep -o 'err=[0-9]*' "$OUT/prober" | head -1)"
