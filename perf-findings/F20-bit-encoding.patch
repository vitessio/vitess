+// bitCharsStackSize is the size of the stack buffer used by encodeBytesSQLBits.
+// It fits the b'...' encoding of a value of up to 15 bytes, which covers
+// BIT(64), the widest BIT column that MySQL supports.
+const bitCharsStackSize = 128
+
+// bitChars maps each byte to its 8 binary digits, most significant bit first.
+var bitChars = func() (t [256][8]byte) {
+	for i := range t {
+		for j := range t[i] {
+			t[i][j] = '0' + byte(i>>(7-j))&1
+		}
+	}
+	return t
+}()
+
+// appendBytesSQLBits appends val to dst as a MySQL bit-value literal (b'0101...').
+func appendBytesSQLBits(dst, val []byte) []byte {
+	dst = append(dst, 'b', '\'')
 	for _, ch := range val {
-		fmt.Fprintf(b, "%08b", ch)
+		dst = append(dst, bitChars[ch][:]...)
+	}
+	return append(dst, '\'')
+}
+
+func encodeBytesSQLBits(val []byte, b BinWriter) {
+	// Writing into a stack buffer is only possible when the writer is a
+	// concrete type: passing the buffer to an interface method makes it escape.
+	switch w := b.(type) {
+	case *bytes2.Buffer:
+		var tmp [bitCharsStackSize]byte
+		w.Write(appendBytesSQLBits(tmp[:0], val))
+	case *strings.Builder:
+		var tmp [bitCharsStackSize]byte
+		w.Write(appendBytesSQLBits(tmp[:0], val))
+	case *bytes.Buffer:
+		var tmp [bitCharsStackSize]byte
+		w.Write(appendBytesSQLBits(tmp[:0], val))
+	default:
+		b.Write(appendBytesSQLBits(make([]byte, 0, 3+8*len(val)), val))
 	}
-	fmt.Fprint(b, "'")
