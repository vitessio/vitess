+#!/bin/bash
+# Run a compiled vreplication/onlineddl test binary as the vt user with a MySQL-backed env.
+# Usage: runtest.sh TESTBIN REGEX LOG
+cd /home/vt/perf/V1/vtroot || exit 1
+setpriv --reuid=vt --regid=vt --init-groups env HOME=/home/vt VTROOT=/home/vt/perf/V1/vtroot \
+  VTDATAROOT=/home/vt/perf/V1/vtroot/data VT_MYSQL_ROOT=/usr PATH=/home/vt/bin-V1:/usr/sbin:/usr/bin:/bin \
+  "$1" -test.run "$2" -test.count=1 -test.v -test.timeout=20m >"$3" 2>&1
+echo "exit=$?"
+grep -E "^(--- |FAIL|PASS|ok)" "$3" | grep -v "^--- PASS.*/" | head -60
