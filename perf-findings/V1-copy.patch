+q "select r.id, r.t, if(cast(r.j as char) <=> cast(n.j as char), 'same-text', 'DIFF-TEXT'), if(r.j <=> n.j, 'json-equal', 'JSON-NOT-EQUAL'),
+     cast(r.j as char), cast(n.j as char)
+   from jt_ref r join jt n using (id) where not (cast(r.j as char) <=> cast(n.j as char)) or not (r.j <=> n.j)"
+q "select 'types', r.id, json_type(r.j->'\$.dec'), json_type(n.j->'\$.dec'), json_type(r.j->'\$.dbl'), json_type(n.j->'\$.dbl'), json_type(r.j->'\$.big'), json_type(n.j->'\$.big'), json_type(r.j->'\$.d'), json_type(n.j->'\$.d') from jt_ref r join jt n using (id) where r.id in (1, 8)"
+q "select 'count', count(*) from jt"
