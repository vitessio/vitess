@@ -0,0 +1,37 @@
+#!/bin/bash
+# Run one Online DDL (vitess strategy) on src and time its copy phase precisely (until the stream is Running with
+# an empty copy_state), with CPU per process. Then wait for completion and drop the artifact table.
+# Usage: oddl.sh LABEL [ALTER]
+LABEL=$1
+ALTER=${2:-"alter table sbtest1 engine=innodb"}
+D=/home/vt/perf/V1
+DR=/home/vt/perf/c30000
+OUT=$D/out/oddl-$LABEL
+rm -rf "$OUT"; mkdir -p "$OUT"
+S=$DR/vt_0000000100/mysql.sock
+q() { mysql -N -S "$S" -u vt_dba -e "$1" 2>/dev/null; }
+"$D/c.sh" cpu >"$OUT/cpu0"
+t0=$(date +%s.%N)
+uuid=$("$D/c.sh" vtctldclient ApplySchema --ddl-strategy "vitess ${ODDL_FLAGS:-}" --sql "$ALTER" src 2>&1 | tail -1)
+while :; do
+  st=$(q "select state from _vt.vreplication where workflow='$uuid'")
+  n=$(q "select count(*) from _vt.copy_state")
+  ms=$(q "select migration_status from _vt.schema_migrations where migration_uuid='$uuid'")
+  [[ $st == Running && $n == 0 ]] && break
+  [[ $ms == failed || $ms == complete || $ms == cancelled ]] && break
+  sleep 0.2
+done
+t1=$(date +%s.%N)
+"$D/c.sh" cpu >"$OUT/cpu1"
+uptime >"$OUT/uptime1"
+rows=$(q "select rows_copied from _vt.vreplication where workflow='$uuid'")
+while :; do
+  ms=$(q "select migration_status from _vt.schema_migrations where migration_uuid='$uuid'")
+  [[ $ms == failed || $ms == complete || $ms == cancelled ]] && break
+  sleep 0.5
+done
+t2=$(date +%s.%N)
+dur=$(echo "$t1 - $t0" | bc)
+echo "oddl-$LABEL $ms copy_dur=${dur}s total=$(echo "$t2 - $t0" | bc)s rows=$rows rows/s=$(echo "${rows:-0} / $dur" | bc) load: $(cut -d, -f3- "$OUT/uptime1")" | tee "$OUT/summary"
+paste -d' ' "$OUT/cpu0" "$OUT/cpu1" | grep _100 | awk -v r="${rows:-1}" '{d=$4-$2; printf "  %-14s %7.2f s  %6.2f s/1M rows\n", $1, d, d*1e6/r}' | tee -a "$OUT/summary"
+grep -hE "Copying table|post copy|Copy of .* finished" $DR/logs/vttablet_100.log | tail -3 | cut -c12-23,60-150 | sed 's/^/    /'
