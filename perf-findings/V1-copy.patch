+#!/bin/bash
+# A/B of INSERT forms on target mysqld (run inside the bench lock).
+D=/home/vt/perf/V1
+W_NOKEYS="create table wide_x (id BIGINT NOT NULL, user_id INT NOT NULL, created_at DATETIME(6) NOT NULL, status VARCHAR(16) NOT NULL, title VARCHAR(255) NOT NULL, amount DECIMAL(12,2) NOT NULL, body TEXT, attrs JSON, PRIMARY KEY (id))"
+W_KEYS="create table wide_x (id BIGINT NOT NULL, user_id INT NOT NULL, created_at DATETIME(6) NOT NULL, status VARCHAR(16) NOT NULL, title VARCHAR(255) NOT NULL, amount DECIMAL(12,2) NOT NULL, body TEXT, attrs JSON, PRIMARY KEY (id), KEY idx_user_created (user_id, created_at), KEY idx_status (status), KEY idx_title (title(32)))"
+S_NOKEYS="create table sbtest_x (id INT NOT NULL, k INT NOT NULL DEFAULT 0, c CHAR(120) NOT NULL DEFAULT '', pad CHAR(60) NOT NULL DEFAULT '', PRIMARY KEY (id))"
+S_KEYS="create table sbtest_x (id INT NOT NULL, k INT NOT NULL DEFAULT 0, c CHAR(120) NOT NULL DEFAULT '', pad CHAR(60) NOT NULL DEFAULT '', PRIMARY KEY (id), KEY k_1 (k))"
+for r in ${ROUNDS:-1}; do
+  for v in ${VARIANTS:-w_jsonobj w_text w_jsonobj_nobinlog w_jsonobj_keys s_1000 s_1000_nobinlog s_4000 s_250 s_1000_keys}; do
+    case $v in
+      w_jsonobj) "$D/sqlbench.sh" "$v" $D/sql/w_jsonobj.sql "$W_NOKEYS" 60000 ;;
+      w_text) "$D/sqlbench.sh" "$v" $D/sql/w_text.sql "$W_NOKEYS" 60000 ;;
+      w_jsonobj_nobinlog) "$D/sqlbench.sh" "$v" $D/sql/w_jsonobj.sql "$W_NOKEYS" 60000 "set sql_log_bin=0;" ;;
+      w_jsonobj_keys) "$D/sqlbench.sh" "$v" $D/sql/w_jsonobj.sql "$W_KEYS" 60000 ;;
+      w_text_keys) "$D/sqlbench.sh" "$v" $D/sql/w_text.sql "$W_KEYS" 60000 ;;
+      s_1000) "$D/sqlbench.sh" "$v" $D/sql/s_1000.sql "$S_NOKEYS" 200000 ;;
+      s_1000_nobinlog) "$D/sqlbench.sh" "$v" $D/sql/s_1000.sql "$S_NOKEYS" 200000 "set sql_log_bin=0;" ;;
+      s_1000_minimal) "$D/sqlbench.sh" "$v" $D/sql/s_1000.sql "$S_NOKEYS" 200000 "set binlog_row_image=minimal;" ;;
+      s_4000) "$D/sqlbench.sh" "$v" $D/sql/s_4000.sql "$S_NOKEYS" 200000 ;;
+      s_250) "$D/sqlbench.sh" "$v" $D/sql/s_250.sql "$S_NOKEYS" 200000 ;;
+      s_1000_keys) "$D/sqlbench.sh" "$v" $D/sql/s_1000.sql "$S_KEYS" 200000 ;;
+      s_1000_uc0) "$D/sqlbench.sh" "$v" $D/sql/s_1000.sql "$S_NOKEYS" 200000 "set unique_checks=0;" ;;
+    esac
+  done
+done
