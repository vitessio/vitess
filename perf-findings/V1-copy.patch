+#!/bin/bash
+# Upper bound for concurrent table copy: one MoveTables workflow per table, all started together.
+# Usage: mtmulti.sh LABEL   (env: TABLES_LIST, MT_FLAGS)
+set -uo pipefail
+LABEL=$1
+D=/home/vt/perf/V1
+DR=/home/vt/perf/c30000
+OUT=$D/out/$LABEL
+rm -rf "$OUT"; mkdir -p "$OUT"
+TL=${TABLES_LIST:-sbtest1,sbtest2,wide}
+q() { mysql -N -S "$1" -u vt_dba -e "$2" 2>/dev/null; }
+"$D/c.sh" cpu >"$OUT/cpu0"
+t0=$(date +%s.%N)
+n=0
+for t in ${TL//,/ }; do
+  n=$((n + 1))
+  "$D/c.sh" vtctldclient MoveTables --workflow "wf_$t" --target-keyspace dst create --source-keyspace src --tables "$t" ${MT_FLAGS:-} >"$OUT/create_$t.log" 2>&1 &
+done
+wait
+while :; do
+  done_=1
+  for s in $DR/vt_0000000101/mysql.sock $DR/vt_0000000102/mysql.sock; do
+    c=$(q $s "select count(*) from _vt.copy_state")
+    r=$(q $s "select count(*) from _vt.vreplication where state='Running' and length(pos) > 0")
+    e=$(q $s "select count(*) from _vt.vreplication where state='Error'")
+    [[ $e != 0 ]] && { echo ERROR; q $s "select message from _vt.vreplication"; exit 1; }
+    [[ $c == 0 && $r == "$n" ]] || done_=0
+  done
+  [[ $done_ == 1 ]] && break
+  sleep 0.2
+done
+t1=$(date +%s.%N)
+"$D/c.sh" cpu >"$OUT/cpu1"
+cq="select 0"
+for t in ${TL//,/ }; do cq+="+(select count(*) from vt_dst.$t)"; done
+rows=$(( $(q $DR/vt_0000000101/mysql.sock "$cq") + $(q $DR/vt_0000000102/mysql.sock "$cq") ))
+dur=$(echo "$t1 - $t0" | bc)
+echo "$LABEL rows=$rows dur=${dur}s rows/s=$(echo "$rows / $dur" | bc) load: $(cut -d, -f3- /proc/loadavg | cut -c1-20)" | tee "$OUT/summary"
+paste -d' ' "$OUT/cpu0" "$OUT/cpu1" | awk -v r="$rows" '{d=$4-$2; printf "  %-14s %7.2f s  %6.2f s/1M rows\n", $1, d, d*1e6/r}' | tee -a "$OUT/summary"
