+++ b/perf-findings/V1-scripts/sqlbench.sh
@@ -0,0 +1,18 @@
+#!/bin/bash
+# Replay generated vcopier-like INSERT workloads directly against target mysqld 101 and report CPU/wall per row.
+# Usage: sqlbench.sh LABEL SQLFILE TABLE_DDL ROWS [SESSION_PREFIX]
+LABEL=$1 FILE=$2 DDL=$3 ROWS=$4 PREFIX=${5:-}
+S=/home/vt/perf/c30000/vt_0000000101/mysql.sock
+PID=$(cat /home/vt/perf/c30000/vt_0000000101/mysql.pid)
+q() { mysql -N -S $S -u vt_dba "$@"; }
+q -e "create database if not exists v1x"
+q v1x -e "drop table if exists wide_x, sbtest_x, copy_state_x; create table copy_state_x (id bigint auto_increment primary key, lastpk varbinary(2000)); $DDL"
+cpu() { awk '{print $14 + $15}' /proc/$PID/stat; }
+st() { q -e "show global status where variable_name in ('Innodb_os_log_written', 'Innodb_data_written')" | awk '{printf "%s ", $2}'; q -e "show binary logs" | awk '{s+=$2} END {print s}'; }
+b0=$(st); c0=$(cpu); t0=$(date +%s.%N)
+{ echo "$PREFIX"; cat "$FILE"; } | q v1x
+t1=$(date +%s.%N); c1=$(cpu); b1=$(st)
+tck=$(getconf CLK_TCK)
+read -r r0 d0 bl0 <<<"$b0"; read -r r1 d1 bl1 <<<"$b1"
+echo "$LABEL wall=$(echo "($t1-$t0)*1000000/$ROWS" | bc -l | xargs printf %.2f)us/row mysqld_cpu=$(echo "($c1-$c0)/$tck*1000000/$ROWS" | bc -l | xargs printf %.2f)us/row redo=$(((r1 - r0) / ROWS))B/row binlog=$(((bl1 - bl0) / ROWS))B/row load=$(cut -d, -f3- /proc/loadavg | cut -c1-40)"
+q -e "drop database v1x"
