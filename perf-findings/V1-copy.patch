+set -euo pipefail
+D=/home/vt/perf/V1
+S=/home/vt/perf/c30000/vt_0000000100/mysql.sock
+q() { mysql -S $S -u vt_dba vt_src -e "$1"; }
+"$D/c.sh" load
+q "insert into sbtest1 (k, c, pad) select k, c, pad from sbtest1 order by id"
