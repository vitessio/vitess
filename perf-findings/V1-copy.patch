new file mode 100755
index 0000000000..06ffe3e191
--- /dev/null
+++ b/perf-findings/V1-scripts/mt.sh
@@ -0,0 +1,68 @@
+#!/bin/bash
+# Time one MoveTables copy phase src -> dst (2 shards), with CPU per process, MySQL counters per mysqld, and optional pprof.
+# Usage: mt.sh LABEL [PROFILE_SECONDS]
+# Env: MT_FLAGS extra flags for `MoveTables create`; TABLES_LIST (default sbtest1,sbtest2,wide); VERBOSE=1 prints counters.
+set -uo pipefail
+LABEL=${1:-run}
+PROF=${2:-0}
+D=/home/vt/perf/V1
+DR=/home/vt/perf/c30000
+OUT=$D/out/$LABEL
+rm -rf "$OUT"; mkdir -p "$OUT"
+VC="$D/c.sh vtctldclient"
+TL=${TABLES_LIST:-sbtest1,sbtest2,wide}
+TSOCK1=$DR/vt_0000000101/mysql.sock
+TSOCK2=$DR/vt_0000000102/mysql.sock
+q() { mysql -N -S "$1" -u vt_dba -e "$2" 2>/dev/null; }
+VARS="Handler_write Handler_read_next Handler_read_key Handler_read_rnd_next Handler_update Handler_delete Handler_commit Innodb_rows_inserted Innodb_rows_read Innodb_data_written Innodb_data_writes Innodb_os_log_written Innodb_pages_written Com_insert Com_commit Com_begin Com_select Com_set_option Com_alter_table Com_delete_multi Com_update Questions Bytes_received Bytes_sent Sort_rows Created_tmp_tables Binlog_cache_use"
+inlist=$(printf "'%s'," $VARS); inlist=${inlist%,}
+snap() { # $1 suffix
+  for u in 100 101 102; do
+    q $DR/vt_0000000$u/mysql.sock "show global status where variable_name in ($inlist)" >"$OUT/st_${u}_$1"
+    echo "BINLOG_BYTES $(q $DR/vt_0000000$u/mysql.sock "show binary logs" | awk '{s+=$2} END {print s}')" >>"$OUT/st_${u}_$1"
+  done
+}
+"$D/c.sh" cpu >"$OUT/cpu0"
+snap 0
+uptime >"$OUT/uptime0"
+t0=$(date +%s.%N)
+$VC MoveTables --workflow wf --target-keyspace dst create --source-keyspace src --tables "$TL" ${MT_FLAGS:-} >"$OUT/create.log" 2>&1 || { cat "$OUT/create.log"; exit 1; }
+if [[ $PROF -gt 0 ]]; then
+  sleep 2
+  curl -s -o "$OUT/src.pprof" "http://localhost:30100/debug/pprof/profile?seconds=$PROF" &
+  curl -s -o "$OUT/dst1.pprof" "http://localhost:30101/debug/pprof/profile?seconds=$PROF" &
+fi
+if [[ ${PERF:-0} -gt 0 ]]; then
+  sleep 1
+  /usr/lib/linux-tools-6.8.0-142/perf record -e cpu-clock -F 499 -g -o "$OUT/mysqld101.perf" -p "$(cat $DR/vt_0000000101/mysql.pid)" -- sleep "$PERF" >/dev/null 2>&1 &
+fi
+while :; do
+  n1=$(q $TSOCK1 "select count(*) from _vt.copy_state")
+  n2=$(q $TSOCK2 "select count(*) from _vt.copy_state")
+  s1=$(q $TSOCK1 "select state from _vt.vreplication where workflow='wf'")
+  s2=$(q $TSOCK2 "select state from _vt.vreplication where workflow='wf'")
+  p1=$(q $TSOCK1 "select length(pos) from _vt.vreplication where workflow='wf'")
+  p2=$(q $TSOCK2 "select length(pos) from _vt.vreplication where workflow='wf'")
+  if [[ $n1 == 0 && $n2 == 0 && $s1 == Running && $s2 == Running && ${p1:-0} -gt 0 && ${p2:-0} -gt 0 ]]; then break; fi
+  if [[ $s1 == Error || $s2 == Error ]]; then echo "ERROR"; q $TSOCK1 "select message from _vt.vreplication"; break; fi
+  sleep 0.2
+done
+t1=$(date +%s.%N)
+"$D/c.sh" cpu >"$OUT/cpu1"
+snap 1
+uptime >"$OUT/uptime1"
+curl -s http://localhost:30101/debug/vars >"$OUT/vars101.json"
+curl -s http://localhost:30100/debug/vars >"$OUT/vars100.json"
+wait
+cq="select 0"
+for t in ${TL//,/ }; do cq+="+(select count(*) from vt_dst.$t)"; done
+rows=$(( $(q $TSOCK1 "$cq") + $(q $TSOCK2 "$cq") ))
+dur=$(echo "$t1 - $t0" | bc)
+echo "$LABEL rows=$rows dur=${dur}s rows/s=$(echo "$rows / $dur" | bc) load: $(cut -d, -f3- "$OUT/uptime1")" | tee "$OUT/summary"
+paste -d' ' "$OUT/cpu0" "$OUT/cpu1" | awk -v r="$rows" '{d=$4-$2; printf "  %-14s %7.2f s  %6.2f s/1M rows\n", $1, d, d*1e6/r}' | tee -a "$OUT/summary"
+if [[ ${VERBOSE:-0} == 1 ]]; then
+  for u in 100 101 102; do
+    echo "  mysqld_$u counters per 1M rows copied:" | tee -a "$OUT/summary"
+    join <(sort "$OUT/st_${u}_0") <(sort "$OUT/st_${u}_1") | awk -v r="$rows" '{d=$3-$2; if (d != 0) printf "    %-26s %14.0f\n", $1, d*1e6/r}' | tee -a "$OUT/summary"
+  done
+fi
