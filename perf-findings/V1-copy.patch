+#!/bin/bash
+# One locked MoveTables copy run + cancel + per-table timeline of shard -80.
+# Usage: run1.sh LABEL   (env passed through: TABLES_LIST, MT_FLAGS, VERBOSE, PERF)
+D=/home/vt/perf/V1
+LABEL=$1
+flock -o /home/vt/perf/bench.lock "$D/mt.sh" "$LABEL" "${PROF:-0}" 2>&1 | grep -E "rows=|vttablet_10|mysqld_10|^    "
+"$D/mtcancel.sh"
+grep -hE "Copying table|post copy|Copy of .* finished" /home/vt/perf/c30000/logs/vttablet_101.log | tail -$((3 * $(echo "${TABLES_LIST:-a,b,c}" | tr ',' '\n' | wc -l))) | cut -c12-23,60-150 | sed 's/^/    /'
