+       concat('title ', md5(rand()), ' ', n), round(rand()*10000, 2),
+       concat_ws(' ', md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()),
+                      md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand())),
+       json_object('n', n, 'batch', $b, 'h', md5(rand()), 'tags', json_array(md5(rand()), floor(rand()*1000), true), 'nested', json_object('x', rand(), 'y', 'yy')) from seq"
+done
+q "analyze table sbtest1, sbtest2, wide; select table_name, table_rows, round(data_length/1e6) data_mb, round(index_length/1e6) idx_mb from information_schema.tables where table_schema='vt_src'"
