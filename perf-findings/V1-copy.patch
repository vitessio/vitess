+q "insert into jt values
+ (1, json_object('dec', 1.50, 'dec2', cast(10 as decimal(10,3)), 'dbl', 0.1e0, 'dbl2', 318.0e0, 'big', 18446744073709551615, 'neg', -9223372036854775808), 'numbers'),
+ (2, '{\"s\": \"quote\\\\\" backslash\\\\\\\\ pct\\\\\\\\% us\\\\\\\\_ nl\\\\n tab\\\\t uni é 😀 \\\\u0001\"}', 'escapes'),
+ (3, json_array(1, 'two', null, true, false, json_object(), json_array()), 'array'),
+ (4, 'null', 'json null'),
+ (5, null, 'sql null'),
+ (6, '\"just a string\"', 'scalar string'),
+ (7, '12.25', 'scalar number'),
+ (8, json_object('d', cast('2024-01-02' as date), 'dt', cast('2024-01-02 03:04:05.123456' as datetime(6)), 't', cast('03:04:05' as time)), 'temporal'),
+ (9, json_object('b', cast(x'00ff41' as binary)), 'opaque binary'),
+ (10, json_object('nested', json_object('a', json_array(json_object('b', 1.5e0)))), 'nested'),
+ (11, '{\"k\": \"it''s\"}', 'single quote'),
+ (12, '[1e300, -1.5e-300, 3.141592653589793]', 'extreme doubles')"
+q "create table jt_ref like jt; insert into jt_ref select * from jt"
+uuid=$("$D/c.sh" vtctldclient ApplySchema --ddl-strategy "vitess" --sql "alter table jt engine=innodb" src 2>&1 | tail -1)
+while :; do
+  ms=$(q "select migration_status from _vt.schema_migrations where migration_uuid='$uuid'")
