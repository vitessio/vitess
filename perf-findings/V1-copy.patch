+#!/bin/bash
+# Final Online DDL A/B: base binaries vs patched binaries (+ ODDL deferred secondary keys flag).
+D=/home/vt/perf/V1
+for r in $(seq 1 "${ROUNDS:-3}"); do
+  for arm in base patched; do
+    if [[ $arm == base ]]; then
+      BIN=/home/vt/bin VTTABLET_EXTRA_FLAGS="" "$D/c.sh" restart-tablets >/dev/null 2>&1
+    else
+      BIN=/home/vt/bin-V1 VTTABLET_EXTRA_FLAGS="--vreplication-experimental-flags=23" "$D/c.sh" restart-tablets >/dev/null 2>&1
+    fi
+    sleep 5
+    for t in ${ODDL_TABLES:-sbtest1 wide}; do
+      flock -o /home/vt/perf/bench.lock "$D/oddl.sh" "$arm-$t-r$r" "alter table $t engine=innodb" | grep -v "^    " | tr '\n' ' ' | sed -e 's/  */ /g'
+      echo
+      "$D/cleanup_artifacts.sh" >/dev/null 2>&1
+    done
+  done
+done
