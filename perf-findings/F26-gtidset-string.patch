+// referenceSIDString is the previous implementation of SID.String, kept as a
+// reference for the equivalence tests.
+func referenceSIDString(sid SID) string {
+	dst := []byte("xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx")
+	hex.Encode(dst, sid[:4])
+	hex.Encode(dst[9:], sid[4:6])
+	hex.Encode(dst[14:], sid[6:8])
+	hex.Encode(dst[19:], sid[8:10])
+	hex.Encode(dst[24:], sid[10:16])
+	return string(dst)
+}
+
+// referenceGTIDSetString is the previous implementation of
+// Mysql56GTIDSet.String, kept as a reference for the equivalence tests.
+func referenceGTIDSetString(set Mysql56GTIDSet) string {
+	var buf strings.Builder
+	for i, sid := range set.SIDs() {
+		if i != 0 {
+			buf.WriteByte(',')
+		}
+		buf.WriteString(referenceSIDString(sid))
+
+		for _, interval := range set[sid] {
+			buf.WriteByte(':')
+			buf.WriteString(strconv.FormatInt(interval.start, 10))
+
+			if interval.end != interval.start {
+				buf.WriteByte('-')
+				buf.WriteString(strconv.FormatInt(interval.end, 10))
+			}
+		}
+	}
+	return buf.String()
+}
+
+// referenceEncodePosition is the previous implementation of EncodePosition.
+func referenceEncodePosition(rp Position) string {
+	if rp.GTIDSet == nil {
+		return ""
+	}
+	return fmt.Sprintf("%s/%s", rp.GTIDSet.Flavor(), referenceGTIDSetString(rp.GTIDSet.(Mysql56GTIDSet)))
+}
+
+func randomSID(r *rand.Rand) SID {
+	var sid SID
+	for i := range sid {
+		sid[i] = byte(r.UintN(256))
+	}
+	return sid
+}
+
+func randomInt64(r *rand.Rand) int64 {
+	switch r.IntN(6) {
+	case 0:
+		return int64(r.IntN(10))
+	case 1:
+		return int64(r.IntN(1000))
+	case 2:
+		return r.Int64()
+	case 3:
+		return math.MaxInt64 - int64(r.IntN(3))
+	case 4:
+		// Not produced by the parser, but reachable through SID blocks.
+		return -r.Int64()
+	default:
+		return int64(r.IntN(1 << 40))
+	}
+}
+
+// randomGTIDSet builds a set without enforcing the invariants that the parser
+// enforces, so that String is exercised on any interval values.
+func randomGTIDSet(r *rand.Rand, maxSIDs, maxIntervals int) Mysql56GTIDSet {
+	set := make(Mysql56GTIDSet)
+	for range r.IntN(maxSIDs + 1) {
+		var intervals []interval
+		for range r.IntN(maxIntervals + 1) {
+			start := randomInt64(r)
+			end := start
+			if r.IntN(2) == 0 {
+				end = randomInt64(r)
+			}
+			intervals = append(intervals, interval{start: start, end: end})
+		}
+		set[randomSID(r)] = intervals
+	}
+	return set
+}
+
+func TestSIDStringMatchesReference(t *testing.T) {
+	r := rand.New(rand.NewPCG(1, 2))
+	for range 1000 {
+		sid := randomSID(r)
+		assert.Equal(t, referenceSIDString(sid), sid.String())
+	}
+	assert.Equal(t, "00000000-0000-0000-0000-000000000000", SID{}.String())
+}
+
+func TestMysql56GTIDSetStringMatchesReference(t *testing.T) {
+	r := rand.New(rand.NewPCG(3, 4))
+	for range 5000 {
+		set := randomGTIDSet(r, 20, 5)
+		want := referenceGTIDSetString(set)
+		got := set.String()
+		require.Equal(t, want, got)
+		// textLen is exact for non-negative interval bounds, and an upper bound otherwise.
+		assert.GreaterOrEqual(t, set.textLen(), len(got), "textLen must not underestimate %q", got)
+		assert.Equal(t, referenceEncodePosition(Position{GTIDSet: set}), EncodePosition(Position{GTIDSet: set}))
+	}
+	assert.Equal(t, "", Mysql56GTIDSet{}.String())
+	assert.Equal(t, "", Mysql56GTIDSet(nil).String())
+	assert.Equal(t, "MySQL56/", EncodePosition(Position{GTIDSet: Mysql56GTIDSet{}}))
+}
+
+func TestMysql56GTIDSetStringRoundTrip(t *testing.T) {
+	r := rand.New(rand.NewPCG(5, 6))
+	for range 2000 {
+		// Build a set through the parser so that it satisfies its invariants.
+		var parts []string
+		for range r.IntN(12) {
+			sid := randomSID(r)
+			seq := int64(1)
+			var sb strings.Builder
+			sb.WriteString(sid.String())
+			for range 1 + r.IntN(4) {
+				start := seq + int64(r.IntN(1000))
+				end := start + int64(r.IntN(3))*int64(r.IntN(100000))
+				sb.WriteString(":" + strconv.FormatInt(start, 10))
+				if end != start {
+					sb.WriteString("-" + strconv.FormatInt(end, 10))
+				}
+				seq = end + 2
+			}
+			parts = append(parts, sb.String())
+		}
+		set, err := ParseMysql56GTIDSet(strings.Join(parts, ","))
+		require.NoError(t, err)
+
+		s := set.String()
+		require.Equal(t, referenceGTIDSetString(set), s)
+		require.Equal(t, len(s), set.textLen(), "textLen must be exact for %q", s)
+		reparsed, err := ParseMysql56GTIDSet(s)
+		require.NoError(t, err)
+		require.True(t, set.Equal(reparsed), "round trip of %q", s)
+
+		pos := Position{GTIDSet: set}
+		decoded, err := DecodePosition(EncodePosition(pos))
+		require.NoError(t, err)
+		require.True(t, pos.Equal(decoded))
+	}
+}
+
+func benchmarkGTIDSet(numSIDs, numIntervals int) Mysql56GTIDSet {
+	r := rand.New(rand.NewPCG(uint64(numSIDs), uint64(numIntervals)))
+	set := make(Mysql56GTIDSet)
+	for range numSIDs {
+		var intervals []interval
+		seq := int64(1)
+		for range numIntervals {
+			end := seq + int64(r.IntN(10_000_000))
+			intervals = append(intervals, interval{start: seq, end: end})
+			seq = end + 2 + int64(r.IntN(1000))
+		}
+		set[randomSID(r)] = intervals
+	}
+	return set
+}
+
+var benchmarkGTIDSetShapes = []struct{ sids, intervals int }{
+	{1, 1}, {1, 10}, {5, 1}, {5, 10}, {50, 1}, {50, 3},
+}
+
+var benchmarkSink string
+
+func BenchmarkMysql56GTIDSetString(b *testing.B) {
+	for _, shape := range benchmarkGTIDSetShapes {
+		set := benchmarkGTIDSet(shape.sids, shape.intervals)
+		name := fmt.Sprintf("sids=%d/intervals=%d", shape.sids, shape.intervals)
+		b.Run(name+"/impl=old", func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				benchmarkSink = referenceGTIDSetString(set)
+			}
+		})
+		b.Run(name+"/impl=new", func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				benchmarkSink = set.String()
+			}
+		})
+	}
+}
+
+func BenchmarkEncodePosition(b *testing.B) {
+	for _, shape := range benchmarkGTIDSetShapes {
+		pos := Position{GTIDSet: benchmarkGTIDSet(shape.sids, shape.intervals)}
+		name := fmt.Sprintf("sids=%d/intervals=%d", shape.sids, shape.intervals)
+		b.Run(name+"/impl=old", func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				benchmarkSink = referenceEncodePosition(pos)
+			}
+		})
+		b.Run(name+"/impl=new", func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				benchmarkSink = EncodePosition(pos)
+			}
+		})
+	}
+}
+
+// BenchmarkVStreamerGTIDCycle models the per-transaction position work of the
+// vstreamer (AppendGTID on the GTID event, EncodePosition on the XID event),
+// and the vplayer (DecodePosition of the GTID event, EncodePosition for the
+// _vt.vreplication update).
+func BenchmarkVStreamerGTIDCycle(b *testing.B) {
+	for _, shape := range benchmarkGTIDSetShapes {
+		set := benchmarkGTIDSet(shape.sids, shape.intervals)
+		sids := set.SIDs()
+		last := sids[len(sids)-1]
+		name := fmt.Sprintf("sids=%d/intervals=%d", shape.sids, shape.intervals)
+		b.Run(name+"/part=AppendGTID", func(b *testing.B) {
+			b.ReportAllocs()
+			pos := Position{GTIDSet: set}
+			seq := set[last][len(set[last])-1].end
+			for b.Loop() {
+				seq++
+				pos = AppendGTID(pos, Mysql56GTID{Server: last, Sequence: seq})
+			}
+		})
+		b.Run(name+"/part=DecodePosition", func(b *testing.B) {
+			b.ReportAllocs()
+			s := EncodePosition(Position{GTIDSet: set})
+			for b.Loop() {
+				_, _ = DecodePosition(s)
+			}
+		})
+		for _, impl := range []string{"old", "new"} {
+			encode := EncodePosition
+			appendGTID := AppendGTID
+			if impl == "old" {
+				encode = referenceEncodePosition
+				appendGTID = func(rp Position, gtid GTID) Position {
+					return Position{GTIDSet: referenceAddGTID(rp.GTIDSet.(Mysql56GTIDSet), gtid.(Mysql56GTID))}
+				}
+			}
+			b.Run(name+"/part=streamer/impl="+impl, func(b *testing.B) {
+				b.ReportAllocs()
+				pos := Position{GTIDSet: set}
+				seq := set[last][len(set[last])-1].end
+				for b.Loop() {
+					seq++
+					pos = appendGTID(pos, Mysql56GTID{Server: last, Sequence: seq})
+					benchmarkSink = encode(pos)
+				}
+			})
+		}
+	}
+}
