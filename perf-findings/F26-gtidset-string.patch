+// referenceAddGTID is the previous implementation of Mysql56GTIDSet.AddGTID,
+// which copied the intervals of every SID.
+func referenceAddGTID(set Mysql56GTIDSet, gtid56 Mysql56GTID) Mysql56GTIDSet {
+	if set.ContainsGTID(gtid56) {
+		return set
+	}
+	newSet := make(Mysql56GTIDSet)
+	added := false
+	for sid, intervals := range set {
+		newIntervals := make([]interval, 0, len(intervals))
+		if sid == gtid56.Server {
+			for _, iv := range intervals {
+				if !added {
+					switch {
+					case gtid56.Sequence == iv.start-1:
+						iv.start = gtid56.Sequence
+						added = true
+					case gtid56.Sequence == iv.end+1:
+						iv.end = gtid56.Sequence
+						added = true
+					case gtid56.Sequence < iv.start-1:
+						newIntervals = append(newIntervals, interval{start: gtid56.Sequence, end: gtid56.Sequence})
+						added = true
+					}
+				}
+				count := len(newIntervals)
+				if count != 0 && iv.start == newIntervals[count-1].end+1 {
+					newIntervals[count-1].end = iv.end
+				} else {
+					newIntervals = append(newIntervals, iv)
+				}
+			}
+		} else {
+			newIntervals = append(newIntervals, intervals...)
+		}
+		newSet[sid] = newIntervals
+	}
+	if !added {
+		newSet[gtid56.Server] = append(newSet[gtid56.Server], interval{start: gtid56.Sequence, end: gtid56.Sequence})
+	}
+	return newSet
+}
+
+func TestMysql56GTIDSetAddGTIDMatchesReference(t *testing.T) {
+	r := rand.New(rand.NewPCG(7, 8))
+	sids := []SID{randomSID(r), randomSID(r), randomSID(r)}
+	for range 500 {
+		set := Mysql56GTIDSet(nil)
+		if r.IntN(10) != 0 {
+			set = make(Mysql56GTIDSet)
+		}
+		ref := set
+		for range r.IntN(60) {
+			gtid := Mysql56GTID{Server: sids[r.IntN(len(sids))], Sequence: 1 + int64(r.IntN(40))}
+			before := referenceGTIDSetString(set)
+			set = set.AddGTID(gtid).(Mysql56GTIDSet)
+			ref = referenceAddGTID(ref, gtid)
+			require.True(t, ref.Equal(set), "adding %v to %s: got %s, want %s", gtid, before, set, ref)
+		}
+	}
+}
