+		added := set.AddGTID(gtid).(Mysql56GTIDSet)
+		assert.True(t, added.ContainsGTID(gtid))
+		assert.Equal(t, want, set.String())
+		// Mutating the new set in place must not modify the receiver either.
+		added.AddGTIDInPlace(Mysql56GTID{Server: sid1, Sequence: 20})
+		added.AddGTIDInPlace(Mysql56GTID{Server: sid2, Sequence: 20})
+		added.UnionInPlace(Mysql56GTIDSet{sid1: {{30, 40}}, sid2: {{30, 40}}})
+		assert.Equal(t, want, set.String())
+	}
+}
+
+func BenchmarkMysql56GTIDSetAddGTID(b *testing.B) {
+	for _, shape := range benchmarkGTIDSetShapes {
+		set := benchmarkGTIDSet(shape.sids, shape.intervals)
+		sids := set.SIDs()
+		last := sids[len(sids)-1]
+		name := fmt.Sprintf("sids=%d/intervals=%d", shape.sids, shape.intervals)
+		b.Run(name+"/impl=old", func(b *testing.B) {
+			b.ReportAllocs()
+			pos := set
+			seq := set[last][len(set[last])-1].end
+			for b.Loop() {
+				seq++
+				pos = referenceAddGTID(pos, Mysql56GTID{Server: last, Sequence: seq})
+			}
+		})
+		b.Run(name+"/impl=new", func(b *testing.B) {
+			b.ReportAllocs()
+			pos := set
+			seq := set[last][len(set[last])-1].end
+			for b.Loop() {
+				seq++
+				pos = pos.AddGTID(Mysql56GTID{Server: last, Sequence: seq}).(Mysql56GTIDSet)
+			}
+		})
+	}
+}
