 func getKeyspaceID(values []sqltypes.Value, vindex vindexes.Vindex, vindexColumns []int, fields []*querypb.Field) (key.DestinationKeyspaceID, error) {
+	// Fast path for functional single column vindexes (hash, xxhash, numeric,
+	// binary, unicode_loose_*, ...): for all of them Map is a per-value call
+	// to Hash, so call Hash directly and skip the allocations of the generic
+	// vindexes.Map path. This runs for every before and after image of every
+	// row event, and during a reshard every target shard's stream runs it for
+	// every row of the source shard.
+	// If Hash fails or returns an empty keyspace id, fall back to the generic
+	// path, which returns the same error as before.
+	if len(vindexColumns) == 1 {
+		if hasher, ok := vindex.(vindexes.Hashing); ok {
+			if _, multi := vindex.(vindexes.MultiColumn); !multi {
+				if ksid, err := hasher.Hash(values[vindexColumns[0]]); err == nil && len(ksid) > 0 {
+					return ksid, nil
+				}
+			}
+		}
+	}
+	return getKeyspaceIDSlow(values, vindex, vindexColumns)
+}
