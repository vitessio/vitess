+// TestGetKeyspaceIDHashingFastPath confirms that getKeyspaceID, which calls Hash
+// directly for single column vindexes that implement vindexes.Hashing, returns
+// the same keyspace ids and errors as the generic vindexes.Map path, including
+// for values the vindexes cannot map.
+func TestGetKeyspaceIDHashingFastPath(t *testing.T) {
+	values := []sqltypes.Value{
+		sqltypes.NULL,
+		sqltypes.NewInt64(0),
+		sqltypes.NewInt64(1),
+		sqltypes.NewInt64(-1),
+		sqltypes.NewInt64(9223372036854775807),
+		sqltypes.NewUint64(18446744073709551615),
+		sqltypes.NewInt32(-42),
+		sqltypes.NewFloat64(1.5),
+		sqltypes.NewDecimal("12.00"),
+		sqltypes.NewVarChar(""),
+		sqltypes.NewVarChar("abc"),
+		sqltypes.NewVarChar("ABC  "),
+		sqltypes.NewVarChar("123"),
+		sqltypes.NewVarChar("\xff\xfe"),
+		sqltypes.NewVarBinary("\x00\x01\x02"),
+	}
+	for _, vindexType := range []string{
+		"hash", "xxhash", "numeric", "binary", "binary_md5", "reverse_bits",
+		"unicode_loose_md5", "unicode_loose_xxhash",
+	} {
+		vindex, err := vindexes.CreateVindex(vindexType, vindexType, nil)
+		require.NoError(t, err)
+		_, isHashing := vindex.(vindexes.Hashing)
+		require.True(t, isHashing, "%s must implement vindexes.Hashing to exercise the fast path", vindexType)
+		for _, value := range values {
+			// Put the vindex column in the middle of the row.
+			row := []sqltypes.Value{sqltypes.NewInt64(7), value, sqltypes.NewVarChar("x")}
+			want, wantErr := getKeyspaceIDSlow(row, vindex, []int{1})
+			got, gotErr := getKeyspaceID(row, vindex, []int{1}, nil)
+			if wantErr != nil {
+				assert.EqualError(t, gotErr, wantErr.Error(), "%s(%v)", vindexType, value)
+				continue
+			}
+			require.NoError(t, gotErr, "%s(%v)", vindexType, value)
+			assert.Equal(t, want, got, "%s(%v)", vindexType, value)
+		}
+	}
+}
