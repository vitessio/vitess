new file mode 100644
index 0000000000..a65295bff8
--- /dev/null
+++ b/perf-findings/harness/H1-scripts/schedsum.py
@@ -0,0 +1,23 @@
+#!/usr/bin/env python3
+"""Summarize `perf sched timehist -w` output: per process, switch-ins, run time and wake-up delay per query,
+and the distribution of wake-up (schedule) delays. usage: schedsum.py QUERIES < timehist"""
+import collections, re, sys
+
+q = int(sys.argv[1])
+st = collections.defaultdict(lambda: [0, 0.0, 0.0, []])  # count, run ms, delay ms, delays
+for line in sys.stdin:
+    m = re.match(r"\s*[\d.]+ \[(\d+)\]\s+\S*\s+(.+?)\[(\d+)(?:/(\d+))?\]\s+([\d.]+)\s+([\d.]+)\s+([\d.]+)\s*$", line)
+    if not m:
+        continue
+    comm = m.group(2).strip()
+    if comm.startswith("<idle>"):
+        comm = "idle"
+    wait, delay, run = float(m.group(5)), float(m.group(6)), float(m.group(7))
+    s = st[comm]
+    s[0] += 1; s[1] += run; s[2] += delay; s[3].append(delay)
+print(f"{'process':<14} {'switch-ins/q':>12} {'run µs/q':>9} {'wake delay µs/q':>15} {'avg delay µs':>12} {'p50':>6} {'p90':>6}")
+for comm, (n, run, delay, ds) in sorted(st.items(), key=lambda kv: -kv[1][1]):
+    if n < q / 20:
+        continue
+    ds.sort()
+    print(f"{comm:<14} {n / q:12.2f} {run * 1e3 / q:9.1f} {delay * 1e3 / q:15.1f} {delay * 1e3 / n:12.1f} {ds[len(ds) // 2] * 1e3:6.1f} {ds[len(ds) * 9 // 10] * 1e3:6.1f}")
