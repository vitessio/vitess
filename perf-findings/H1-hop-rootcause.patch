+
+// traceana summarizes goroutine hand-offs in a Go execution trace.
+//
+// usage: traceana [-q queries] [-dump N] [-from µs] file.trace
+package main
+
+import (
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strings"
+
+	"golang.org/x/exp/trace"
+)
+
+func entryName(s trace.Stack) string {
+	var frames []trace.StackFrame
+	for f := range s.Frames() {
+		frames = append(frames, f)
+	}
+	// innermost first; walk from outermost to find a non-runtime entry
+	for i := len(frames) - 1; i >= 0; i-- {
+		fn := frames[i].Func
+		if strings.HasPrefix(fn, "runtime.") && fn != "runtime.main" {
+			continue
+		}
+		return short(fn)
+	}
+	if len(frames) > 0 {
+		return short(frames[len(frames)-1].Func)
+	}
+	return "?"
+}
+
+func blockSite(s trace.Stack) string {
+	var out []string
+	for f := range s.Frames() {
+		fn := f.Func
+		if strings.HasPrefix(fn, "runtime.") || strings.HasPrefix(fn, "internal/poll.") || strings.HasPrefix(fn, "sync.") {
+			continue
+		}
+		out = append(out, short(fn))
+		if len(out) == 2 {
+			break
+		}
+	}
+	return strings.Join(out, "<")
+}
+
+func short(fn string) string {
+	if i := strings.LastIndex(fn, "/"); i >= 0 {
+		fn = fn[i+1:]
+	}
+	if len(fn) > 60 {
+		fn = fn[:60]
+	}
+	return fn
+}
+
+func main() {
+	q := flag.Int("q", 1, "queries in the trace window (for per-query numbers)")
+	dump := flag.Int("dump", 0, "print N events in time order starting at -from")
+	from := flag.Float64("from", 0, "start of the dump, µs from trace start")
+	flag.Parse()
+	f, err := os.Open(flag.Arg(0))
+	if err != nil {
+		panic(err)
+	}
+	r, err := trace.NewReader(f)
+	if err != nil {
+		panic(err)
+	}
+	gname := map[trace.GoID]string{}
+	lastThread := map[trace.GoID]trace.ThreadID{}
+	unblockBy := map[string]int{}
+	unblocked := map[string]int{}
+	blockReasons := map[string]int{}
+	procRan := map[trace.ProcID]bool{}
+	var futile int
+	var procStart, procStop, goStart, goStartOtherThread, unblocks, creates, syscalls, syscallBlocked int
+	threadsSeen := map[trace.ThreadID]bool{}
+	var t0 trace.Time
+	first := true
+	var printed int
+	var lastT trace.Time
+	for {
+		ev, err := r.ReadEvent()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			panic(err)
+		}
+		if first {
+			t0 = ev.Time()
+			first = false
+		}
+		us := float64(ev.Time()-t0) / 1e3
+		g := ev.Goroutine()
+		if ev.Thread() != trace.NoThread {
+			threadsSeen[ev.Thread()] = true
+		}
+		if ev.Kind() != trace.EventStateTransition {
+			continue
+		}
+		st := ev.StateTransition()
+		desc := ""
+		switch st.Resource.Kind {
+		case trace.ResourceProc:
+			from, to := st.Proc()
+			if from == trace.ProcIdle && to == trace.ProcRunning {
+				procStart++
+				procRan[st.Resource.Proc()] = false
+				desc = fmt.Sprintf("ProcStart P%d", st.Resource.Proc())
+			} else if from == trace.ProcRunning && to == trace.ProcIdle {
+				procStop++
+				if ran, ok := procRan[st.Resource.Proc()]; ok && !ran {
+					futile++
+				}
+				desc = fmt.Sprintf("ProcStop P%d", st.Resource.Proc())
+			}
+		case trace.ResourceGoroutine:
+			id := st.Resource.Goroutine()
+			from, to := st.Goroutine()
+			if st.Stack != trace.NoStack {
+				if _, ok := gname[id]; !ok || from == trace.GoNotExist {
+					gname[id] = entryName(st.Stack)
+				}
+			}
+			name := gname[id]
+			if name == "" {
+				name = fmt.Sprintf("g%d", id)
+			}
+			switch {
+			case from == trace.GoNotExist && to == trace.GoRunnable:
+				creates++
+				desc = "create " + name
+			case from == trace.GoRunnable && to == trace.GoRunning:
+				goStart++
+				procRan[ev.Proc()] = true
+				if lt, ok := lastThread[id]; ok && lt != ev.Thread() {
+					goStartOtherThread++
+				}
+				lastThread[id] = ev.Thread()
+				desc = "start " + name
+			case from == trace.GoRunning && to == trace.GoWaiting:
+				site := blockSite(st.Stack)
+				blockReasons[st.Reason+" @ "+site]++
+				desc = "block " + name + " (" + st.Reason + " @ " + site + ")"
+			case from == trace.GoWaiting && to == trace.GoRunnable:
+				unblocks++
+				by := "no-G(netpoll/sched)"
+				if g != trace.NoGoroutine {
+					by = gname[g]
+				}
+				unblockBy[by+" -> "+name]++
+				unblocked[name]++
+				desc = "unblock " + name + " by " + by
+			case from == trace.GoRunning && to == trace.GoRunnable:
+				desc = "preempt/yield " + name + " " + st.Reason
+			case from == trace.GoRunning && to == trace.GoSyscall:
+				syscalls++
+				desc = "syscall " + name + " " + blockSite(st.Stack)
+			case from == trace.GoSyscall && to == trace.GoRunnable:
+				syscallBlocked++
+				desc = "syscall-end-blocked(P lost) " + name
+			case from == trace.GoSyscall && to == trace.GoRunning:
+				desc = "syscall-end " + name
+			case from == trace.GoRunning && to == trace.GoNotExist:
+				desc = "exit " + name
+			}
+		}
+		if *dump > 0 && us >= *from && printed < *dump && desc != "" {
+			fmt.Printf("%10.1fµs +%6.1f M%-5d P%-3d %s\n", us, float64(ev.Time()-lastT)/1e3, ev.Thread(), ev.Proc(), desc)
+			lastT = ev.Time()
+			printed++
+		}
+	}
+	n := float64(*q)
+	fmt.Printf("per query (q=%d): unblocks %.2f, goroutine starts %.2f (on a different thread than last time %.2f), creates %.2f, ProcStart %.2f, ProcStop %.2f, syscalls(traced) %.2f, syscall-end-without-P %.2f, threads seen %d\n",
+		*q, float64(unblocks)/n, float64(goStart)/n, float64(goStartOtherThread)/n, float64(creates)/n, float64(procStart)/n, float64(procStop)/n, float64(syscalls)/n, float64(syscallBlocked)/n, len(threadsSeen))
+	fmt.Printf("futile ProcStart (P started and stopped without running a goroutine): %.2f/q\n", float64(futile)/n)
+	printTop("unblocks by waker -> wakee", unblockBy, n, 20)
+	printTop("block reasons", blockReasons, n, 20)
+}
+
+func printTop(title string, m map[string]int, n float64, k int) {
+	type kv struct {
+		k string
+		v int
+	}
+	var s []kv
+	for a, b := range m {
+		s = append(s, kv{a, b})
+	}
+	sort.Slice(s, func(i, j int) bool { return s[i].v > s[j].v })
+	fmt.Println(title + ":")
+	for i, e := range s {
+		if i >= k {
+			break
+		}
+		fmt.Printf("  %6.3f/q  %s\n", float64(e.v)/n, e.k)
+	}
+}
