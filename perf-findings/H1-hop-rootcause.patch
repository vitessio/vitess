+#!/bin/bash
+# usage: sysc.sh SECONDS THREADS -- runs sysbench (text) in background, perf-trace -s on vtgate, tablet 100, mysqld 100.
+# Prints the number of queries seen by vtgate and tablet 100 during the trace window.
+P=/usr/lib/linux-tools/6.8.0-142-generic/perf
+S=${1:-3}; T=${2:-1}
+cd /home/vt/perf/H1
+GATE=$(./c pids | awk '$1=="vtgate"{print $2}')
+TAB=$(./c pids | awk '$1=="vttablet_100"{print $2}')
+MY=$(./c pids | awk '$1=="mysqld_100"{print $2}')
+gq() { curl -s localhost:30001/debug/vars | python3 -c 'import json,sys; d=json.load(sys.stdin); print(sum(d["QueryExecutions"].values()))'; }
+tq() { curl -s localhost:30100/debug/vars | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["Queries"]["TotalCount"])'; }
+sysbench oltp_point_select --db-driver=mysql --mysql-host=127.0.0.1 --mysql-port=30003 --mysql-user=root --mysql-db=sbtest --tables=4 --table-size=100000 --threads=$T --db-ps-mode=disable --time=$((S+4)) run > tmp/sysc_sb.txt &
+SB=$!
+sleep 1.5
+g0=$(gq); t0=$(tq)
+$P trace -s -p $GATE -o tmp/trace_gate.txt -- sleep $S &
+$P trace -s -p $TAB -o tmp/trace_tab.txt -- sleep $S &
+$P trace -s -p $MY -o tmp/trace_my.txt -- sleep $S &
+wait %2 %3 %4
+g1=$(gq); t1=$(tq)
+echo "gate queries $((g1-g0)) tablet100 queries $((t1-t0))"
+wait $SB
+grep -E 'queries:|avg:' tmp/sysc_sb.txt
