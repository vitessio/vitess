@@ -0,0 +1,22 @@
+#!/bin/bash
+# CPU placement experiments (taskset on running processes; Go >= 1.25 follows the affinity mask for GOMAXPROCS).
+# usage: place.sh THREADS SECONDS PLACEMENT...   placements: default | all0 | all01 | gate0-tab1-my23 | go012-my3 | go01-my23
+cd /home/vt/perf/H1
+T=$1; S=$2; shift 2
+set_aff() { # name-regex cpus
+  ./c pids | awk -v r="$1" '$1 ~ r {print $2}' | while read -r p; do taskset -a -cp "$2" "$p" >/dev/null; done
+}
+for pl in "$@"; do
+  case $pl in
+    default) set_aff . 0-3 ;;
+    all0) set_aff . 0 ;;
+    all01) set_aff . 0-1 ;;
+    gate0-tab1-my23) set_aff vtgate 0; set_aff vttablet 1; set_aff mysqld 2-3 ;;
+    go012-my3) set_aff 'vtgate|vttablet' 0-2; set_aff mysqld 3 ;;
+    go01-my23) set_aff 'vtgate|vttablet' 0-1; set_aff mysqld 2-3 ;;
+    go0-my1) set_aff 'vtgate|vttablet' 0; set_aff mysqld 1 ;;
+  esac
+  sleep 1.5  # let the Go runtimes pick up the new GOMAXPROCS
+  python3 bench.py "place-$pl" "$T" "$S" warm=2 ${PERFARG:-}
+done
+set_aff . 0-3
