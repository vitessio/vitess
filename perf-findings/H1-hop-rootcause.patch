+#!/bin/bash
+# Floor programs under several configs. usage: floorab.sh "THREADS:SECONDS ..." config...
+# configs: def | procs1 | window | unix | window-procs1 | fake (grpcsrv returns a canned result, no mysqld)
+cd /home/vt/perf/H1
+RUNS=$1; shift
+for cfg in "$@"; do
+  bash floor.sh stop >/dev/null 2>&1
+  FE=""; FA=""; GA=""
+  case $cfg in
+    procs1) FE="GOMAXPROCS=1" ;;
+    procs2) FE="GOMAXPROCS=2" ;;
+    window) FA="-window=4194304" ;;
+    unix) FA="-unix"; GA="/home/vt/perf/H1/tmp/grpc.sock" ;;
+    window-procs1) FE="GOMAXPROCS=1"; FA="-window=4194304" ;;
+    window-unix-procs1) FE="GOMAXPROCS=1"; FA="-window=4194304 -unix"; GA="/home/vt/perf/H1/tmp/grpc.sock" ;;
+    fake) FA="-fake" ;;
+    lockthread) FA="-lockthread" ;;
+    fake-window) FA="-fake -window=4194304" ;;
+  esac
+  FLOOR_ENV="$FE" FLOOR_ARGS="$FA" GRPC_ADDR="$GA" bash floor.sh start >/dev/null 2>&1
+  sleep 1
+  for run in $RUNS; do
+    T=${run%%:*}; S=${run##*:}
+    [[ $cfg == fake* ]] || flock -o /home/vt/perf/bench.lock python3 bench.py "fl-proxy-$cfg" $T $S target=hostport port=30510 db=vt_sbtest nocluster=1 extra=proxy:%proxy,mysqld:@mysqld_100 ${PERFARG:-}
+    flock -o /home/vt/perf/bench.lock python3 bench.py "fl-grpcproxy-$cfg" $T $S target=hostport port=30512 db=vt_sbtest nocluster=1 extra=gproxy:%grpcproxy,gsrv:%grpcsrv,mysqld:@mysqld_100 ${PERFARG:-}
+  done
+done
diff --git a/perf-findings/harness/H1-scripts/groups.py b/perf-findings/harness/H1-scripts/groups.py
new file mode 100644
index 0000000000..7d5047c1de
--- /dev/null
+++ b/perf-findings/harness/H1-scripts/groups.py
@@ -0,0 +1,24 @@
+#!/usr/bin/env python3
+"""Group classify.py output into mechanism buckets. usage: groups.py FILE.class ..."""
+import re, sys
+
+groups = {'sched': ['k:futex', 'u:go-sched', 'k:epoll', 'k:nanosleep', 'k:sched_yield'],
+          'sock': ['k:net-write', 'k:net-read', 'k:other-syscall', 'k:poll', 'u:go-net'],
+          'grpc': ['u:grpc', 'u:proto'], 'mem': ['u:malloc', 'u:gc'],
+          'logic': ['u:sqlparser', 'u:vtgate-logic', 'u:vttablet-logic', 'u:vitess-other', 'u:mysql-proto']}
+for f in sys.argv[1:]:
+    cur = None
+    d = {}
+    for line in open(f):
+        m = re.match(r'(\S+): (\d+) µs/q', line)
+        if m:
+            cur = m.group(1)
+            d[cur] = {'total': float(m.group(2))}
+            continue
+        m = re.match(r'\s+(\S+(?:\([^)]*\))?)\s+([\d.]+) µs/q', line)
+        if m and cur:
+            d[cur][m.group(1)] = float(m.group(2))
+    for p, v in d.items():
+        out = {g: sum(v.get(k, 0) for k in ks) for g, ks in groups.items()}
+        out['other'] = v['total'] - sum(out.values())
+        print(f, p, int(v['total']), {k: round(x) for k, x in out.items()})
diff --git a/perf-findings/harness/H1-scripts/kbreak.py b/perf-findings/harness/H1-scripts/kbreak.py
new file mode 100644
index 0000000000..765214dc72
--- /dev/null
+++ b/perf-findings/harness/H1-scripts/kbreak.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""For samples of COMM whose kernel stack contains SYSCALL_SUBSTR, count which 'interesting' kernel
+function (first match from the leaf) the sample is in. usage: kbreak.py QUERIES COMM SYSCALL_SUBSTR < perf-script"""
+import collections, sys
+
+FREQ = 1999.0
+q, comm_want, sc = int(sys.argv[1]), sys.argv[2], sys.argv[3]
+MARKERS = ["try_to_wake_up", "ep_poll_callback", "sock_def_readable", "__wake_up", "tcp_v4_rcv", "__netif_receive_skb",
+           "net_rx_action", "__dev_queue_xmit", "tcp_ack", "tcp_rcv_established", "tcp_write_xmit", "tcp_sendmsg_locked",
+           "__schedule", "schedule", "futex_wait", "futex_wake", "ep_poll", "tcp_recvmsg", "_copy_from_iter",
+           "_copy_to_iter", "__alloc_skb", "kfree_skb", "skb_release", "selinux", "security_", "fdget", "do_syscall_64"]
+cnt = collections.Counter()
+tot = 0
+comm, frames = None, []
+
+
+def flush():
+    global tot
+    if comm != comm_want or not frames:
+        return
+    ks = [f for f, k in frames if k]
+    if not any(sc in f for f in ks):
+        return
+    tot += 1
+    for f in ks:
+        for m in MARKERS:
+            if f.startswith(m):
+                cnt[m] += 1
+                return
+    cnt["(" + ks[0] + ")"] += 1
+
+
+for line in sys.stdin:
+    if not line.strip():
+        flush(); comm, frames = None, []; continue
+    if not line.startswith((" ", "\t")):
+        flush(); comm = line.split()[0]; frames = []; continue
+    p = line.strip().split(None, 1)
+    if len(p) < 2:
+        continue
+    k = p[1].endswith("([kernel.kallsyms])")
+    frames.append((p[1].rsplit(" (", 1)[0], k))
+flush()
+print(f"{comm_want} {sc}: {tot / FREQ * 1e6 / q:.1f} µs/q")
+for m, n in cnt.most_common(20):
+    print(f"   {m:<40} {n / FREQ * 1e6 / q:6.1f} µs/q {100 * n / tot:5.1f}%")
