+-- point select with the exact statement text vttablet sends
+function thread_init()
+  drv = sysbench.sql.driver()
+  con = drv:connect()
+end
+function event()
+  con:query(string.format("select c from sbtest1 where id = %d limit 10001 /* INT64 */", sysbench.rand.uniform(1, 100000)))
+end
+function thread_done()
+  con:disconnect()
+end
