diff --git a/perf-findings/harness/H1-c/pingpong.c b/perf-findings/harness/H1-c/pingpong.c
new file mode 100644
index 0000000000..ec3a27acba
--- /dev/null
+++ b/perf-findings/harness/H1-c/pingpong.c
@@ -0,0 +1,95 @@
+// pingpong: cost of a cross-thread wake-up on this machine.
+// Two processes ping-pong one byte over a pair of pipes (or a socketpair / loopback TCP), N round trips.
+// usage: pingpong pipe|unix|tcp N CPU_A CPU_B [think_us]
+//   CPU_A/CPU_B: -1 = no pinning. think_us: busy-free sleep (nanosleep) before each ping, to model an idle gap.
+// Prints wall time per round trip and CPU (user+sys of both processes) per round trip.
+#define _GNU_SOURCE
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sched.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/resource.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+static void pin(int cpu) {
+  if (cpu < 0) return;
+  cpu_set_t s;
+  CPU_ZERO(&s);
+  CPU_SET(cpu, &s);
+  sched_setaffinity(0, sizeof(s), &s);
+}
+
+static double now(void) {
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return t.tv_sec + t.tv_nsec / 1e9;
+}
+
+int main(int argc, char **argv) {
+  const char *mode = argv[1];
+  long n = atol(argv[2]);
+  int ca = atoi(argv[3]), cb = atoi(argv[4]);
+  long think = argc > 5 ? atol(argv[5]) : 0;
+  int a_rd, a_wr, b_rd, b_wr;
+  if (!strcmp(mode, "pipe")) {
+    int p1[2], p2[2];
+    pipe(p1);
+    pipe(p2);
+    a_wr = p1[1]; b_rd = p1[0]; b_wr = p2[1]; a_rd = p2[0];
+  } else if (!strcmp(mode, "unix")) {
+    int sv[2];
+    socketpair(AF_UNIX, SOCK_STREAM, 0, sv);
+    a_rd = a_wr = sv[0]; b_rd = b_wr = sv[1];
+  } else {
+    int l = socket(AF_INET, SOCK_STREAM, 0), one = 1;
+    struct sockaddr_in addr = {.sin_family = AF_INET, .sin_addr.s_addr = htonl(INADDR_LOOPBACK)};
+    setsockopt(l, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+    bind(l, (struct sockaddr *)&addr, sizeof(addr));
+    socklen_t len = sizeof(addr);
+    getsockname(l, (struct sockaddr *)&addr, &len);
+    listen(l, 1);
+    int c = socket(AF_INET, SOCK_STREAM, 0);
+    connect(c, (struct sockaddr *)&addr, sizeof(addr));
+    int s = accept(l, NULL, NULL);
+    setsockopt(c, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+    setsockopt(s, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+    a_rd = a_wr = c; b_rd = b_wr = s;
+  }
+  char buf[256];
+  pid_t pid = fork();
+  if (pid == 0) {
+    pin(cb);
+    for (long i = 0; i < n; i++) {
+      if (read(b_rd, buf, 1) != 1) exit(1);
+      if (write(b_wr, buf, 1) != 1) exit(1);
+    }
+    exit(0);
+  }
+  pin(ca);
+  struct timespec ts = {0, think * 1000};
+  double wait = 0, t0 = now();
+  for (long i = 0; i < n; i++) {
+    if (think) nanosleep(&ts, NULL);
+    double t1 = now();
+    write(a_wr, buf, 1);
+    read(a_rd, buf, 1);
+    wait += now() - t1;
+  }
+  double el = now() - t0;
+  waitpid(pid, NULL, 0);
+  struct rusage self, child;
+  getrusage(RUSAGE_SELF, &self);
+  getrusage(RUSAGE_CHILDREN, &child);
+  double cpu = self.ru_utime.tv_sec + self.ru_stime.tv_sec + child.ru_utime.tv_sec + child.ru_stime.tv_sec +
+               (self.ru_utime.tv_usec + self.ru_stime.tv_usec + child.ru_utime.tv_usec + child.ru_stime.tv_usec) / 1e6;
+  printf("%s cpus=%d,%d think=%ldus: rtt=%.1fus cpu=%.1fus/rt (elapsed %.2fs)\n", mode, ca, cb, think, wait / n * 1e6,
+         cpu / n * 1e6, el);
+  return 0;
+}
diff --git a/perf-findings/harness/H1-c/spinner.c b/perf-findings/harness/H1-c/spinner.c
new file mode 100644
index 0000000000..ffff73cf00
--- /dev/null
+++ b/perf-findings/harness/H1-c/spinner.c
@@ -0,0 +1,33 @@
+// spinner: keep every vCPU out of HLT with SCHED_IDLE busy loops (they only get CPU nobody else wants).
+// Experiment only: isolates the cost of waking a halted vCPU from the cost of the wake-up itself.
+// usage: spinner SECONDS
+#define _GNU_SOURCE
+#include <pthread.h>
+#include <sched.h>
+#include <stdlib.h>
+#include <time.h>
+#include <unistd.h>
+
+static volatile int stop;
+
+static void *spin(void *arg) {
+  long cpu = (long)arg;
+  cpu_set_t s;
+  CPU_ZERO(&s);
+  CPU_SET(cpu, &s);
+  sched_setaffinity(0, sizeof(s), &s);
+  struct sched_param p = {0};
+  sched_setscheduler(0, SCHED_IDLE, &p);
+  while (!stop) __builtin_ia32_pause();
+  return NULL;
+}
+
+int main(int argc, char **argv) {
+  int n = sysconf(_SC_NPROCESSORS_ONLN);
+  pthread_t t[256];
+  for (long i = 0; i < n; i++) pthread_create(&t[i], NULL, spin, (void *)i);
+  sleep(atoi(argv[1]));
+  stop = 1;
+  for (int i = 0; i < n; i++) pthread_join(t[i], NULL);
+  return 0;
+}
diff --git a/perf-findings/harness/H1-floor/main.go b/perf-findings/harness/H1-floor/main.go
new file mode 100644
index 0000000000..a7920cdaad
--- /dev/null
+++ b/perf-findings/harness/H1-floor/main.go
@@ -0,0 +1,400 @@
+/*
+Copyright 2026 The Vitess Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+// Command h1floor builds the "floor" for the per-hop cost of a Vitess point select on a given machine:
+// minimal programs that do only the network hops, with the same libraries Vitess uses.
+//
+//	-mode proxy      MySQL protocol server (go/mysql) that forwards each COM_QUERY text to mysqld over one
+//	                 go/mysql client connection per client connection. No parsing, planning or gRPC.
+//	-mode grpcsrv    gRPC server implementing queryservice.Execute (the vtgate->vttablet RPC) on a pool of go/mysql
+//	                 client connections to mysqld (a vttablet without any query logic).
+//	-mode grpcproxy  MySQL protocol server that sends each COM_QUERY through one unary queryservice.Execute call to
+//	                 grpcsrv (a vtgate without any query logic).
+//	-mode tcpsrv     TCP echo server: reads a request, writes a -resp byte response.
+//	-mode tcpclient  closed-loop TCP ping-pong client with -conns connections, prints round trips/s and latency.
+//
+// Tuning knobs mirror the ones tested in the report: -unix (unix sockets for gRPC), -window (static HTTP/2 windows,
+// which disables BDP pings), -lockthread (serve each MySQL connection on a locked OS thread).
+package main
+
+import (
+	"context"
+	"flag"
+	"fmt"
+	"io"
+	"log"
+	"net"
+	"os"
+	"os/signal"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+
+	"vitess.io/vitess/go/mysql"
+	"vitess.io/vitess/go/mysql/replication"
+	"vitess.io/vitess/go/sqltypes"
+	querypb "vitess.io/vitess/go/vt/proto/query"
+	queryservicepb "vitess.io/vitess/go/vt/proto/queryservice"
+	_ "vitess.io/vitess/go/vt/servenv" // registers the vtprotobuf gRPC codec, as in vtgate/vttablet
+	"vitess.io/vitess/go/vt/vtenv"
+)
+
+var (
+	mode       = flag.String("mode", "", "proxy|grpcsrv|grpcproxy|tcpsrv|tcpclient")
+	listen     = flag.String("listen", "127.0.0.1:30510", "listen address (host:port, or a path for -unix)")
+	backend    = flag.String("backend", "127.0.0.1:30511", "grpc backend address (grpcproxy) or tcp server (tcpclient)")
+	socket     = flag.String("socket", "", "mysqld unix socket")
+	user       = flag.String("user", "vt_dba", "mysqld user")
+	dbname     = flag.String("db", "vt_sbtest", "mysqld database")
+	unix       = flag.Bool("unix", false, "use a unix socket for gRPC (listen/backend are paths)")
+	window     = flag.Int("window", 0, "if > 0, static HTTP/2 stream and connection windows (disables BDP estimation)")
+	conns      = flag.Int("conns", 1, "tcpclient: concurrent connections")
+	dur        = flag.Duration("dur", 10*time.Second, "tcpclient: duration")
+	reqSize    = flag.Int("req", 52, "tcpclient: request bytes")
+	respSize   = flag.Int("resp", 191, "tcpsrv: response bytes")
+	fake       = flag.Bool("fake", false, "grpcsrv: return a canned point-select result without querying mysqld")
+	lockThread = flag.Bool("lockthread", false, "proxy/grpcproxy: LockOSThread in each connection handler")
+)
+
+func main() {
+	flag.Parse()
+	switch *mode {
+	case "proxy":
+		serveMySQL(&proxyHandler{})
+	case "grpcproxy":
+		serveMySQL(newGRPCProxyHandler())
+	case "grpcsrv":
+		serveGRPC()
+	case "tcpsrv":
+		tcpServer()
+	case "tcpclient":
+		tcpClient()
+	default:
+		log.Fatalf("unknown -mode %q", *mode)
+	}
+}
+
+func connParams() *mysql.ConnParams {
+	return &mysql.ConnParams{UnixSocket: *socket, Uname: *user, DbName: *dbname}
+}
+
+// baseHandler implements the parts of mysql.Handler that the floor programs don't use.
+type baseHandler struct{ env *vtenv.Environment }
+
+func (h *baseHandler) NewConnection(c *mysql.Conn)    {}
+func (h *baseHandler) ConnectionReady(c *mysql.Conn)  {}
+func (h *baseHandler) ConnectionClosed(c *mysql.Conn) {}
+func (h *baseHandler) ComQueryMulti(c *mysql.Conn, sql string, callback func(qr sqltypes.QueryResponse, more bool, firstPacket bool) error) error {
+	return fmt.Errorf("not supported")
+}
+
+func (h *baseHandler) ComPrepare(c *mysql.Conn, query string) ([]*querypb.Field, uint16, error) {
+	return nil, 0, fmt.Errorf("not supported")
+}
+
+func (h *baseHandler) ComStmtExecute(c *mysql.Conn, prepare *mysql.PrepareData, callback func(*sqltypes.Result) error) error {
+	return fmt.Errorf("not supported")
+}
+
+func (h *baseHandler) ComRegisterReplica(c *mysql.Conn, replicaHost string, replicaPort uint16, replicaUser string, replicaPassword string) error {
+	return fmt.Errorf("not supported")
+}
+
+func (h *baseHandler) ComBinlogDump(c *mysql.Conn, logFile string, binlogPos uint32) error {
+	return fmt.Errorf("not supported")
+}
+
+func (h *baseHandler) ComBinlogDumpGTID(c *mysql.Conn, logFile string, logPos uint64, gtidSet replication.GTIDSet, flags uint16) error {
+	return fmt.Errorf("not supported")
+}
+func (h *baseHandler) WarningCount(c *mysql.Conn) uint16 { return 0 }
+func (h *baseHandler) ComResetConnection(c *mysql.Conn)  {}
+func (h *baseHandler) Env() *vtenv.Environment           { return h.env }
+func (h *baseHandler) setEnv(env *vtenv.Environment)     { h.env = env }
+func (h *baseHandler) lockOSThreadOnce(c *mysql.Conn) {
+	if *lockThread && c.ClientData == nil {
+		runtime.LockOSThread()
+		c.ClientData = true
+	}
+}
+
+// proxyHandler forwards each query to mysqld on a per-client-connection go/mysql client connection.
+type proxyHandler struct {
+	baseHandler
+	mu    sync.Mutex
+	conns map[uint32]*mysql.Conn
+}
+
+func (h *proxyHandler) ComQuery(c *mysql.Conn, query string, callback func(*sqltypes.Result) error) error {
+	h.lockOSThreadOnce(c)
+	h.mu.Lock()
+	if h.conns == nil {
+		h.conns = map[uint32]*mysql.Conn{}
+	}
+	bc := h.conns[c.ConnectionID]
+	h.mu.Unlock()
+	if bc == nil {
+		var err error
+		bc, err = mysql.Connect(context.Background(), connParams())
+		if err != nil {
+			return err
+		}
+		h.mu.Lock()
+		h.conns[c.ConnectionID] = bc
+		h.mu.Unlock()
+	}
+	qr, err := bc.ExecuteFetch(query, 10001, true)
+	if err != nil {
+		return err
+	}
+	return callback(qr)
+}
+
+func (h *proxyHandler) ConnectionClosed(c *mysql.Conn) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if bc := h.conns[c.ConnectionID]; bc != nil {
+		bc.Close()
+		delete(h.conns, c.ConnectionID)
+	}
+}
+
+type grpcProxyHandler struct {
+	baseHandler
+	client queryservicepb.QueryClient
+}
+
+func dialOptions() []grpc.DialOption {
+	opts := []grpc.DialOption{grpc.WithTransportCredentials(insecure.NewCredentials())}
+	if *window > 0 {
+		opts = append(opts, grpc.WithInitialWindowSize(int32(*window)), grpc.WithInitialConnWindowSize(int32(*window)))
+	}
+	if *unix {
+		opts = append(opts, grpc.WithContextDialer(func(ctx context.Context, addr string) (net.Conn, error) {
+			var d net.Dialer
+			return d.DialContext(ctx, "unix", addr)
+		}))
+	}
+	return opts
+}
+
+func newGRPCProxyHandler() *grpcProxyHandler {
+	target := *backend
+	if *unix {
+		target = "passthrough:///" + target
+	}
+	cc, err := grpc.NewClient(target, dialOptions()...)
+	if err != nil {
+		log.Fatal(err)
+	}
+	return &grpcProxyHandler{client: queryservicepb.NewQueryClient(cc)}
+}
+
+func (h *grpcProxyHandler) ComQuery(c *mysql.Conn, query string, callback func(*sqltypes.Result) error) error {
+	h.lockOSThreadOnce(c)
+	resp, err := h.client.Execute(context.Background(), &querypb.ExecuteRequest{Query: &querypb.BoundQuery{Sql: query}})
+	if err != nil {
+		return err
+	}
+	return callback(sqltypes.Proto3ToResult(resp.Result))
+}
+
+type envSetter interface {
+	mysql.Handler
+	setEnv(*vtenv.Environment)
+}
+
+func serveMySQL(h envSetter) {
+	env, err := vtenv.New(vtenv.Options{MySQLServerVersion: "8.0.40-Vitess"})
+	if err != nil {
+		log.Fatal(err)
+	}
+	h.setEnv(env)
+	// Same listener settings as vtgate's defaults (flush delay 100ms, no multi-query).
+	l, err := mysql.NewListener("tcp", *listen, mysql.NewAuthServerNone(), h, 0, 0, false, false, 0, 100*time.Millisecond, false)
+	if err != nil {
+		log.Fatal(err)
+	}
+	go l.Accept()
+	waitSignal()
+}
+
+// queryServer is a vttablet without query logic: a LIFO pool of mysqld connections (like smartconnpool, which
+// reuses the most recently returned connection).
+type queryServer struct {
+	queryservicepb.UnimplementedQueryServer
+	mu   sync.Mutex
+	pool []*mysql.Conn
+	fake *querypb.QueryResult
+}
+
+func (s *queryServer) get() *mysql.Conn {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if n := len(s.pool); n > 0 {
+		c := s.pool[n-1]
+		s.pool = s.pool[:n-1]
+		return c
+	}
+	return nil
+}
+
+func (s *queryServer) put(c *mysql.Conn) {
+	s.mu.Lock()
+	s.pool = append(s.pool, c)
+	s.mu.Unlock()
+}
+
+func (s *queryServer) Execute(ctx context.Context, req *querypb.ExecuteRequest) (*querypb.ExecuteResponse, error) {
+	if s.fake != nil {
+		return &querypb.ExecuteResponse{Result: s.fake}, nil
+	}
+	c := s.get()
+	if c == nil {
+		var err error
+		if c, err = mysql.Connect(ctx, connParams()); err != nil {
+			return nil, err
+		}
+	}
+	defer s.put(c)
+	qr, err := c.ExecuteFetch(req.Query.Sql, 10001, true)
+	if err != nil {
+		return nil, err
+	}
+	return &querypb.ExecuteResponse{Result: sqltypes.ResultToProto3(qr)}, nil
+}
+
+func serveGRPC() {
+	s := &queryServer{}
+	if *fake {
+		// canned result of a sysbench point select (one CHAR(120) column, one row)
+		c, err := mysql.Connect(context.Background(), connParams())
+		if err != nil {
+			log.Fatal(err)
+		}
+		qr, err := c.ExecuteFetch("select c from sbtest1 where id=1", 1, true)
+		if err != nil {
+			log.Fatal(err)
+		}
+		s.fake = sqltypes.ResultToProto3(qr)
+		c.Close()
+	}
+	var opts []grpc.ServerOption
+	if *window > 0 {
+		opts = append(opts, grpc.InitialWindowSize(int32(*window)), grpc.InitialConnWindowSize(int32(*window)))
+	}
+	// vttablet uses a stream worker pool; mirror it.
+	opts = append(opts, grpc.NumStreamWorkers(uint32(runtime.GOMAXPROCS(0))))
+	gs := grpc.NewServer(opts...)
+	queryservicepb.RegisterQueryServer(gs, s)
+	network := "tcp"
+	if *unix {
+		network = "unix"
+		os.Remove(*listen)
+	}
+	l, err := net.Listen(network, *listen)
+	if err != nil {
+		log.Fatal(err)
+	}
+	go gs.Serve(l)
+	waitSignal()
+}
+
+func tcpServer() {
+	l, err := net.Listen("tcp", *listen)
+	if err != nil {
+		log.Fatal(err)
+	}
+	go func() {
+		for {
+			c, err := l.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				buf := make([]byte, 4096)
+				resp := make([]byte, *respSize)
+				for {
+					if _, err := c.Read(buf); err != nil {
+						c.Close()
+						return
+					}
+					if _, err := c.Write(resp); err != nil {
+						c.Close()
+						return
+					}
+				}
+			}()
+		}
+	}()
+	waitSignal()
+}
+
+func tcpClient() {
+	var n atomic.Int64
+	var totalNs atomic.Int64
+	deadline := time.Now().Add(*dur)
+	var wg sync.WaitGroup
+	for range *conns {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			c, err := net.Dial("tcp", *backend)
+			if err != nil {
+				log.Fatal(err)
+			}
+			defer c.Close()
+			req := make([]byte, *reqSize)
+			buf := make([]byte, 4096)
+			for time.Now().Before(deadline) {
+				t0 := time.Now()
+				if _, err := c.Write(req); err != nil {
+					log.Fatal(err)
+				}
+				got := 0
+				for got < *respSize {
+					k, err := c.Read(buf)
+					if err != nil {
+						if err == io.EOF {
+							return
+						}
+						log.Fatal(err)
+					}
+					got += k
+				}
+				totalNs.Add(int64(time.Since(t0)))
+				n.Add(1)
+			}
+		}()
+	}
+	wg.Wait()
+	var ru syscall.Rusage
+	_ = syscall.Getrusage(syscall.RUSAGE_SELF, &ru)
+	cpu := time.Duration(ru.Utime.Nano() + ru.Stime.Nano())
+	fmt.Printf("roundtrips=%d rps=%.0f avg=%.1fus client_cpu=%.1fus/rt\n", n.Load(), float64(n.Load())/dur.Seconds(),
+		float64(totalNs.Load())/float64(n.Load())/1e3, float64(cpu.Microseconds())/float64(n.Load()))
+}
+
+func waitSignal() {
+	ch := make(chan os.Signal, 1)
+	signal.Notify(ch, syscall.SIGINT, syscall.SIGTERM)
+	<-ch
+}
diff --git a/perf-findings/harness/H1-go-runtime-experiment.diff b/perf-findings/harness/H1-go-runtime-experiment.diff
