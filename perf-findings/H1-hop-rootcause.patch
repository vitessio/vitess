+#!/bin/bash
+# 1 s Go execution traces of vtgate and tablet 100 during a 1-thread run; prints hop counts per query
+cd /home/vt/perf/H1
+L=$1
+sysbench oltp_point_select --db-driver=mysql --mysql-host=127.0.0.1 --mysql-port=30003 --mysql-user=root --mysql-db=sbtest --tables=4 --table-size=100000 --threads=1 --db-ps-mode=disable --time=5 run > tmp/tp_sb.txt &
+SB=$!
+sleep 2
+g0=$(curl -s localhost:30001/debug/vars | python3 -c 'import json,sys; d=json.load(sys.stdin); print(sum(d["QueryExecutions"].values()))')
+t0=$(curl -s localhost:30100/debug/vars | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["Queries"]["TotalCount"])')
+curl -s -o tmp/gate-$L.trace "http://localhost:30001/debug/pprof/trace?seconds=1" &
+curl -s -o tmp/tab-$L.trace "http://localhost:30100/debug/pprof/trace?seconds=1"
+wait %2
+g1=$(curl -s localhost:30001/debug/vars | python3 -c 'import json,sys; d=json.load(sys.stdin); print(sum(d["QueryExecutions"].values()))')
+t1=$(curl -s localhost:30100/debug/vars | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["Queries"]["TotalCount"])')
+wait $SB
+echo "== $L vtgate (q~$(( (g1-g0) ))) "
+./traceana -q $((g1-g0)) tmp/gate-$L.trace | head -2
+echo "== $L vttablet100 (q~$(( (t1-t0) )))"
+./traceana -q $((t1-t0)) tmp/tab-$L.trace | head -2
