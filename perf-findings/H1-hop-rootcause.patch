+++ b/perf-findings/harness/H1-go-runtime-experiment.diff
@@ -0,0 +1,43 @@
+--- /root/go/pkg/mod/golang.org/toolchain@v0.0.1-go1.27.1.linux-amd64/src/runtime/runtime1.go	2026-09-25 17:05:30.183959154 +0000
