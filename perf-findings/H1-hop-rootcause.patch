diff --git a/perf-findings/harness/H1-scripts/ab.sh b/perf-findings/harness/H1-scripts/ab.sh
new file mode 100644
index 0000000000..50e80c2e31
--- /dev/null
+++ b/perf-findings/harness/H1-scripts/ab.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+# A/B driver. usage: ab.sh ROUNDS "THREADS:SECONDS ..." cfg1 cfg2 ...
+# cfg files (cfg/NAME.cfg) set BIN, GATE_ENV, TABLET_ENV, VTGATE_EXTRA_FLAGS, VTTABLET_EXTRA_FLAGS.
+# The cluster restart happens OUTSIDE the bench lock; each measurement runs under `flock -o`.
+cd /home/vt/perf/H1
+R=$1; RUNS=$2; shift 2
+for r in $(seq 1 "$R"); do
+  for cfg in "$@"; do
+    (
+      unset BIN GATE_ENV TABLET_ENV VTGATE_EXTRA_FLAGS VTTABLET_EXTRA_FLAGS
+      source "cfg/$cfg.cfg"
+      export BIN GATE_ENV TABLET_ENV VTGATE_EXTRA_FLAGS VTTABLET_EXTRA_FLAGS
+      ./c restart >/dev/null 2>&1
+    )
+    sleep 3
+    for run in $RUNS; do
+      flock -o /home/vt/perf/bench.lock python3 bench.py "$cfg" "${run%%:*}" "${run##*:}" warm=3 ${PERFARG:-}
+    done
+  done
+done
diff --git a/perf-findings/harness/H1-scripts/agg.py b/perf-findings/harness/H1-scripts/agg.py
new file mode 100644
index 0000000000..cf63a8b379
--- /dev/null
+++ b/perf-findings/harness/H1-scripts/agg.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""Aggregate bench.py result lines: mean per (label, threads), % vs the first label per thread count.
+usage: agg.py FILE [label ...]  (labels in the given order; default: order of appearance)"""
+import collections, re, sys
+
+rows = collections.defaultdict(list)
+order = []
+for line in open(sys.argv[1]):
+    m = re.search(r"(\S+)\s+thr=(\d+)\s+qps=\s*(\d+) avg=([\d.]+) p99=([\d.]+)", line)
+    if not m:
+        continue
+    lab, thr = m.group(1), int(m.group(2))
+    d = dict(qps=float(m.group(3)), avg=float(m.group(4)), p99=float(m.group(5)))
+    for g in ("vtgate", "tablets", "mysqlds", "vtcombo", "proxy", "gproxy", "gsrv"):
+        mm = re.search(r"\| " + g + r" (\d+)us", line)
+        if mm:
+            d[g] = float(mm.group(1))
+    mm = re.search(r"IPI resched ([\d.]+) callfn ([\d.]+)", line)
+    if mm:
+        d["ipi"] = float(mm.group(1)) + float(mm.group(2))
+    d["load"] = float(re.search(r"load ([\d.]+)", line).group(1))
+    if (lab, thr) not in rows:
+        order.append((lab, thr))
+    rows[(lab, thr)].append(d)
+labels = sys.argv[2:] or list(dict.fromkeys(l for l, _ in order))
+cols = ["vtgate", "tablets", "mysqlds"]
+print("| config | thr | n | QPS | avg ms | p99 ms | vtgate µs/q | tablets µs/q | mysqld µs/q | IPIs/q | load |")
+print("|---|---|---|---|---|---|---|---|---|---|---|")
+for thr in sorted({t for _, t in order}):
+    base = None
+    for lab in labels:
+        rs = rows.get((lab, thr))
+        if not rs:
+            continue
+        mean = lambda k: sum(r.get(k, 0) for r in rs) / len(rs)
+        cell = {}
+        for k in ["qps", "avg", "p99"] + cols:
+            cell[k] = mean(k)
+        if base is None:
+            base = cell
+        def pct(k):
+            return "" if base is cell or not base[k] else f" ({100 * (cell[k] / base[k] - 1):+.0f}%)"
+        def rng(k):
+            vs = [r.get(k, 0) for r in rs]
+            return f" [{min(vs):.0f}–{max(vs):.0f}]" if len(vs) > 1 else ""
+        ipi = f"{mean('ipi'):.1f}" if all("ipi" in r for r in rs) else "–"
+        print(f"| {lab} | {thr} | {len(rs)} | {cell['qps']:.0f}{pct('qps')} | {cell['avg']:.2f}{pct('avg')} | {cell['p99']:.2f}{pct('p99')} | "
+              + " | ".join(f"{cell[k]:.0f}{pct(k)}{rng(k)}" for k in cols) + f" | {ipi} | {mean('load'):.1f} |")
diff --git a/perf-findings/harness/H1-scripts/aggtrace.py b/perf-findings/harness/H1-scripts/aggtrace.py
new file mode 100644
index 0000000000..189696461e
--- /dev/null
+++ b/perf-findings/harness/H1-scripts/aggtrace.py
@@ -0,0 +1,25 @@
+#!/usr/bin/env python3
+# aggregate `perf trace -s` output: per-syscall calls (and per thread role) divided by a query count
+import re, sys
+fn, q = sys.argv[1], int(sys.argv[2])
+tot = {}
+threads = []
+cur = None
+for line in open(fn):
+    m = re.match(r"\s*(\S+) \((\d+)\), (\d+) events", line)
+    if m:
+        cur = {"tid": m.group(2), "calls": {}}
+        threads.append(cur)
+        continue
+    m = re.match(r"\s+(\w+)\s+(\d+)\s+(\d+)\s+([\d.]+)", line)
+    if m and cur is not None:
+        name, calls, errs, ms = m.group(1), int(m.group(2)), int(m.group(3)), float(m.group(4))
+        cur["calls"][name] = calls
+        t = tot.setdefault(name, [0, 0, 0.0])
+        t[0] += calls; t[1] += errs; t[2] += ms
+print(f"{fn}: per query (q={q})")
+for k, v in sorted(tot.items(), key=lambda kv: -kv[1][0]):
+    print(f"  {k:<16} {v[0] / q:6.2f}/q  (errors {v[1] / q:.2f}/q)")
+print(f"  TOTAL            {sum(v[0] for v in tot.values()) / q:6.2f}/q")
+for t in threads:
+    print("  tid", t["tid"], " ".join(f"{k}={v / q:.2f}" for k, v in sorted(t["calls"].items(), key=lambda kv: -kv[1])))
diff --git a/perf-findings/harness/H1-scripts/bench.py b/perf-findings/harness/H1-scripts/bench.py
new file mode 100644
index 0000000000..e33eb7c8c0
--- /dev/null
+++ b/perf-findings/harness/H1-scripts/bench.py
@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""One sysbench oltp_point_select run with per-process accounting.
+
+usage: bench.py LABEL THREADS SECONDS [key=value ...]
+  target=gate|direct|hostport   (gate: vtgate mysql 30003; direct: mysqld 30400 TCP; hostport: host=,port=)
+  mode=text|ps                  (sysbench --db-ps-mode disable|auto)
+  perf=1                        count syscalls / sched_switch / sched_wakeup per process group + IPIs system-wide
+  warm=2                        warm-up seconds (not measured)
+  extra=name:pid,name:pid       additional processes to account (e.g. floor programs)
+  nocluster=1                   do not account the cluster processes
+Prints one result line (also appended to results.txt).
+"""
+import os, re, signal, subprocess, sys, time
+
+H = "/home/vt/perf/H1"
+PERF = "/usr/lib/linux-tools/6.8.0-142-generic/perf"
+TCK = os.sysconf("SC_CLK_TCK")
+
+
+def cluster_pids():
+    out = subprocess.run([H + "/c", "pids"], capture_output=True, text=True).stdout
+    res = []
+    for line in out.split():
+        pass
+    toks = out.split()
+    for i in range(0, len(toks), 2):
+        res.append((toks[i], int(toks[i + 1])))
+    return res
+
+
+def resolve(p):
+    """pid literal, @<cluster pid name> (e.g. @mysqld_100), or %<floor mode> (e.g. %proxy)"""
+    if p.startswith("@"):
+        return dict(cluster_pids())[p[1:]]
+    if p.startswith("%"):
+        out = subprocess.run(["bash", H + "/floor.sh", "pids"], capture_output=True, text=True).stdout
+        return int(dict(l.split() for l in out.splitlines() if len(l.split()) == 2)[p[1:]])
+    return int(p)
+
+
+def group(name):
+    if name.startswith("vttablet"):
+        return "tablets"
+    if name.startswith("mysqld"):
+        return "mysqlds"
+    return name
+
+
+def snap(pid):
+    with open(f"/proc/{pid}/stat") as f:
+        s = f.read()
+    fields = s[s.rindex(")") + 2:].split()
+    ut, st = int(fields[11]), int(fields[12])
+    vcs = ncs = 0
+    for t in os.listdir(f"/proc/{pid}/task"):
+        try:
+            with open(f"/proc/{pid}/task/{t}/status") as f:
+                for line in f:
+                    if line.startswith("voluntary_ctxt_switches"):
+                        vcs += int(line.split()[1])
+                    elif line.startswith("nonvoluntary_ctxt_switches"):
+                        ncs += int(line.split()[1])
+        except FileNotFoundError:
+            pass
+    return dict(ut=ut, st=st, vcs=vcs, ncs=ncs)
+
+
+def main():
+    label, threads, secs = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
+    kv = dict(a.split("=", 1) for a in sys.argv[4:])
+    target = kv.get("target", "gate")
+    mode = kv.get("mode", "text")
+    warm = int(kv.get("warm", "2"))
+    if target == "gate":
+        host, port, user, db = "127.0.0.1", "30003", "root", "sbtest"
+    elif target == "direct":
+        host, port, user, db = "127.0.0.1", "30400", "sb", "vt_sbtest"
+    else:
+        host, port, user, db = kv.get("host", "127.0.0.1"), kv["port"], kv.get("user", "root"), kv.get("db", "sbtest")
+    procs = [] if kv.get("nocluster") else cluster_pids()
+    if kv.get("extra"):
+        for e in kv["extra"].split(","):
+            n, p = e.split(":")
+            procs.append((n, resolve(p)))
+    sb = ["sysbench", kv.get("script", "oltp_point_select"), "--db-driver=mysql", f"--mysql-host={host}", f"--mysql-port={port}",
+          f"--mysql-user={user}", f"--mysql-db={db}", "--tables=4", "--table-size=100000", "--auto_inc=off",
+          f"--threads={threads}", "--db-ps-mode=" + ("disable" if mode == "text" else "auto"), "--percentile=99",
+          "--rand-type=uniform"] + ([f"--rate={kv['rate']}"] if kv.get("rate") else [])
+    if warm:
+        subprocess.run(sb + [f"--time={warm}", "run"], capture_output=True)
+    groups = {}
+    for n, p in procs:
+        groups.setdefault(group(n), []).append(p)
+    perfs = []
+    if kv.get("perf"):
+        ev = "raw_syscalls:sys_enter,sched:sched_switch,sched:sched_wakeup,sched:sched_waking"
+        for g, pl in groups.items():
+            fn = f"{H}/tmp/perf_{g}.csv"
+            perfs.append((g, fn, subprocess.Popen([PERF, "stat", "-x,", "-e", ev, "-p", ",".join(map(str, pl)), "-o", fn],
+                                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)))
+        fn = f"{H}/tmp/perf_sys.csv"
+        perfs.append(("sys", fn, subprocess.Popen([PERF, "stat", "-a", "-x,", "-e",
+                                                   "irq_vectors:reschedule_entry,irq_vectors:call_function_single_entry,ipi:ipi_send_cpu,cpu-clock",
+                                                   "-o", fn], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)))
+        time.sleep(0.3)
+    before = {p: snap(p) for _, p in procs}
+    t0 = time.time()
+    r = subprocess.run(sb + [f"--time={secs}", "run"], capture_output=True, text=True)
+    wall = time.time() - t0
+    after = {p: snap(p) for _, p in procs}
+    for _, _, pp in perfs:
+        pp.send_signal(signal.SIGINT)
+    for _, _, pp in perfs:
+        pp.wait()
+    out = r.stdout
+    m = re.search(r"queries:\s+(\d+)\s+\(([\d.]+) per sec", out)
+    if not m:
+        print(out, r.stderr)
+        sys.exit(1)
+    q, qps = int(m.group(1)), float(m.group(2))
+    avg = float(re.search(r"avg:\s+([\d.]+)", out).group(1))
+    p99 = float(re.search(r"99th percentile:\s+([\d.]+)", out).group(1))
+    load = open("/proc/loadavg").read().split()[0]
+    parts = [f"{label:<22} thr={threads:<2} qps={qps:8.0f} avg={avg:.3f} p99={p99:.3f}"]
+    for g, pl in groups.items():
+        ut = sum(after[p]["ut"] - before[p]["ut"] for p in pl) / TCK
+        st = sum(after[p]["st"] - before[p]["st"] for p in pl) / TCK
+        vcs = sum(after[p]["vcs"] - before[p]["vcs"] for p in pl)
+        ncs = sum(after[p]["ncs"] - before[p]["ncs"] for p in pl)
+        parts.append(f"| {g} {1e6 * (ut + st) / q:.0f}us (u{1e6 * ut / q:.0f}/s{1e6 * st / q:.0f}) cs {vcs / q:.2f}v/{ncs / q:.2f}n")
+    for g, fn, _ in perfs:
+        vals = {}
+        for line in open(fn):
+            f = line.strip().split(",")
+            if len(f) > 3 and f[0] and f[0][0].isdigit():
+                vals[f[2]] = float(f[0])
+        if g == "sys":
+            parts.append("| IPI resched %.2f callfn %.2f send %.2f /q" % (
+                vals.get("irq_vectors:reschedule_entry", 0) / q, vals.get("irq_vectors:call_function_single_entry", 0) / q,
+                vals.get("ipi:ipi_send_cpu", 0) / q))
+        else:
+            parts.append("| %s sysc %.1f sw %.2f wake %.2f" % (
+                g, vals.get("raw_syscalls:sys_enter", 0) / q, vals.get("sched:sched_switch", 0) / q,
+                vals.get("sched:sched_waking", 0) / q))
+    parts.append(f"| load {load}")
+    line = " ".join(parts)
+    print(line)
+    with open(H + "/results.txt", "a") as f:
+        f.write(time.strftime("%H:%M:%S ") + line + "\n")
+
+
+if __name__ == "__main__":
+    main()
