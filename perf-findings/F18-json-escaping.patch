+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package json
+
+import (
+	"math/rand/v2"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"vitess.io/vitess/go/bytes2"
+	"vitess.io/vitess/go/sqltypes"
+
+	querypb "vitess.io/vitess/go/vt/proto/query"
+)
+
+// escapeAlphabet is biased towards bytes that need special handling so that
+// random strings hit every branch, including at every position of an
+// 8-byte word.
+var escapeAlphabet = []string{
+	"a", "b", "z", "0", " ", "~", "/", "u", "\x7f",
+	"\"", "\\", "\x00", "\x01", "\b", "\t", "\n", "\f", "\r", "\x1b", "\x1f", "\x20", "\x21", "\x5b", "\x5d",
+	"é", "€", "😀", "�",
+	"\x80", "\xbf", "\xc0", "\xc1", "\xc2", "\xe2\x82", "\xf0\x9f", "\xf5", "\xff", "\xed\xa0\x80",
+	`é`, `😀`, `\ud83d`, `\uzzzz`, `\u12`, `\n`, `\"`, `\\`, `\/`, `\x`,
+}
+
+func randomEscapeInput(r *rand.Rand, maxParts int) string {
+	var sb strings.Builder
+	n := r.IntN(maxParts + 1)
+	for range n {
+		if r.IntN(3) == 0 {
+			// Long clean runs exercise the 8-byte fast path.
+			sb.WriteString(strings.Repeat("x", r.IntN(20)))
+		}
+		sb.WriteString(escapeAlphabet[r.IntN(len(escapeAlphabet))])
+	}
+	return sb.String()
+}
+
+func escapeEdgeCases() []string {
+	cases := []string{
+		"",
+		"hello world",
+		strings.Repeat("a", 7),
+		strings.Repeat("a", 8),
+		strings.Repeat("a", 9),
+		strings.Repeat("a", 1000),
+		"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f",
+		"\x20\x21\x22\x5c\x7f\x80\xff",
+		"日本語のテキスト",
+		"\xff\xfe\xfd",
+		"abc\xe2\x82",
+		"\xed\xa0\x80\xed\xb0\x80",
+		"\xf4\x90\x80\x80",
+		"<script>&amp;  </script>",
+	}
+	// Put every special byte at every offset of a 16-byte window.
+	for _, sp := range []string{"\"", "\\", "\x00", "\x1f", "\x80", "é", "\xff"} {
+		for off := range 16 {
+			cases = append(cases, strings.Repeat("a", off)+sp+strings.Repeat("b", 16-off))
+		}
+	}
+	return cases
+}
+
+func TestEscapeStringMatchesReference(t *testing.T) {
+	check := func(t *testing.T, s string) {
+		want := escapeStringRef([]byte("prefix"), s)
+		got := escapeString([]byte("prefix"), s)
+		require.Equal(t, string(want), string(got), "input %q", s)
+	}
+	for _, s := range escapeEdgeCases() {
+		check(t, s)
+	}
+	r := rand.New(rand.NewPCG(1, 2))
+	for range 20000 {
+		check(t, randomEscapeInput(r, 30))
+	}
+	// Arbitrary bytes.
+	buf := make([]byte, 64)
+	for range 20000 {
+		b := buf[:r.IntN(len(buf))]
+		for i := range b {
+			b[i] = byte(r.Uint32())
+		}
+		check(t, string(b))
+	}
+}
+
+func TestEscapeStringKnownOutput(t *testing.T) {
+	assert.Equal(t, `"a\"b\\c\n\t\r\b\f\u0000\u001f"`, string(escapeString(nil, "a\"b\\c\n\t\r\b\f\x00\x1f")))
+	assert.Equal(t, "\"x�y�\"", string(escapeString(nil, "x\xffy\xc3")))
+	assert.Equal(t, `"<>&/`+" \x7f"+`"`, string(escapeString(nil, "<>&/ \x7f")))
+}
+
+// writeStringContentRef runs the previous scan, unescape and SQL encoding of
+// a JSON string that starts at data[0] == '"'.
+func writeStringContentRef(data []byte) (string, int, error) {
+	end, hasEscape, err := scanJSONStringRef(data, 1)
+	if err != nil {
+		return "", 0, err
+	}
+	content := data[1:end]
+	buf := &bytes2.Buffer{}
+	if hasEscape {
+		content, err = unescapeJSONRef(nil, content)
+		if err != nil {
+			return "", 0, err
+		}
+	}
+	sqltypes.MakeTrusted(querypb.Type_VARCHAR, content).EncodeSQLBytes2(buf)
+	return buf.String(), end + 1, nil
+}
+
+func TestWriteStringContentMatchesReference(t *testing.T) {
+	check := func(t *testing.T, body string) {
+		for _, tail := range []string{`"`, `", 1`, ``, `\`} {
+			data := []byte(`"` + body + tail)
+			want, wantPos, wantErr := writeStringContentRef(data)
+
+			w := sqlWriter{data: data, buf: &bytes2.Buffer{}}
+			gotErr := w.writeStringContent()
+			if wantErr != nil {
+				require.Error(t, gotErr, "input %q", data)
+				assert.Equal(t, wantErr.Error(), gotErr.Error(), "input %q", data)
+				continue
+			}
+			require.NoError(t, gotErr, "input %q", data)
+			assert.Equal(t, want, w.buf.String(), "input %q", data)
+			assert.Equal(t, wantPos, w.pos, "input %q", data)
+		}
+	}
+	for _, s := range escapeEdgeCases() {
+		check(t, s)
+	}
+	r := rand.New(rand.NewPCG(3, 4))
+	for range 20000 {
+		check(t, randomEscapeInput(r, 30))
+	}
+}
+
+func TestUnescapeJSONMatchesReference(t *testing.T) {
+	check := func(t *testing.T, s string) {
+		want, wantErr := unescapeJSONRef([]byte("p"), []byte(s))
+		got, gotErr := unescapeJSON([]byte("p"), []byte(s))
+		if wantErr != nil {
+			require.Error(t, gotErr, "input %q", s)
+			assert.Equal(t, wantErr.Error(), gotErr.Error(), "input %q", s)
+			return
+		}
+		require.NoError(t, gotErr, "input %q", s)
+		assert.Equal(t, string(want), string(got), "input %q", s)
+	}
+	for _, s := range escapeEdgeCases() {
+		check(t, s)
+	}
+	r := rand.New(rand.NewPCG(5, 6))
+	for range 20000 {
+		check(t, randomEscapeInput(r, 30))
+	}
+}
+
+func FuzzEscapeString(f *testing.F) {
+	for _, s := range escapeEdgeCases() {
+		f.Add(s)
+	}
+	f.Fuzz(func(t *testing.T, s string) {
+		require.Equal(t, string(escapeStringRef(nil, s)), string(escapeString(nil, s)))
+
+		want, wantErr := unescapeJSONRef(nil, []byte(s))
+		got, gotErr := unescapeJSON(nil, []byte(s))
+		require.Equal(t, wantErr == nil, gotErr == nil)
+		if wantErr == nil {
+			require.Equal(t, want, got)
+		}
+
+		data := []byte(`"` + s)
+		wantSQL, wantPos, wantErr := writeStringContentRef(data)
+		w := sqlWriter{data: data, buf: &bytes2.Buffer{}}
+		gotErr = w.writeStringContent()
+		require.Equal(t, wantErr == nil, gotErr == nil)
+		if wantErr == nil {
+			require.Equal(t, wantSQL, w.buf.String())
+			require.Equal(t, wantPos, w.pos)
+		}
+	})
+}
