+
+package json
+
+import (
+	"strings"
+	"testing"
+)
+
+var escapeBenchInputs = []struct {
+	name string
+	s    string
+}{
+	{"short10", "John Smith"},
+	{"medium200", benchLorem[:200]},
+	{"long10K", strings.Repeat(benchLorem[:200], 50)},
+	{"medium200_escapes", strings.ReplaceAll(strings.ReplaceAll(benchLorem[:200], ". ", ".\n"), ",", "\",")},
+	{"long10K_escapes", strings.Repeat(strings.ReplaceAll(benchLorem[:200], ". ", ".\n"), 50)},
+	{"medium_cjk", strings.Repeat("日本語のテキスト、", 8)},
+	{"medium_invalid_utf8", "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et" + "\xff" + "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et"},
+}
+
+func BenchmarkEscapeString(b *testing.B) {
+	for _, in := range escapeBenchInputs {
+		b.Run(in.name+"/ref", func(b *testing.B) {
+			dst := make([]byte, 0, 4*len(in.s)+2)
+			b.SetBytes(int64(len(in.s)))
+			for b.Loop() {
+				dst = escapeStringRef(dst[:0], in.s)
+			}
+		})
+		b.Run(in.name+"/new", func(b *testing.B) {
+			dst := make([]byte, 0, 4*len(in.s)+2)
+			b.SetBytes(int64(len(in.s)))
+			for b.Loop() {
+				dst = escapeString(dst[:0], in.s)
+			}
+		})
+	}
+}
+
+func BenchmarkUnescapeJSON(b *testing.B) {
+	for _, in := range escapeBenchInputs {
+		esc := escapeString(nil, in.s)
+		esc = esc[1 : len(esc)-1]
+		b.Run(in.name+"/ref", func(b *testing.B) {
+			dst := make([]byte, 0, len(esc))
+			b.SetBytes(int64(len(esc)))
+			for b.Loop() {
+				dst, _ = unescapeJSONRef(dst[:0], esc)
+			}
+		})
+		b.Run(in.name+"/new", func(b *testing.B) {
+			dst := make([]byte, 0, len(esc))
+			b.SetBytes(int64(len(esc)))
+			for b.Loop() {
+				dst, _ = unescapeJSON(dst[:0], esc)
+			}
+		})
+	}
+}
+
+func BenchmarkScanJSONString(b *testing.B) {
+	for _, in := range escapeBenchInputs {
+		esc := escapeString(nil, in.s)
+		b.Run(in.name+"/ref", func(b *testing.B) {
+			b.SetBytes(int64(len(esc)))
+			for b.Loop() {
+				_, _, _ = scanJSONStringRef(esc, 1)
+			}
+		})
+		b.Run(in.name+"/new", func(b *testing.B) {
+			b.SetBytes(int64(len(esc)))
+			s := string(esc)
+			for b.Loop() {
+				pos := 1
+				for {
+					pos = nextQuoteOrBackslash(s, pos)
+					if s[pos] == '"' {
+						break
+					}
+					pos += 2
+				}
+			}
+		})
+	}
+}
