+
+// keywordKey packs the length and the first two and last two bytes of s into 40 bits.
+// It ORs every byte with 0x20, which maps an ASCII upper case letter to its lower case
+// form; the other bytes that this maps onto each other are told apart by the exact
+// comparison that follows every key match. len(s) must be between 2 and 255.
+func keywordKey(s string) uint64 {
+	n := len(s)
+	return uint64(n) |
+		uint64(s[0]|0x20)<<8 |
+		uint64(s[1]|0x20)<<16 |
+		uint64(s[n-2]|0x20)<<24 |
+		uint64(s[n-1]|0x20)<<32
+}
