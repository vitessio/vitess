+package throttle
+
+import (
+	"math"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"vitess.io/vitess/go/vt/vttablet/tabletserver/throttle/base"
+	"vitess.io/vitess/go/vt/vttablet/tabletserver/throttle/throttlerapp"
+)
+
+// checkOKAsync runs ThrottleCheckOK in a goroutine and returns a channel that receives its result.
+func checkOKAsync(t *testing.T, client *Client, appName throttlerapp.Name) <-chan bool {
+	done := make(chan bool, 1)
+	go func() {
+		_, ok := client.ThrottleCheckOK(t.Context(), appName)
+		done <- ok
+	}()
+	return done
+}
+
+// TestThrottleCheckOKFreshResultDoesNotLock verifies that a still-fresh successful check is served
+// without taking the client's mutex, which is held while the throttler is actually checked. Callers
+// that check the throttler per row or per event (rowstreamer, vstreamer, vplayer) share one client,
+// so they must not serialize on that mutex.
+func TestThrottleCheckOKFreshResultDoesNotLock(t *testing.T) {
+	// A throttler that is not running always responds OK.
+	client := NewBackgroundClient(&Throttler{}, throttlerapp.RowStreamerName, base.UndefinedScope)
+	_, ok := client.ThrottleCheckOK(t.Context(), "")
+	require.True(t, ok)
+	// Make the cached success fresh for good, so that the background ticker cannot make it stale.
+	client.lastSuccessfulTick(throttlerapp.RowStreamerName.String()).Store(math.MaxInt64)
+
+	client.lastSuccessfulThrottleMu.Lock()
+	t.Cleanup(client.lastSuccessfulThrottleMu.Unlock)
+
+	done := checkOKAsync(t, client, "")
+	select {
+	case ok := <-done:
+		assert.True(t, ok)
+	case <-time.After(30 * time.Second):
+		require.Fail(t, "ThrottleCheckOK blocked on the client mutex despite a fresh successful check")
+	}
+}
+
+// TestThrottleCheckOKStaleResultChecksThrottler verifies that the lock-free fast path is only taken
+// for the same app and the same tick: another app, or the same app after the tick has advanced,
+// must go through an actual (mutex-serialized) throttler check.
+func TestThrottleCheckOKStaleResultChecksThrottler(t *testing.T) {
+	client := NewBackgroundClient(&Throttler{}, throttlerapp.RowStreamerName, base.UndefinedScope)
+	_, ok := client.ThrottleCheckOK(t.Context(), "")
+	require.True(t, ok)
+
+	assertBlockedUntilUnlocked := func(appName throttlerapp.Name) {
+		client.lastSuccessfulThrottleMu.Lock()
+		done := checkOKAsync(t, client, appName)
+		select {
+		case <-done:
+			client.lastSuccessfulThrottleMu.Unlock()
+			require.Fail(t, "ThrottleCheckOK did not check the throttler", "app: %v", appName)
+		case <-time.After(50 * time.Millisecond):
+		}
+		client.lastSuccessfulThrottleMu.Unlock()
+		select {
+		case ok := <-done:
+			assert.True(t, ok)
+		case <-time.After(30 * time.Second):
+			require.Fail(t, "ThrottleCheckOK did not return", "app: %v", appName)
+		}
+	}
+
+	// A different app has no cached success.
+	assertBlockedUntilUnlocked(throttlerapp.VPlayerName)
+	// The success of the default app goes stale once the tick advances.
+	atomic.AddInt64(&throttleTicks, 1)
+	assertBlockedUntilUnlocked("")
+	// Clearing the cache makes the next check fresh.
+	client.lastSuccessfulTick(throttlerapp.RowStreamerName.String()).Store(math.MaxInt64)
+	client.clearSuccessfulResultsCache()
+	assertBlockedUntilUnlocked("")
+}
+
+func BenchmarkThrottleCheckOK(b *testing.B) {
+	client := NewBackgroundClient(&Throttler{}, throttlerapp.VStreamerName, base.UndefinedScope)
+	ctx := b.Context()
+	// Keep the cached successes fresh so that we measure the fast path.
+	for _, appName := range []throttlerapp.Name{throttlerapp.RowStreamerName, "vplayer:some-workflow-name:0123456789abcdef"} {
+		_, ok := client.ThrottleCheckOK(ctx, appName)
+		require.True(b, ok)
+		client.lastSuccessfulTick(appName.String()).Store(math.MaxInt64)
+	}
+
+	b.Run("serial", func(b *testing.B) {
+		for b.Loop() {
+			if _, ok := client.ThrottleCheckOK(ctx, throttlerapp.RowStreamerName); !ok {
+				b.Fatal("throttled")
+			}
+		}
+	})
+	b.Run("serial-long-name", func(b *testing.B) {
+		for b.Loop() {
+			if _, ok := client.ThrottleCheckOK(ctx, "vplayer:some-workflow-name:0123456789abcdef"); !ok {
+				b.Fatal("throttled")
+			}
+		}
+	})
+	b.Run("parallel", func(b *testing.B) {
+		b.RunParallel(func(pb *testing.PB) {
+			for pb.Next() {
+				if _, ok := client.ThrottleCheckOK(ctx, throttlerapp.RowStreamerName); !ok {
+					b.Fatal("throttled")
+				}
+			}
+		})
+	})
+}
