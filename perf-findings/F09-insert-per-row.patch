+// TestInsertShardedQueriesMatchOld checks that the precomputed per-plan query parts produce the exact
+// same per-shard queries and bind variables as the original per-execution rendering.
+func TestInsertShardedQueriesMatchOld(t *testing.T) {
+	for _, rows := range []int{1, 7, 100} {
+		for _, onDup := range []bool{false, true} {
+			ins, bv := newBenchShardedInsert(t, rows, 8, onDup)
+			vc := newBenchInsertVCursor()
+			for range 2 { // the second round uses the cached parts
+				rssOld, qOld, err := ins.getInsertShardedQueriesOld(t.Context(), vc, bv)
+				require.NoError(t, err)
+				rssNew, qNew, err := ins.getInsertShardedQueries(t.Context(), vc, bv)
+				require.NoError(t, err)
+				require.Equal(t, rssOld, rssNew)
+				require.Len(t, qNew, len(qOld))
+				for i := range qOld {
+					require.Equal(t, qOld[i].Sql, qNew[i].Sql)
+					require.Equal(t, qOld[i].BindVariables, qNew[i].BindVariables)
+				}
+			}
+		}
+	}
+}
+
+// TestInsertShardedMissingBindVar checks that a bind variable referenced by a row or by the
+// ON DUPLICATE KEY UPDATE suffix, but missing at execution time, is reported as VT03026.
+func TestInsertShardedMissingBindVar(t *testing.T) {
+	for _, missing := range []string{"vtg2", "vtg12", "upd"} {
+		t.Run(missing, func(t *testing.T) {
+			ins, bv := newBenchShardedInsert(t, 3, 4, true)
+			delete(bv, missing)
+			_, err := ins.TryExecute(t.Context(), newBenchInsertVCursor(), bv, false)
+			require.ErrorContains(t, err, fmt.Sprintf("'%s' bind variable does not exists", missing))
+			// The plan-constant parts are cached now; the error must be the same on the next execution.
+			_, err = ins.TryExecute(t.Context(), newBenchInsertVCursor(), bv, false)
+			require.ErrorContains(t, err, fmt.Sprintf("'%s' bind variable does not exists", missing))
+		})
+	}
+}
+
+// TestInsertShardedConcurrentFirstExecution executes a fresh sharded insert plan from several
+// goroutines at once, so that the race detector can check the lazy computation of its query parts.
+func TestInsertShardedConcurrentFirstExecution(t *testing.T) {
+	ins, bv := newBenchShardedInsert(t, 10, 4, true)
+	var wg sync.WaitGroup
+	for range 8 {
+		execBv := maps.Clone(bv)
+		wg.Go(func() {
+			_, queries, err := ins.getInsertShardedQueries(t.Context(), newBenchInsertVCursor(), execBv)
+			assert.NoError(t, err)
+			assert.NotEmpty(t, queries)
+		})
+	}
+	wg.Wait()
+}
