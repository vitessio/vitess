+// benchInsertVCursor resolves keyspace ids onto 4 shards by their first byte,
+// without logging, so that benchmarks measure the Insert primitive itself.
+type benchInsertVCursor struct {
+	noopVCursor
+	shards []*srvtopo.ResolvedShard
+}
+
+func newBenchInsertVCursor() *benchInsertVCursor {
+	vc := &benchInsertVCursor{}
+	for _, shard := range []string{"-40", "40-80", "80-c0", "c0-"} {
+		vc.shards = append(vc.shards, &srvtopo.ResolvedShard{Target: &querypb.Target{Keyspace: "sharded", Shard: shard}})
+	}
+	return vc
+}
+
+func (vc *benchInsertVCursor) ResolveDestinations(_ context.Context, _ string, ids []*querypb.Value, destinations []key.ShardDestination) ([]*srvtopo.ResolvedShard, [][]*querypb.Value, error) {
+	values := make([][]*querypb.Value, len(vc.shards))
+	for i, d := range destinations {
+		ksid := d.(key.DestinationKeyspaceID)
+		s := int(ksid[0]) >> 6
+		values[s] = append(values[s], ids[i])
+	}
+	var rss []*srvtopo.ResolvedShard
+	var out [][]*querypb.Value
+	for s, v := range values {
+		if len(v) > 0 {
+			rss = append(rss, vc.shards[s])
+			out = append(out, v)
+		}
+	}
+	return rss, out, nil
+}
+
+func (vc *benchInsertVCursor) ExecuteMultiShard(context.Context, Primitive, []*srvtopo.ResolvedShard, []*querypb.BoundQuery, bool, bool, bool) (*sqltypes.Result, []error) {
+	return &sqltypes.Result{}, nil
+}
+
+// newBenchShardedInsert builds a sharded insert of `rows` rows with `cols` columns each, shaped
+// like a normalized plan: the vindex column is :_id_N, the other columns are :vtgN arguments.
+// It also returns a bind variable map holding all the normalized arguments.
+func newBenchShardedInsert(tb testing.TB, rows, cols int, onDup bool) (*Insert, map[string]*querypb.BindVariable) {
+	invschema := &vschemapb.SrvVSchema{
+		Keyspaces: map[string]*vschemapb.Keyspace{
+			"sharded": {
+				Sharded:  true,
+				Vindexes: map[string]*vschemapb.Vindex{"hash": {Type: "hash"}},
+				Tables: map[string]*vschemapb.Table{
+					"t1": {ColumnVindexes: []*vschemapb.ColumnVindex{{Name: "hash", Columns: []string{"id"}}}},
+				},
+			},
+		},
+	}
+	vs := vindexes.BuildVSchema(invschema, sqlparser.NewTestParser())
+	ks := vs.Keyspaces["sharded"]
+	require.NoError(tb, ks.Error)
+
+	bv := map[string]*querypb.BindVariable{}
+	var idExprs []evalengine.Expr
+	mid := make(sqlparser.Values, 0, rows)
+	arg := 1
+	for r := range rows {
+		idArg := fmt.Sprintf("vtg%d", arg)
+		arg++
+		bv[idArg] = sqltypes.Int64BindVariable(int64(r + 1))
+		idExprs = append(idExprs, evalengine.NewBindVar(idArg, evalengine.NewType(sqltypes.Int64, 0)))
+		tuple := sqlparser.ValTuple{sqlparser.NewTypedArgument(fmt.Sprintf("_id_%d", r), sqltypes.Int64)}
+		for range cols - 1 {
+			name := fmt.Sprintf("vtg%d", arg)
+			arg++
+			bv[name] = sqltypes.StringBindVariable("some value")
+			tuple = append(tuple, sqlparser.NewTypedArgument(name, sqltypes.VarChar))
+		}
+		mid = append(mid, tuple)
+	}
+	var suffix sqlparser.OnDup
+	if onDup {
+		bv["upd"] = sqltypes.Int64BindVariable(1)
+		suffix = sqlparser.OnDup{&sqlparser.UpdateExpr{Name: sqlparser.NewColName("c"), Expr: sqlparser.NewArgument("upd")}}
+	}
+	ins := newInsert(InsertSharded, false, ks.Keyspace, [][][]evalengine.Expr{{idExprs}}, ks.Tables["t1"],
+		"insert into t1(id, c1, c2, c3, c4, c5, c6, c7) values ", mid, suffix)
+	return ins, bv
+}
+
+func BenchmarkInsertShardedQueries(b *testing.B) {
+	for _, rows := range []int{1, 100, 1000} {
+		for _, onDup := range []bool{false, true} {
+			ins, bv := newBenchShardedInsert(b, rows, 8, onDup)
+			vc := newBenchInsertVCursor()
+			name := fmt.Sprintf("rows=%d/ondup=%v", rows, onDup)
+			b.Run(name+"/impl=old", func(b *testing.B) {
+				b.ReportAllocs()
+				for b.Loop() {
+					_, _, err := ins.getInsertShardedQueriesOld(b.Context(), vc, bv)
+					if err != nil {
+						b.Fatal(err)
+					}
+				}
+			})
+			b.Run(name+"/impl=new", func(b *testing.B) {
+				b.ReportAllocs()
+				for b.Loop() {
+					_, _, err := ins.getInsertShardedQueries(b.Context(), vc, bv)
+					if err != nil {
+						b.Fatal(err)
+					}
+				}
+			})
+		}
+	}
+}
