+func benchmarkTablePlan20Cols(b *testing.B) (*TablePlan, []querypb.Type) {
+	types := []querypb.Type{
+		querypb.Type_INT64,
+		querypb.Type_INT32, querypb.Type_INT32, querypb.Type_INT64, querypb.Type_INT64, querypb.Type_UINT32,
+		querypb.Type_VARCHAR, querypb.Type_VARCHAR, querypb.Type_VARCHAR, querypb.Type_VARCHAR, querypb.Type_VARCHAR, querypb.Type_VARCHAR,
+		querypb.Type_DATETIME, querypb.Type_DATETIME, querypb.Type_TIMESTAMP,
+		querypb.Type_DECIMAL, querypb.Type_DECIMAL,
+		querypb.Type_TEXT, querypb.Type_BLOB,
+		querypb.Type_INT8,
+	}
+	colInfos := make([]*ColumnInfo, len(types))
+	fields := make([]*querypb.Field, len(types))
+	for i, typ := range types {
+		name := fmt.Sprintf("col_%02d", i)
+		colInfos[i] = &ColumnInfo{Name: name, IsPK: i == 0}
+		fields[i] = &querypb.Field{Name: name, Type: typ}
+	}
+	vr := &vreplicator{workflowConfig: vttablet.GetDefaultVReplicationConfig()}
+	source := &binlogdatapb.BinlogSource{Filter: &binlogdatapb.Filter{Rules: []*binlogdatapb.Rule{{Match: "t", Filter: "select * from t"}}}}
+	rp, err := vr.buildReplicatorPlan(source, map[string][]*ColumnInfo{"t": colInfos}, nil, binlogplayer.NewStats(), collations.MySQL8(), sqlparser.NewTestParser())
+	require.NoError(b, err)
+	tp, err := rp.buildExecutionPlan(&binlogdatapb.FieldEvent{TableName: "t", Fields: fields})
+	require.NoError(b, err)
+	return tp, types
+}
+
+func benchmarkRow(types []querypb.Type, id int) *querypb.Row {
+	vals := make([]sqltypes.Value, len(types))
+	for i, typ := range types {
+		switch {
+		case i == 0:
+			vals[i] = sqltypes.NewInt64(int64(id))
+		case sqltypes.IsIntegral(typ):
+			vals[i] = sqltypes.MakeTrusted(typ, strconv.AppendInt(nil, int64(id*7+i), 10))
+		case typ == querypb.Type_DATETIME || typ == querypb.Type_TIMESTAMP:
+			vals[i] = sqltypes.MakeTrusted(typ, []byte("2026-09-25 12:34:56"))
+		case typ == querypb.Type_DECIMAL:
+			vals[i] = sqltypes.MakeTrusted(typ, []byte("12345.6789"))
+		default:
+			vals[i] = sqltypes.MakeTrusted(typ, fmt.Appendf(nil, "some string value %d/%d", id, i))
+		}
+	}
+	return sqltypes.RowToProto3(vals)
+}
+
+func BenchmarkApplyChange20Cols(b *testing.B) {
+	tp, types := benchmarkTablePlan20Cols(b)
+	before, after := benchmarkRow(types, 1), benchmarkRow(types, 1)
+	after.Values[len(after.Values)-1] = '9'
+	executor := func(sql string) (*sqltypes.Result, error) { return &sqltypes.Result{RowsAffected: 1}, nil }
+	for _, tc := range []struct {
+		name      string
+		rowChange *binlogdatapb.RowChange
+	}{
+		{"insert", &binlogdatapb.RowChange{After: after}},
+		{"update", &binlogdatapb.RowChange{Before: before, After: after}},
+		{"delete", &binlogdatapb.RowChange{Before: before}},
+	} {
+		b.Run(tc.name, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				if _, err := tp.applyChange(tc.rowChange, executor); err != nil {
+					b.Fatal(err)
+				}
+			}
+		})
+	}
+}
+
+func BenchmarkApplyBulkInsertChanges20Cols(b *testing.B) {
+	tp, types := benchmarkTablePlan20Cols(b)
+	rowInserts := make([]*binlogdatapb.RowChange, 100)
+	for i := range rowInserts {
+		rowInserts[i] = &binlogdatapb.RowChange{After: benchmarkRow(types, i)}
+	}
+	executor := func(sql string) (*sqltypes.Result, error) { return &sqltypes.Result{RowsAffected: 1}, nil }
+	b.ReportAllocs()
+	for b.Loop() {
+		if _, err := tp.applyBulkInsertChanges(rowInserts, executor, 64*1024*1024); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
