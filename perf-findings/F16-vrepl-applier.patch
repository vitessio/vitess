+// TestTablePlanFieldInfosFallback verifies that a TablePlan that was not built
+// through buildExecutionPlan computes its per-column metadata on demand.
+func TestTablePlanFieldInfosFallback(t *testing.T) {
+	tp := &TablePlan{
+		Fields: []*querypb.Field{
+			{Name: "id", Type: querypb.Type_INT64},
+			{Name: "GenCol", Type: querypb.Type_INT64},
+		},
+		FieldsToSkip: map[string]bool{"gencol": true},
+	}
+	require.Nil(t, tp.fieldInfos)
+	assert.Equal(t, []fieldInfo{
+		{beforeName: "b_id", afterName: "a_id"},
+		{beforeName: "b_GenCol", afterName: "a_GenCol", skip: true},
+	}, tp.getFieldInfos())
+	assert.Nil(t, tp.fieldInfos, "the fallback must not store the result, as plans can be shared by concurrent copy workers")
+}
