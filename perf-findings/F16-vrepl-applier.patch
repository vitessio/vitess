+		})
+		require.NoError(t, err)
+		require.Len(t, executed, 1)
+		assert.Contains(t, executed[0], "(1,'n','caf\xe9','2')")
+	})
+
+	t.Run("select star skips generated columns case-insensitively", func(t *testing.T) {
+		tp := build(t, &binlogdatapb.Rule{Match: "t", Filter: "select * from t"}, []*querypb.Field{
+			{Name: "id", Type: querypb.Type_INT64},
+			{Name: "Name", Type: querypb.Type_VARCHAR},
+			{Name: "gencol", Type: querypb.Type_INT64},
+		})
+		assert.Equal(t, []fieldInfo{
+			{beforeName: "b_id", afterName: "a_id"},
+			{beforeName: "b_Name", afterName: "a_Name"},
+			{beforeName: "b_gencol", afterName: "a_gencol", skip: true},
+		}, tp.fieldInfos)
+	})
+}
