+// matchesAtMostOneRow reports whether a single-table DML with this WHERE clause
+// can match at most one row of table: the top-level AND of the WHERE clause
+// compares every primary key column for equality with a literal or a scalar
+// bind variable. Only integral primary key columns qualify: comparing an integer
+// with any scalar value (string, decimal, float) selects at most one integer,
+// whereas a string column compared with a number is compared as a double, so
+// that '1', '01' and '1.0' would all match.
+func matchesAtMostOneRow(where *sqlparser.Where, table *schema.Table) bool {
+	if where == nil || table == nil || len(table.PKColumns) == 0 {
+		return false
+	}
+	pinned := make([]bool, len(table.PKColumns))
+	for _, expr := range sqlparser.SplitAndExpression(nil, where.Expr) {
+		cmp, ok := expr.(*sqlparser.ComparisonExpr)
+		if !ok || cmp.Operator != sqlparser.EqualOp {
+			continue
+		}
+		col, ok := cmp.Left.(*sqlparser.ColName)
+		val := cmp.Right
+		if !ok {
+			col, ok = cmp.Right.(*sqlparser.ColName)
+			val = cmp.Left
+		}
+		if !ok || !isScalarValue(val) {
+			continue
+		}
+		for i, pkIdx := range table.PKColumns {
+			if pkIdx >= len(table.Fields) {
+				return false
+			}
+			field := table.Fields[pkIdx]
+			if sqltypes.IsIntegral(field.Type) && col.Name.EqualString(field.Name) {
+				pinned[i] = true
+			}
+		}
+	}
+	for _, p := range pinned {
+		if !p {
+			return false
+		}
+	}
+	return true
+}
+
+// isScalarValue reports whether expr is a literal or a scalar bind variable.
+func isScalarValue(expr sqlparser.Expr) bool {
+	switch expr.(type) {
+	case *sqlparser.Literal, *sqlparser.Argument:
+		return true
+	}
+	return false
+}
