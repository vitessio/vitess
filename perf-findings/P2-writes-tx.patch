+		case <-ctx.Done():
+			return nil, err
+		default:
+		}
+		if reconnectErr := dbc.Reconnect(ctx); reconnectErr != nil {
+			dbc.env.CheckMySQL()
+			return nil, reconnectErr
+		}
+	}
+	panic("unreachable")
+}
