new file mode 100755
index 0000000..a5696a7
--- /dev/null
+++ b/perf-findings/harness/P2-vars.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""vars.py snap > file | vars.py diff before after
+Snapshots vtgate CommitModeTimings and the tablets' Queries timings (BEGIN, COMMIT) and prints the average
+latency (ms) per operation between two snapshots."""
+import json
+import sys
+import urllib.request
+
+
+def get(port):
+    try:
+        with urllib.request.urlopen(f"http://localhost:{port}/debug/vars", timeout=5) as r:
+            return json.load(r)
+    except Exception:
+        return {}
+
+
+def snap():
+    out = {}
+    g = get(30001)
+    for k, h in g.get("CommitModeTimings", {}).get("Histograms", {}).items():
+        out["commit" + k] = [h["Count"], h["Time"]]
+    for port in (30100, 30101):
+        t = get(port)
+        for k in ("BEGIN", "COMMIT"):
+            h = t.get("Queries", {}).get("Histograms", {}).get(k)
+            if h:
+                c = out.setdefault("tablet" + k, [0, 0])
+                c[0] += h["Count"]
+                c[1] += h["Time"]
+    json.dump(out, sys.stdout)
+
+
+def diff(a, b):
+    a, b = json.load(open(a)), json.load(open(b))
+    parts = []
+    for k in sorted(b):
+        c = b[k][0] - a.get(k, [0, 0])[0]
+        t = b[k][1] - a.get(k, [0, 0])[1]
+        if c > 0:
+            parts.append(f"{k}={t / c / 1e6:.2f}ms")
+    print(" ".join(parts))
+
+
+if sys.argv[1] == "snap":
+    snap()
+else:
+    diff(sys.argv[2], sys.argv[3])
