+// TestDMLOnFullPrimaryKeySkipsRowLimit checks that an UPDATE or DELETE whose
+// WHERE clause pins every (integral) primary key column is planned without the
+// row limit, so that in autocommit mode it runs as one statement instead of
+// BEGIN, DML ... LIMIT, COMMIT. Anything that can match more than one row keeps
+// the limit.
+func TestDMLOnFullPrimaryKeySkipsRowLimit(t *testing.T) {
+	tables := map[string]*schema.Table{
+		"t1": {
+			Name: sqlparser.NewIdentifierCS("t1"),
+			Fields: []*querypb.Field{
+				{Name: "id", Type: querypb.Type_INT64},
+				{Name: "k", Type: querypb.Type_INT32},
+				{Name: "c", Type: querypb.Type_VARCHAR},
+			},
+			PKColumns: []int{0},
+		},
+		"t2": {
+			Name: sqlparser.NewIdentifierCS("t2"),
+			Fields: []*querypb.Field{
+				{Name: "a", Type: querypb.Type_UINT64},
+				{Name: "b", Type: querypb.Type_INT64},
+				{Name: "c", Type: querypb.Type_VARCHAR},
+			},
+			PKColumns: []int{0, 1},
+		},
+		"tstr": {
+			Name: sqlparser.NewIdentifierCS("tstr"),
+			Fields: []*querypb.Field{
+				{Name: "name", Type: querypb.Type_VARCHAR},
+				{Name: "c", Type: querypb.Type_VARCHAR},
+			},
+			PKColumns: []int{0},
+		},
+		"nopk": {
+			Name: sqlparser.NewIdentifierCS("nopk"),
+			Fields: []*querypb.Field{
+				{Name: "id", Type: querypb.Type_INT64},
+			},
+		},
+	}
+	tests := []struct {
+		query string
+		plan  PlanType
+		full  string
+	}{
+		{"update t1 set c = 'x' where id = 1", PlanUpdate, "update t1 set c = 'x' where id = 1"},
+		{"update t1 set c = 'x' where id = :id", PlanUpdate, "update t1 set c = 'x' where id = :id"},
+		{"update t1 set c = 'x' where :id = id and k > 3", PlanUpdate, "update t1 set c = 'x' where :id = id and k > 3"},
+		{"update t1 set k = k + 1 where t1.id = '5'", PlanUpdate, "update t1 set k = k + 1 where t1.id = '5'"},
+		{"delete from t1 where id = :id", PlanDelete, "delete from t1 where id = :id"},
+		{"update t2 set c = 'x' where a = 1 and b = 2", PlanUpdate, "update t2 set c = 'x' where a = 1 and b = 2"},
+		{"delete from t2 where b = :b and a = :a", PlanDelete, "delete from t2 where b = :b and a = :a"},
+		// Only part of the primary key is pinned.
+		{"update t2 set c = 'x' where a = 1", PlanUpdateLimit, "update t2 set c = 'x' where a = 1 limit :#maxLimit"},
+		// A disjunction can match several rows.
+		{"update t1 set c = 'x' where id = 1 or k = 2", PlanUpdateLimit, "update t1 set c = 'x' where id = 1 or k = 2 limit :#maxLimit"},
+		// Not an equality with a single value.
+		{"update t1 set c = 'x' where id in (1, 2)", PlanUpdateLimit, "update t1 set c = 'x' where id in (1, 2) limit :#maxLimit"},
+		{"update t1 set c = 'x' where id in ::ids", PlanUpdateLimit, "update t1 set c = 'x' where id in ::ids limit :#maxLimit"},
+		{"update t1 set c = 'x' where id >= 1", PlanUpdateLimit, "update t1 set c = 'x' where id >= 1 limit :#maxLimit"},
+		{"update t1 set c = 'x' where id = k", PlanUpdateLimit, "update t1 set c = 'x' where id = k limit :#maxLimit"},
+		{"delete from t1 where k = 1", PlanDeleteLimit, "delete from t1 where k = 1 limit :#maxLimit"},
+		{"delete from t1", PlanDeleteLimit, "delete from t1 limit :#maxLimit"},
+		// A string primary key compared with a number matches '1', '01', '1.0', ...
+		{"update tstr set c = 'x' where name = 1", PlanUpdateLimit, "update tstr set c = 'x' where `name` = 1 limit :#maxLimit"},
+		{"delete from tstr where name = :name", PlanDeleteLimit, "delete from tstr where `name` = :name limit :#maxLimit"},
+		// No primary key known.
+		{"update nopk set id = 2 where id = 1", PlanUpdateLimit, "update nopk set id = 2 where id = 1 limit :#maxLimit"},
+	}
+	env := vtenv.NewTestEnv()
+	for _, tc := range tests {
+		t.Run(tc.query, func(t *testing.T) {
+			stmt, err := env.Parser().Parse(tc.query)
+			require.NoError(t, err)
+			plan, err := Build(env, stmt, tables, "dbName", false)
+			require.NoError(t, err)
+			assert.Equal(t, tc.plan, plan.PlanID)
+			assert.Equal(t, tc.full, plan.FullQuery.Query)
+		})
+	}
