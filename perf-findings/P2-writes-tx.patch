index 0000000..7241cea
--- /dev/null
+++ b/perf-findings/harness/P2-setvar.lua
@@ -0,0 +1,22 @@
+-- Runs the sysbench script $BASE_LUA (e.g. oltp_write_only) after executing
+-- "set session <name> = '<value>'" on every connection, with SETVAR=<name>:<value>,
+-- e.g. SETVAR=sql_mode:STRICT_TRANS_TABLES to make vtgate carry a session setting.
+dofile("/usr/share/sysbench/" .. os.getenv("BASE_LUA") .. ".lua")
+
+local orig_thread_init = thread_init
+function thread_init()
+   orig_thread_init()
+   local sv = os.getenv("SETVAR")
+   if sv and sv ~= "" then
+      local name, value = sv:match("^([^:]+):(.*)$")
+      if value:match("^%d+$") then
+         con:query(string.format("set session %s = %s", name, value))
+      else
+         con:query(string.format("set session %s = '%s'", name, value))
+      end
+   end
+   -- RESERVE=temp: create a temporary table, which pins the session to reserved connections
+   if os.getenv("RESERVE") == "temp" then
+      con:query("create temporary table p2tmp (id int primary key)")
+   end
+end
diff --git a/perf-findings/harness/P2-tx1shard.lua b/perf-findings/harness/P2-tx1shard.lua
new file mode 100644
index 0000000..faa8f69
--- /dev/null
+++ b/perf-findings/harness/P2-tx1shard.lua
@@ -0,0 +1,31 @@
+-- Explicit single-shard transaction: BEGIN; SELECT c ... WHERE id=? [FOR UPDATE]; UPDATE ... SET k=k+1 WHERE id=?; COMMIT
+-- (same id, so one shard). FOR_UPDATE=1 adds FOR UPDATE to the select. Prepared statements unless --db-ps-mode=disable.
+require("oltp_common")
+
+local for_update = os.getenv("FOR_UPDATE") == "1"
+
+function prepare_statements()
+   local sel = "SELECT c FROM sbtest%u WHERE id=?"
+   if for_update then sel = sel .. " FOR UPDATE" end
+   for t = 1, sysbench.opt.tables do
+      stmt[t].sel = con:prepare(string.format(sel, t))
+      param[t].sel = { stmt[t].sel:bind_create(sysbench.sql.type.INT) }
+      stmt[t].sel:bind_param(unpack(param[t].sel))
+      stmt[t].upd = con:prepare(string.format("UPDATE sbtest%u SET k=k+1 WHERE id=?", t))
+      param[t].upd = { stmt[t].upd:bind_create(sysbench.sql.type.INT) }
+      stmt[t].upd:bind_param(unpack(param[t].upd))
+   end
+   stmt.begin = con:prepare("BEGIN")
+   stmt.commit = con:prepare("COMMIT")
+end
+
+function event()
+   local t = sysbench.rand.uniform(1, sysbench.opt.tables)
+   local id = sysbench.rand.default(1, sysbench.opt.table_size)
+   stmt.begin:execute()
+   param[t].sel[1]:set(id)
+   stmt[t].sel:execute()
+   param[t].upd[1]:set(id)
+   stmt[t].upd:execute()
+   stmt.commit:execute()
+end
