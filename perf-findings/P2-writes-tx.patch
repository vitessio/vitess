+// TestDBConnExecWithPrefix checks that ExecWithPrefix runs the prefix and the
+// query in one round trip, returns the query's result, and does not run the
+// query when the prefix fails.
+func TestDBConnExecWithPrefix(t *testing.T) {
+	db := fakesqldb.New(t)
+	defer db.Close()
+
+	sql := "select * from test_table limit 1000"
+	expectedResult := &sqltypes.Result{
+		Fields: []*querypb.Field{
+			{Type: sqltypes.VarChar},
+		},
+		Rows: [][]sqltypes.Value{
+			{sqltypes.NewVarChar("123")},
+		},
+	}
+	db.AddQuery(sql, expectedResult)
+	db.AddQuery("begin", &sqltypes.Result{})
+	connPool := newPool()
+	mysqlTimings := connPool.env.Stats().MySQLTimings
+	params := dbconfigs.New(db.ConnParams())
+	connPool.Open(params, params, params)
+	defer connPool.Close()
+	dbConn, err := newPooledConn(t.Context(), connPool, params)
+	require.NoError(t, err)
+	defer dbConn.Close()
+
+	db.ResetQueryLog() // drop the connection setup
+	startCounts := mysqlTimings.Counts()
+	result, err := dbConn.ExecWithPrefix(t.Context(), "begin", sql, 10, true)
+	require.NoError(t, err)
+	assert.True(t, expectedResult.Equal(result), "got %v, want %v", result, expectedResult)
+	assert.Equal(t, "begin;"+sql, db.QueryLog())
+	// One round trip.
+	compareTimingCounts(t, "PoolTest.Exec", 1, startCounts, mysqlTimings.Counts())
+
+	// An error of the query is reported for the query.
+	db.ResetQueryLog()
+	db.AddRejectedQuery(sql, sqlerror.NewSQLError(sqlerror.ERDupEntry, sqlerror.SSConstraintViolation, "Duplicate entry"))
+	_, err = dbConn.ExecWithPrefix(t.Context(), "begin", sql, 10, true)
+	require.ErrorContains(t, err, "Duplicate entry")
+	require.ErrorContains(t, err, "during query: "+sql)
+	assert.Equal(t, "begin;"+sql, db.QueryLog())
+
+	// If the prefix fails, the query does not run.
+	db.ResetQueryLog()
+	db.AddRejectedQuery("begin", sqlerror.NewSQLError(sqlerror.ERUnknownError, sqlerror.SSUnknownSQLState, "begin failed"))
+	_, err = dbConn.ExecWithPrefix(t.Context(), "begin", sql, 10, true)
+	require.ErrorContains(t, err, "begin failed")
+	require.ErrorContains(t, err, "during query: begin")
+	assert.Equal(t, "begin", db.QueryLog())
+}
