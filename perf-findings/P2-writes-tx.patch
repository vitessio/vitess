diff --git a/go/mysql/query.go b/go/mysql/query.go
index 86db97b..c9fee68 100644
--- a/go/mysql/query.go
+++ b/go/mysql/query.go
@@ -326,6 +326,41 @@ func (c *Conn) ExecuteFetch(query string, maxrows int, wantfields bool) (result
 	return result, err
 }
 
+// ExecuteFetchWithPrefix sends prefix and query in one COM_QUERY packet, as the
+// multi-statement "prefix;query", and returns the result of query, like
+// ExecuteFetch(query) would after a separate ExecuteFetch(prefix). It saves
+// the round trip to the server for prefix. prefix must be one statement that
+// returns no rows, e.g. "begin". If prefix fails, the server does not run query.
+func (c *Conn) ExecuteFetchWithPrefix(prefix, query string, maxrows int, wantfields bool) (result *sqltypes.Result, err error) {
+	failed := query
+	defer func() {
+		if err != nil {
+			if sqlerr, ok := err.(*sqlerror.SQLError); ok {
+				sqlerr.Query = sqlparser.TruncateQuery(failed, c.truncateErrLen)
+			}
+		}
+	}()
+
+	if err = c.WriteComQuery(prefix + ";" + query); err != nil {
+		return nil, err
+	}
+	_, more, _, err := c.ReadQueryResult(FETCH_NO_ROWS, false)
+	if err != nil {
+		failed = prefix
+		return nil, err
+	}
+	if !more {
+		return nil, vterrors.Errorf(vtrpc.Code_INTERNAL, "[BUG] no result for %q after %q", sqlparser.TruncateQuery(query, c.truncateErrLen), prefix)
+	}
+	result, more, _, err = c.ReadQueryResult(maxrows, wantfields)
+	if more {
+		// Same as ExecuteFetch: query must return a single result.
+		err = errors.Join(ErrExecuteFetchMultipleResults, err)
+	}
+	err = c.drainMoreResults(more, err)
+	return result, err
+}
+
 // ExecuteFetchMultiDrain is for executing multiple statements in one call, but without
 // caring for any results. The function returns an error if any of the statements fail.
 // The function drains the query results of all statements, even if there's an error.
