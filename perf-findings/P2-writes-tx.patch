new file mode 100755
index 0000000..f29c304
--- /dev/null
+++ b/perf-findings/harness/P2-agg.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""Aggregate bench.sh lines: mean (and min..max for CPU) per workload/mode/threads/config; % vs the first config."""
+import re, sys
+from collections import defaultdict
+rows = defaultdict(list); order = []
+pat = re.compile(r'(r\d+-)?(\S+)\s+(\S+)\s+(\S+)\s+thr=(\d+)\s+tps=(\S+)\s+qps=(\S+)\s+avg=(\S+)\s+p95=(\S+)\s+p99=(\S+)\s+'
+                 r'vtgate=(\d+) tablets=(\d+) mysqld=(\d+) myq=(\S+) mybegin=(\S+) mycommit=(\S+) err/s=(\S+) load=(\S+)')
+for path in sys.argv[1:]:
+    for line in open(path):
+        m = pat.match(line)
+        if not m: continue
+        key = (m.group(3), m.group(4), int(m.group(5)), m.group(2))
+        if key not in rows: order.append(key)
+        rows[key].append([float(m.group(i)) for i in range(6, 19)])
+names = ['tps','qps','avg','p95','p99','vtgate','tablets','mysqld','myq','mybegin','mycommit','err','load']
+print("| workload | mode | thr | config | n | TPS | avg ms | p95 ms | p99 ms | vtgate µs/tx | tablets µs/tx | mysqld µs/tx | MySQL stmts/tx | load |")
+print("|---|---|---|---|---|---|---|---|---|---|---|---|---|---|")
+base = {}
+for key in sorted(order, key=lambda k: (order.index([o for o in order if o[:3]==k[:3]][0]), order.index(k))):
+    v = rows[key]; n = len(v)
+    mean = [sum(x[i] for x in v)/n for i in range(13)]
+    lo = [min(x[i] for x in v) for i in range(13)]; hi = [max(x[i] for x in v) for i in range(13)]
+    b = base.setdefault(key[:3], mean)
+    def f(i, p, rng=False):
+        s = f"{mean[i]:.{p}f}"
+        if b is not mean and b[i]: s += f" ({(mean[i]/b[i]-1)*100:+.1f}%)"
+        if rng and n > 1: s += f" [{lo[i]:.{p}f}–{hi[i]:.{p}f}]"
+        return s
+    print(f"| {key[0]} | {key[1]} | {key[2]} | {key[3]} | {n} | {f(0,0)} | {f(2,2)} | {f(3,2)} | {f(4,2)} | {f(5,0,True)} | {f(6,0,True)} | {f(7,0,True)} | {mean[8]:.2f} | {mean[12]:.1f} |")
