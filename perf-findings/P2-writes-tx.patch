+// TestTxPoolDeferBegin checks that with DeferBegin the transaction's BEGIN is
+// sent together with its first statement, and that a transaction that
+// executed no statement sends neither BEGIN nor COMMIT/ROLLBACK.
+func TestTxPoolDeferBegin(t *testing.T) {
+	ctx := t.Context()
+	env := newEnv("TabletServerTest")
+	env.Config().DeferBegin = true
+	db, txPool, _, closer := setupWithEnv(t, env)
+	defer closer()
+
+	sql := "update t set a = 1 where id = 1"
+	conn, beginSQL, _, err := txPool.Begin(ctx, &querypb.ExecuteOptions{}, false, 0, nil)
+	require.NoError(t, err)
+	assert.Equal(t, "begin", beginSQL)
+	assert.NotContains(t, db.QueryLog(), "begin", "begin must wait for the first statement")
+	db.ResetQueryLog() // drop the connection setup
+	_, err = conn.Exec(ctx, sql, 1, true, false /* keepConnOnTimeout */)
+	require.NoError(t, err)
+	assert.Equal(t, "begin;"+sql, db.QueryLog())
+	commitSQL, err := txPool.Commit(ctx, conn)
+	require.NoError(t, err)
+	assert.Equal(t, "commit", commitSQL)
+	assert.Equal(t, "begin;"+sql+";commit", db.QueryLog())
+	conn.Release(tx.TxCommit)
+
+	// Nothing executed: nothing to send.
+	conn, _, _, err = txPool.Begin(ctx, &querypb.ExecuteOptions{}, false, 0, nil)
+	require.NoError(t, err)
+	db.ResetQueryLog()
+	commitSQL, err = txPool.Commit(ctx, conn)
+	require.NoError(t, err)
+	assert.Empty(t, commitSQL)
+	conn.Release(tx.TxCommit)
+	conn, _, _, err = txPool.Begin(ctx, &querypb.ExecuteOptions{}, false, 0, nil)
+	require.NoError(t, err)
+	require.NoError(t, txPool.Rollback(ctx, conn))
+	conn.Release(tx.TxRollback)
+	assert.Empty(t, db.QueryLog())
+
+	// Paths that use the connection directly send the begin first.
+	conn, _, _, err = txPool.Begin(ctx, &querypb.ExecuteOptions{}, false, 0, nil)
+	require.NoError(t, err)
+	db.ResetQueryLog()
+	require.NoError(t, conn.FlushPendingBegin(ctx))
+	assert.Equal(t, "begin", db.QueryLog())
+	require.NoError(t, txPool.Rollback(ctx, conn))
+	conn.Release(tx.TxRollback)
+	assert.Equal(t, "begin;rollback", db.QueryLog())
