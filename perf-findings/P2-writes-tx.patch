+		r, err := dbc.execOnceWith(ctx, query, true /* insideTxn */, fetch)
+		switch {
+		case err == nil:
+			return r, nil
+		case sqlerror.IsConnLostDuringQuery(err), !sqlerror.IsConnErr(err), attempt == 2:
+			return nil, err
+		}
