+// ExecWithPrefix executes prefix and then query in a single round trip (see
+// mysql.Conn.ExecuteFetchWithPrefix) and returns the result of query. prefix
+// is typically the "begin" of a transaction that query is the first statement
+// of. Like Exec, it reconnects and retries once if the connection was found
+// broken before the statements ran. Like ExecOnce, a context expiring while
+// the statements run kills the connection.
+func (dbc *Conn) ExecWithPrefix(ctx context.Context, prefix, query string, maxrows int, wantfields bool) (*sqltypes.Result, error) {
+	fetch := func() (*sqltypes.Result, error) {
+		return dbc.conn.ExecuteFetchWithPrefix(prefix, query, maxrows, wantfields)
+	}
