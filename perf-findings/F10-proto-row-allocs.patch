+// capped (3-index slicing) so that appending to one row's Lengths or Values
+// reallocates instead of overwriting the next row. Note that retaining any
+// single returned row keeps the backing arrays of all rows alive.
 func RowsToProto3(rows [][]Value) []*querypb.Row {
 	if len(rows) == 0 {
 		return nil
 	}
 
+	var numCols, numBytes int
