+
+// rowsToProto3PerRow is the per-row allocating reference implementation.
+func rowsToProto3PerRow(rows [][]Value) []*querypb.Row {
+	if len(rows) == 0 {
+		return nil
+	}
+	result := make([]*querypb.Row, len(rows))
+	for i, r := range rows {
+		result[i] = RowToProto3(r)
+	}
+	return result
+}
+
+// proto3ToRowsPerRow is the per-row allocating reference implementation.
+func proto3ToRowsPerRow(fields []*querypb.Field, rows []*querypb.Row) [][]Value {
+	if len(rows) == 0 {
+		return [][]Value{}
+	}
+	result := make([][]Value, len(rows))
+	for i, r := range rows {
+		result[i] = MakeRowTrusted(fields, r)
+	}
+	return result
+}
+
+func randomSlabResult(rng *rand.Rand, numRows, numCols int) *Result {
+	fields := make([]*querypb.Field, numCols)
+	for i := range fields {
+		fields[i] = &querypb.Field{Name: "c" + strconv.Itoa(i), Type: Int64}
+		if i%2 == 1 {
+			fields[i].Type = VarChar
+		}
+	}
+	rows := make([]Row, numRows)
+	for i := range rows {
+		row := make(Row, numCols)
+		for j := range row {
+			switch rng.IntN(4) {
+			case 0:
+				row[j] = NULL
+			case 1:
+				row[j] = MakeTrusted(fields[j].Type, []byte{})
+			default:
+				if fields[j].Type == Int64 {
+					row[j] = NewInt64(rng.Int64())
+				} else {
+					b := make([]byte, rng.IntN(40))
+					for k := range b {
+						b[k] = byte('a' + rng.IntN(26))
+					}
+					row[j] = NewVarChar(string(b))
+				}
+			}
+		}
+		rows[i] = row
+	}
+	return &Result{Fields: fields, Rows: rows}
+}
+
+func TestRowsToProto3SlabEquivalence(t *testing.T) {
+	rng := rand.New(rand.NewPCG(1, 2))
+	for _, shape := range [][2]int{{1, 0}, {1, 1}, {3, 0}, {1, 5}, {10, 3}, {100, 7}, {500, 1}} {
+		for range 20 {
+			qr := randomSlabResult(rng, shape[0], shape[1])
+
+			got := RowsToProto3(qr.Rows)
+			want := rowsToProto3PerRow(qr.Rows)
+			require.Len(t, got, len(want))
+			for i := range want {
+				require.True(t, proto.Equal(want[i], got[i]), "row %d", i)
+				// Sub-slices must be capped so that appends cannot clobber neighbours.
+				assert.Equal(t, len(got[i].Lengths), cap(got[i].Lengths))
+				assert.Equal(t, len(got[i].Values), cap(got[i].Values))
+				assert.NotNil(t, got[i].Lengths)
+				assert.NotNil(t, got[i].Values)
+			}
+
+			back := proto3ToRows(qr.Fields, got)
+			wantBack := proto3ToRowsPerRow(qr.Fields, want)
+			require.Equal(t, wantBack, back)
+			for i := range back {
+				assert.Equal(t, len(back[i]), cap(back[i]))
+			}
+		}
+	}
+}
+
+func TestRowsToProto3SlabAppendIsolation(t *testing.T) {
+	rows := [][]Value{
+		{NewInt64(1), NewVarChar("ab")},
+		{NewInt64(2), NewVarChar("cd")},
+	}
+	p := RowsToProto3(rows)
+	p[0].Lengths = append(p[0].Lengths, 1)
+	p[0].Values = append(p[0].Values, 'x')
+	assert.Equal(t, []int64{1, 2}, p[1].Lengths)
+	assert.Equal(t, []byte("2cd"), p[1].Values)
+
+	fields := []*querypb.Field{{Type: Int64}, {Type: VarChar}}
+	back := proto3ToRows(fields, RowsToProto3(rows))
+	back[0] = append(back[0], NewInt64(99))
+	assert.Equal(t, Row{NewInt64(2), NewVarChar("cd")}, Row(back[1]))
+}
+
+var slabBenchShapes = [][2]int{{1, 5}, {10, 5}, {100, 5}, {1000, 5}, {10000, 20}}
+
+func BenchmarkRowsToProto3Slab(b *testing.B) {
+	rng := rand.New(rand.NewPCG(3, 4))
+	for _, shape := range slabBenchShapes {
+		qr := makeSlabBenchResult(rng, shape[0], shape[1])
+		name := fmt.Sprintf("rows=%d,cols=%d", shape[0], shape[1])
+		b.Run("old/"+name, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				rowsToProto3PerRow(qr.Rows)
+			}
+		})
+		b.Run("new/"+name, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				RowsToProto3(qr.Rows)
+			}
+		})
+	}
+}
+
+func BenchmarkProto3ToRowsSlab(b *testing.B) {
+	rng := rand.New(rand.NewPCG(5, 6))
+	for _, shape := range slabBenchShapes {
+		qr := makeSlabBenchResult(rng, shape[0], shape[1])
+		p := rowsToProto3PerRow(qr.Rows)
+		name := fmt.Sprintf("rows=%d,cols=%d", shape[0], shape[1])
+		b.Run("old/"+name, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				proto3ToRowsPerRow(qr.Fields, p)
+			}
+		})
+		b.Run("new/"+name, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				proto3ToRows(qr.Fields, p)
+			}
+		})
+	}
+}
+
+// makeSlabBenchResult builds a result without NULLs with realistic value sizes.
+func makeSlabBenchResult(rng *rand.Rand, numRows, numCols int) *Result {
+	fields := make([]*querypb.Field, numCols)
+	for i := range fields {
+		fields[i] = &querypb.Field{Name: "c" + strconv.Itoa(i), Type: Int64}
+		if i%2 == 1 {
+			fields[i].Type = VarChar
+		}
+	}
+	rows := make([]Row, numRows)
+	for i := range rows {
+		row := make(Row, numCols)
+		for j := range row {
+			if fields[j].Type == Int64 {
+				row[j] = NewInt64(rng.Int64N(1 << 40))
+			} else {
+				row[j] = NewVarChar(fmt.Sprintf("value-%d-%d", i, j))
+			}
+		}
+		rows[i] = row
+	}
+	return &Result{Fields: fields, Rows: rows}
+}
