+			if c.IsNull() {
+				rowLengths[j] = -1
+				continue
+			}
+			byteOff += copy(values[byteOff:], c.Raw())
+			rowLengths[j] = int64(c.Len())
+		}
+		colOff += len(r)
+
+		row := &protoRows[i]
+		row.Lengths = rowLengths
