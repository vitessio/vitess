+package grpctabletconn
+
+import (
+	"context"
+	"fmt"
+	"strconv"
+	"testing"
+
+	"vitess.io/vitess/go/sqltypes"
+	querypb "vitess.io/vitess/go/vt/proto/query"
+	"vitess.io/vitess/go/vt/vttablet/queryservice"
+	"vitess.io/vitess/go/vt/vttablet/tabletconntest"
+)
+
+// benchRowsService returns a fixed result from Execute and streams the same
+// rows in chunks of chunkRows from StreamExecute.
+type benchRowsService struct {
+	*tabletconntest.FakeQueryService
+	result    *sqltypes.Result
+	chunkRows int
+}
+
+func (s *benchRowsService) Execute(context.Context, queryservice.Session, *querypb.Target, string, map[string]*querypb.BindVariable, int64, int64, *querypb.ExecuteOptions) (*sqltypes.Result, error) {
+	return s.result, nil
+}
+
+func (s *benchRowsService) StreamExecute(_ context.Context, _ queryservice.Session, _ *querypb.Target, _ string, _ map[string]*querypb.BindVariable, _ int64, _ int64, _ *querypb.ExecuteOptions, callback func(*sqltypes.Result) error) error {
+	if err := callback(&sqltypes.Result{Fields: s.result.Fields}); err != nil {
+		return err
+	}
+	rows := s.result.Rows
+	for len(rows) > 0 {
+		n := min(s.chunkRows, len(rows))
+		if err := callback(&sqltypes.Result{Rows: rows[:n]}); err != nil {
+			return err
+		}
+		rows = rows[n:]
+	}
+	return nil
+}
+
+func makeBenchRowsResult(numRows, numCols int) *sqltypes.Result {
+	fields := make([]*querypb.Field, numCols)
+	for i := range fields {
+		fields[i] = &querypb.Field{Name: "c" + strconv.Itoa(i), Type: sqltypes.Int64}
+		if i%2 == 1 {
+			fields[i].Type = sqltypes.VarChar
+		}
+	}
+	rows := make([]sqltypes.Row, numRows)
+	for i := range rows {
+		row := make(sqltypes.Row, numCols)
+		for j := range row {
+			if fields[j].Type == sqltypes.Int64 {
+				row[j] = sqltypes.NewInt64(int64(i*numCols + j))
+			} else {
+				row[j] = sqltypes.NewVarChar(fmt.Sprintf("value-%d-%d", i, j))
+			}
+		}
+		rows[i] = row
+	}
+	return &sqltypes.Result{Fields: fields, Rows: rows}
+}
+
+// BenchmarkGRPCRows measures Execute and StreamExecute over a loopback gRPC
+// connection, including ResultToProto3 on the server and Proto3ToResult on
+// the client.
+func BenchmarkGRPCRows(b *testing.B) {
+	for _, shape := range [][2]int{{1, 5}, {10, 5}, {1000, 5}, {10000, 20}} {
+		result := makeBenchRowsResult(shape[0], shape[1])
+		service := &benchRowsService{
+			FakeQueryService: tabletconntest.CreateFakeServer(b),
+			result:           result,
+			// Roughly what a 32KiB stream buffer holds for these rows.
+			chunkRows: max(1, 32*1024/(shape[1]*12)),
+		}
+		client := setupBenchGRPC(b, service, 256<<20)
+		target := &querypb.Target{Keyspace: "bench", Shard: "0"}
+		name := fmt.Sprintf("rows=%d,cols=%d", shape[0], shape[1])
+
+		b.Run("Execute/"+name, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				qr, err := client.Execute(b.Context(), nil, target, "select", nil, 0, 0, nil)
+				if err != nil || len(qr.Rows) != shape[0] {
+					b.Fatalf("unexpected: %v", err)
+				}
+			}
+		})
+		b.Run("StreamExecute/"+name, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				n := 0
+				err := client.StreamExecute(b.Context(), nil, target, "select", nil, 0, 0, nil, func(qr *sqltypes.Result) error {
+					n += len(qr.Rows)
+					return nil
+				})
+				if err != nil || n != shape[0] {
+					b.Fatalf("unexpected: %v %d", err, n)
+				}
+			}
+		})
+	}
+}
