+#!/bin/bash
+# Summarize drain results: summ.sh GLOB  (e.g. summ.sh 'base-r*-wo')
+cd /home/vt/perf/V2/out || exit 1
+for d in $1; do
+  [[ -f $d/summary ]] || continue
+  awk -v n="$d" '
+    NR==1 { for (i=1;i<=NF;i++) { if ($i ~ /^rate=/) r=substr($i,6); if ($i ~ /^drain=/) dr=substr($i,7) } }
+    $1=="vttablet_100" { sv=$4 } $1=="vttablet_101" { tv=$4 } $1=="mysqld_101" { tm=$4 }
+    /Questions/ { for (i=1;i<=NF;i++) { if ($i=="Questions") q=$(i+1); if ($i=="Com_commit") c=$(i+1) } }
+    /top target mysqld threads/ { match($0, /: [0-9.]+ [0-9]+%busy [0-9]+%runqwait/); split(substr($0, RSTART+2, RLENGTH-2), a, " "); tb=a[2]; tw=a[3] ; if (tb=="") { match($0, /: [0-9.]+ [0-9]+%/); split(substr($0, RSTART+2, RLENGTH-2), a, " "); tb=a[2] } }
+    END { printf "%-22s rate=%-7s drain=%-6.2f srcVT=%-7s tgtVT=%-7s tgtMy=%-8s stmts/trx=%-7s commits/trx=%-6s applythr=%s %s\n", n, r, dr, sv, tv, tm, q, c, tb, tw }' "$d/summary"
+done
diff --git a/perf-findings/harness/V2/thr.sh b/perf-findings/harness/V2/thr.sh
new file mode 100755
index 0000000000..8ded0287d5
--- /dev/null
+++ b/perf-findings/harness/V2/thr.sh
@@ -0,0 +1,6 @@
+#!/bin/bash
+# Per-thread CPU of the process in pid file $1: "tid comm cpu_ticks runqueue_wait_ns"
+for t in /proc/$(cat $1)/task/*; do
+  w=$(awk '{print $2}' "$t/schedstat" 2>/dev/null)
+  awk -v tid="${t##*/}" -v w="${w:-0}" '{ s=$0; sub(/^[^)]*\) /, "", s); split(s, f, " "); c=$0; sub(/^[^(]*\(/, "", c); sub(/\).*/, "", c); print tid, c, f[12]+f[13], w }' "$t/stat" 2>/dev/null
+done
