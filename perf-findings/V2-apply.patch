+// bulkUpdatePlan holds what is needed to render several single-row UPDATEs
+// that only differ in their values as one statement:
+//
+//	update t set c1=case pk when 1 then v11 when 2 then v21 end, ... where pk in (1, 2) order by pk
+//
+// See tablePlanBuilder.generateBulkUpdatePlan for when a plan has one.
+type bulkUpdatePlan struct {
+	prefix      string   // "update `t` set "
+	pkCol       string   // target PK column, escaped
+	pkBindVar   string   // before-image bind variable of the PK, e.g. "b_id"
+	setCols     []string // target columns to set, escaped
+	setBindVars []string // after-image bind variable of each set column, e.g. "a_c"
+}
+
+// maxBulkUpdateRows caps the rows per bulk UPDATE statement. Every row
+// evaluates one CASE per column, and a CASE is a linear scan over the rows,
+// so the per-row cost of a bulk UPDATE grows with the statement size.
+var maxBulkUpdateRows = 100
+
+// fieldsOK reports whether the field types allow the bulk UPDATE:
+// the PK must be an integer (runs are formed by comparing PK values) and the
+// set columns must not be JSON (JSON values are expressions), BIT, geometry or
+// floating point, whose values could be converted differently when they are
+// the result of a CASE expression rather than a literal.
+func (bu *bulkUpdatePlan) fieldsOK(fields []*querypb.Field) bool {
+	if bu == nil || len(fields) == 0 {
+		return false
+	}
+	types := make(map[string]querypb.Type, len(fields))
+	for _, field := range fields {
+		if field.Type == querypb.Type_JSON {
+			// JSON columns need their bind variables rewritten (bindAfterJSONFieldVals).
+			return false
+		}
+		types[field.Name] = field.Type
+	}
+	pkType, ok := types[strings.TrimPrefix(bu.pkBindVar, "b_")]
+	if !ok || !sqltypes.IsIntegral(pkType) {
+		return false
+	}
+	for _, bv := range bu.setBindVars {
+		typ, ok := types[strings.TrimPrefix(bv, "a_")]
+		if !ok || sqltypes.IsFloat(typ) {
+			return false
+		}
+		switch typ {
+		case querypb.Type_BIT, querypb.Type_GEOMETRY, querypb.Type_EXPRESSION, querypb.Type_TUPLE, querypb.Type_ROW_TUPLE:
+			return false
+		}
+	}
+	return true
+}
+
+// applyBulkUpdateChanges applies the row changes of a row event in order,
+// combining runs of consecutive update-shaped changes into single UPDATE
+// statements. A run holds changes that keep their PK and whose PK values are
+// strictly increasing (or strictly decreasing), and the statement updates the
+// rows in that same order (ORDER BY), so the target goes through the same
+// sequence of row states as with one UPDATE per row: unique key checks,
+// missing rows (no-op) and errors behave the same. Any other change (insert,
+// delete, PK change, partial image) ends the run and is applied by applyChange.
+func (tp *TablePlan) applyBulkUpdateChanges(rowChanges []*binlogdatapb.RowChange, executor func(string) (*sqltypes.Result, error), maxQuerySize int64) (*sqltypes.Result, error) {
+	bu := tp.BulkUpdate
+	if bu == nil {
+		for _, change := range rowChanges {
+			if _, err := tp.applyChange(change, executor); err != nil {
+				return nil, err
+			}
+		}
+		return &sqltypes.Result{}, nil
+	}
+	pkUnsigned := false
+	for _, field := range tp.Fields {
+		if "b_"+field.Name == bu.pkBindVar {
+			pkUnsigned = sqltypes.IsUnsigned(field.Type)
+			break
+		}
+	}
+
+	type pendingRow struct {
+		pk       sqltypes.Value
+		bindvars map[string]*querypb.BindVariable
+	}
+	var (
+		run      []pendingRow
+		runSize  int64
+		dir      int // 0: undetermined, 1: increasing, -1: decreasing PKs
+		lastPK   uint64
+		lastPKs  int64
+		baseSize = int64(len(bu.prefix)) + int64(len(" where  in () order by  desc")+2*len(bu.pkCol))
+	)
+	for _, col := range bu.setCols {
+		baseSize += int64(len(col) + len("=case ") + len(bu.pkCol) + len(" end, "))
+	}
+	comparePK := func(v sqltypes.Value) (int, bool) {
+		if pkUnsigned {
+			u, err := v.ToUint64()
+			if err != nil {
+				return 0, false
+			}
+			c := 0
+			if len(run) > 0 {
+				switch {
+				case u > lastPK:
+					c = 1
+				case u < lastPK:
+					c = -1
+				}
+			}
+			lastPK = u
+			return c, true
+		}
+		s, err := v.ToInt64()
+		if err != nil {
+			return 0, false
+		}
+		c := 0
+		if len(run) > 0 {
+			switch {
+			case s > lastPKs:
+				c = 1
+			case s < lastPKs:
+				c = -1
+			}
+		}
+		lastPKs = s
+		return c, true
+	}
+	flush := func() error {
+		switch len(run) {
+		case 0:
+			return nil
+		case 1:
+			if _, err := execParsedQuery(tp.Update, run[0].bindvars, executor); err != nil {
+				return err
+			}
+		default:
+			var buf strings.Builder
+			buf.Grow(int(runSize))
+			buf.WriteString(bu.prefix)
+			for i, col := range bu.setCols {
+				if i > 0 {
+					buf.WriteString(", ")
+				}
+				buf.WriteString(col)
+				buf.WriteString("=case ")
+				buf.WriteString(bu.pkCol)
+				for _, row := range run {
+					buf.WriteString(" when ")
+					row.pk.EncodeSQLStringBuilder(&buf)
+					buf.WriteString(" then ")
+					sqlparser.EncodeValue(&buf, row.bindvars[bu.setBindVars[i]])
+				}
+				buf.WriteString(" end")
+			}
+			buf.WriteString(" where ")
+			buf.WriteString(bu.pkCol)
+			buf.WriteString(" in (")
+			for i, row := range run {
+				if i > 0 {
+					buf.WriteString(", ")
+				}
+				row.pk.EncodeSQLStringBuilder(&buf)
+			}
+			buf.WriteString(") order by ")
+			buf.WriteString(bu.pkCol)
+			if dir < 0 {
+				buf.WriteString(" desc")
+			}
+			tp.Stats.BulkQueryCount.Add("update", 1)
+			if _, err := executor(buf.String()); err != nil {
+				return err
+			}
+		}
+		run = run[:0]
+		runSize = baseSize
+		dir = 0
+		return nil
+	}
+	runSize = baseSize
+	for _, change := range rowChanges {
+		if change.GetBefore() == nil || change.GetAfter() == nil || tp.isPartial(change) {
+			if err := flush(); err != nil {
+				return nil, err
+			}
+			if _, err := tp.applyChange(change, executor); err != nil {
+				return nil, err
+			}
+			continue
+		}
+		bindvars := make(map[string]*querypb.BindVariable, 2*len(tp.Fields))
+		beforeVals := sqltypes.MakeRowTrusted(tp.Fields, change.Before)
+		afterVals := sqltypes.MakeRowTrusted(tp.Fields, change.After)
+		if len(beforeVals) != len(tp.Fields) || len(afterVals) != len(tp.Fields) {
+			return nil, vterrors.Errorf(vtrpcpb.Code_FAILED_PRECONDITION,
+				"vreplication: row change for table %s does not match its %d fields", tp.TargetName, len(tp.Fields))
+		}
+		var rowSize int64
+		for i, field := range tp.Fields {
+			bv, err := tp.bindFieldVal(field, &beforeVals[i])
+			if err != nil {
+				return nil, err
+			}
+			bindvars["b_"+field.Name] = bv
+			bv, err = tp.bindFieldVal(field, &afterVals[i])
+			if err != nil {
+				return nil, err
+			}
+			bindvars["a_"+field.Name] = bv
+			rowSize += int64(len(bv.Value))*2 + 16
+		}
+		pkBV := bindvars[bu.pkBindVar]
+		if pkBV == nil || tp.pkChanged(bindvars) {
+			if err := flush(); err != nil {
+				return nil, err
+			}
+			if _, err := tp.applyChange(change, executor); err != nil {
+				return nil, err
+			}
+			continue
+		}
+		pk, err := sqltypes.BindVariableToValue(pkBV)
+		if err != nil {
+			return nil, err
+		}
+		rowSize += int64(len(bu.setCols))*(int64(len(pk.Raw()))+12) + int64(len(pk.Raw())) + 2
+		c, ok := comparePK(pk)
+		if !ok {
+			if err := flush(); err != nil {
+				return nil, err
+			}
+			if _, err := tp.applyChange(change, executor); err != nil {
+				return nil, err
+			}
+			continue
+		}
+		if len(run) > 0 && (c == 0 || (dir != 0 && c != dir) || len(run) >= maxBulkUpdateRows || runSize+rowSize > maxQuerySize) {
+			if err := flush(); err != nil {
+				return nil, err
+			}
+			c = 0
+		}
+		if len(run) > 0 && dir == 0 {
+			dir = c
+		}
+		run = append(run, pendingRow{pk: pk, bindvars: bindvars})
+		runSize += rowSize
+	}
+	if err := flush(); err != nil {
+		return nil, err
+	}
+	return &sqltypes.Result{}, nil
+}
