diff --git a/perf-findings/harness/V2/bulk.lua b/perf-findings/harness/V2/bulk.lua
new file mode 100644
index 0000000000..53ec23a335
--- /dev/null
+++ b/perf-findings/harness/V2/bulk.lua
@@ -0,0 +1,35 @@
+-- Large-transaction workload on bulk1 (200k rows, ids 1..200000).
+--   --mode=upd : UPDATE bulk1 SET k=k+1 WHERE id BETWEEN r AND r+N-1        (one N-row UPDATE row event)
+--   --mode=del : DELETE the N-row range and re-INSERT it with one multi-row INSERT (N-row DELETE + N-row INSERT events)
+sysbench.cmdline.options = {
+  rows = {"rows per transaction", 100},
+  mode = {"upd or del", "upd"},
+  tables = {"ignored", 4},
+  table_size = {"ignored", 200000},
+}
+
+function thread_init()
+  drv = sysbench.sql.driver()
+  con = drv:connect()
+end
+
+function thread_done()
+  con:disconnect()
+end
+
+function event()
+  local n = sysbench.opt.rows
+  local r = sysbench.rand.uniform(1, 200000 - n)
+  if sysbench.opt.mode == "upd" then
+    con:query(string.format("UPDATE bulk1 SET k=k+1 WHERE id BETWEEN %d AND %d", r, r + n - 1))
+    return
+  end
+  con:query("BEGIN")
+  con:query(string.format("DELETE FROM bulk1 WHERE id BETWEEN %d AND %d", r, r + n - 1))
+  local vals = {}
+  for i = r, r + n - 1 do
+    vals[#vals + 1] = string.format("(%d,%d,'%s','%s')", i, i % 1000, sysbench.rand.string(string.rep("#", 60)), sysbench.rand.string(string.rep("#", 30)))
+  end
+  con:query("INSERT INTO bulk1 (id,k,c,pad) VALUES " .. table.concat(vals, ","))
+  con:query("COMMIT")
+end
