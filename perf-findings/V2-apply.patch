+// TestVPlayerBuffersRowChangesAcrossRowEvents confirms that in batch mode the
+// vplayer combines the row changes of consecutive row events of the same table
+// and shape, e.g. single-row INSERTs of consecutive source transactions merged
+// into one target transaction, into one bulk statement, and that it applies
+// the buffered changes in order before a row event of another shape and
+// before the commit.
+func TestVPlayerBuffersRowChangesAcrossRowEvents(t *testing.T) {
+	fields := []*querypb.Field{
+		{Name: "id", Type: querypb.Type_INT64},
+		{Name: "v", Type: querypb.Type_VARCHAR},
+	}
+	tp := buildBulkUpdateTestPlan(t, "select * from t1", fields)
+	stats := binlogplayer.NewStats()
+	t.Cleanup(stats.Stop)
+	dbClient := newVDBClient(binlogplayer.NewMockDBClient(t), stats, vttablet.DefaultVReplicationConfig.RelayLogMaxItems)
+	dbClient.maxBatchSize = 1 << 20
+	var executed []string
+	committed := 0
+	vp := &vplayer{
+		vr: &vreplicator{
+			id:             1,
+			dbClient:       dbClient,
+			stats:          stats,
+			workflowConfig: vttablet.DefaultVReplicationConfig,
+		},
+		batchMode:  true,
+		tablePlans: map[string]*TablePlan{"t1": tp},
+		query: func(ctx context.Context, sql string) (*sqltypes.Result, error) {
+			executed = append(executed, sql)
+			return &sqltypes.Result{}, nil
+		},
+		commit: func() error {
+			committed++
+			dbClient.InTransaction = false
+			return nil
+		},
+	}
+	row := func(id int64, v string) *querypb.Row {
+		return sqltypes.RowToProto3([]sqltypes.Value{sqltypes.NewInt64(id), sqltypes.NewVarChar(v)})
+	}
+	rowEvent := func(change *binlogdatapb.RowChange) *binlogdatapb.VEvent {
+		return &binlogdatapb.VEvent{Type: binlogdatapb.VEventType_ROW, RowEvent: &binlogdatapb.RowEvent{TableName: "t1", RowChanges: []*binlogdatapb.RowChange{change}}}
+	}
+	events := []*binlogdatapb.VEvent{
+		{Type: binlogdatapb.VEventType_BEGIN},
+		rowEvent(&binlogdatapb.RowChange{After: row(1, "a")}),
+		// The next source transaction; its BEGIN and COMMIT were merged away.
+		{Type: binlogdatapb.VEventType_GTID, Gtid: "MySQL56/33333333-3333-3333-3333-333333333333:1-5"},
+		rowEvent(&binlogdatapb.RowChange{After: row(2, "b")}),
+		rowEvent(&binlogdatapb.RowChange{After: row(3, "c")}),
+		rowEvent(&binlogdatapb.RowChange{Before: row(2, "b"), After: row(2, "x")}),
+		rowEvent(&binlogdatapb.RowChange{Before: row(3, "c"), After: row(3, "y")}),
+		rowEvent(&binlogdatapb.RowChange{Before: row(1, "a")}),
+		{Type: binlogdatapb.VEventType_COMMIT},
+	}
+	for _, ev := range events {
+		require.NoError(t, vp.applyEvent(t.Context(), ev, false))
+	}
+	require.Len(t, executed, 4)
+	assert.Equal(t, []string{
+		"insert into t1(id,v) values (1,'a'), (2,'b'), (3,'c')",
+		"update t1 set v=case id when 2 then 'x' when 3 then 'y' end where id in (2, 3) order by id",
+		"delete from t1 where id=1",
+	}, executed[:3])
+	assert.Contains(t, executed[3], "update _vt.vreplication set pos=")
+	assert.Equal(t, 1, committed)
+	assert.Nil(t, vp.pending.tplan)
+}
