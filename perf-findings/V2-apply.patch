+func TestBuildPlayerPlanBulkUpdate(t *testing.T) {
+	fields := []*querypb.Field{
+		{Name: "id", Type: querypb.Type_INT64},
+		{Name: "c2", Type: querypb.Type_VARCHAR},
+		{Name: "c3", Type: querypb.Type_INT32},
+	}
+	testcases := []struct {
+		name        string
+		filter      string
+		wantCols    []string
+		wantBVs     []string
+		wantNoPlan  bool
+		wantNotElig bool
+	}{{
+		name:     "select star",
+		filter:   "select * from t1",
+		wantCols: []string{"c2", "c3"},
+		wantBVs:  []string{"a_c2", "a_c3"},
+	}, {
+		name:     "explicit columns with a rename",
+		filter:   "select id, c2 as x, c3 from t1",
+		wantCols: []string{"x", "c3"},
+		wantBVs:  []string{"a_c2", "a_c3"},
+	}, {
+		name:       "expression",
+		filter:     "select id, concat(c2, 'x') as c2 from t1",
+		wantNoPlan: true,
+	}, {
+		name:       "aggregation",
+		filter:     "select id, count(*) as c2 from t1 group by id",
+		wantNoPlan: true,
+	}}
+	for _, tc := range testcases {
+		t.Run(tc.name, func(t *testing.T) {
+			tp := buildBulkUpdateTestPlan(t, tc.filter, fields)
+			if tc.wantNoPlan {
+				assert.Nil(t, tp.BulkUpdate)
+				return
+			}
+			require.NotNil(t, tp.BulkUpdate)
+			assert.Equal(t, tc.wantCols, tp.BulkUpdate.setCols)
+			assert.Equal(t, tc.wantBVs, tp.BulkUpdate.setBindVars)
+			assert.Equal(t, "b_id", tp.BulkUpdate.pkBindVar)
+		})
+	}
+}
