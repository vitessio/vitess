+)
+
+// TestPlayerBatchModeBulkUpdate confirms that in batch mode the update-shaped
+// changes of a multi-row UPDATE are applied as one UPDATE statement per run
+// of monotonic primary keys, in the source's row order, and that the target
+// ends up with the same data as the source. The first UPDATE shifts a unique
+// key in descending id order: applying it in ascending order would hit a
+// duplicate key error, so it checks that the bulk statement keeps the order.
+func TestPlayerBatchModeBulkUpdate(t *testing.T) {
+	oldVreplicationExperimentalFlags := vttablet.DefaultVReplicationConfig.ExperimentalFlags
+	vttablet.DefaultVReplicationConfig.ExperimentalFlags = vttablet.VReplicationExperimentalFlagVPlayerBatching
+	// The framework helpers run on t.Context(), which is canceled before
+	// t.Cleanup callbacks run, so teardown uses defer.
+	defer func() {
+		vttablet.DefaultVReplicationConfig.ExperimentalFlags = oldVreplicationExperimentalFlags
+	}()
+
+	defer deleteTablet(addTablet(100))
+	schema := "(id bigint, uk int, c varchar(20), d datetime(3), dc decimal(10,2), b varbinary(10), e enum('x','y','z'), n int, primary key(id), unique key(uk))"
+	execStatements(t, []string{
+		"create table t1" + schema,
+		fmt.Sprintf("create table %s.t1%s", vrepldb, schema),
+	})
+	defer execStatements(t, []string{
+		"drop table t1",
+		fmt.Sprintf("drop table %s.t1", vrepldb),
+	})
+
+	filter := &binlogdatapb.Filter{
+		Rules: []*binlogdatapb.Rule{{
+			Match:  "t1",
+			Filter: "select * from t1",
+		}},
+	}
+	bls := &binlogdatapb.BinlogSource{
+		Keyspace: env.KeyspaceName,
+		Shard:    env.ShardName,
+		Filter:   filter,
+		OnDdl:    binlogdatapb.OnDDLAction_IGNORE,
+	}
+	cancel, vrID := startVReplication(t, bls, "")
+	defer cancel()
+	stats := globalStats.controllers[int32(vrID)].blpStats
+
+	execStatements(t, []string{
+		"insert into t1 values (1, 10, 'a', '2020-01-01 00:00:00.123', 1.50, 'x1', 'x', 1), (2, 20, 'b', '2020-01-02 00:00:00', 2.50, 'x2', 'y', null), (3, 30, 'it''s', null, -3.25, null, 'z', 3)",
+	})
+	expectNontxQueries(t, qh.Expect("/insert into t1"), recvTimeout)
+
+	// Descending ids: every row takes the unique key value of the row after it.
+	execStatements(t, []string{"update t1 set uk = uk + 10 order by id desc"})
+	expectNontxQueries(t, qh.Expect(
+		"/^update t1 set uk=case id when 3 then 40 when 2 then 30 when 1 then 20 end, c=case id when 3 then 'it\\\\'s' .* where id in \\(3, 2, 1\\) order by id desc$",
+	), recvTimeout)
+
+	// Ascending ids, every column type changes, NULLs in both directions.
+	execStatements(t, []string{
+		"update t1 set c = concat(c, 'é'), d = coalesce(d + interval 1 second, '2021-01-01'), dc = dc * 2, b = if(b is null, 0x00ff, null), e = 'y', n = if(n is null, 7, null) where id in (1, 2, 3)",
+	})
+	expectNontxQueries(t, qh.Expect("/^update t1 set uk=case id when 1 then 20 when 2 then 30 when 3 then 40 end, .* where id in \\(1, 2, 3\\) order by id$"), recvTimeout)
+
+	want := [][]string{
+		{"1", "20", "aé", "2020-01-01 00:00:01.123", "3.00", "", "y", ""},
+		{"2", "30", "bé", "2020-01-02 00:00:01.000", "5.00", "", "y", "7"},
+		{"3", "40", "it'sé", "2021-01-01 00:00:00.000", "-6.50", "\x00\xff", "y", ""},
+	}
+	expectData(t, "t1", want)
+	expectQueryResult(t, "select id, uk, c, d, dc, b, e, n from vttest.t1", want)
+	require.Eventually(t, func() bool {
+		return stats.BulkQueryCount.Counts()["update"] == 2
+	}, 30*time.Second, 100*time.Millisecond, "bulk update count: %v", stats.BulkQueryCount.Counts())
+}
