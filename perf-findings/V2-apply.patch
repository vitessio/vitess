+#!/bin/bash
+# One round of drain tests for the label prefix $1 (each test takes the bench lock separately).
+P=$1
+D=/home/vt/perf/V2
+L="flock -o /home/vt/perf/bench.lock"
+W=${WORKLOADS:-"wo ins upd wide b100 b1000 d100"}
+for w in $W; do
+  case $w in
+    wo) $L $D/drain.sh $P-wo 60000 oltp_write_only --threads=16 ;;
+    ins) $L $D/drain.sh $P-ins 150000 oltp_insert --threads=16 ;;
+    ins1) $L $D/drain.sh $P-ins1 150000 oltp_insert --threads=16 --tables=1 ;;
+    upd)$L $D/drain.sh $P-upd 150000 oltp_update_index --threads=16 ;;
+    wide) $L $D/drain.sh $P-wide2 40000 $D/wide.lua --threads=16 ;;
+    b100) $L $D/drain.sh $P-b100 3000 $D/bulk.lua --threads=8 --rows=100 --mode=upd ;;
+    b1000) $L $D/drain.sh $P-b1000 300 $D/bulk.lua --threads=8 --rows=1000 --mode=upd ;;
+    d100) $L $D/drain.sh $P-d100 3000 $D/bulk.lua --threads=8 --rows=100 --mode=del ;;
+  esac
+  $D/c.sh purge-binlogs 5 >/dev/null 2>&1
+done
