+func TestApplyBulkUpdateChanges(t *testing.T) {
+	intFields := []*querypb.Field{
+		{Name: "id", Type: querypb.Type_INT64},
+		{Name: "v", Type: querypb.Type_VARCHAR},
+		{Name: "b", Type: querypb.Type_VARBINARY},
+	}
+	row := func(id int64, v string) *querypb.Row {
+		return sqltypes.RowToProto3([]sqltypes.Value{sqltypes.NewInt64(id), sqltypes.NewVarChar(v), sqltypes.NewVarBinary("x" + v)})
+	}
+	upd := func(id int64, from, to string) *binlogdatapb.RowChange {
+		return &binlogdatapb.RowChange{Before: row(id, from), After: row(id, to)}
+	}
+	apply := func(t *testing.T, tp *TablePlan, changes []*binlogdatapb.RowChange) []string {
+		var executed []string
+		_, err := tp.applyBulkUpdateChanges(changes, func(sql string) (*sqltypes.Result, error) {
+			executed = append(executed, sql)
+			return &sqltypes.Result{}, nil
+		}, 1<<20)
+		require.NoError(t, err)
+		return executed
+	}
+
+	t.Run("increasing PKs make one statement", func(t *testing.T) {
+		tp := buildBulkUpdateTestPlan(t, "select * from t1", intFields)
+		got := apply(t, tp, []*binlogdatapb.RowChange{upd(1, "a", "b"), upd(3, "c", "d"), upd(7, "e", "it's")})
+		assert.Equal(t, []string{
+			"update t1 set v=case id when 1 then 'b' when 3 then 'd' when 7 then 'it\\'s' end, " +
+				"b=case id when 1 then _binary'xb' when 3 then _binary'xd' when 7 then _binary'xit\\'s' end " +
+				"where id in (1, 3, 7) order by id",
+		}, got)
+		assert.EqualValues(t, 1, tp.Stats.BulkQueryCount.Counts()["update"])
+	})
+
+	t.Run("decreasing PKs keep the source order", func(t *testing.T) {
+		tp := buildBulkUpdateTestPlan(t, "select id, v from t1", intFields[:2])
+		got := apply(t, tp, []*binlogdatapb.RowChange{
+			{Before: sqltypes.RowToProto3([]sqltypes.Value{sqltypes.NewInt64(9), sqltypes.NewVarChar("a")}), After: sqltypes.RowToProto3([]sqltypes.Value{sqltypes.NewInt64(9), sqltypes.NewVarChar("b")})},
+			{Before: sqltypes.RowToProto3([]sqltypes.Value{sqltypes.NewInt64(2), sqltypes.NewVarChar("c")}), After: sqltypes.RowToProto3([]sqltypes.Value{sqltypes.NewInt64(2), sqltypes.NewVarChar("d")})},
+		})
+		assert.Equal(t, []string{"update t1 set v=case id when 9 then 'b' when 2 then 'd' end where id in (9, 2) order by id desc"}, got)
+	})
+
+	t.Run("a change of direction, a PK change and other shapes split the runs in order", func(t *testing.T) {
+		tp := buildBulkUpdateTestPlan(t, "select * from t1", intFields)
+		got := apply(t, tp, []*binlogdatapb.RowChange{
+			upd(1, "a", "b"),
+			upd(2, "a", "b"),
+			upd(1, "b", "c"), // direction change: 1,2 | 1
+			{Before: row(5, "a"), After: row(6, "a")}, // PK change: per-row delete + insert
+			{After: row(10, "n")},                     // insert
+			upd(11, "a", "b"),
+			upd(12, "a", "b"),
+		})
+		assert.Equal(t, []string{
+			"update t1 set v=case id when 1 then 'b' when 2 then 'b' end, b=case id when 1 then _binary'xb' when 2 then _binary'xb' end where id in (1, 2) order by id",
+			"update t1 set v='c', b=_binary'xc' where id=1",
+			"delete from t1 where id=5",
+			"insert into t1(id,v,b) values (6,'a',_binary'xa')",
+			"insert into t1(id,v,b) values (10,'n',_binary'xn')",
+			"update t1 set v=case id when 11 then 'b' when 12 then 'b' end, b=case id when 11 then _binary'xb' when 12 then _binary'xb' end where id in (11, 12) order by id",
+		}, got)
+	})
+
+	t.Run("statements are capped at maxBulkUpdateRows", func(t *testing.T) {
+		old := maxBulkUpdateRows
+		maxBulkUpdateRows = 2
+		t.Cleanup(func() { maxBulkUpdateRows = old })
+		tp := buildBulkUpdateTestPlan(t, "select id, v from t1", intFields[:2])
+		var changes []*binlogdatapb.RowChange
+		for i := int64(1); i <= 5; i++ {
+			changes = append(changes, &binlogdatapb.RowChange{
+				Before: sqltypes.RowToProto3([]sqltypes.Value{sqltypes.NewInt64(i), sqltypes.NewVarChar("a")}),
+				After:  sqltypes.RowToProto3([]sqltypes.Value{sqltypes.NewInt64(i), sqltypes.NewVarChar(fmt.Sprint(i))}),
+			})
+		}
+		assert.Equal(t, []string{
+			"update t1 set v=case id when 1 then '1' when 2 then '2' end where id in (1, 2) order by id",
+			"update t1 set v=case id when 3 then '3' when 4 then '4' end where id in (3, 4) order by id",
+			"update t1 set v='5' where id=5",
+		}, apply(t, tp, changes))
+	})
+
+	t.Run("ineligible field types use one UPDATE per row", func(t *testing.T) {
+		for _, fields := range [][]*querypb.Field{
+			{{Name: "id", Type: querypb.Type_VARCHAR}, {Name: "v", Type: querypb.Type_VARCHAR}},
+			{{Name: "id", Type: querypb.Type_INT64}, {Name: "v", Type: querypb.Type_FLOAT64}},
+			{{Name: "id", Type: querypb.Type_INT64}, {Name: "v", Type: querypb.Type_JSON}},
+		} {
+			tp := buildBulkUpdateTestPlan(t, "select * from t1", fields)
+			require.Nil(t, tp.BulkUpdate)
+		}
+		tp := buildBulkUpdateTestPlan(t, "select * from t1", []*querypb.Field{{Name: "id", Type: querypb.Type_INT64}, {Name: "v", Type: querypb.Type_FLOAT64}})
+		got := apply(t, tp, []*binlogdatapb.RowChange{
+			{Before: sqltypes.RowToProto3([]sqltypes.Value{sqltypes.NewInt64(1), sqltypes.NewFloat64(1.5)}), After: sqltypes.RowToProto3([]sqltypes.Value{sqltypes.NewInt64(1), sqltypes.NewFloat64(2.5)})},
+			{Before: sqltypes.RowToProto3([]sqltypes.Value{sqltypes.NewInt64(2), sqltypes.NewFloat64(1.5)}), After: sqltypes.RowToProto3([]sqltypes.Value{sqltypes.NewInt64(2), sqltypes.NewFloat64(3.5)})},
+		})
+		assert.Equal(t, []string{"update t1 set v=2.5 where id=1", "update t1 set v=3.5 where id=2"}, got)
+	})
+}
