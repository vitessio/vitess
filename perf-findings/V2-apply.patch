+#!/bin/bash
+# A/B drain rounds. Usage: ab.sh ROUNDS "cfg1 cfg2 ..." ; WORKLOADS env passes through to drainset.sh.
+# cfg names: base | prw1 | prw4 | prw8 | v2 | v2off
+D=/home/vt/perf/V2
+ROUNDS=$1; CFGS=$2
+for r in $(seq 1 "$ROUNDS"); do
+  for cfg in $CFGS; do
+    case $cfg in
+      base) export TABLET_BIN=/home/vt/bin-V2base VTTABLET_EXTRA_FLAGS="" ;;
+      prw1) export TABLET_BIN=/home/vt/bin-PR VTTABLET_EXTRA_FLAGS="" ;;
+      prw4) export TABLET_BIN=/home/vt/bin-PR VTTABLET_EXTRA_FLAGS="--vreplication-parallel-replication-workers=4" ;;
+      prw8) export TABLET_BIN=/home/vt/bin-PR VTTABLET_EXTRA_FLAGS="--vreplication-parallel-replication-workers=8" ;;
+      prv2w4) export TABLET_BIN=/home/vt/bin-PRV2 VTTABLET_EXTRA_FLAGS="--vreplication-parallel-replication-workers=4" ;;
+      v2a) export TABLET_BIN=/home/vt/bin-V2a VTTABLET_EXTRA_FLAGS="" ;;
+      v2) export TABLET_BIN=/home/vt/bin-V2 VTTABLET_EXTRA_FLAGS="" ;;
+      v2off) export TABLET_BIN=/home/vt/bin-V2 VTTABLET_EXTRA_FLAGS="${V2OFF_FLAGS:-}" ;;
+      *) echo "bad cfg $cfg"; exit 1 ;;
+    esac
+    $D/c.sh restart-tablets >/dev/null 2>&1
+    sleep 8
+    $D/waitstream.sh
+    $D/${SET:-drainset}.sh "$cfg-r$r"
+  done
+done
