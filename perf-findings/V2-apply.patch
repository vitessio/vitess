+#!/bin/bash
+# Busiest target mysqld thread CPU per updated row (20k rows) for each variant.
+cd "$(dirname "$0")"
+PID=/home/vt/perf/c40000/vt_0000000101/mysql.pid
+for r in 1 2; do
+  for f in m1 m2o m2 m4 m100o m100; do
+    /home/vt/perf/V2/thr.sh $PID | sort >a
+    t0=$(date +%s.%N)
+    mysql -S /home/vt/perf/c40000/vt_0000000101/mysql.sock -u vt_dba v2scratch <$f-r$r.sql
+    t1=$(date +%s.%N)
+    /home/vt/perf/V2/thr.sh $PID | sort >b
+    top=$(join a b | awk '{print $6-$3}' | sort -n -r | head -1)
+    echo "$f r$r wall=$(echo "$t1 - $t0" | bc)s busiest_thread=$(echo "$top * 10000 / 20000" | bc -l | cut -c1-5)us/row"
+  done
+done
