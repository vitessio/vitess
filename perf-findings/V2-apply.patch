@@ -0,0 +1,9 @@
+#!/bin/bash
+# Wait (max 90 s) until the target vplayer reports a finite lag, i.e. the stream is running.
+for _ in $(seq 1 180); do
+  l=$(curl -s localhost:40101/debug/vars | python3 -c "import json,sys; print(json.load(sys.stdin).get('VReplicationLagSecondsMax', -1))" 2>/dev/null)
+  if [[ -n $l && $l -ge 0 && $l -lt 1000000 ]]; then exit 0; fi
+  sleep 0.5
+done
+echo "stream did not start" >&2
+exit 1
diff --git a/perf-findings/harness/V2/wide.lua b/perf-findings/harness/V2/wide.lua
new file mode 100644
index 0000000000..fe0d0e7668
--- /dev/null
+++ b/perf-findings/harness/V2/wide.lua
@@ -0,0 +1,28 @@
+-- Wide-row workload: each transaction updates one random wide1 row (3 columns), deletes one random row and re-inserts it (table size stays constant).
+-- Row images are ~2.3 KB (16 varchar(64), 4 bigint, 2 datetime, decimal, 800 B text).
+function thread_init()
+  drv = sysbench.sql.driver()
+  con = drv:connect()
+end
+
+function thread_done()
+  con:disconnect()
+end
+
+local function s64()
+  return sysbench.rand.string(string.rep("@", 32))
+end
+
+function event()
+  local id = sysbench.rand.uniform(1, 50000)
+  con:query("BEGIN")
+  con:query(string.format("UPDATE wide1 SET k=k+1, c01='%s', n01=n01+1 WHERE id=%d", s64(), id))
+  local id2 = sysbench.rand.uniform(1, 50000)
+  con:query(string.format("DELETE FROM wide1 WHERE id=%d", id2))
+  con:query(string.format(
+    "INSERT INTO wide1 (id,k,c01,c02,c03,c04,c05,c06,c07,c08,c09,c10,c11,c12,c13,c14,c15,c16,n01,n02,n03,n04,dec1,t1) " ..
+    "VALUES (%d,%d,'%s','%s','%s','%s','%s','%s','%s','%s','%s','%s','%s','%s','%s','%s','%s','%s',%d,%d,%d,%d,%d.25,'%s')",
+    id2, id, s64(), s64(), s64(), s64(), s64(), s64(), s64(), s64(), s64(), s64(), s64(), s64(), s64(), s64(), s64(), s64(),
+    id, id, id, id, id, string.rep(s64(), 25)))
+  con:query("COMMIT")
+end
