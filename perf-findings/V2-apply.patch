diff --git a/perf-findings/harness/V2/gen2.py b/perf-findings/harness/V2/gen2.py
new file mode 100644
index 0000000000..59ceb72591
--- /dev/null
+++ b/perf-findings/harness/V2/gen2.py
@@ -0,0 +1,34 @@
+import random
+
+
+def s(n):
+    return ''.join(random.choice('abcdefghij') for _ in range(n))
+
+
+def rowset(seed):
+    random.seed(seed)
+    return [(i, random.randint(1, 1000000), s(119), s(59)) for i in range(1000, 21000)]
+
+
+def case_file(name, rows, n, order):
+    with open(name, 'w') as f:
+        f.write('begin;\n')
+        for j in range(0, len(rows), n):
+            ch = rows[j:j + n]
+            if len(ch) == 1:
+                i, k, c, p = ch[0]
+                f.write("update t set k=%d, c='%s', pad='%s' where id=%d;\n" % (k, c, p, i))
+                continue
+            parts = []
+            for col, idx, q in (('k', 1, False), ('c', 2, True), ('pad', 3, True)):
+                w = ' '.join("when %d then %s" % (x[0], ("'%s'" % x[idx]) if q else x[idx]) for x in ch)
+                parts.append("%s=case id %s end" % (col, w))
+            f.write("update t set %s where id in (%s)%s;\n" % (', '.join(parts), ','.join(str(x[0]) for x in ch), ' order by id' if order else ''))
+        f.write('commit;\n')
+
+
+seed = 500
+for r in (1, 2):
+    for (n, order) in ((1, False), (2, True), (2, False), (4, False), (100, True), (100, False)):
+        seed += 1
+        case_file('m%d%s-r%d.sql' % (n, 'o' if order else '', r), rowset(seed), n, order)
diff --git a/perf-findings/harness/V2/run.sh b/perf-findings/harness/V2/run.sh
