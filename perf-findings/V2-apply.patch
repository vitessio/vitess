index 0000000000..e8ec5fca97
--- /dev/null
+++ b/perf-findings/harness/V2/run.sh
@@ -0,0 +1,70 @@
+#!/bin/bash
+# Concurrent running-phase test: run a sysbench workload on the source mysqld while the workflow runs,
+# sample GTID lag every second, then wait for the target to catch up.
+# Usage: run.sh LABEL TIME RATE SYSBENCH_ARGS...
+#   RATE: sysbench --rate (0 = unlimited). SYSBENCH_ARGS e.g. "oltp_write_only --threads=16" or "/home/vt/perf/V2/bulk.lua --threads=8 --rows=100"
+# Env: PROF=seconds  -> capture target (and source) vttablet CPU profile starting 5 s into the run.
+#      NOLOCK=1 -> don't take the bench lock (caller holds it).
+set -uo pipefail
+LABEL=$1; TIME=$2; RATE=$3; shift 3
+D=/home/vt/perf/V2
+OUT=$D/out/$LABEL
+rm -rf "$OUT"; mkdir -p "$OUT"
+SSOCK=/home/vt/perf/c40000/vt_0000000100/mysql.sock
+TSOCK=/home/vt/perf/c40000/vt_0000000101/mysql.sock
+q() { mysql -N -S "$1" -u vt_dba -e "$2" 2>/dev/null; }
+srcseq() { q $SSOCK "select @@global.gtid_executed" | tr -d '\n' | sed -E 's/.*-([0-9]+)$/\1/'; }
+tgtseq() { q $TSOCK "select pos from _vt.vreplication where workflow='wf'" | sed -E 's/.*-([0-9]+)$/\1/'; }
+status() { q "$1" "show global status where variable_name in ('Questions','Com_insert','Com_update','Com_delete','Com_commit','Com_begin','Com_select','Com_set_option','Com_rollback','Handler_commit','Innodb_rows_updated','Innodb_rows_inserted','Innodb_rows_deleted','Bytes_received')"; }
+
+uptime >"$OUT/uptime0"
+"$D/c.sh" cpu >"$OUT/cpu0"
+status $TSOCK >"$OUT/tstat0"
+status $SSOCK >"$OUT/sstat0"
+s0=$(srcseq); g0=$(tgtseq)
+curl -s localhost:40101/debug/vars >"$OUT/vars0"
+# sampler
+(
+  t0=$(date +%s.%N)
+  while [[ ! -f $OUT/stop ]]; do
+    s=$(srcseq); g=$(tgtseq); l=$(curl -s localhost:40101/debug/vars | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('VReplicationLagSecondsMax',-1))" 2>/dev/null)
+    printf "%.1f %d %d %d %s\n" "$(echo "$(date +%s.%N) - $t0" | bc)" "$((s - s0))" "$((g - s0))" "$((s - g))" "$l" >>"$OUT/lag"
+    sleep 1
+  done
+) &
+SAMP=$!
+if [[ ${PROF:-0} -gt 0 ]]; then
+  (sleep 5; curl -s -o "$OUT/tgt.pprof" "http://localhost:40101/debug/pprof/profile?seconds=$PROF") &
+  (sleep 5; curl -s -o "$OUT/src.pprof" "http://localhost:40100/debug/pprof/profile?seconds=$PROF") &
+fi
+ts=$(date +%s.%N)
+sysbench --db-driver=mysql --mysql-socket=$SSOCK --mysql-user=vt_dba --mysql-db=vt_src --tables=4 --table-size=200000 \
+  --time="$TIME" --rate="$RATE" --rand-type=uniform --report-interval=0 --db-ps-mode=disable "$@" run >"$OUT/sysbench" 2>&1
+te=$(date +%s.%N)
+s1=$(srcseq)
+"$D/c.sh" cpu >"$OUT/cpu_gen"
+# wait for catch-up (max 300 s)
+for _ in $(seq 1 3000); do
+  g=$(tgtseq); [[ $g -ge $s1 ]] && break; sleep 0.1
+done
+tc=$(date +%s.%N)
+touch "$OUT/stop"; wait $SAMP 2>/dev/null
+wait
+"$D/c.sh" cpu >"$OUT/cpu1"
+status $TSOCK >"$OUT/tstat1"
+status $SSOCK >"$OUT/sstat1"
+curl -s localhost:40101/debug/vars >"$OUT/vars1"
+uptime >"$OUT/uptime1"
+N=$((s1 - s0))
+gen=$(echo "$te - $ts" | bc); cu=$(echo "$tc - $te" | bc)
+maxgap=$(awk 'BEGIN{m=0} $4>m{m=$4} END{print m}' "$OUT/lag")
+maxlag=$(awk 'BEGIN{m=0} $5>m && $5<1e9{m=$5} END{print m}' "$OUT/lag")
+{
+echo "$LABEL trx=$N gen=${gen}s src_rate=$(echo "$N / $gen" | bc)/s catchup_after_end=${cu}s eff_apply=$(echo "$N / ($gen + $cu)" | bc)/s max_gtid_gap=$maxgap max_lag_s=$maxlag load0=[$(sed 's/.*average: //' "$OUT/uptime0")] load1=[$(sed 's/.*average: //' "$OUT/uptime1")]"
+echo "  sysbench: $(grep -Eo 'transactions:.*|queries:.*' "$OUT/sysbench" | tr '\n' ' ')"
+paste -d' ' "$OUT/cpu0" "$OUT/cpu1" | awk -v r="$N" '{d=$4-$2; printf "  %-14s %7.2f s  %7.1f us/src-trx\n", $1, d, d*1e6/r}'
+echo "  target mysqld per src trx:"
+paste "$OUT/tstat0" "$OUT/tstat1" | awk -v r="$N" '{printf "    %-22s %9.3f\n", $1, ($4-$2)/r}'
+echo "  source per src trx:"
+paste "$OUT/sstat0" "$OUT/sstat1" | awk -v r="$N" '$1 ~ /Innodb_rows|Com_commit|Questions/ {printf "    %-22s %9.3f\n", $1, ($4-$2)/r}'
+} | tee "$OUT/summary"
