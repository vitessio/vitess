 		Stats:                   tpb.stats,
@@ -905,6 +906,51 @@ func (tpb *tablePlanBuilder) generateMultiDeleteStatement() *sqlparser.ParsedQue
 	)
 }
 
+// generateBulkUpdatePlan returns the metadata needed to apply several update-shaped
+// row changes of one row event as a single UPDATE statement, or nil if the plan is
+// not eligible. Only plain column copies keyed by a single PK column qualify:
+// grouped/aggregate plans, expressions, time zone conversions, extra source PK
+// columns and copy-phase (lastpk) plans keep using the per-row UPDATE. The field
+// types are checked by buildExecutionPlan (see bulkUpdatePlan.fieldsOK), as they
+// are only known once the FIELD event has been received.
+func (tpb *tablePlanBuilder) generateBulkUpdatePlan() *bulkUpdatePlan {
+	if tpb.workflowConfig.ExperimentalFlags&vttablet.VReplicationExperimentalFlagVPlayerBatching == 0 ||
+		tpb.onInsert != insertNormal || tpb.lastpk != nil ||
+		len(tpb.pkCols) != 1 || len(tpb.extraSourcePkCols) != 0 {
+		return nil
+	}
+	if tpb.source != nil && tpb.source.SourceTimeZone != "" && tpb.source.TargetTimeZone != "" {
+		return nil
+	}
+	pkRef, ok := tpb.pkCols[0].expr.(*sqlparser.ColName)
+	if !ok {
+		return nil
+	}
+	plan := &bulkUpdatePlan{
+		prefix:    "update " + sqlparser.String(tpb.name) + " set ",
+		pkCol:     sqlparser.String(tpb.pkCols[0].colName),
+		pkBindVar: "b_" + pkRef.Name.String(),
+	}
+	for _, cexpr := range tpb.colExprs {
+		if cexpr.isPK || cexpr.isGenerated {
+			continue
+		}
+		if cexpr.isGrouped || cexpr.operation != opExpr {
+			return nil
+		}
+		ref, ok := cexpr.expr.(*sqlparser.ColName)
+		if !ok {
+			return nil
+		}
+		plan.setCols = append(plan.setCols, sqlparser.String(cexpr.colName))
+		plan.setBindVars = append(plan.setBindVars, "a_"+ref.Name.String())
+	}
+	if len(plan.setCols) == 0 {
+		return nil
+	}
+	return plan
+}
