+package colldata
+
+import (
+	"encoding/binary"
+
+	"vitess.io/vitess/go/vt/vthash"
+)
+
+// hashBuffer batches the weights that a collation feeds to a hasher, so that
+// they reach the hasher in blocks instead of one codepoint at a time. The
+// hasher consumes a byte stream, so the resulting hash does not depend on how
+// the weights are batched: it is identical to writing each weight separately.
+// A hashBuffer must be flushed once all the weights have been written.
+type hashBuffer struct {
+	buf [64]byte
+	n   int
+}
+
+// flush is kept out of line so that the write helpers below stay inlinable.
+//
+//go:noinline
+func (b *hashBuffer) flush(hasher *vthash.Hasher) {
+	_, _ = hasher.Write(b.buf[:b.n])
+	b.n = 0
+}
+
+func (b *hashBuffer) write8(hasher *vthash.Hasher, w byte) {
+	if b.n >= len(b.buf) {
+		b.flush(hasher)
+	}
+	b.buf[b.n] = w
+	b.n++
+}
+
+// write16 writes w in big-endian order, the same bytes as
+// hasher.Write16(bits.ReverseBytes16(w)).
+func (b *hashBuffer) write16(hasher *vthash.Hasher, w uint16) {
+	if b.n > len(b.buf)-2 {
+		b.flush(hasher)
+	}
+	binary.BigEndian.PutUint16(b.buf[b.n:], w)
+	b.n += 2
+}
+
+// write32 writes w in big-endian order, the same bytes as
+// hasher.Write32(bits.ReverseBytes32(w)).
+func (b *hashBuffer) write32(hasher *vthash.Hasher, w uint32) {
+	if b.n > len(b.buf)-4 {
+		b.flush(hasher)
+	}
+	binary.BigEndian.PutUint32(b.buf[b.n:], w)
+	b.n += 4
+}
+
+// hashPadding8 writes count copies of the byte pad to the hasher.
+func hashPadding8(hasher *vthash.Hasher, pad byte, count int) {
+	var b hashBuffer
+	for ; count > 0; count-- {
+		b.write8(hasher, pad)
+	}
+	b.flush(hasher)
+}
+
+// writeBytes writes p, which must be at most len(b.buf) bytes long.
+func (b *hashBuffer) writeBytes(hasher *vthash.Hasher, p []byte) {
+	if b.n > len(b.buf)-len(p) {
+		b.flush(hasher)
+	}
+	b.n += copy(b.buf[b.n:], p)
+}
