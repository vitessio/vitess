+package grpctmclient
+
+import (
+	"context"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+
+	replicationdatapb "vitess.io/vitess/go/vt/proto/replicationdata"
+	tabletmanagerdatapb "vitess.io/vitess/go/vt/proto/tabletmanagerdata"
+	tabletmanagerservicepb "vitess.io/vitess/go/vt/proto/tabletmanagerservice"
+	topodatapb "vitess.io/vitess/go/vt/proto/topodata"
+	"vitess.io/vitess/go/vt/topo"
+)
+
+// fullStatusServer is a minimal tablet manager that answers FullStatus.
+type fullStatusServer struct {
+	tabletmanagerservicepb.UnimplementedTabletManagerServer
+}
+
+func (fullStatusServer) FullStatus(context.Context, *tabletmanagerdatapb.FullStatusRequest) (*tabletmanagerdatapb.FullStatusResponse, error) {
+	return &tabletmanagerdatapb.FullStatusResponse{Status: &replicationdatapb.FullStatus{ServerId: 1}}, nil
+}
+
+// closedPort returns a localhost TCP port that nothing listens on, so a dial
+// gets "connection refused".
+func closedPort(t *testing.T) int32 {
+	lis, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	port := int32(lis.Addr().(*net.TCPAddr).Port)
+	require.NoError(t, lis.Close())
+	return port
+}
+
+// maxFailFastDuration is how long FullStatus may take to report a tablet whose
+// gRPC port refuses connections. VTOrc calls FullStatus with a
+// topo.RemoteOperationTimeout (15 s) deadline; a refused connection must fail
+// well before that instead of waiting for the deadline.
+const maxFailFastDuration = 2 * time.Second
+
+// TestFullStatusFailsFastOnRefusedConnection is the validation test for bug #13
+// (VTOrc FullStatus hangs ~15 s on a refused connection). The tablet manager
+// client dials with WaitForReady, so an RPC to a dead vttablet (host alive,
+// port closed) blocks until the caller's deadline instead of failing with
+// Unavailable.
+func TestFullStatusFailsFastOnRefusedConnection(t *testing.T) {
+	client := NewClient()
+	t.Cleanup(client.Close)
+	tablet := &topodatapb.Tablet{
+		Hostname: "127.0.0.1",
+		PortMap:  map[string]int32{"grpc": closedPort(t)},
+	}
+
+	// Same deadline VTOrc uses (inst.fullStatus).
+	ctx, cancel := context.WithTimeout(t.Context(), topo.RemoteOperationTimeout)
+	defer cancel()
+	start := time.Now()
+	_, err := client.FullStatus(ctx, tablet)
+	elapsed := time.Since(start)
+	require.Error(t, err)
+	assert.Less(t, elapsed, maxFailFastDuration, "FullStatus to a refused port took %v (err: %v)", elapsed, err)
+}
+
+// TestFullStatusFailsFastAfterTabletDies covers the VTOrc scenario for bug #13:
+// VTOrc has a pooled connection to a healthy tablet, then the vttablet process
+// dies (kill -9). The next poll must fail fast rather than wait for the deadline.
+func TestFullStatusFailsFastAfterTabletDies(t *testing.T) {
+	lis, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	port := int32(lis.Addr().(*net.TCPAddr).Port)
+	server := grpc.NewServer()
+	tabletmanagerservicepb.RegisterTabletManagerServer(server, fullStatusServer{})
+	go server.Serve(lis) // nolint:errcheck
+	t.Cleanup(server.Stop)
+
+	client := NewClient()
+	t.Cleanup(client.Close)
+	tablet := &topodatapb.Tablet{
+		Hostname: "127.0.0.1",
+		PortMap:  map[string]int32{"grpc": port},
+	}
+
+	ctx, cancel := context.WithTimeout(t.Context(), topo.RemoteOperationTimeout)
+	defer cancel()
+	status, err := client.FullStatus(ctx, tablet)
+	require.NoError(t, err)
+	require.EqualValues(t, 1, status.ServerId)
+
+	// The tablet process dies: its listener and connections go away.
+	server.Stop()
+
+	ctx2, cancel2 := context.WithTimeout(t.Context(), topo.RemoteOperationTimeout)
+	defer cancel2()
+	start := time.Now()
+	_, err = client.FullStatus(ctx2, tablet)
+	elapsed := time.Since(start)
+	require.Error(t, err)
+	assert.Less(t, elapsed, maxFailFastDuration, "FullStatus to a dead tablet took %v (err: %v)", elapsed, err)
+}
