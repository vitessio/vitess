+#!/bin/bash
+# c.sh ARGS: run the VAL-D copy of the cluster harness (BASE 40000) as the vt user.
+exec setpriv --reuid=vt --regid=vt --init-groups env HOME=/home/vt BASE=40000 NAME=c40000 \
