+#!/bin/bash
+# runvt.sh PKGDIR BINARY RUNREGEX LOG [extra args]: run a MySQL-backed test binary as vt,
+# write the full output to LOG and print the test result lines.
+PKG=$1; BINARY=$2; RE=$3; LOG=$4; shift 4
+cd "$PKG" || exit 1
+runuser -u vt -- env HOME=/home/vt VTROOT=/home/vt VT_MYSQL_ROOT=/usr VTDATAROOT=/home/vt/VAL-D/data \
+  PATH=/home/vt/bin:/usr/sbin:/usr/bin:/bin "$BINARY" -test.run "$RE" -test.v "$@" >"$LOG" 2>&1
+rc=$?
+grep -E -A12 "^(=== RUN|--- (FAIL|PASS)|FAIL|PASS|ok)|Error Trace|panic" "$LOG" | grep -vE "INF|WRN|ERR" | head -80
+echo "rc=$rc"
diff --git a/go/test/valrepro/scripts/vtorc_failover.sh b/go/test/valrepro/scripts/vtorc_failover.sh
