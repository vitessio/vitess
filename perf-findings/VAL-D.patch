index 0000000000..d6c672b156
--- /dev/null
+++ b/go/test/valrepro/scripts/vtorc_failover.sh
@@ -0,0 +1,68 @@
+#!/bin/bash
+# vtorc_failover.sh TAG [vtorc flags...]
+# Bug #13 end-to-end: fresh 3-tablet semi_sync shard (BASE 40000) + VTOrc, kill -9 the primary's
+# vttablet+mysqld_safe+mysqld (host death), then report, relative to the kill:
+#   - VTOrc's DeadPrimary detection and ERS completion,
+#   - how long VTOrc keeps holding the shard lock (etcd lock key under the shard) after ERS,
+#   - VTOrc discovery calls to the dead primary that took >= 10 s.
+S=/tmp/claude-0/-home-user-vitess/d4e874e9-36db-544e-abf5-6cb4fd4871ca/scratchpad/VAL-D
+TAG=$1; shift
+D=/home/vt/VAL-D/c40000
+V="/home/vt/bin/vtctldclient --server localhost:40021"
+OUT=$S/out/$TAG; mkdir -p "$OUT"
+REPLICAS=2 DURABILITY=semi_sync bash $S/c.sh down >/dev/null 2>&1
+REPLICAS=2 DURABILITY=semi_sync bash $S/c.sh up >/dev/null 2>&1 || { echo "up failed"; exit 1; }
+setpriv --reuid=vt --regid=vt --init-groups env HOME=/home/vt nohup /home/vt/bin/vtorc \
+  --topo-implementation etcd2 --topo-global-server-address localhost:40010 --topo-global-root /vitess/global \
+  --cell zone1 --port 40030 --log-format text --config-file-not-found-handling=ignore \
+  --sqlite-data-file $D/vtorc.db "$@" >$D/logs/vtorc.log 2>&1 </dev/null &
+echo $! >$D/vtorc.pid
+sleep 15; sleep "$(awk 'BEGIN{srand(); print rand()*6}')"
+
+PRIM=$($V GetTablets --keyspace sbtest --shard 0 | awk '$4=="primary"{print $1}')
+T=$D/vt_$(printf '%010d' $((10#${PRIM#zone1-})))
+# Poll the shard lock (etcd keys under the shard's locks dir) every 50 ms.
+(
+  prev=""
+  while :; do
+    k=$(etcdctl --endpoints localhost:40010 get --prefix --keys-only /vitess/global/keyspaces/sbtest/shards/0/locks 2>/dev/null | grep -c .)
+    [[ $k != "$prev" ]] && echo "$(date +%s.%N) $k" && prev=$k
+    sleep 0.05
+  done
+) >"$OUT/lock" &
+LP=$!
+sleep 1
+MPID=$(cat $T/mysql.pid)
+SAFE=$(ps -eo pid,args | awk -v f="$T/my.cnf" '$0 ~ "mysqld_safe" && index($0, f) {print $1}')
+TPID=$(ps -eo pid,args | awk -v p="--port $((40100 + 10#${PRIM#zone1-} - 100)) " '$0 ~ "vttablet" && index($0, p) {print $1}')
+T0=$(date +%s.%N)
+kill -9 $TPID $SAFE $MPID
+for _ in $(seq 1 600); do
+  NP=$($V GetTablets --keyspace sbtest --shard 0 2>/dev/null | awk '$4=="primary"{print $1}')
+  [[ -n $NP && $NP != "$PRIM" ]] && break
+  sleep 0.1
+done
+TNP=$(date +%s.%N)
+if [[ -n ${PRS:-} ]]; then
+  # An operator PRS right after the failover (needs the shard lock).
+  sleep 1
+  OTHER=$($V GetTablets --keyspace sbtest --shard 0 | awk -v p="$PRIM" -v n="$NP" '$1!=p && $1!=n {print $1}')
+  TP=$(date +%s.%N)
+  $V PlannedReparentShard sbtest/0 --new-primary "$OTHER" >"$OUT/prs" 2>&1; RC=$?
+  echo "  PRS to $OTHER issued at +$(echo "$TP - $T0" | bc)s rc=$RC took $(echo "$(date +%s.%N) - $TP" | bc)s: $(tail -1 "$OUT/prs" | cut -c1-150)"
+fi
+sleep 60
+kill $LP
+cp $D/logs/vtorc.log "$OUT/vtorc.log"
+rel() { echo "$1 - $T0" | bc; }
+ts() { date -d "$(echo "$1" | cut -c1-23)" +%s.%N; }
+echo "[$TAG] killed $PRIM at $(date -d @$T0 +%T.%3N); new primary $NP in topo at +$(rel $TNP)s"
+L=$OUT/vtorc.log
+line=$(grep -m1 -E "Analysis: DeadPrimary" $L); [[ -n $line ]] && echo "  DeadPrimary analysis     +$(rel "$(ts "$line")")s"
+line=$(grep -m1 "finished EmergencyReparentShard" $L); [[ -n $line ]] && echo "  ERS finished             +$(rel "$(ts "$line")")s"
+line=$(grep -m1 "Forcing refresh of all tablets post recovery" $L); [[ -n $line ]] && echo "  post-recovery refresh    +$(rel "$(ts "$line")")s"
+awk -v t0="$T0" '$1 >= t0 - 1 {printf "  shard lock keys=%s at %+.3fs\n", $2, $1 - t0}' "$OUT/lock"
+grep -E "exceeded InstancePollSeconds|Failed to discover" $L | grep "$PRIM" | while read -r l; do
+  echo "  +$(rel "$(ts "$l")")s $(echo "$l" | grep -oE "(took [0-9.]+s|Failed to discover [^ ]+ \(force: [a-z]+\))")"
+done
+kill "$(cat $D/vtorc.pid)" 2>/dev/null
