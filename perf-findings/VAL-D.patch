+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+// vtgaterestart is the reproduction harness for bug #12 (vtgate took ~40 s to
+// route to a restarted tablet). It runs read (and optionally write) load
+// through vtgate at one tablet type, kills and restarts one vttablet (mysqld
+// is kept) several times, and reports per trial:
+//
+//   - down:    kill -> the old process is gone, plus the extra -down time;
+//   - serving: restart -> the new vttablet reports TabletStateName=SERVING;
+//   - route:   SERVING -> the first query through vtgate that succeeds after
+//     the outage (the vtgate-side delay the bug claims is ~40 s).
+//
+// It must run as root: it relaunches the vttablet with the exact argv,
+// environment, owner and log file of the process it kills.
+package main
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"math/rand/v2"
+	"net/http"
+	"os"
+	"os/exec"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	_ "github.com/go-sql-driver/mysql"
+)
+
+type event struct {
+	start, end time.Time
+	err        string
+}
+
+var (
+	mu     sync.Mutex
+	events []event
+)
+
+func record(e event) {
+	mu.Lock()
+	events = append(events, e)
+	mu.Unlock()
+}
+
+func takeEvents() []event {
+	mu.Lock()
+	defer mu.Unlock()
+	evs := events
+	events = nil
+	return evs
+}
+
+func tabletState(web int) string {
+	client := http.Client{Timeout: 500 * time.Millisecond}
+	resp, err := client.Get(fmt.Sprintf("http://127.0.0.1:%d/debug/vars", web))
+	if err != nil {
+		return ""
+	}
+	defer resp.Body.Close()
+	var vars struct {
+		TabletStateName string
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&vars); err != nil {
+		return ""
+	}
+	return vars.TabletStateName
+}
+
+type proc struct {
+	exe       string
+	argv, env []string
+	log       string
+	uid, gid  uint32
+}
+
+func inspect(pid int) (*proc, error) {
+	cmdline, err := os.ReadFile(fmt.Sprintf("/proc/%d/cmdline", pid))
+	if err != nil {
+		return nil, err
+	}
+	environ, err := os.ReadFile(fmt.Sprintf("/proc/%d/environ", pid))
+	if err != nil {
+		return nil, err
+	}
+	log, err := os.Readlink(fmt.Sprintf("/proc/%d/fd/1", pid))
+	if err != nil {
+		return nil, err
+	}
+	exe, err := os.Readlink(fmt.Sprintf("/proc/%d/exe", pid))
+	if err != nil {
+		return nil, err
+	}
+	var st syscall.Stat_t
+	if err := syscall.Stat(fmt.Sprintf("/proc/%d", pid), &st); err != nil {
+		return nil, err
+	}
+	split := func(b []byte) []string { return strings.Split(strings.TrimRight(string(b), "\x00"), "\x00") }
+	return &proc{exe: exe, argv: split(cmdline), env: split(environ), log: log, uid: st.Uid, gid: st.Gid}, nil
+}
+
+func (p *proc) start() error {
+	logf, err := os.OpenFile(p.log, os.O_WRONLY|os.O_APPEND|os.O_CREATE, 0o644)
+	if err != nil {
+		return err
+	}
+	cmd := exec.Command(p.exe, p.argv[1:]...)
+	cmd.Env = p.env
+	cmd.Stdout = logf
+	cmd.Stderr = logf
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setsid: true, Credential: &syscall.Credential{Uid: p.uid, Gid: p.gid}}
+	if err := cmd.Start(); err != nil {
+		return err
+	}
+	go func() {
+		_ = cmd.Wait()
+		logf.Close()
+	}()
+	return nil
+}
+
+// findPid returns the pid of the live process whose command line contains
+// match (pid files are not reliable across kill -9).
+func findPid(match string) (int, error) {
+	dirs, err := os.ReadDir("/proc")
+	if err != nil {
+		return 0, err
+	}
+	for _, d := range dirs {
+		pid, err := strconv.Atoi(d.Name())
+		if err != nil || !alive(pid) {
+			continue
+		}
+		b, err := os.ReadFile(fmt.Sprintf("/proc/%d/cmdline", pid))
+		if err != nil {
+			continue
+		}
+		args := strings.ReplaceAll(string(b), "\x00", " ")
+		if strings.Contains(args, "vttablet") && strings.Contains(args, match) {
+			return pid, nil
+		}
+	}
+	return 0, fmt.Errorf("no live process matches %q", match)
+}
+
+// alive reports whether pid exists and is not a zombie.
+func alive(pid int) bool {
+	b, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+	if err != nil {
+		return false
+	}
+	s := string(b)
+	i := strings.LastIndexByte(s, ')')
+	return i >= 0 && i+2 < len(s) && s[i+2] != 'Z'
+}
+
+func main() {
+	dsn := flag.String("dsn", "root@tcp(127.0.0.1:40003)/sbtest@replica?timeout=2s&readTimeout=10s&writeTimeout=10s", "vtgate DSN; the database selects the tablet type")
+	write := flag.Bool("write", false, "run writes (the DSN must target the primary)")
+	threads := flag.Int("threads", 4, "load threads")
+	interval := flag.Duration("interval", 5*time.Millisecond, "per-thread query interval")
+	match := flag.String("match", "", "substring of the command line of the vttablet to restart, e.g. \"--port 40101 \"")
+	web := flag.Int("web", 0, "web port of that vttablet")
+	mode := flag.String("mode", "kill9", "kill9 (SIGKILL) or term (SIGTERM, graceful)")
+	down := flag.Duration("down", 0, "how long the vttablet stays down after its old process exited")
+	trials := flag.Int("trials", 5, "number of restarts")
+	settle := flag.Duration("settle", 5*time.Second, "error-free time required before each trial")
+	flag.Parse()
+
+	db, err := sql.Open("mysql", *dsn)
+	if err != nil {
+		panic(err)
+	}
+	db.SetMaxOpenConns(*threads * 2)
+	db.SetMaxIdleConns(*threads * 2)
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	var wg sync.WaitGroup
+	for range *threads {
+		wg.Go(func() {
+			t := time.NewTicker(*interval)
+			defer t.Stop()
+			for {
+				select {
+				case <-ctx.Done():
+					return
+				case <-t.C:
+				}
+				id := rand.IntN(1000) + 1
+				start := time.Now()
+				qctx, qcancel := context.WithTimeout(ctx, 5*time.Second)
+				var err error
+				if *write {
+					_, err = db.ExecContext(qctx, "insert into sbtest1(id, k, c, pad) values (?, 1, '', '') on duplicate key update k = k + 1", id)
+				} else {
+					var n int
+					err = db.QueryRowContext(qctx, "select count(*) from sbtest1 where id = ?", id).Scan(&n)
+				}
+				qcancel()
+				e := event{start: start, end: time.Now()}
+				if err != nil {
+					e.err = err.Error()
+				}
+				record(e)
+			}
+		})
+	}
+
+	fmt.Printf("# dsn=%s mode=%s down=%v threads=%d interval=%v\n", *dsn, *mode, *down, *threads, *interval)
+	fmt.Println("trial exit_s serving_s route_s outage_s errors first_error")
+	var routes []float64
+	for trial := 1; trial <= *trials; trial++ {
+		// Wait for an error-free window.
+		for {
+			takeEvents()
+			time.Sleep(*settle)
+			bad := 0
+			evs := takeEvents()
+			for _, e := range evs {
+				if e.err != "" {
+					bad++
+				}
+			}
+			if bad == 0 && len(evs) > 0 {
+				break
+			}
+			fmt.Printf("# waiting for an error-free window (%d/%d errors)\n", bad, len(evs))
+		}
+
+		pid, err := findPid(*match)
+		if err != nil {
+			panic(err)
+		}
+		p, err := inspect(pid)
+		if err != nil {
+			panic(err)
+		}
+		sig := syscall.SIGKILL
+		if *mode == "term" {
+			sig = syscall.SIGTERM
+		}
+		tKill := time.Now()
+		if err := syscall.Kill(pid, sig); err != nil {
+			panic(err)
+		}
+		for alive(pid) {
+			time.Sleep(5 * time.Millisecond)
+		}
+		tExit := time.Now()
+		time.Sleep(*down)
+		tStart := time.Now()
+		if err := p.start(); err != nil {
+			panic(err)
+		}
+		var tServing time.Time
+		for deadline := time.Now().Add(3 * time.Minute); time.Now().Before(deadline); {
+			if tabletState(*web) == "SERVING" {
+				tServing = time.Now()
+				break
+			}
+			time.Sleep(20 * time.Millisecond)
+		}
+		if tServing.IsZero() {
+			fmt.Printf("%d tablet not SERVING after 3m\n", trial)
+			os.Exit(1)
+		}
+		// Wait for the first success after the outage (at most 3 minutes).
+		var firstErr, firstOK time.Time
+		var nErr int
+		var firstErrMsg string
+		var evs []event
+		for deadline := time.Now().Add(3 * time.Minute); time.Now().Before(deadline) && firstOK.IsZero(); {
+			time.Sleep(20 * time.Millisecond)
+			evs = append(evs, takeEvents()...)
+			sort.Slice(evs, func(i, j int) bool { return evs[i].end.Before(evs[j].end) })
+			firstErr, firstOK, nErr, firstErrMsg = time.Time{}, time.Time{}, 0, ""
+			for _, e := range evs {
+				if e.end.Before(tKill) {
+					continue
+				}
+				if e.err != "" {
+					nErr++
+					if firstErr.IsZero() {
+						firstErr, firstErrMsg = e.end, e.err
+					}
+					continue
+				}
+				if !firstErr.IsZero() && e.start.After(firstErr) && firstOK.IsZero() {
+					firstOK = e.end
+				}
+			}
+			if firstErr.IsZero() && time.Since(tServing) > 5*time.Second {
+				break // no outage at all
+			}
+		}
+		if len(firstErrMsg) > 100 {
+			firstErrMsg = firstErrMsg[:100]
+		}
+		route, outage := 0.0, 0.0
+		if !firstErr.IsZero() {
+			route = firstOK.Sub(tServing).Seconds()
+			outage = firstOK.Sub(firstErr).Seconds()
+			routes = append(routes, route)
+		}
+		fmt.Printf("%d %.3f %.3f %.3f %.3f %d %q\n", trial, tExit.Sub(tKill).Seconds()+down.Seconds(), tServing.Sub(tStart).Seconds(), route, outage, nErr, firstErrMsg)
+		// Error classes, with the time of their first and last occurrence relative to the kill.
+		type class struct {
+			n           int
+			first, last time.Time
+		}
+		classes := map[string]*class{}
+		var keys []string
+		for _, e := range evs {
+			if e.err == "" || e.end.Before(tKill) {
+				continue
+			}
+			k := e.err
+			if i := strings.Index(k, "desc = "); i >= 0 {
+				k = k[i+len("desc = "):]
+			} else if i := strings.Index(k, "vttablet: "); i >= 0 {
+				k = k[i:]
+			}
+			if len(k) > 70 {
+				k = k[:70]
+			}
+			c, ok := classes[k]
+			if !ok {
+				c = &class{first: e.end}
+				classes[k] = c
+				keys = append(keys, k)
+			}
+			c.n++
+			c.last = e.end
+		}
+		for _, k := range keys {
+			c := classes[k]
+			fmt.Printf("#   %6d errors %7.3f..%7.3f s after kill: %s\n", c.n, c.first.Sub(tKill).Seconds(), c.last.Sub(tKill).Seconds(), k)
+		}
+	}
+	sort.Float64s(routes)
+	fmt.Printf("# route_s sorted: %v\n", routes)
+	cancel()
+	wg.Wait()
+}
