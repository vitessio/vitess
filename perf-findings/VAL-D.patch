+// TestVDiffStopWhileWaitingForWorkflowLock is the validation test for bug #14
+// (`VDiff stop/delete` blocked ~7 minutes waiting for the workflow lock).
+//
+// Two VDiffs run on one target tablet, and the first one's workflow lock is
+// held elsewhere (in the original report: orphaned by a tablet restart, with a
+// 24 h lease). The first VDiff to reach tableDiffer.initialize takes the
+// engine-wide snapshotMu and retries LockName with backoff. The second one
+// blocks in snapshotMu.Lock(), which does not observe its context, even when it
+// diffs another workflow whose lock is free. Stopping the second VDiff (VDiff
+// stop, or VDiff delete, which calls controller.Stop() while holding the engine
+// mutex) must return promptly; on base it waits until the first VDiff gets its
+// workflow lock or is itself stopped.
+func TestVDiffStopWhileWaitingForWorkflowLock(t *testing.T) {
+	const (
+		keyspace       = "ks"
+		lockedWorkflow = "wf"
+	)
+	for name, secondWorkflow := range map[string]string{
+		"same workflow":  lockedWorkflow,
+		"other workflow": "wf2",
+	} {
+		t.Run(name, func(t *testing.T) {
+			ctx := t.Context()
+			ts := memorytopo.NewServer(ctx, "zone1")
+			t.Cleanup(ts.Close)
+			tablet := &topodatapb.Tablet{
+				Alias:    &topodatapb.TabletAlias{Cell: "zone1", Uid: 100},
+				Keyspace: keyspace,
+				Shard:    "0",
+				Type:     topodatapb.TabletType_PRIMARY,
+			}
+			dbClientFactory := func() binlogplayer.DBClient { return binlogplayer.NewMockDBClient(t) }
+			vde := NewTestEngine(ts, tablet, "vt_"+keyspace, dbClientFactory, func() tmclient.TabletManagerClient { return nil })
+
+			// Someone else holds the first workflow's lock for the whole test
+			// (e.g. an orphaned lock left behind by a tablet restart).
+			_, unlockWorkflow, err := ts.LockName(ctx, fmt.Sprintf("%s/%s", keyspace, lockedWorkflow), "orphan")
+			require.NoError(t, err)
+			t.Cleanup(func() {
+				var unlockErr error
+				unlockWorkflow(&unlockErr)
+			})
+
+			// startVDiff mimics engine.addController + controller.run up to the
+			// table differ's initialization: run() closes ct.done when it returns.
+			startVDiff := func(id int64, workflow string) *controller {
+				row := sqltypes.MakeTestResult(sqltypes.MakeTestFields("id|vdiff_uuid|workflow", "int64|varchar|varchar"),
+					fmt.Sprintf("%d|uuid-%d|%s", id, id, workflow)).Named().Row()
+				ct, err := newController(row, dbClientFactory, ts, vde, &tabletmanagerdatapb.VDiffOptions{})
+				require.NoError(t, err)
+				ctCtx, cancel := context.WithCancel(ctx)
+				ct.cancel = cancel
+				wd, err := newWorkflowDiffer(ct, ct.options, vde.collationEnv)
+				require.NoError(t, err)
+				td := newTableDiffer(wd, &tabletmanagerdatapb.TableDefinition{Name: "t1"}, "select * from t1")
+				go func() {
+					defer close(ct.done)
+					_ = td.initialize(ctCtx)
+				}()
+				return ct
+			}
+
+			// stopWithin calls ct.Stop() (what VDiff stop/delete do) and reports
+			// whether it returned within d.
+			stopWithin := func(ct *controller, d time.Duration) (chan struct{}, bool) {
+				stopped := make(chan struct{})
+				go func() {
+					ct.Stop()
+					close(stopped)
+				}()
+				select {
+				case <-stopped:
+					return stopped, true
+				case <-time.After(d):
+					return stopped, false
+				}
+			}
+
+			// VDiff 1 takes snapshotMu and waits for its workflow lock.
+			vdiff1 := startVDiff(1, lockedWorkflow)
+			require.Eventually(t, func() bool {
+				if vde.snapshotMu.TryLock() {
+					vde.snapshotMu.Unlock()
+					return false
+				}
+				return true
+			}, 30*time.Second, 10*time.Millisecond, "the first VDiff should be waiting for the workflow lock while holding snapshotMu")
+
+			// VDiff 2 queues behind it.
+			vdiff2 := startVDiff(2, secondWorkflow)
+
+			// Stopping VDiff 2 must not wait for VDiff 1's lock wait to end.
+			stopped2, ok := stopWithin(vdiff2, 10*time.Second)
+			assert.True(t, ok, "VDiff stop of a VDiff queued behind another VDiff's workflow-lock wait did not return within 10s")
+
+			// Stopping the VDiff that is itself retrying LockName is prompt.
+			_, ok = stopWithin(vdiff1, 10*time.Second)
+			assert.True(t, ok, "VDiff stop of the VDiff waiting in LockName did not return within 10s")
+			select {
+			case <-stopped2:
+			case <-time.After(30 * time.Second):
+				require.FailNow(t, "VDiff 2 did not stop even after VDiff 1 stopped")
+			}
+		})
+	}
+}
