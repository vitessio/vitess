+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package charset
+
+// This file holds a verbatim copy of the conversion routines as they were
+// before the ASCII fast path was added. The equivalence tests and the A/B
+// benchmarks compare the current implementation against it.
+
+func legacyConvertFastFromUTF8(dst []byte, dstCharset Charset, src []byte) ([]byte, error) {
+	var failed, nDst int
+
+	if dst == nil {
+		dst = make([]byte, len(src)*3)
+	} else {
+		nDst = len(dst)
+		dst = dst[:cap(dst)]
+	}
+
+	for _, cp := range string(src) {
+		if len(dst)-nDst < 4 {
+			newDst := make([]byte, len(dst)*2)
+			copy(newDst, dst[:nDst])
+			dst = newDst
+		}
+		w := dstCharset.EncodeRune(dst[nDst:], cp)
+		if w < 0 {
+			failed++
+			if w = dstCharset.EncodeRune(dst[nDst:], '?'); w < 0 {
+				break
+			}
+		}
+		nDst += w
+	}
+
+	if failed > 0 {
+		return dst[:nDst], failedConversionError(&Charset_utf8mb4{}, dstCharset, src)
+	}
+	return dst[:nDst], nil
+}
+
+func legacyConvertSlow(dst []byte, dstCharset Charset, src []byte, srcCharset Charset) ([]byte, error) {
+	var failed, nDst int
+	original := src
+
+	if dst == nil {
+		dst = make([]byte, len(src)*3)
+	} else {
+		nDst = len(dst)
+		dst = dst[:cap(dst)]
+	}
+
+	for len(src) > 0 {
+		cp, width, ok := srcCharset.DecodeRune(src)
+		if !ok {
+			failed++
+			cp = '?'
+		}
+		src = src[width:]
+
+		if len(dst)-nDst < 4 {
+			newDst := make([]byte, len(dst)*2)
+			copy(newDst, dst[:nDst])
+			dst = newDst
+		}
+
+		w := dstCharset.EncodeRune(dst[nDst:], cp)
+		if w < 0 {
+			failed++
+			w = dstCharset.EncodeRune(dst[nDst:], '?')
+			if w < 0 {
+				break
+			}
+		}
+		nDst += w
+	}
+
+	if failed > 0 {
+		return dst[:nDst], failedConversionError(srcCharset, dstCharset, original)
+	}
+	return dst[:nDst], nil
+}
+
+func legacyConvert(dst []byte, dstCharset Charset, src []byte, srcCharset Charset) ([]byte, error) {
+	if dstCharset.IsSuperset(srcCharset) {
+		if dst != nil {
+			return append(dst, src...), nil
+		}
+		return src, nil
+	}
+	if trans, ok := dstCharset.(Convertible); ok {
+		return trans.Convert(dst, src, srcCharset)
+	}
+	switch srcCharset.(type) {
+	case Charset_binary:
+		return ConvertFromBinary(dst, dstCharset, src)
+	case Charset_utf8mb3, Charset_utf8mb4:
+		return legacyConvertFastFromUTF8(dst, dstCharset, src)
+	default:
+		return legacyConvertSlow(dst, dstCharset, src, srcCharset)
+	}
+}
