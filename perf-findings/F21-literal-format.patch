 }
 
+// writeStringLiteral writes val into the buffer as a quoted and escaped
+// SQL string literal. The escaping is byte-oriented (identical to encoding a
+// VarChar sqltypes.Value), so invalid UTF-8 is preserved as-is. It writes
+// directly into the underlying strings.Builder without copying val first.
+func (buf *TrackedBuffer) writeStringLiteral(val string) {
+	sqltypes.MakeTrusted(sqltypes.VarChar, hack.StringBytes(val)).EncodeSQLStringBuilder(buf.Builder)
+}
