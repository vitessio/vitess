+// TestStringLiteralFormatEquivalence checks that string literals are formatted
+// byte-for-byte like a VarChar sqltypes.Value encoded with EncodeSQL, which is
+// how Literal.Format and Literal.FormatFast historically encoded them. The
+// encoding is byte-oriented, so invalid UTF-8 must be preserved as-is.
+func TestStringLiteralFormatEquivalence(t *testing.T) {
+	check := func(val string) {
+		var want bytes.Buffer
+		sqltypes.MakeTrusted(sqltypes.VarChar, []byte(val)).EncodeSQL(&want)
+
+		lit := &Literal{Type: StrVal, Val: val}
+		require.Equal(t, want.String(), String(lit), "FormatFast(%q)", val)
+
+		buf := NewTrackedBuffer(nil)
+		lit.Format(buf)
+		require.Equal(t, want.String(), buf.String(), "Format(%q)", val)
+	}
+
+	for _, val := range []string{
+		"", "a", "'", "\\", "\\%", "\\_", "a\\%b\\_c\\", "\\\\%", "it's", "\x00\b\n\r\t\x1a",
+		"\xff\xfe", "caf\xc3\xa9", "\xc3", "\xe4\xb8", "日本語", "abc\x80def",
+		strings.Repeat("the quick brown fox ", 64),
+	} {
+		check(val)
+	}
+
+	// All strings of length <= 2 over all byte values.
+	for i := range 256 {
+		check(string([]byte{byte(i)}))
+		for j := range 256 {
+			check(string([]byte{byte(i), byte(j)}))
+		}
+	}
+
+	// Random strings biased towards bytes that need special handling.
+	special := []byte{0, '\'', '"', '\\', '%', '_', '\b', '\n', '\r', '\t', 0x1a, 0x80, 0xc3, 0xff}
+	r := rand.New(rand.NewPCG(1, 2))
+	for range 20000 {
+		b := make([]byte, r.IntN(64))
+		for k := range b {
+			if r.IntN(3) == 0 {
+				b[k] = special[r.IntN(len(special))]
+			} else {
+				b[k] = byte(r.IntN(256))
+			}
+		}
+		check(string(b))
+	}
+}
