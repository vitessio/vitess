 	mu sync.RWMutex
 	cc *grpc.ClientConn
 	c  queryservicepb.QueryClient
+
+	// PROTOTYPE(P1): extra connections used round-robin by Execute.
+	extraCC []*grpc.ClientConn
+	extraC  []queryservicepb.QueryClient
+	next    atomic.Uint32
+}
+
+// executeClient returns the client used for the next Execute call. conn.mu must be held.
+func (conn *gRPCQueryClient) executeClient() queryservicepb.QueryClient {
+	if len(conn.extraC) == 0 {
+		return conn.c
+	}
+	n := conn.next.Add(1) % uint32(len(conn.extraC)+1)
+	if n == 0 {
+		return conn.c
+	}
+	return conn.extraC[n-1]
 }
 
