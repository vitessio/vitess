+const maxDecimalBinarySize = 32
+
+// maxDecimalTextSize covers the text representation of the largest DECIMAL
+// column that MySQL supports: a sign, 65 digits and a decimal point.
+const maxDecimalTextSize = 80
+
+// decimalCellValue decodes a DECIMAL value, stored in MySQL's binary format,
+// and returns its text representation and how many bytes it takes.
+func decimalCellValue(data []byte, pos int, metadata uint16) (sqltypes.Value, int, error) {
+	precision := int(metadata >> 8) // total digits number
+	scale := int(metadata & 0xff)   // number of fractional digits
+	intg := precision - scale       // number of full digits
+	intg0 := intg / 9               // number of 32-bits digits
+	intg0x := intg - intg0*9        // leftover full digits
+	frac0 := scale / 9              // number of 32 bits fractionals
+	frac0x := scale - frac0*9       // leftover fractionals
+
+	l := intg0*4 + dig2bytes[intg0x] + frac0*4 + dig2bytes[frac0x]
+
+	// Copy the data so we can change it. Otherwise
+	// decoding is just too hard.
+	var dbuf [maxDecimalBinarySize]byte
+	var d []byte
+	if l <= len(dbuf) {
+		d = dbuf[:l]
+	} else {
+		d = make([]byte, l)
+	}
+	copy(d, data[pos:pos+l])
+
+	var tbuf [maxDecimalTextSize]byte
+	txt := tbuf[:0]
+
+	isNegative := (d[0] & 0x80) == 0
+	d[0] ^= 0x80 // First bit is inverted.
+	if isNegative {
+		// Negative numbers are just inverted bytes.
+		txt = append(txt, '-')
+		for i := range d {
+			d[i] ^= 0xff
+		}
+	}
+
+	// first we have the leftover full digits
+	var val uint32
+	switch dig2bytes[intg0x] {
+	case 0:
+		// nothing to do
+	case 1:
+		// one byte, up to two digits
+		val = uint32(d[0])
+	case 2:
+		// two bytes, up to 4 digits
+		val = uint32(d[0])<<8 +
+			uint32(d[1])
+	case 3:
+		// 3 bytes, up to 6 digits
+		val = uint32(d[0])<<16 +
+			uint32(d[1])<<8 +
+			uint32(d[2])
+	case 4:
+		// 4 bytes, up to 8 digits (9 digits would be a full)
+		val = uint32(d[0])<<24 +
+			uint32(d[1])<<16 +
+			uint32(d[2])<<8 +
+			uint32(d[3])
+	}
+	pos = dig2bytes[intg0x]
+	if val > 0 {
+		txt = strconv.AppendUint(txt, uint64(val), 10)
+	}
+
+	// now the full digits, 32 bits each, 9 digits
+	for range intg0 {
+		txt = appendUintPadded(txt, uint64(binary.BigEndian.Uint32(d[pos:pos+4])), 9)
+		pos += 4
+	}
+
+	// now see if we have a fraction
+	if scale == 0 {
+		// When the field is a DECIMAL using a scale of 0, e.g.
+		// DECIMAL(5,0), a binlogged value of 0 is almost treated
+		// like the NULL byte and we get a 0 byte length value.
+		// In this case let's return the correct value of 0.
+		if len(txt) == 0 {
+			txt = append(txt, '0')
+		}
+
+		return sqltypes.MakeTrusted(querypb.Type_DECIMAL,
+			trimDecimalLeadingZeroes(txt)), l, nil
+	}
+	txt = append(txt, '.')
+
+	// now the full fractional digits
+	for range frac0 {
+		txt = appendUintPadded(txt, uint64(binary.BigEndian.Uint32(d[pos:pos+4])), 9)
+		pos += 4
+	}
+
+	// then the partial fractional digits, zero padded to frac0x digits
+	switch dig2bytes[frac0x] {
+	case 0:
+		// Nothing to do
+	case 1:
+		// one byte, 1 or 2 digits
+		val = uint32(d[pos])
+	case 2:
+		// two bytes, 3 or 4 digits
+		val = uint32(d[pos])<<8 +
+			uint32(d[pos+1])
+	case 3:
+		// 3 bytes, 5 or 6 digits
+		val = uint32(d[pos])<<16 +
+			uint32(d[pos+1])<<8 +
+			uint32(d[pos+2])
+	case 4:
+		// 4 bytes, 7 or 8 digits (9 digits would be a full)
+		val = uint32(d[pos])<<24 +
+			uint32(d[pos+1])<<16 +
+			uint32(d[pos+2])<<8 +
+			uint32(d[pos+3])
+	}
+	if frac0x > 0 {
+		txt = appendUintPadded(txt, uint64(val), frac0x)
+	}
+
+	return sqltypes.MakeTrusted(querypb.Type_DECIMAL, trimDecimalLeadingZeroes(txt)), l, nil
+}
+
+// trimDecimalLeadingZeroes removes preceding 0s from the integral part of a
+// decimal, otherwise we get "000000000001.23" instead of "1.23". It returns
+// a newly allocated slice, so b can be a temporary buffer.
+func trimDecimalLeadingZeroes(b []byte) []byte {
+	isNegative := b[0] == '-'
+	if isNegative {
+		b = b[1:]
+	}
+	i := 0
+	for i < len(b) && b[i] == '0' {
+		i++
+	}
+	b = b[i:]
+	// Ensure at least one digit precedes the decimal point so values
+	// like 0.1 round-trip as "0.1" instead of ".1" (invalid JSON when
+	// the decimal appears inside a JSON column), and so a fully zero
+	// integral part collapses to "0" rather than "" or a run of zeroes.
+	needLeadingZero := len(b) == 0 || b[0] == '.'
+
+	size := len(b)
+	if isNegative {
+		size++
+	}
+	if needLeadingZero {
+		size++
+	}
+	out := make([]byte, 0, size)
+	if isNegative {
+		out = append(out, '-')
+	}
+	if needLeadingZero {
+		out = append(out, '0')
+	}
+	return append(out, b...)
+}
