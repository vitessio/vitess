+// encodeDecimal returns a random value in MySQL's binary DECIMAL format.
+// Digit groups are valid most of the time, and often zero, to exercise the
+// trimming of leading zeroes.
+func encodeDecimal(r *rand.Rand, precision, scale int) []byte {
+	intg := precision - scale
+	intg0, intg0x := intg/9, intg%9
+	frac0, frac0x := scale/9, scale%9
+	pow10 := func(n int) uint32 {
+		p := uint32(1)
+		for range n {
+			p *= 10
+		}
+		return p
+	}
+	group := func(digits int) uint32 {
+		switch r.IntN(4) {
+		case 0:
+			return 0
+		case 1:
+			return pow10(digits) - 1
+		default:
+			return r.Uint32N(pow10(digits))
+		}
+	}
+	var out []byte
+	put := func(v uint32, size int) {
+		for i := size - 1; i >= 0; i-- {
+			out = append(out, byte(v>>(8*i)))
+		}
+	}
+	put(group(intg0x), dig2bytes[intg0x])
+	for range intg0 {
+		put(group(9), 4)
+	}
+	for range frac0 {
+		put(group(9), 4)
+	}
+	put(group(frac0x), dig2bytes[frac0x])
+	if len(out) == 0 {
+		return out
+	}
+	if r.IntN(2) == 0 {
+		for i := range out {
+			out[i] ^= 0xff
+		}
+	}
+	out[0] ^= 0x80
+	return out
+}
