+// DATETIME2 or TIME2 value, which uses (fsp+1)/2 big endian bytes to store
+// fsp digits. It returns the raw stored value, the number of bytes it takes,
+// and the number of digits to print. An odd fsp stores one extra digit, which
+// the caller has to drop by dividing by 10. It returns a zero width when fsp
+// is not in the [1, 6] range.
+func readFractionalSeconds(data []byte, pos int, fsp uint16) (raw uint64, size int, width int) {
+	switch fsp {
+	case 1, 2:
