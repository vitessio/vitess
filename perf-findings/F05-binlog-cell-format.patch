+		hour := (hms >> 12) % (1 << 10)
+		minute := (hms >> 6) % (1 << 6)
+		second := hms % (1 << 6)
+		return sqltypes.MakeTrusted(querypb.Type_TIME,
+			fmt.Appendf(nil, "%v%02d:%02d:%02d%v", sign, hour, minute, second, fracStr)), 3 + (int(metadata)+1)/2, nil
+
+	case TypeNewDecimal:
