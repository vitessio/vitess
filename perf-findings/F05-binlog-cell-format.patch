+// BenchmarkCellValueRow decodes a row that mixes integer, string, temporal
+// and DECIMAL columns, as the vstreamer does for every row event.
+func BenchmarkCellValueRow(b *testing.B) {
+	var types []byte
+	var metadata []uint16
+	var fields []*querypb.Field
+	var data []byte
+	cells := benchCells()
+	for _, name := range []string{"BIGINT", "INT", "VARCHAR", "VARCHAR", "DECIMAL_10_2", "DECIMAL_19_4", "DATE", "DATETIME2_0", "DATETIME2_6", "TIMESTAMP2_0", "INT"} {
+		for _, c := range cells {
+			if c.name == name {
+				types = append(types, c.typ)
+				metadata = append(metadata, c.metadata)
+				fields = append(fields, &querypb.Field{Type: c.field})
+				data = append(data, c.data...)
+			}
+		}
+	}
+	values := make([]sqltypes.Value, len(types))
+	for _, impl := range cellValueImpls {
+		b.Run("impl="+impl.name, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				pos := 0
+				for i := range types {
