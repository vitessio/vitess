+type cellResult struct {
+	typ      querypb.Type
+	raw      string
+	length   int
+	err      string
+	panicked bool
+}
+
+func callCellValue(fn func([]byte, int, byte, uint16, *querypb.Field, bool) (sqltypes.Value, int, error), data []byte, pos int, typ byte, metadata uint16) (res cellResult) {
+	defer func() {
+		if r := recover(); r != nil {
+			res = cellResult{panicked: true}
+		}
+	}()
+	v, l, err := fn(data, pos, typ, metadata, &querypb.Field{Type: querypb.Type_UINT64}, false)
+	res = cellResult{typ: v.Type(), raw: string(v.Raw()), length: l}
+	if err != nil {
+		res.err = err.Error()
+	}
+	return res
+}
+
+func requireSameCellValue(t *testing.T, data []byte, typ byte, metadata uint16) {
+	// Pad the data on both sides, so we make sure the 'pos' field works.
+	padded := make([]byte, len(data)+2)
+	padded[0] = 0x5a
+	padded[len(padded)-1] = 0xa5
+	copy(padded[1:], data)
+	want := callCellValue(cellValueReference, padded, 1, typ, metadata)
+	got := callCellValue(CellValue, padded, 1, typ, metadata)
+	if want != got {
+		require.Equal(t, want, got, "type %d, metadata %#04x, data %x", typ, metadata, data)
+	}
+}
+
+func randomBytes(r *rand.Rand, n int) []byte {
+	b := make([]byte, n)
+	for i := range b {
+		switch r.IntN(8) {
+		case 0:
+			b[i] = 0
+		case 1:
+			b[i] = 0xff
+		case 2:
+			b[i] = 0x80
+		case 3:
+			b[i] = 0x7f
+		default:
+			b[i] = byte(r.Uint32())
+		}
+	}
+	return b
+}
