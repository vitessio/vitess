+// TestCellValueTemporalFormatEquivalence checks that the temporal formatters
+// produce byte-identical output to the previous fmt-based implementation,
+// for valid values and for arbitrary bytes.
+func TestCellValueTemporalFormatEquivalence(t *testing.T) {
+	r := rand.New(rand.NewPCG(1, 2))
+	const iterations = 20000
+
+	fixedPatterns := func(n int) [][]byte {
+		var out [][]byte
+		for _, fill := range []byte{0x00, 0xff, 0x80, 0x7f, 0x01, 0xfe} {
+			b := make([]byte, n)
+			for i := range b {
+				b[i] = fill
+			}
+			out = append(out, b)
+			c := make([]byte, n)
+			copy(c, b)
+			c[0] ^= 0x80
+			out = append(out, c)
+		}
+		return out
+	}
+
+	for _, typ := range []byte{TypeDate, TypeNewDate, TypeTime, TypeDateTime, TypeTimestamp} {
+		t.Run(fmt.Sprintf("type-%d", typ), func(t *testing.T) {
+			n, err := CellLength(nil, 0, typ, 0)
+			require.NoError(t, err)
+			for _, b := range fixedPatterns(n) {
+				requireSameCellValue(t, b, typ, 0)
+			}
+			for range iterations {
+				requireSameCellValue(t, randomBytes(r, n), typ, 0)
+			}
+		})
+	}
+
+	t.Run("valid-time", func(t *testing.T) {
+		for range iterations {
+			v := int32(r.IntN(8385960))
+			if r.IntN(2) == 0 {
+				v = -v
+			}
+			var b [4]byte
+			binary.LittleEndian.PutUint32(b[:], uint32(v))
+			requireSameCellValue(t, b[:3], TypeTime, 0)
+		}
+	})
+
+	t.Run("valid-datetime", func(t *testing.T) {
+		for range iterations {
+			v := uint64(r.IntN(10000))*10000000000 + uint64(r.IntN(13))*100000000 + uint64(r.IntN(32))*1000000 +
+				uint64(r.IntN(24))*10000 + uint64(r.IntN(60))*100 + uint64(r.IntN(60))
+			var b [8]byte
+			binary.LittleEndian.PutUint64(b[:], v)
+			requireSameCellValue(t, b[:], TypeDateTime, 0)
+		}
+	})
+
+	t.Run("timestamp-every-day", func(t *testing.T) {
+		// Every day that a TIMESTAMP can represent, at a random time.
+		for day := uint32(0); day <= 0xffffffff/86400; day++ {
+			v := day*86400 + uint32(r.IntN(86400))
+			if day == 0xffffffff/86400 {
+				v = 0xffffffff
+			}
+			var b [4]byte
+			binary.LittleEndian.PutUint32(b[:], v)
+			requireSameCellValue(t, b[:], TypeTimestamp, 0)
+			binary.BigEndian.PutUint32(b[:], v)
+			requireSameCellValue(t, append(b[:], 0x12, 0x34, 0x56), TypeTimestamp2, uint16(day%7))
+		}
+	})
+
+	for _, typ := range []byte{TypeTimestamp2, TypeDateTime2, TypeTime2} {
+		// Metadata values above 6 are invalid, but make sure they behave the same.
+		for metadata := uint16(0); metadata <= 8; metadata++ {
+			t.Run(fmt.Sprintf("type-%d-fsp-%d", typ, metadata), func(t *testing.T) {
+				n, err := CellLength(nil, 0, typ, metadata)
+				require.NoError(t, err)
+				for _, b := range fixedPatterns(n) {
+					requireSameCellValue(t, b, typ, metadata)
+				}
+				for range iterations {
+					requireSameCellValue(t, randomBytes(r, n), typ, metadata)
+				}
+			})
+		}
+	}
+
+	t.Run("valid-datetime2", func(t *testing.T) {
+		for range iterations {
+			ym := uint64(r.IntN(10000))*13 + uint64(r.IntN(13))
+			ymd := ym<<5 | uint64(r.IntN(32))
+			hms := uint64(r.IntN(24))<<12 | uint64(r.IntN(60))<<6 | uint64(r.IntN(60))
+			v := (ymd<<17 | hms) + 0x8000000000
+			fsp := uint16(r.IntN(7))
+			n := (int(fsp) + 1) / 2
+			b := []byte{byte(v >> 32), byte(v >> 24), byte(v >> 16), byte(v >> 8), byte(v)}
+			frac := uint32(r.IntN(1000000))
+			fb := make([]byte, n)
+			for i := n - 1; i >= 0; i-- {
+				fb[i] = byte(frac % 100)
+				frac /= 100
+			}
+			requireSameCellValue(t, append(b, fb...), TypeDateTime2, fsp)
+		}
+	})
+
+	t.Run("valid-time2", func(t *testing.T) {
+		for range iterations {
+			hms := int64(r.IntN(839))<<12 | int64(r.IntN(60))<<6 | int64(r.IntN(60))
+			fsp := uint16(r.IntN(7))
+			n := (int(fsp) + 1) / 2
+			frac := int64(0)
+			if n > 0 {
+				frac = int64(r.IntN(1 << (8 * n)))
+			}
+			packed := hms<<(8*n) | frac
+			if r.IntN(2) == 0 {
+				packed = -packed
+			}
+			packed += 0x800000 << (8 * n)
+			b := make([]byte, 3+n)
+			for i := len(b) - 1; i >= 0; i-- {
+				b[i] = byte(packed)
+				packed >>= 8
+			}
+			requireSameCellValue(t, b, TypeTime2, fsp)
+		}
+	})
+}
