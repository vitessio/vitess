+// TestCellValueDecimalFormatEquivalence checks that the DECIMAL formatter
+// produces byte-identical output to the previous fmt-based implementation,
+// for every precision and scale that MySQL supports.
+func TestCellValueDecimalFormatEquivalence(t *testing.T) {
+	r := rand.New(rand.NewPCG(3, 4))
+	for precision := 1; precision <= 65; precision++ {
+		for scale := 0; scale <= min(precision, 30); scale++ {
+			metadata := uint16(precision)<<8 | uint16(scale)
+			n, err := CellLength(nil, 0, TypeNewDecimal, metadata)
+			require.NoError(t, err)
+			for _, fill := range []byte{0x00, 0xff, 0x80, 0x7f} {
+				b := make([]byte, n)
+				for i := range b {
+					b[i] = fill
+				}
+				requireSameCellValue(t, b, TypeNewDecimal, metadata)
+			}
+			for range 300 {
+				requireSameCellValue(t, encodeDecimal(r, precision, scale), TypeNewDecimal, metadata)
+				requireSameCellValue(t, randomBytes(r, n), TypeNewDecimal, metadata)
+			}
+		}
+	}
+	// Metadata that MySQL never produces, including binary values that do
+	// not fit in the stack buffers.
+	for _, metadata := range []uint16{0, 0x0000 | 0, 90<<8 | 0, 200<<8 | 30, 255<<8 | 255, 255<<8 | 0, 100<<8 | 60} {
+		n, err := CellLength(nil, 0, TypeNewDecimal, metadata)
+		require.NoError(t, err)
+		for range 300 {
+			requireSameCellValue(t, randomBytes(r, n), TypeNewDecimal, metadata)
+		}
+	}
+}
