+func writeBinaryRowsWith(t testing.TB, old bool, fields []*querypb.Field, rows [][]sqltypes.Value) ([]byte, error) {
+	cc := &captureConn{}
+	c := newConn(cc, DefaultFlushDelay, 0)
+	for _, row := range rows {
+		var err error
+		if old {
+			err = c.writeBinaryRowOld(fields, row)
+		} else {
+			err = c.writeBinaryRow(fields, row)
+		}
+		if err != nil {
+			return cc.buf.Bytes(), err
+		}
+	}
+	return cc.buf.Bytes(), nil
+}
+
+// TestWriteBinaryRowMatchesReference checks full packets (header, NULL bitmap,
+// values, and splitting of rows larger than MaxPacketSize).
+func TestWriteBinaryRowMatchesReference(t *testing.T) {
+	r := rand.New(rand.NewPCG(3, 4))
+	for range 500 {
+		n := 1 + r.IntN(20)
+		fields := make([]*querypb.Field, n)
+		row := make([]sqltypes.Value, n)
+		for i := range n {
+			typ := binaryRowTypes[1+r.IntN(len(binaryRowTypes)-1)]
+			fields[i] = &querypb.Field{Name: fmt.Sprint("c", i), Type: typ}
+			if r.IntN(4) == 0 {
+				row[i] = sqltypes.NULL
+			} else {
+				row[i] = sqltypes.MakeTrusted(typ, []byte(randomBinaryRowValue(r, typ)))
+			}
+		}
+		want, wantErr := writeBinaryRowsWith(t, true, fields, [][]sqltypes.Value{row})
+		got, gotErr := writeBinaryRowsWith(t, false, fields, [][]sqltypes.Value{row})
+		if wantErr != nil {
+			require.EqualError(t, gotErr, wantErr.Error())
+			continue
+		}
+		require.NoError(t, gotErr)
+		require.Equal(t, want, got)
+	}
+
+	// Error path: the packet buffer is recycled and a subsequent row still
+	// works identically.
+	fields := []*querypb.Field{{Type: sqltypes.Int8}, {Type: sqltypes.Time}}
+	rows := [][]sqltypes.Value{
+		{sqltypes.MakeTrusted(sqltypes.Int8, []byte("1")), sqltypes.MakeTrusted(sqltypes.Time, []byte("1:2"))},
+	}
+	want, wantErr := writeBinaryRowsWith(t, true, fields, rows)
+	got, gotErr := writeBinaryRowsWith(t, false, fields, rows)
+	require.Error(t, wantErr)
+	assert.EqualError(t, gotErr, wantErr.Error())
+	assert.Equal(t, want, got)
+
+	// A row larger than MaxPacketSize must be split identically.
+	big := sqltypes.MakeTrusted(sqltypes.Blob, bytes.Repeat([]byte{'b'}, MaxPacketSize+10))
+	fields = []*querypb.Field{{Type: sqltypes.Int64}, {Type: sqltypes.Blob}, {Type: sqltypes.VarChar}}
+	rows = [][]sqltypes.Value{{sqltypes.NewInt64(42), big, sqltypes.NULL}}
+	want, wantErr = writeBinaryRowsWith(t, true, fields, rows)
+	require.NoError(t, wantErr)
+	got, gotErr = writeBinaryRowsWith(t, false, fields, rows)
+	require.NoError(t, gotErr)
+	require.True(t, bytes.Equal(want, got), "large row mismatch")
+}
+
+func benchmarkRows() (typical, blob struct {
+	fields []*querypb.Field
+	row    []sqltypes.Value
+},
+) {
+	typical.fields = []*querypb.Field{
+		{Type: sqltypes.Int64},
+		{Type: sqltypes.Int32},
+		{Type: sqltypes.VarChar},
+		{Type: sqltypes.VarChar},
+		{Type: sqltypes.Datetime},
+		{Type: sqltypes.Decimal},
+		{Type: sqltypes.Int8},
+		{Type: sqltypes.Timestamp},
+		{Type: sqltypes.VarChar},
+		{Type: sqltypes.Uint64},
+	}
+	typical.row = []sqltypes.Value{
+		sqltypes.NewInt64(1234567890123),
+		sqltypes.NewInt32(42),
+		sqltypes.NewVarChar("john.doe@example.com"),
+		sqltypes.NewVarChar("Some product description text"),
+		sqltypes.MakeTrusted(sqltypes.Datetime, []byte("2024-05-06 07:08:09")),
+		sqltypes.MakeTrusted(sqltypes.Decimal, []byte("12345.67")),
+		sqltypes.NewInt8(1),
+		sqltypes.MakeTrusted(sqltypes.Timestamp, []byte("2024-05-06 07:08:09.123456")),
+		sqltypes.NULL,
+		sqltypes.NewUint64(987654321),
+	}
+	blob.fields = []*querypb.Field{{Type: sqltypes.Int64}, {Type: sqltypes.Blob}}
+	blob.row = []sqltypes.Value{
+		sqltypes.NewInt64(1),
+		sqltypes.MakeTrusted(sqltypes.Blob, bytes.Repeat([]byte("0123456789abcdef"), 4096)), // 64KiB
+	}
+	return typical, blob
+}
+
+func BenchmarkWriteBinaryRow(b *testing.B) {
+	typical, blob := benchmarkRows()
+	timeFields := []*querypb.Field{{Type: sqltypes.Time}, {Type: sqltypes.Time}}
+	timeRow := []sqltypes.Value{
+		sqltypes.MakeTrusted(sqltypes.Time, []byte("-12:34:56.789")),
+		sqltypes.MakeTrusted(sqltypes.Time, []byte("101:02:03")),
+	}
+	cases := []struct {
+		name   string
+		fields []*querypb.Field
+		row    []sqltypes.Value
+	}{
+		{"typical10", typical.fields, typical.row},
+		{"blob64k", blob.fields, blob.row},
+		{"time", timeFields, timeRow},
+	}
+	for _, tc := range cases {
+		for _, impl := range []string{"old", "new"} {
+			b.Run(tc.name+"/"+impl, func(b *testing.B) {
+				c := newConn(&captureConn{discard: true}, DefaultFlushDelay, 0)
+				b.ReportAllocs()
+				for b.Loop() {
+					var err error
+					if impl == "old" {
+						err = c.writeBinaryRowOld(tc.fields, tc.row)
+					} else {
+						err = c.writeBinaryRow(tc.fields, tc.row)
+					}
+					if err != nil {
+						b.Fatal(err)
+					}
+				}
+			})
+		}
+	}
+}
