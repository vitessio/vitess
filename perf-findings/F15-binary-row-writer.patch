+
+// val2MySQL encodes v into a newly allocated buffer, sized with val2MySQLLen.
+func val2MySQL(v sqltypes.Value) ([]byte, error) {
+	l, err := val2MySQLLen(v)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]byte, l)
+	n, err := val2MySQLTo(out, 0, v)
+	if err != nil {
+		return nil, err
+	}
+	return out[:n], nil
+}
+
+// captureConn is a net.Conn that records (or discards) everything written.
+type captureConn struct {
+	net.Conn
+	buf     bytes.Buffer
+	discard bool
+}
+
+func (c *captureConn) Write(b []byte) (int, error) {
+	if !c.discard {
+		c.buf.Write(b)
+	}
+	return len(b), nil
+}
+
+func (c *captureConn) RemoteAddr() net.Addr { return mockAddress{s: "a"} }
+
+type encodeResult struct {
+	out      []byte
+	err      string
+	panicked bool
+}
+
+func encodeWith(f func(sqltypes.Value) ([]byte, error), v sqltypes.Value) (res encodeResult) {
+	defer func() {
+		if r := recover(); r != nil {
+			res = encodeResult{panicked: true}
+		}
+	}()
+	out, err := f(v)
+	if err != nil {
+		return encodeResult{err: err.Error()}
+	}
+	if len(out) == 0 {
+		out = nil
+	}
+	return encodeResult{out: out}
+}
+
+// newVal2MySQL runs the production path: size with val2MySQLLen, then encode
+// in place. Errors from val2MySQLLen surface the same way writeBinaryRow does.
+func newVal2MySQL(v sqltypes.Value) ([]byte, error) {
+	return val2MySQL(v)
+}
+
+// oldVal2MySQL mirrors the old writeBinaryRow, which also called
+// val2MySQLLen before val2MySQLOld.
+func oldVal2MySQL(v sqltypes.Value) ([]byte, error) {
+	l, err := val2MySQLLen(v)
+	if err != nil {
+		return nil, err
+	}
+	out, err := val2MySQLOld(v)
+	if err != nil {
+		return nil, err
+	}
+	if len(out) != l {
+		return nil, fmt.Errorf("length mismatch: val2MySQLLen=%d, encoded=%d", l, len(out))
+	}
+	return out, nil
+}
+
+var binaryRowTypes = []sqltypes.Type{
+	sqltypes.Null, sqltypes.Int8, sqltypes.Uint8, sqltypes.Int16, sqltypes.Uint16,
+	sqltypes.Int24, sqltypes.Uint24, sqltypes.Int32, sqltypes.Uint32, sqltypes.Int64,
+	sqltypes.Uint64, sqltypes.Float32, sqltypes.Float64, sqltypes.Timestamp,
+	sqltypes.Date, sqltypes.Time, sqltypes.Datetime, sqltypes.Year, sqltypes.Decimal,
+	sqltypes.Text, sqltypes.Blob, sqltypes.VarChar, sqltypes.VarBinary, sqltypes.Char,
+	sqltypes.Binary, sqltypes.Bit, sqltypes.Enum, sqltypes.Set, sqltypes.Geometry,
+	sqltypes.TypeJSON, sqltypes.Vector, sqltypes.HexNum, sqltypes.HexVal, sqltypes.BitNum,
+}
+
+func binaryRowEdgeValues() []string {
+	vals := []string{
+		"", "0", "1", "-1", "127", "-128", "128", "255", "256", "-129",
+		"32767", "-32768", "65535", "65536", "8388607", "16777215",
+		"2147483647", "-2147483648", "4294967295", "4294967296",
+		"9223372036854775807", "-9223372036854775808", "18446744073709551615",
+		"18446744073709551616", "1.5", "-0.0", "3.4028235e38", "1e309", "NaN", "abc", " 1",
+		"2024", "1901", "2155",
+		"0000-00-00", "0000-00-00 00:00:00", "0000-00-00 00:00:00.0", "0000-00-00 00:00:00.000000",
+		"0000-00-00 00:00:00.", "0000-00-00 00:00:00.0000000", "0001-00-00",
+		"2020-01-02", "2020-01-02 03:04:05", "2020-01-02 03:04:05.1", "2020-01-02 03:04:05.123456",
+		"2020-01-02 03:04:05.1234567", "9999-12-31 23:59:59.999999", "1000-01-01 00:00:00.000001",
+		"2020/01/02", "2020-01-02 03:04:5x", "2020-01-02 03:04:05.12a", "----------",
+		"20200102", "2020-01-02T03:04:05", "2020-01-02 03:04:05 ",
+		"00:00:00", "00:00:00.0", "00:00:00.000000", "01:02:03", "-01:02:03", "838:59:59", "-838:59:59",
+		"838:59:59.000000", "-838:59:59.999999", "12:34:56.7", "12:34:56.1234567", "-00:00:01",
+		"25:00:00", "4294967295:00:00", "4294967296:00:00", "12:34", "12:34:56:78", "1.2:03:04",
+		"12:34:56.7.8", "12:3.4:56", ":::", "::", ".", "12:34:56.", "12:34:.5", "--1:00:00",
+		"-:00:00", "12:60:61", "12:256:00", "1:2:3",
+		"12.345", "-99999999999999999999999999999999999.99", "a", "'quoted'", "\x00\xff",
+		`{"a":1}`, "a,b", "\x01", strings.Repeat("x", 250), strings.Repeat("x", 251),
+		strings.Repeat("y", 65535), strings.Repeat("y", 65536), strings.Repeat("z", 1<<16+17),
+	}
+	return vals
+}
+
+func randomBinaryRowValue(r *rand.Rand, typ sqltypes.Type) string {
+	switch typ {
+	case sqltypes.Int8, sqltypes.Int16, sqltypes.Int24, sqltypes.Int32, sqltypes.Int64:
+		return strconv.FormatInt(int64(r.Uint64())>>r.IntN(64), 10)
+	case sqltypes.Uint8, sqltypes.Uint16, sqltypes.Uint24, sqltypes.Uint32, sqltypes.Uint64, sqltypes.Year:
+		return strconv.FormatUint(r.Uint64()>>r.IntN(64), 10)
+	case sqltypes.Float32:
+		return strconv.FormatFloat(float64(r.Float32()*1e6-5e5), 'g', -1, 32)
+	case sqltypes.Float64:
+		return strconv.FormatFloat(r.NormFloat64()*1e12, 'g', -1, 64)
+	case sqltypes.Date:
+		return fmt.Sprintf("%04d-%02d-%02d", r.IntN(10000), r.IntN(13), r.IntN(32))
+	case sqltypes.Datetime, sqltypes.Timestamp:
+		s := fmt.Sprintf("%04d-%02d-%02d %02d:%02d:%02d", r.IntN(10000), r.IntN(13), r.IntN(32), r.IntN(24), r.IntN(60), r.IntN(60))
+		if prec := r.IntN(8); prec > 0 {
+			s += "." + fmt.Sprintf("%07d", r.IntN(10000000))[:prec]
+		}
+		return s
+	case sqltypes.Time:
+		s := fmt.Sprintf("%02d:%02d:%02d", r.IntN(839), r.IntN(60), r.IntN(60))
+		if r.IntN(2) == 0 {
+			s = "-" + s
+		}
+		if prec := r.IntN(8); prec > 0 {
+			s += "." + fmt.Sprintf("%07d", r.IntN(10000000))[:prec]
+		}
+		return s
+	case sqltypes.Decimal:
+		return fmt.Sprintf("%d.%d", r.Int64()>>r.IntN(64)-r.Int64()>>r.IntN(64), r.IntN(1000000))
+	default:
+		b := make([]byte, r.IntN(300))
+		for i := range b {
+			b[i] = byte(r.Uint32())
+		}
+		return string(b)
+	}
+}
+
+// TestVal2MySQLToMatchesReference checks that the in-place encoder produces
+// byte-identical output, errors and panics to the previous allocating encoder
+// for every type, over edge cases and random values.
+func TestVal2MySQLToMatchesReference(t *testing.T) {
+	check := func(typ sqltypes.Type, raw string) {
+		v := sqltypes.MakeTrusted(typ, []byte(raw))
+		want := encodeWith(oldVal2MySQL, v)
+		got := encodeWith(newVal2MySQL, v)
