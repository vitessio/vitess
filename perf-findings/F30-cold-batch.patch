+package mysql
+
+import (
+	"net"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+type f30DiscardConn struct{ net.Conn }
+
+func (f30DiscardConn) Write(b []byte) (int, error) { return len(b), nil }
+func (f30DiscardConn) Close() error                { return nil }
+
+func BenchmarkF30WritePacket(b *testing.B) {
+	c := newConn(f30DiscardConn{}, 0, 0)
+	c.startWriterBuffering()
+	data := make([]byte, 4+100)
+	b.ReportAllocs()
+	for b.Loop() {
+		if err := c.writePacket(data); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+func TestF30WritePacketNoAlloc(t *testing.T) {
+	c := newConn(f30DiscardConn{}, 0, 0)
+	c.startWriterBuffering()
+	data := make([]byte, 4+100)
+	require.Zero(t, testing.AllocsPerRun(100, func() {
+		require.NoError(t, c.writePacket(data))
+	}))
+}
+
+func TestF30BitmapBitCountEquivalence(t *testing.T) {
+	for count := 0; count <= 70; count++ {
+		for _, fill := range []byte{0x00, 0xff, 0xa5, 0x5a} {
+			data := make([]byte, (count+7)/8)
+			for i := range data {
+				data[i] = fill ^ byte(i*37)
+			}
+			bm, _ := newBitmap(data, 0, count)
+			want := 0
+			for i := range count {
+				if bm.Bit(i) {
+					want++
+				}
+			}
+			require.Equal(t, want, bm.BitCount(), "count=%d fill=%x", count, fill)
+		}
+	}
+}
