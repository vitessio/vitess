+// previewToLower returns s lowercased, like strings.ToLower, but without
+// allocating when s is ASCII. buf is used as scratch space for the result,
+// which is only valid until buf is modified. ASCII strings longer than buf
+// cannot match any keyword and yield "".
+func previewToLower(buf []byte, s string) string {
+	hasUpper := false
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c >= utf8.RuneSelf {
+			// Keep the exact Unicode semantics of strings.ToLower
+			// (e.g. the Kelvin sign lowercases to 'k').
+			return strings.ToLower(s)
+		}
+		hasUpper = hasUpper || ('A' <= c && c <= 'Z')
+	}
+	if !hasUpper {
+		return s
+	}
+	if len(s) > len(buf) {
+		return ""
+	}
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if 'A' <= c && c <= 'Z' {
+			c += 'a' - 'A'
+		}
+		buf[i] = c
+	}
+	return hack.String(buf[:len(s)])
+}
