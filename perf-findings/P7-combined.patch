+// typeNames caches the protobuf enum names of sqltypes.Type, indexed by the
+// low byte of the type value (the MySQL type id, which is unique across all
+// types; the upper bits are flags). It is built from querypb.Type_name so it
+// always stays in sync with the proto definition.
+var typeNames = func() (names [256]typeNameEntry) {
+	for v, name := range querypb.Type_name {
+		e := &names[v&0xff]
+		switch {
+		case e.typ == sqltypes.Unknown:
+			// slot already disabled by a collision
+		case e.name != "":
+			// Two types share the same low byte: disable this slot so that
+			// typeName falls back to the protobuf lookup for both of them.
+			e.typ, e.name = sqltypes.Unknown, ""
+		default:
+			e.typ, e.name = sqltypes.Type(v), name
+		}
+	}
+	return names
+}()
+
+type typeNameEntry struct {
+	typ  sqltypes.Type
+	name string
+}
+
+// typeName returns the same result as t.String(), but avoids the protobuf
+// reflection lookup for known types.
+func typeName(t sqltypes.Type) string {
+	if e := &typeNames[uint8(t)]; e.typ == t && e.name != "" {
+		return e.name
+	}
+	return t.String()
+}
