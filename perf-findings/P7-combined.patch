+limitations under the License.
+*/
+
+package json
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"unicode/utf16"
+	"unicode/utf8"
+)
+
+// This file keeps the previous byte-at-a-time implementations of the JSON
+// string escaping helpers as a reference for equivalence tests and A/B
+// benchmarks.
+
+func escapeStringRef(dst []byte, s string) []byte {
+	if !utf8.ValidString(s) {
+		s = string([]rune(s))
+	}
+	if !hasSpecialCharsRef(s) {
+		dst = append(dst, '"')
+		dst = append(dst, s...)
+		dst = append(dst, '"')
+		return dst
+	}
+	dst = append(dst, '"')
+	for i := 0; i < len(s); i++ {
+		ch := s[i]
+		switch ch {
+		case '"', '\\':
+			dst = append(dst, '\\', ch)
+		case '\b':
+			dst = append(dst, '\\', 'b')
+		case '\f':
+			dst = append(dst, '\\', 'f')
+		case '\n':
+			dst = append(dst, '\\', 'n')
+		case '\r':
+			dst = append(dst, '\\', 'r')
+		case '\t':
+			dst = append(dst, '\\', 't')
+		default:
+			if ch < 0x20 {
+				dst = append(dst, '\\', 'u', '0', '0', hexDigits[ch>>4], hexDigits[ch&0x0f])
+				continue
+			}
+			dst = append(dst, ch)
+		}
+	}
+	dst = append(dst, '"')
+	return dst
+}
+
+func hasSpecialCharsRef(s string) bool {
+	if strings.IndexByte(s, '"') >= 0 || strings.IndexByte(s, '\\') >= 0 {
+		return true
+	}
+	for i := range len(s) {
+		if s[i] < 0x20 {
+			return true
+		}
+	}
+	return false
+}
+
+// scanJSONStringRef is the previous closing-quote scan of
+// sqlWriter.writeStringContent. data[pos] is the first byte after the
+// opening quote. It returns the index of the closing quote and whether an
+// escape sequence was seen.
+func scanJSONStringRef(data []byte, pos int) (int, bool, error) {
+	hasEscape := false
+	for pos < len(data) {
+		ch := data[pos]
+		if ch == '\\' {
+			if pos+1 >= len(data) {
+				return 0, false, errors.New("unterminated string in JSON")
+			}
+			hasEscape = true
+			pos += 2
+			continue
+		}
+		if ch == '"' {
+			break
+		}
+		pos++
+	}
+	if pos >= len(data) {
+		return 0, false, errors.New("unterminated string in JSON")
+	}
+	return pos, hasEscape, nil
+}
+
+func unescapeJSONRef(dst, src []byte) ([]byte, error) {
+	i := 0
+	for i < len(src) {
+		if src[i] != '\\' {
+			dst = append(dst, src[i])
+			i++
+			continue
+		}
+		if i+1 >= len(src) {
+			return dst, errors.New("truncated escape sequence in JSON string")
+		}
+		i++
+		switch src[i] {
+		case '"', '\\', '/':
+			dst = append(dst, src[i])
+			i++
+		case 'b':
+			dst = append(dst, '\b')
+			i++
+		case 'f':
+			dst = append(dst, '\f')
+			i++
+		case 'n':
+			dst = append(dst, '\n')
+			i++
+		case 'r':
+			dst = append(dst, '\r')
+			i++
+		case 't':
+			dst = append(dst, '\t')
+			i++
+		case 'u':
+			i++
+			if i+4 > len(src) {
+				return dst, errors.New("truncated \\u escape in JSON string")
+			}
+			r := parseHex4(src[i : i+4])
+			if r < 0 {
+				return dst, fmt.Errorf("invalid hex digit in \\u escape: %q", src[i:i+4])
+			}
+			i += 4
+			if utf16.IsSurrogate(r) {
+				if i+6 <= len(src) && src[i] == '\\' && src[i+1] == 'u' {
+					r2 := parseHex4(src[i+2 : i+6])
+					if r2 >= 0 {
+						combined := utf16.DecodeRune(r, r2)
+						if combined != utf8.RuneError {
+							dst = utf8.AppendRune(dst, combined)
+							i += 6
+							continue
+						}
+					}
+				}
+				dst = utf8.AppendRune(dst, utf8.RuneError)
+				continue
+			}
+			dst = utf8.AppendRune(dst, r)
+		default:
+			return dst, fmt.Errorf("invalid escape character %q in JSON string", src[i])
+		}
+	}
+	return dst, nil
+}
