+
+package json
+
+import (
+	"strings"
+	"testing"
+
+	"vitess.io/vitess/go/bytes2"
+)
+
+const benchLorem = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip. "
+
+// escapeBenchDocs are realistic JSON documents: an object with several string
+// fields, as commonly stored in a JSON column.
+var escapeBenchDocs = []struct {
+	name string
+	doc  string
+}{
+	{"user", `{"id": "8c2f5e4a-1b7d-4c9e-a3f0-2d6b8e1c4f7a", "name": "John Smith", "email": "john.smith@example.com", "address": "123 Main Street, Springfield, IL 62701", "status": "active", "age": 42, "bio": "` + benchLorem[:200] + `", "tags": ["admin", "beta", "newsletter"]}`},
+	{"user_escapes", `{"id": "8c2f5e4a-1b7d-4c9e-a3f0-2d6b8e1c4f7a", "name": "John \"Johnny\" Smith", "email": "john.smith@example.com", "address": "123 Main Street\nSpringfield, IL 62701", "status": "active", "age": 42, "bio": "` + strings.ReplaceAll(benchLorem[:200], ". ", ".\\n") + `", "tags": ["admin", "beta", "newsletter"]}`},
+	{"long_text", `{"id": 1, "title": "A long article", "body": "` + strings.Repeat(benchLorem[:200], 50) + `"}`},
+}
+
+func BenchmarkMarshalTo(b *testing.B) {
+	for _, d := range escapeBenchDocs {
+		b.Run(d.name, func(b *testing.B) {
+			var p Parser
+			v, err := p.Parse(d.doc)
+			if err != nil {
+				b.Fatal(err)
+			}
+			// Decode the lazily unescaped strings, so that MarshalTo escapes
+			// them again as it does for documents decoded from binlog events.
+			materializeStrings(v)
+			dst := v.MarshalTo(nil)
+			b.SetBytes(int64(len(d.doc)))
+			for b.Loop() {
+				dst = v.MarshalTo(dst[:0])
+			}
+		})
+	}
+}
+
+func BenchmarkAppendMarshalSQL(b *testing.B) {
+	for _, d := range escapeBenchDocs {
+		b.Run(d.name, func(b *testing.B) {
+			raw := []byte(d.doc)
+			buf := &bytes2.Buffer{}
+			b.SetBytes(int64(len(raw)))
+			for b.Loop() {
+				buf.Reset()
+				if err := AppendMarshalSQL(buf, raw); err != nil {
+					b.Fatal(err)
+				}
+			}
+		})
+		b.Run(d.name+"/MarshalSQLValue", func(b *testing.B) {
+			raw := []byte(d.doc)
+			b.ReportAllocs()
+			b.SetBytes(int64(len(raw)))
+			for b.Loop() {
+				if _, err := MarshalSQLValue(raw); err != nil {
+					b.Fatal(err)
+				}
+			}
+		})
+	}
+}
+
+func materializeStrings(v *Value) {
+	switch v.Type() {
+	case TypeObject:
+		for _, kv := range v.o.kvs {
+			materializeStrings(kv.v)
+		}
+	case TypeArray:
+		for _, vv := range v.a {
+			materializeStrings(vv)
+		}
+	}
+}
