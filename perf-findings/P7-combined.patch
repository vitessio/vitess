+var binaryRowTypes = []sqltypes.Type{
+	sqltypes.Null, sqltypes.Int8, sqltypes.Uint8, sqltypes.Int16, sqltypes.Uint16,
+	sqltypes.Int24, sqltypes.Uint24, sqltypes.Int32, sqltypes.Uint32, sqltypes.Int64,
+	sqltypes.Uint64, sqltypes.Float32, sqltypes.Float64, sqltypes.Timestamp,
+	sqltypes.Date, sqltypes.Time, sqltypes.Datetime, sqltypes.Year, sqltypes.Decimal,
+	sqltypes.Text, sqltypes.Blob, sqltypes.VarChar, sqltypes.VarBinary, sqltypes.Char,
+	sqltypes.Binary, sqltypes.Bit, sqltypes.Enum, sqltypes.Set, sqltypes.Geometry,
+	sqltypes.TypeJSON, sqltypes.Vector, sqltypes.HexNum, sqltypes.HexVal, sqltypes.BitNum,
+}
