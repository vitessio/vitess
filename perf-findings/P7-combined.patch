+	rc := &recordingConn{}
+	c := newConn(rc, DefaultFlushDelay, 0)
+	row := []sqltypes.Value{sqltypes.NewInt64(12345), sqltypes.NewVarChar("some short value")}
+	b.ReportAllocs()
+	for b.Loop() {
+		c.startWriterBuffering()
+		for range 1000 {
+			if err := c.writeRow(row); err != nil {
+				b.Fatal(err)
+			}
+		}
+		if err := c.endWriterBuffering(); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
