+// encodeDecimal returns a random value in MySQL's binary DECIMAL format.
+// Digit groups are valid most of the time, and often zero, to exercise the
+// trimming of leading zeroes.
+func encodeDecimal(r *rand.Rand, precision, scale int) []byte {
+	intg := precision - scale
+	intg0, intg0x := intg/9, intg%9
+	frac0, frac0x := scale/9, scale%9
+	pow10 := func(n int) uint32 {
+		p := uint32(1)
+		for range n {
+			p *= 10
+		}
+		return p
+	}
+	group := func(digits int) uint32 {
+		switch r.IntN(4) {
+		case 0:
+			return 0
+		case 1:
+			return pow10(digits) - 1
+		default:
+			return r.Uint32N(pow10(digits))
+		}
+	}
+	var out []byte
+	put := func(v uint32, size int) {
+		for i := size - 1; i >= 0; i-- {
+			out = append(out, byte(v>>(8*i)))
+		}
+	}
+	put(group(intg0x), dig2bytes[intg0x])
+	for range intg0 {
+		put(group(9), 4)
+	}
+	for range frac0 {
+		put(group(9), 4)
+	}
+	put(group(frac0x), dig2bytes[frac0x])
+	if len(out) == 0 {
+		return out
+	}
+	if r.IntN(2) == 0 {
+		for i := range out {
+			out[i] ^= 0xff
+		}
+	}
+	out[0] ^= 0x80
+	return out
+}
+
+// TestCellValueDecimalFormatEquivalence checks that the DECIMAL formatter
+// produces byte-identical output to the previous fmt-based implementation,
+// for every precision and scale that MySQL supports.
+func TestCellValueDecimalFormatEquivalence(t *testing.T) {
+	r := rand.New(rand.NewPCG(3, 4))
+	for precision := 1; precision <= 65; precision++ {
+		for scale := 0; scale <= min(precision, 30); scale++ {
+			metadata := uint16(precision)<<8 | uint16(scale)
+			n, err := CellLength(nil, 0, TypeNewDecimal, metadata)
+			require.NoError(t, err)
+			for _, fill := range []byte{0x00, 0xff, 0x80, 0x7f} {
+				b := make([]byte, n)
+				for i := range b {
+					b[i] = fill
+				}
+				requireSameCellValue(t, b, TypeNewDecimal, metadata)
+			}
+			for range 300 {
+				requireSameCellValue(t, encodeDecimal(r, precision, scale), TypeNewDecimal, metadata)
+				requireSameCellValue(t, randomBytes(r, n), TypeNewDecimal, metadata)
+			}
+		}
+	}
+	// Metadata that MySQL never produces, including binary values that do
+	// not fit in the stack buffers.
+	for _, metadata := range []uint16{0, 0x0000 | 0, 90<<8 | 0, 200<<8 | 30, 255<<8 | 255, 255<<8 | 0, 100<<8 | 60} {
+		n, err := CellLength(nil, 0, TypeNewDecimal, metadata)
+		require.NoError(t, err)
+		for range 300 {
+			requireSameCellValue(t, randomBytes(r, n), TypeNewDecimal, metadata)
+		}
+	}
+}
+
+// FuzzCellValueFormat checks that the temporal and DECIMAL formatters produce
+// byte-identical output to the previous fmt-based implementation.
+func FuzzCellValueFormat(f *testing.F) {
+	f.Add(byte(TypeDateTime2), uint16(6), []byte{0x99, 0xb4, 0x2a, 0x7b, 0x5e, 0x0f, 0x42, 0x3f})
+	f.Add(byte(TypeNewDecimal), uint16(19<<8|4), []byte{0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x04, 0xd2, 0x00, 0x00})
+	f.Fuzz(func(t *testing.T, typIndex byte, metadata uint16, data []byte) {
+		types := []byte{TypeDate, TypeNewDate, TypeTime, TypeDateTime, TypeTimestamp, TypeTimestamp2, TypeDateTime2, TypeTime2, TypeNewDecimal}
+		typ := types[int(typIndex)%len(types)]
+		if typ == TypeNewDecimal && int(metadata&0xff) > int(metadata>>8) {
+			metadata = metadata&0xff00 | metadata>>8
+		}
+		requireSameCellValue(t, data, typ, metadata)
+	})
+}
