+// recordingConn is a net.Conn that discards writes but records how many
+// Write calls reached it and how many bytes they carried. It is safe for
+// concurrent use because the flush timer writes from its own goroutine.
+type recordingConn struct {
+	net.Conn // nil; only Write and Close are used.
+
+	mu         sync.Mutex
+	writes     int
+	bytes      int
+	firstWrite int
+}
+
+func (r *recordingConn) Write(b []byte) (int, error) {
+	r.mu.Lock()
+	if r.writes == 0 {
+		r.firstWrite = len(b)
+	}
+	r.writes++
+	r.bytes += len(b)
+	r.mu.Unlock()
+	return len(b), nil
+}
+
+func (r *recordingConn) Close() error { return nil }
+
+func (r *recordingConn) stats() (writes, bytes int) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.writes, r.bytes
+}
+
+// TestFlushTimerFlushesIdleBuffer checks that buffered data is flushed by the
+// flush timer once the writer goes idle, without an explicit flush.
+func TestFlushTimerFlushesIdleBuffer(t *testing.T) {
+	rc := &recordingConn{}
+	c := newConn(rc, 50*time.Millisecond, 0)
+	c.startWriterBuffering()
+	t.Cleanup(func() { _ = c.endWriterBuffering() })
+
+	row := []sqltypes.Value{sqltypes.NewInt64(1), sqltypes.NewVarChar("abc")}
+	require.NoError(t, c.writeRow(row))
+	require.NoError(t, c.writeRow(row))
+
+	assert.Eventually(t, func() bool {
+		_, n := rc.stats()
+		return n > 0
+	}, 30*time.Second, 5*time.Millisecond)
+
+	writes, _ := rc.stats()
+	assert.Equal(t, 1, writes, "both rows must be flushed together by a single timer flush")
+
+	// A later write after the timer fired must re-arm the timer.
+	require.NoError(t, c.writeRow(row))
+	assert.Eventually(t, func() bool {
+		w, _ := rc.stats()
+		return w == 2
+	}, 30*time.Second, 5*time.Millisecond)
+}
+
+// TestFlushTimerBoundsLatencyWhileStreaming checks that buffered data is
+// flushed within roughly one flush delay of being written even when the
+// writer keeps writing more often than the flush delay, and that the timer
+// does not flush once per packet.
+func TestFlushTimerBoundsLatencyWhileStreaming(t *testing.T) {
+	const delay = 50 * time.Millisecond
+	rc := &recordingConn{}
+	c := newConn(rc, delay, 0)
+	c.startWriterBuffering()
+	t.Cleanup(func() { _ = c.endWriterBuffering() })
+
+	row := []sqltypes.Value{sqltypes.NewInt64(1), sqltypes.NewVarChar("abc")}
+	packets := 0
+	start := time.Now()
+	// Write a small row every millisecond; the buffer never fills up, so any
+	// flush observed here comes from the flush timer.
+	for {
+		require.NoError(t, c.writeRow(row))
+		packets++
+		if w, _ := rc.stats(); w > 0 {
+			break
+		}
+		require.Less(t, time.Since(start), 30*time.Second, "flush timer never fired while streaming")
+		time.Sleep(time.Millisecond)
+	}
+	rc.mu.Lock()
+	firstWrite := rc.firstWrite
+	rc.mu.Unlock()
+	// A full buffer is flushed by bufio itself; the flush timer must have
+	// fired well before that, instead of being pushed back by every write.
+	assert.Less(t, firstWrite, connBufferSize, "first flush came from a full buffer after %d packets, not from the flush timer", packets)
+
+	// Keep streaming for a few more flush delays: the number of flushes must
+	// stay in the order of elapsed/delay, not in the order of packets written.
+	for range 200 {
+		require.NoError(t, c.writeRow(row))
+		packets++
+		time.Sleep(time.Millisecond)
+	}
+	writes, _ := rc.stats()
+	elapsed := time.Since(start)
+	assert.LessOrEqual(t, writes, int(elapsed/delay)+1, "flush storm: %d writes for %d packets in %v", writes, packets, elapsed)
+}
