+	// An open, idle pool and a pool whose connection is in use but has no waiters: no expire runs.
+	assert.Never(t, func() bool { return p.wait.expireRuns.Load() > 0 }, 500*time.Millisecond, 50*time.Millisecond)
+	conn, err := p.Get(t.Context(), nil)
+	require.NoError(t, err)
+	assert.Never(t, func() bool { return p.wait.expireRuns.Load() > 0 }, 300*time.Millisecond, 50*time.Millisecond)
+
+	// A client waits for the only connection: the expire worker runs while it waits.
+	waitDone := make(chan error, 1)
+	go func() {
+		ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
+		defer cancel()
+		c, err := p.Get(ctx, nil)
+		if err == nil {
+			p.put(c)
+		}
+		waitDone <- err
+	}()
+	assert.Eventually(t, func() bool { return p.wait.expireRuns.Load() > 0 }, 30*time.Second, 10*time.Millisecond)
+
+	// Once nobody waits anymore, the worker goes back to sleep.
+	p.put(conn)
+	require.NoError(t, <-waitDone)
+	runs := p.wait.expireRuns.Load()
+	assert.Never(t, func() bool { return p.wait.expireRuns.Load() > runs+1 }, 500*time.Millisecond, 50*time.Millisecond)
+}
