+// referenceHash hashes src the way the collations did before their weights
+// were batched: one hasher write per codepoint. It returns false for the
+// collations whose Hash does not write per-codepoint weights.
+func referenceHash(coll Collation, hasher *vthash.Hasher, src []byte, numCodepoints int) bool {
+	switch c := coll.(type) {
+	case *Collation_8bit_simple_ci:
+		tocopy := len(src)
+		if numCodepoints > 0 {
+			tocopy = min(tocopy, numCodepoints)
+		}
+		hasher.Write64(uint64(c.id))
+		for _, ch := range src[:tocopy] {
+			hasher.Write8(c.sort[ch])
+		}
+		for n := numCodepoints - tocopy; numCodepoints > 0 && n > 0; n-- {
+			hasher.Write8(' ')
+		}
+	case *Collation_unicode_general_ci:
+		hasher.Write64(uint64(c.id))
+		left := numCodepoints
+		if left == 0 {
+			left = math.MaxInt32
+		}
+		for left > 0 {
+			r, width, ok := c.charset.DecodeRune(src)
+			if !ok {
+				break
+			}
+			src = src[width:]
+			hasher.Write16(bits.ReverseBytes16(uint16(c.unicase.unicodeSort(r))))
+			left--
+		}
+		for ; numCodepoints > 0 && left > 0; left-- {
+			hasher.Write16(bits.ReverseBytes16(0x0020))
+		}
+	case *Collation_unicode_bin:
+		hasher.Write64(uint64(c.id))
+		left := numCodepoints
+		if left == 0 {
+			left = math.MaxInt32
+		}
+		supplementary := c.charset.SupportsSupplementaryChars()
+		for left > 0 {
+			r, width, ok := c.charset.DecodeRune(src)
+			if !ok {
+				break
+			}
+			src = src[width:]
+			if supplementary {
+				hasher.Write32(bits.ReverseBytes32(uint32(r)))
+			} else {
+				hasher.Write16(bits.ReverseBytes16(uint16(r)))
+			}
+			left--
+		}
+		for ; numCodepoints > 0 && left > 0; left-- {
+			if supplementary {
+				hasher.Write32(bits.ReverseBytes32(0x20))
+			} else {
+				hasher.Write16(bits.ReverseBytes16(0x20))
+			}
+		}
+	case *Collation_uca_legacy:
+		it := c.uca.Iterator(src)
+		hasher.Write64(uint64(c.id))
+		for {
+			w, ok := it.Next()
+			if !ok {
+				break
+			}
+			hasher.Write16(bits.ReverseBytes16(w))
+		}
+		if numCodepoints > 0 {
+			numCodepoints -= it.Length()
+			for ; numCodepoints > 0; numCodepoints-- {
+				hasher.Write16(bits.ReverseBytes16(c.uca.WeightForSpace()))
+			}
+		}
+	case *Collation_multibyte:
+		hasher.Write64(uint64(c.id))
+		left := numCodepoints
+		if left == 0 {
+			left = math.MaxInt32
+		}
+		for len(src) > 0 && left > 0 {
+			w := src[0]
+			if w <= 127 {
+				if c.sort != nil {
+					w = c.sort[w]
+				}
+				hasher.Write8(w)
+				src = src[1:]
+			} else {
+				_, width, _ := c.charset.DecodeRune(src)
+				hasher.Write(src[:width])
+				src = src[width:]
+			}
+			left--
+		}
+		for ; numCodepoints > 0 && left > 0; left-- {
+			hasher.Write8(' ')
+		}
+	default:
+		return false
+	}
+	return true
+}
+
+// TestHashMatchesPerCodepointHash checks that batching the collation weights
+// before hashing them does not change any hash: vtgate compares these hashes
+// for hash joins and DISTINCT, and they must stay stable.
+func TestHashMatchesPerCodepointHash(t *testing.T) {
+	rng := rand.New(rand.NewPCG(1, 2))
+	corpus := []string{
+		"", "a", "abc   ", "The quick brown fox jumps over the lazy dog!",
+		"Thé quick brówn fox jumps över the lazy dög", "日本語のテキストと漢字が混ざった文字列",
+		"😀 emoji 𝄞 clef", "\xff\xfea\x80", strings.Repeat("x", 100), strings.Repeat("ä", 70),
+	}
+	for range 100 {
+		// Mostly ASCII text with some non-ASCII codepoints and invalid bytes.
+		var sb strings.Builder
+		for range rng.IntN(150) {
+			switch rng.IntN(8) {
+			case 0:
+				sb.WriteRune(rune(0x80 + rng.IntN(0x780)))
+			case 1:
+				sb.WriteRune(rune(0x800 + rng.IntN(0xD000)))
+			case 2:
+				sb.WriteRune(rune(0x10000 + rng.IntN(0x10000)))
+			case 3:
+				sb.WriteByte(byte(0x80 + rng.IntN(0x80)))
+			default:
+				sb.WriteByte(byte(rng.IntN(0x80)))
+			}
+		}
+		corpus = append(corpus, sb.String())
+	}
+
+	var tested int
+	for _, coll := range All(collations.MySQL8()) {
+		for _, text := range corpus {
+			inputs := [][]byte{[]byte(text)}
+			if native, err := charset.ConvertFromUTF8(nil, coll.Charset(), []byte(text)); err == nil {
+				inputs = append(inputs, native)
+			}
+			for _, src := range inputs {
+				for _, numCodepoints := range []int{0, 1, 7, 40, 200} {
+					want := vthash.New()
+					if !referenceHash(coll, &want, src, numCodepoints) {
+						continue
+					}
+					got := vthash.New()
+					coll.Hash(&got, src, numCodepoints)
+					require.Equal(t, want.Sum128(), got.Sum128(), "collation %s, input %q, numCodepoints %d", coll.Name(), src, numCodepoints)
+					tested++
+				}
+			}
+		}
+	}
+	require.Positive(t, tested)
+}
