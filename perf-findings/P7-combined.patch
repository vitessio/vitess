+		{"TIME2_0", TypeTime2, 0, querypb.Type_TIME, []byte{0x80, 0xc7, 0x8e}},
+		{"TIME2_6", TypeTime2, 6, querypb.Type_TIME, []byte{0x7f, 0x38, 0x71, 0xfe, 0x1d, 0xc0}},
+		{"DATETIME2_0", TypeDateTime2, 0, querypb.Type_DATETIME, []byte{0x99, 0xb4, 0x2a, 0x7b, 0x5e}},
+		{"DATETIME2_3", TypeDateTime2, 3, querypb.Type_DATETIME, []byte{0x99, 0xb4, 0x2a, 0x7b, 0x5e, 0x04, 0xd2}},
+		{"DATETIME2_6", TypeDateTime2, 6, querypb.Type_DATETIME, []byte{0x99, 0xb4, 0x2a, 0x7b, 0x5e, 0x0f, 0x42, 0x3f}},
+		{"TIMESTAMP2_0", TypeTimestamp2, 0, querypb.Type_TIMESTAMP, []byte{0x67, 0xd1, 0xae, 0xf0}},
+		{"TIMESTAMP2_6", TypeTimestamp2, 6, querypb.Type_TIMESTAMP, []byte{0x67, 0xd1, 0xae, 0xf0, 0x0f, 0x42, 0x3f}},
+		{"DECIMAL_10_2", TypeNewDecimal, 10<<8 | 2, querypb.Type_DECIMAL, []byte{0x80, 0x01, 0xe2, 0x40, 0x2d}},
+		{"DECIMAL_19_4", TypeNewDecimal, 19<<8 | 4, querypb.Type_DECIMAL, []byte{0x80, 0x00, 0x00, 0x00, 0x00, 0x04, 0xd2, 0x16, 0x2e}},
+		{"DECIMAL_65_30", TypeNewDecimal, 65<<8 | 30, querypb.Type_DECIMAL, encodeDecimal(rand.New(rand.NewPCG(5, 6)), 65, 30)},
+	}
+}
+
+var cellValueImpls = []struct {
+	name string
+	fn   func([]byte, int, byte, uint16, *querypb.Field, bool) (sqltypes.Value, int, error)
+}{{"old", cellValueReference}, {"new", CellValue}}
+
+func BenchmarkCellValueFormat(b *testing.B) {
+	for _, c := range benchCells() {
+		field := &querypb.Field{Type: c.field}
+		for _, impl := range cellValueImpls {
+			b.Run(fmt.Sprintf("type=%s/impl=%s", c.name, impl.name), func(b *testing.B) {
+				b.ReportAllocs()
+				v, l, err := impl.fn(c.data, 0, c.typ, c.metadata, field, false)
+				if err != nil || l != len(c.data) {
+					b.Fatalf("CellValue(%s) = %v, %d, %v", c.name, v, l, err)
+				}
+				for b.Loop() {
+					_, _, _ = impl.fn(c.data, 0, c.typ, c.metadata, field, false)
+				}
+			})
+		}
+	}
+}
+
+// BenchmarkCellValueRow decodes a row that mixes integer, string, temporal
+// and DECIMAL columns, as the vstreamer does for every row event.
+func BenchmarkCellValueRow(b *testing.B) {
+	var types []byte
+	var metadata []uint16
+	var fields []*querypb.Field
+	var data []byte
+	cells := benchCells()
+	for _, name := range []string{"BIGINT", "INT", "VARCHAR", "VARCHAR", "DECIMAL_10_2", "DECIMAL_19_4", "DATE", "DATETIME2_0", "DATETIME2_6", "TIMESTAMP2_0", "INT"} {
+		for _, c := range cells {
+			if c.name == name {
+				types = append(types, c.typ)
+				metadata = append(metadata, c.metadata)
+				fields = append(fields, &querypb.Field{Type: c.field})
+				data = append(data, c.data...)
+			}
+		}
+	}
+	values := make([]sqltypes.Value, len(types))
+	for _, impl := range cellValueImpls {
+		b.Run("impl="+impl.name, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				pos := 0
+				for i := range types {
+					v, l, err := impl.fn(data, pos, types[i], metadata[i], fields[i], false)
+					if err != nil {
+						b.Fatal(err)
+					}
+					values[i] = v
+					pos += l
+				}
+				if pos != len(data) {
+					b.Fatalf("decoded %d bytes out of %d", pos, len(data))
+				}
+			}
+		})
+	}
+}
