+	"github.com/stretchr/testify/require"
+)
+
+// encodeSmallStringObject encodes a flat JSON object whose values are all
+// strings in the MySQL binary JSON format, as found in row events. The
+// encoded object must be smaller than 64KiB.
+func encodeSmallStringObject(keys, vals []string) []byte {
+	n := len(keys)
+	headerLen := 4 + 4*n + 3*n
+	obj := make([]byte, headerLen)
+	binary.LittleEndian.PutUint16(obj[0:], uint16(n))
+	for i, k := range keys {
+		binary.LittleEndian.PutUint16(obj[4+4*i:], uint16(len(obj)))
+		binary.LittleEndian.PutUint16(obj[4+4*i+2:], uint16(len(k)))
+		obj = append(obj, k...)
+	}
+	for i, v := range vals {
+		entry := 4 + 4*n + 3*i
+		obj[entry] = jsonString
+		binary.LittleEndian.PutUint16(obj[entry+1:], uint16(len(obj)))
+		obj = binary.AppendUvarint(obj, uint64(len(v)))
+		obj = append(obj, v...)
+	}
+	binary.LittleEndian.PutUint16(obj[2:], uint16(len(obj)))
+	return append([]byte{jsonSmallObject}, obj...)
+}
+
+// BenchmarkParseBinaryJSONMarshal measures the row event path for a JSON
+// column: decoding the binary JSON and marshaling it back to text JSON.
+func BenchmarkParseBinaryJSONMarshal(b *testing.B) {
+	const lorem = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip. "
+	docs := []struct {
+		name string
+		keys []string
+		vals []string
+	}{
+		{
+			"user",
+			[]string{"id", "bio", "name", "email", "status", "address"},
+			[]string{"8c2f5e4a-1b7d-4c9e-a3f0-2d6b8e1c4f7a", lorem[:200], "John Smith", "john.smith@example.com", "active", "123 Main Street, Springfield, IL 62701"},
+		},
+		{
+			"user_escapes",
+			[]string{"id", "bio", "name", "email", "status", "address"},
+			[]string{"8c2f5e4a-1b7d-4c9e-a3f0-2d6b8e1c4f7a", strings.ReplaceAll(lorem[:200], ". ", ".\n"), `John "Johnny" Smith`, "john.smith@example.com", "active", "123 Main Street\nSpringfield, IL 62701"},
+		},
+		{
+			"long_text",
+			[]string{"body", "title"},
+			[]string{strings.Repeat(lorem[:200], 50), "A long article"},
+		},
+	}
+	for _, d := range docs {
+		data := encodeSmallStringObject(d.keys, d.vals)
+		v, err := ParseBinaryJSON(data)
+		require.NoError(b, err)
+		require.Contains(b, string(v.MarshalTo(nil)), `"`+d.keys[1]+`": "`)
+		b.Run(d.name, func(b *testing.B) {
+			b.ReportAllocs()
+			b.SetBytes(int64(len(data)))
+			for b.Loop() {
+				v, err := ParseBinaryJSON(data)
+				if err != nil {
+					b.Fatal(err)
+				}
+				_ = v.MarshalTo(nil)
+			}
+		})
+	}
+}
