+func TestMysql56GTIDSetAddGTIDMatchesReference(t *testing.T) {
+	r := rand.New(rand.NewPCG(7, 8))
+	sids := []SID{randomSID(r), randomSID(r), randomSID(r)}
+	for range 500 {
+		set := Mysql56GTIDSet(nil)
+		if r.IntN(10) != 0 {
+			set = make(Mysql56GTIDSet)
+		}
+		ref := set
+		for range r.IntN(60) {
+			gtid := Mysql56GTID{Server: sids[r.IntN(len(sids))], Sequence: 1 + int64(r.IntN(40))}
+			before := referenceGTIDSetString(set)
+			set = set.AddGTID(gtid).(Mysql56GTIDSet)
+			ref = referenceAddGTID(ref, gtid)
+			require.True(t, ref.Equal(set), "adding %v to %s: got %s, want %s", gtid, before, set, ref)
+		}
+	}
+}
+
+func TestMysql56GTIDSetAddGTIDDoesNotModifyReceiver(t *testing.T) {
+	sid1 := SID{1}
+	sid2 := SID{2}
+	const want = "01000000-0000-0000-0000-000000000000:1-5:7-9,02000000-0000-0000-0000-000000000000:1-3"
+	set := Mysql56GTIDSet{sid1: {{1, 5}, {7, 9}}, sid2: {{1, 3}}}
+	for _, gtid := range []Mysql56GTID{
+		{Server: sid1, Sequence: 6}, {Server: sid1, Sequence: 12}, {Server: sid2, Sequence: 4}, {Server: SID{3}, Sequence: 1},
+	} {
+		added := set.AddGTID(gtid).(Mysql56GTIDSet)
+		assert.True(t, added.ContainsGTID(gtid))
+		assert.Equal(t, want, set.String())
+		// Mutating the new set in place must not modify the receiver either.
+		added.AddGTIDInPlace(Mysql56GTID{Server: sid1, Sequence: 20})
+		added.AddGTIDInPlace(Mysql56GTID{Server: sid2, Sequence: 20})
+		added.UnionInPlace(Mysql56GTIDSet{sid1: {{30, 40}}, sid2: {{30, 40}}})
+		assert.Equal(t, want, set.String())
+	}
+}
