+
+package servenv
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc/mem"
+	"google.golang.org/protobuf/proto"
+
+	"vitess.io/vitess/go/sqltypes"
+	querypb "vitess.io/vitess/go/vt/proto/query"
+)
+
+// TestCodecBufferPoolTiers checks that the codec pool hands out buffers from
+// the smallest power-of-two tier that fits. gRPC's default pool serves a
+// ~33 KiB streaming chunk from its 1 MiB tier and zeroes all of it.
+func TestCodecBufferPoolTiers(t *testing.T) {
+	cases := []struct {
+		size    int
+		wantCap int
+	}{
+		{size: 1, wantCap: 256},
+		{size: 256, wantCap: 256},
+		{size: 257, wantCap: 512},
+		{size: 33 * 1024, wantCap: 64 * 1024},
+		{size: 1<<20 + 1, wantCap: 2 << 20},
+		{size: 1 << 24, wantCap: 1 << 24},
+		{size: 1<<24 + 1, wantCap: 1<<24 + 1},
+	}
+	for _, tc := range cases {
+		t.Run(fmt.Sprint(tc.size), func(t *testing.T) {
+			buf := defaultBufferPool.Get(tc.size)
+			assert.Len(t, *buf, tc.size)
+			assert.Equal(t, tc.wantCap, cap(*buf))
+			defaultBufferPool.Put(buf)
+		})
+	}
+}
+
+func TestCodecBufferPoolPut(t *testing.T) {
+	p := &codecBufferPool{}
+	// buffers whose capacity is not a tier size are dropped, not handed out again
+	odd := make([]byte, 300, 300)
+	p.Put(&odd)
+	got := p.Get(300)
+	assert.Equal(t, 512, cap(*got))
+
+	// a returned buffer is reused for any size in its tier
+	p.Put(got)
+	again := p.Get(400)
+	assert.Len(t, *again, 400)
+	assert.Equal(t, 512, cap(*again))
+
+	empty := p.Get(0)
+	assert.Empty(t, *empty)
+}
+
+// TestCodecRoundTripDirtyBuffers marshals and unmarshals results through the
+// codec while the pool holds buffers full of garbage, to show that the codec
+// never reads bytes it did not write.
+func TestCodecRoundTripDirtyBuffers(t *testing.T) {
+	codec := &Codec{}
+	for _, rows := range []int{1, 10, 300, 5000} {
+		t.Run(fmt.Sprint(rows), func(t *testing.T) {
+			result := &sqltypes.Result{Fields: sqltypes.MakeTestFields("id|name", "int64|varchar")}
+			for i := range rows {
+				result.Rows = append(result.Rows, sqltypes.Row{sqltypes.NewInt64(int64(i)), sqltypes.NewVarChar(fmt.Sprintf("name-%d", i))})
+			}
+			in := &querypb.ExecuteResponse{Result: sqltypes.ResultToProto3(result)}
+
+			for range 3 {
+				// fill every tier the messages can use with garbage
+				size := in.SizeVT()
+				for _, s := range []int{size, size / 3, size / 2} {
+					if s == 0 {
+						continue
+					}
+					buf := defaultBufferPool.Get(s)
+					b := (*buf)[:cap(*buf)]
+					for i := range b {
+						b[i] = 0xff
+					}
+					defaultBufferPool.Put(buf)
+				}
+
+				data, err := codec.Marshal(in)
+				require.NoError(t, err)
+				// split the message into several buffers, as gRPC does with frames, so
+				// that Unmarshal has to materialize it into a pooled buffer
+				flat := data.Materialize()
+				data.Free()
+				var split mem.BufferSlice
+				for chunk := range chunks(flat, 1000) {
+					split = append(split, mem.SliceBuffer(chunk))
+				}
+
+				out := &querypb.ExecuteResponse{}
+				require.NoError(t, codec.Unmarshal(split, out))
+				assert.True(t, proto.Equal(in, out))
+			}
+		})
+	}
+}
+
+func chunks(b []byte, n int) func(func([]byte) bool) {
+	return func(yield func([]byte) bool) {
+		for len(b) > 0 {
+			c := b[:min(n, len(b))]
+			b = b[len(c):]
+			if !yield(c) {
+				return
+			}
+		}
+	}
+}
