+// makeSlabBenchResult builds a result without NULLs with realistic value sizes.
+func makeSlabBenchResult(rng *rand.Rand, numRows, numCols int) *Result {
+	fields := make([]*querypb.Field, numCols)
+	for i := range fields {
+		fields[i] = &querypb.Field{Name: "c" + strconv.Itoa(i), Type: Int64}
+		if i%2 == 1 {
+			fields[i].Type = VarChar
+		}
+	}
+	rows := make([]Row, numRows)
+	for i := range rows {
+		row := make(Row, numCols)
+		for j := range row {
+			if fields[j].Type == Int64 {
+				row[j] = NewInt64(rng.Int64N(1 << 40))
+			} else {
+				row[j] = NewVarChar(fmt.Sprintf("value-%d-%d", i, j))
+			}
