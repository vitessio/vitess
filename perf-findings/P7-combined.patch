+	p[0].Values = append(p[0].Values, 'x')
+	assert.Equal(t, []int64{1, 2}, p[1].Lengths)
+	assert.Equal(t, []byte("2cd"), p[1].Values)
+
+	fields := []*querypb.Field{{Type: Int64}, {Type: VarChar}}
+	back := proto3ToRows(fields, RowsToProto3(rows))
+	back[0] = append(back[0], NewInt64(99))
+	assert.Equal(t, Row{NewInt64(2), NewVarChar("cd")}, Row(back[1]))
+}
+
+var slabBenchShapes = [][2]int{{1, 5}, {10, 5}, {100, 5}, {1000, 5}, {10000, 20}}
+
+func BenchmarkRowsToProto3Slab(b *testing.B) {
