+
+// insertShardedParts holds the renderings of the sharded insert query that only depend on the plan,
+// so that they are computed once per plan instead of once per row on every execution.
+type insertShardedParts struct {
+	// mids[i] is sqlparser.String(ins.Mid[i]).
+	mids []string
+	// midArgs[i] lists the bind variables referenced by ins.Mid[i], in walk order.
+	midArgs [][]string
+	// suffix is sqlparser.String(ins.Suffix).
+	suffix string
+	// suffixArgs lists the bind variables referenced by ins.Suffix, in walk order.
+	suffixArgs []string
+	// vindexVarNames[vIdx][colIdx][row] is InsertVarName(ins.ColVindexes[vIdx].Columns[colIdx], row).
+	vindexVarNames [][][]string
+}
+
+// shardedParts returns the plan-constant parts of the sharded insert query, computing them on first use.
+// Plans are shared between concurrent executions, so the computation is guarded by a sync.Once.
+func (ins *Insert) shardedParts() *insertShardedParts {
+	ins.partsOnce.Do(func() {
+		ins.parts = buildInsertShardedParts(ins)
+	})
+	return ins.parts
+}
+
+func buildInsertShardedParts(ins *Insert) *insertShardedParts {
+	parts := &insertShardedParts{
+		mids:       make([]string, len(ins.Mid)),
+		midArgs:    make([][]string, len(ins.Mid)),
+		suffix:     sqlparser.String(ins.Suffix),
+		suffixArgs: insertArgNames(ins.Suffix),
+	}
+	for i, row := range ins.Mid {
+		parts.mids[i] = sqlparser.String(row)
+		for _, expr := range row {
+			parts.midArgs[i] = append(parts.midArgs[i], insertArgNames(expr)...)
+		}
+	}
+	parts.vindexVarNames = make([][][]string, len(ins.ColVindexes))
+	for vIdx, colVindex := range ins.ColVindexes {
+		parts.vindexVarNames[vIdx] = make([][]string, len(colVindex.Columns))
+		for colIdx, col := range colVindex.Columns {
+			names := make([]string, len(ins.Mid))
+			for row := range names {
+				names[row] = InsertVarName(col, row)
+			}
+			parts.vindexVarNames[vIdx][colIdx] = names
+		}
+	}
+	return parts
+}
+
+// vindexVarName returns InsertVarName for the given vindex column and row, from the precomputed names when possible.
+func (parts *insertShardedParts) vindexVarName(colVindex *vindexes.ColumnVindex, vIdx, colIdx, row int) string {
+	if vIdx < len(parts.vindexVarNames) && colIdx < len(parts.vindexVarNames[vIdx]) && row < len(parts.vindexVarNames[vIdx][colIdx]) {
+		return parts.vindexVarNames[vIdx][colIdx][row]
+	}
+	return InsertVarName(colVindex.Columns[colIdx], row)
+}
+
+// insertArgNames returns the names of the bind variables referenced by node, in walk order.
+func insertArgNames(node sqlparser.SQLNode) []string {
+	var names []string
+	_ = sqlparser.Walk(func(node sqlparser.SQLNode) (bool, error) {
+		switch arg := node.(type) {
+		case *sqlparser.Argument:
+			names = append(names, arg.Name)
+		case sqlparser.ListArg:
+			names = append(names, string(arg))
+		}
+		return true, nil
+	}, node)
+	return names
+}
