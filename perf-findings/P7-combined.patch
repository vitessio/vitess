+	"user_id",
+	"$col",
+	"a.b",
+	".ab",
+	"a b",
+	"a-b",
+	"a`b",
+	"é",
+	"aé1",
+	"1é",
+	"\xff",
+	"a\xffb",
+	"a\xc3",
+	"\U00010061",  // truncates to 'a' as uint16: kept as-is
+	"a\U00010031", // truncates to '1' as uint16: kept after the first rune
+	"\U00010031a", // truncates to '1' as uint16 at the start: replaced
+	"\U0001005f",  // truncates to '_' as uint16: kept as-is
+	"xš",          // 0x161 is not a letter
+	"col\x00umn",
+	"abc\U0001F600",
+}
