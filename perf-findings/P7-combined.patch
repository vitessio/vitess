+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package json
+
+import (
+	"math/bits"
+	"unicode/utf8"
+)
+
+// SWAR ("SIMD within a register") helpers that find the next byte of a JSON
+// string that needs special handling, eight bytes at a time.
+//
+// For a word x, ((x - swarLo*n) &^ x) & swarHi has the high bit of a byte set
+// if that byte is < n (for n <= 0x80); with n == 1 it finds zero bytes, so
+// x^(swarLo*c) finds bytes equal to c. A borrow can only produce a false
+// positive in a byte that is more significant than a true positive, so on a
+// little-endian load the lowest set bit is always exact. This also holds for
+// an OR of several such masks.
+const (
+	swarLo = 0x0101010101010101
+	swarHi = 0x8080808080808080
+)
+
+// load64 reads 8 bytes of s starting at i as a little-endian word. The
+// compiler combines the byte loads into a single 64-bit load.
+func load64(s string, i int) uint64 {
+	s = s[i : i+8]
+	return uint64(s[0]) | uint64(s[1])<<8 | uint64(s[2])<<16 | uint64(s[3])<<24 |
+		uint64(s[4])<<32 | uint64(s[5])<<40 | uint64(s[6])<<48 | uint64(s[7])<<56
+}
+
+// quoteOrBackslashMask marks the bytes of x that are '"' or '\\'.
+func quoteOrBackslashMask(x uint64) uint64 {
+	q := x ^ (swarLo * '"')
+	b := x ^ (swarLo * '\\')
+	return ((q - swarLo) &^ q) | ((b - swarLo) &^ b)
+}
+
+// escapeMask marks the bytes of x that are '"', '\\' or control characters
+// (< 0x20), plus the bytes >= 0x80 if highMask is swarHi (it is either 0 or
+// swarHi).
+func escapeMask(x, highMask uint64) uint64 {
+	return (quoteOrBackslashMask(x)|((x-swarLo*0x20)&^x))&swarHi | x&highMask
+}
+
+const (
+	escControl  = 1 // '"', '\\' and control characters
+	escNonASCII = 2 // bytes >= 0x80
+)
+
+// escapeClass classifies each byte for escapeString.
+var escapeClass = func() (t [256]uint8) {
+	for i := range 0x20 {
+		t[i] = escControl
+	}
+	t['"'] = escControl
+	t['\\'] = escControl
+	for i := utf8.RuneSelf; i < len(t); i++ {
+		t[i] = escNonASCII
+	}
+	return
+}()
+
+// nextEscape returns the index of the first byte at or after i that is a
+// '"', '\\' or control character, or also a non-ASCII byte if nonASCII is
+// set. It returns len(s) if there is none.
+func nextEscape(s string, i int, nonASCII bool) int {
+	var highMask uint64
+	if nonASCII {
+		highMask = swarHi
+	}
+	for ; i+8 <= len(s); i += 8 {
+		if m := escapeMask(load64(s, i), highMask); m != 0 {
+			return i + bits.TrailingZeros64(m)>>3
+		}
+	}
+	want := uint8(escControl)
+	if nonASCII {
+		want |= escNonASCII
+	}
+	for ; i < len(s); i++ {
+		if escapeClass[s[i]]&want != 0 {
+			return i
+		}
+	}
+	return i
+}
+
+// nextQuoteOrBackslash returns the index of the first '"' or '\\' in s at or
+// after i, or len(s) if there is none.
+func nextQuoteOrBackslash(s string, i int) int {
+	for ; i+8 <= len(s); i += 8 {
+		if m := quoteOrBackslashMask(load64(s, i)) & swarHi; m != 0 {
+			return i + bits.TrailingZeros64(m)>>3
+		}
+	}
+	for ; i < len(s); i++ {
+		if c := s[i]; c == '"' || c == '\\' {
+			return i
+		}
+	}
+	return i
+}
+
+const hexDigits = "0123456789abcdef"
+
+// utf8 validation state of the remainder of the string in escapeString.
+const (
+	utf8Unknown = iota
+	utf8Valid
+	utf8Invalid
+)
+
+// escapeString appends s as a JSON string to dst and returns the result.
+//
+// The output uses JSON compliant escapes for control bytes and only uses the
+// short escape sequences for \b, \f, \n, \r, and \t. Invalid UTF-8 bytes are
+// replaced by U+FFFD so the JSON output stays valid, the same way a
+// conversion to []rune would.
+//
+// Runs of bytes that need no escaping are copied in bulk; the scan for the
+// next byte that needs attention works on eight bytes at a time. The UTF-8
+// validity of s is only checked once a non-ASCII byte is seen.
+func escapeString(dst []byte, s string) []byte {
+	dst = append(dst, '"')
+	state := utf8Unknown
+	start := 0 // start of the pending run of bytes to copy verbatim
+	i := nextEscape(s, 0, true)
+	for i < len(s) {
+		ch := s[i]
+		if ch >= utf8.RuneSelf {
+			if state == utf8Unknown {
+				if utf8.ValidString(s[i:]) {
+					// Only ASCII bytes need escaping in the rest of s.
+					state = utf8Valid
+					i = nextEscape(s, i, false)
+					continue
+				}
+				state = utf8Invalid
+			}
+			// Replace invalid bytes by U+FFFD, rune by rune.
+			r, size := utf8.DecodeRuneInString(s[i:])
+			if r == utf8.RuneError && size == 1 {
+				dst = append(dst, s[start:i]...)
+				dst = append(dst, "�"...)
+				start = i + 1
+			}
+			i = nextEscape(s, i+size, true)
+			continue
+		}
+		dst = append(dst, s[start:i]...)
+		switch ch {
+		case '"', '\\':
+			dst = append(dst, '\\', ch)
+		case '\b': // 0x08, backspace
+			dst = append(dst, '\\', 'b')
+		case '\f': // 0x0C, form feed
+			dst = append(dst, '\\', 'f')
+		case '\n': // 0x0A, line feed
+			dst = append(dst, '\\', 'n')
+		case '\r': // 0x0D, carriage return
+			dst = append(dst, '\\', 'r')
+		case '\t': // 0x09, horizontal tab
+			dst = append(dst, '\\', 't')
+		default:
+			// Other control characters (0x00-0x1F) use \u00XX escapes.
+			dst = append(dst, '\\', 'u', '0', '0', hexDigits[ch>>4], hexDigits[ch&0x0f])
+		}
+		start = i + 1
+		i = nextEscape(s, start, state != utf8Valid)
+	}
+	dst = append(dst, s[start:]...)
+	return append(dst, '"')
+}
