-	index := block + counterHash&1 + uint64(offset<<1)
-	return uint(index), uint((counterHash & 0xF) << 2)
+	index := block + ch&1 + uint64(offset<<1)
+	return uint(index), uint(((ch >> 1) & 0xF) << 2)
