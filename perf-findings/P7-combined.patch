+package sqlparser
+
+import (
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func previewOld(sql string) StatementType {
+	trimmed := StripLeadingComments(sql)
+	if strings.Index(trimmed, "/*!") == 0 {
+		return StmtComment
+	}
+	isNotLetter := func(r rune) bool { return !unicode.IsLetter(r) }
+	firstWord := strings.TrimLeftFunc(trimmed, isNotLetter)
+	if end := strings.IndexFunc(firstWord, unicode.IsSpace); end != -1 {
+		firstWord = firstWord[:end]
+	}
+	loweredFirstWord := strings.ToLower(firstWord)
+	switch loweredFirstWord {
+	case "select":
+		return StmtSelect
+	case "stream":
+		return StmtStream
+	case "vstream":
+		return StmtVStream
+	case "revert":
+		return StmtMigration
+	case "insert":
+		return StmtInsert
+	case "replace":
+		return StmtReplace
+	case "update":
+		return StmtUpdate
+	case "delete":
+		return StmtDelete
+	case "savepoint":
+		return StmtSavepoint
+	case "lock":
+		return StmtLockTables
+	case "unlock":
+		return StmtUnlockTables
+	}
+	trimmedNoComments, _ := SplitMarginComments(trimmed)
+	switch strings.ToLower(trimmedNoComments) {
+	case "begin", "start transaction":
+		return StmtBegin
+	case "commit":
+		return StmtCommit
+	case "rollback":
+		return StmtRollback
+	}
+	switch loweredFirstWord {
+	case "create", "alter", "rename", "drop", "truncate":
+		return StmtDDL
+	case "flush":
+		return StmtFlush
+	case "set":
+		return StmtSet
+	case "show":
+		return StmtShow
+	case "use":
+		return StmtUse
+	case "describe", "desc", "explain":
+		return StmtExplain
+	case "repair", "optimize":
+		return StmtOther
+	case "analyze":
+		return StmtAnalyze
+	case "grant", "revoke":
+		return StmtPriv
+	case "release":
+		return StmtRelease
+	case "rollback":
+		return StmtSRollback
+	case "kill":
+		return StmtKill
+	}
+	return StmtUnknown
+}
+
+var f30Queries = []string{
+	"SELECT id, name FROM users WHERE id = 1",
+	"select id, name from users where id = 1",
+	"/* comment */ INSERT INTO t (a) VALUES (1)",
+	"UPDATE t SET a = 1 WHERE id = 2",
+	"SET @@session.autocommit = 1",
+	"BEGIN", "COMMIT", "Start Transaction", "ROLLBACK", "rollback to x",
+	"Kill 1", "ſelect", "SÉLECT", "SELECTSELECTSELECTSELECT x",
+	"SHOW TABLES", "  /* a */ -- b\n commit /* c */", "",
+	"(SELECT 1)", "START TRANSACTIONS", "start  transaction",
+}
+
+func TestF30PreviewEquivalence(t *testing.T) {
+	for _, q := range f30Queries {
+		assert.Equal(t, previewOld(q), Preview(q), q)
+	}
+}
+
+func FuzzF30Preview(f *testing.F) {
+	for _, q := range f30Queries {
+		f.Add(q)
+	}
+	f.Fuzz(func(t *testing.T, q string) {
+		if previewOld(q) != Preview(q) {
+			t.Fatalf("mismatch for %q", q)
+		}
+	})
+}
+
+func BenchmarkF30PreviewOld(b *testing.B) {
+	b.ReportAllocs()
+	for b.Loop() {
+		for _, q := range f30Queries[:5] {
+			previewOld(q)
+		}
+	}
+}
+
+func BenchmarkF30PreviewNew(b *testing.B) {
+	b.ReportAllocs()
+	for b.Loop() {
+		for _, q := range f30Queries[:5] {
+			Preview(q)
+		}
+	}
+}
