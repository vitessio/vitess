+func benchSrvKeyspace(b *testing.B, n int) *topodatapb.SrvKeyspace {
+	names, err := key.GenerateShardRanges(n, 0)
+	require.NoError(b, err)
+	refs := make([]*topodatapb.ShardReference, 0, len(names))
+	for _, name := range names {
+		krs, err := key.ParseShardingSpec(name)
+		require.NoError(b, err)
+		refs = append(refs, &topodatapb.ShardReference{Name: name, KeyRange: krs[0]})
+	}
+	return &topodatapb.SrvKeyspace{
+		Partitions: []*topodatapb.SrvKeyspace_KeyspacePartition{{
+			ServedType:      topodatapb.TabletType_PRIMARY,
+			ShardReferences: refs,
+		}},
+	}
+}
+
+// BenchmarkResolveDestinations resolves one DestinationKeyspaceID per row,
+// the way a multi-row sharded INSERT does.
+func BenchmarkResolveDestinations(b *testing.B) {
+	for _, n := range []int{4, 32, 256} {
+		for _, rows := range []int{1, 100, 1000} {
+			b.Run(fmt.Sprintf("shards=%d/rows=%d", n, rows), func(b *testing.B) {
+				srv := srvtopotest.NewPassthroughSrvTopoServer()
+				srv.SrvKeyspace = benchSrvKeyspace(b, n)
+				resolver := NewResolver(srv, &tabletconntest.FakeQueryService{}, "cell1")
+
+				r := rand.New(rand.NewPCG(1, 2))
+				ids := make([]*querypb.Value, rows)
+				destinations := make([]key.ShardDestination, rows)
+				for i := range rows {
+					ids[i] = &querypb.Value{Value: strconv.AppendInt(nil, int64(i), 10)}
+					destinations[i] = key.DestinationKeyspaceID(binary.BigEndian.AppendUint64(nil, r.Uint64()))
+				}
+
+				ctx := b.Context()
+				b.ReportAllocs()
+				for b.Loop() {
+					rss, _, err := resolver.ResolveDestinations(ctx, "ks", topodatapb.TabletType_PRIMARY, ids, destinations)
+					if err != nil {
+						b.Fatal(err)
+					}
+					if len(rss) == 0 {
+						b.Fatal("no shards resolved")
+					}
+				}
+			})
+		}
+	}
+}
