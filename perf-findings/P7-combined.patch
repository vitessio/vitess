+// TestBuildExecutionPlanFieldInfos verifies that buildExecutionPlan precomputes
+// the per-column metadata used by the apply paths, and that it matches the
+// per-row lookups it replaces: bind variable names use the (backtick-trimmed)
+// field name, FieldsToSkip is matched case-insensitively, and the charset and
+// int-to-enum conversions are keyed by the exact field name.
+func TestBuildExecutionPlanFieldInfos(t *testing.T) {
+	colInfos := map[string][]*ColumnInfo{
+		"t": {
+			{Name: "id", IsPK: true},
+			{Name: "Name"},
+			{Name: "c_latin"},
+			{Name: "e_enum"},
+			{Name: "GenCol", IsGenerated: true},
+		},
+	}
+	build := func(t *testing.T, rule *binlogdatapb.Rule, fields []*querypb.Field) *TablePlan {
+		vr := &vreplicator{workflowConfig: vttablet.GetDefaultVReplicationConfig()}
+		source := &binlogdatapb.BinlogSource{Filter: &binlogdatapb.Filter{Rules: []*binlogdatapb.Rule{rule}}}
+		rp, err := vr.buildReplicatorPlan(source, colInfos, nil, binlogplayer.NewStats(), collations.MySQL8(), sqlparser.NewTestParser())
+		require.NoError(t, err)
+		tp, err := rp.buildExecutionPlan(&binlogdatapb.FieldEvent{TableName: "t", Fields: fields})
+		require.NoError(t, err)
+		require.Len(t, tp.fieldInfos, len(tp.Fields))
+		return tp
+	}
+
+	t.Run("explicit columns", func(t *testing.T) {
+		conversion := &binlogdatapb.CharsetConversion{FromCharset: "utf8mb4", ToCharset: "latin1"}
+		tp := build(t, &binlogdatapb.Rule{
+			Match:            "t",
+			Filter:           "select id, `Name`, c_latin, e_enum from t",
+			ConvertCharset:   map[string]*binlogdatapb.CharsetConversion{"c_latin": conversion},
+			ConvertIntToEnum: map[string]bool{"e_enum": true},
+		}, []*querypb.Field{
+			{Name: "id", Type: querypb.Type_INT64},
+			{Name: "`Name`", Type: querypb.Type_VARCHAR},
+			{Name: "c_latin", Type: querypb.Type_VARCHAR},
+			{Name: "e_enum", Type: querypb.Type_INT32},
+		})
+		assert.Equal(t, []fieldInfo{
+			{beforeName: "b_id", afterName: "a_id"},
+			{beforeName: "b_Name", afterName: "a_Name"},
+			{beforeName: "b_c_latin", afterName: "a_c_latin", charsetConversion: conversion},
+			{beforeName: "b_e_enum", afterName: "a_e_enum", intToEnum: true},
+		}, tp.fieldInfos)
+
+		var executed []string
+		_, err := tp.applyChange(&binlogdatapb.RowChange{
+			After: sqltypes.RowToProto3([]sqltypes.Value{
+				sqltypes.NewInt64(1),
+				sqltypes.NewVarChar("n"),
+				sqltypes.NewVarChar("café"),
+				sqltypes.NewInt32(2),
+			}),
+		}, func(sql string) (*sqltypes.Result, error) {
+			executed = append(executed, sql)
+			return &sqltypes.Result{RowsAffected: 1}, nil
+		})
+		require.NoError(t, err)
+		require.Len(t, executed, 1)
+		assert.Contains(t, executed[0], "(1,'n','caf\xe9','2')")
+	})
+
+	t.Run("select star skips generated columns case-insensitively", func(t *testing.T) {
+		tp := build(t, &binlogdatapb.Rule{Match: "t", Filter: "select * from t"}, []*querypb.Field{
+			{Name: "id", Type: querypb.Type_INT64},
+			{Name: "Name", Type: querypb.Type_VARCHAR},
+			{Name: "gencol", Type: querypb.Type_INT64},
+		})
+		assert.Equal(t, []fieldInfo{
+			{beforeName: "b_id", afterName: "a_id"},
+			{beforeName: "b_Name", afterName: "a_Name"},
+			{beforeName: "b_gencol", afterName: "a_gencol", skip: true},
+		}, tp.fieldInfos)
+	})
+}
