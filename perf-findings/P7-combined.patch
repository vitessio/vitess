+// genericWriter is a BinWriter that is not special-cased by the encoders.
+type genericWriter struct {
+	buf []byte
+}
+
+func (w *genericWriter) Write(b []byte) (int, error) {
+	w.buf = append(w.buf, b...)
+	return len(b), nil
+}
+
+// encodeSQLAllWriters encodes v through every EncodeSQL entry point and writer type,
+// and returns the results keyed by the entry point.
+func encodeSQLAllWriters(v Value) map[string]string {
+	var sb strings.Builder
+	v.EncodeSQL(&sb)
+	var bb bytes.Buffer
+	v.EncodeSQL(&bb)
+	var b2 bytes2.Buffer
+	v.EncodeSQL(&b2)
+	var gw genericWriter
+	v.EncodeSQL(&gw)
+	var sb2 strings.Builder
+	v.EncodeSQLStringBuilder(&sb2)
+	var b22 bytes2.Buffer
+	v.EncodeSQLBytes2(&b22)
+	return map[string]string{
+		"EncodeSQL(*strings.Builder)": sb.String(),
+		"EncodeSQL(*bytes.Buffer)":    bb.String(),
+		"EncodeSQL(*bytes2.Buffer)":   b2.String(),
+		"EncodeSQL(generic)":          string(gw.buf),
+		"EncodeSQLStringBuilder":      sb2.String(),
+		"EncodeSQLBytes2":             b22.String(),
+	}
+}
+
+// expectedBitsSQL is the reference encoding of a BIT value: every byte as 8
+// binary digits, most significant bit first.
+func expectedBitsSQL(val []byte) string {
+	var sb strings.Builder
+	sb.WriteString("b'")
+	for _, ch := range val {
+		fmt.Fprintf(&sb, "%08b", ch)
+	}
+	sb.WriteString("'")
+	return sb.String()
+}
+
+func TestEncodeSQLBits(t *testing.T) {
+	check := func(t *testing.T, val []byte) {
+		want := expectedBitsSQL(val)
+		for name, got := range encodeSQLAllWriters(MakeTrusted(Bit, val)) {
+			require.Equal(t, want, got, "%s(%x)", name, val)
+		}
+	}
+
+	t.Run("empty", func(t *testing.T) {
+		check(t, nil)
+		check(t, []byte{})
+		assert.Equal(t, "b''", encodeSQLAllWriters(MakeTrusted(Bit, nil))["EncodeSQLBytes2"])
+	})
+
+	t.Run("every byte value", func(t *testing.T) {
+		for i := range 256 {
+			check(t, []byte{byte(i)})
+		}
+		assert.Equal(t, "b'0000000110000000'", encodeSQLAllWriters(MakeTrusted(Bit, []byte{0x01, 0x80}))["EncodeSQL(generic)"])
+	})
+
+	t.Run("random lengths", func(t *testing.T) {
+		// Lengths above 15 bytes exceed the stack buffer and exercise the growth path.
+		r := rand.New(rand.NewPCG(1, 2))
+		for n := range 65 {
+			for range 4 {
+				val := make([]byte, n)
+				for i := range val {
+					val[i] = byte(r.Uint32())
+				}
+				check(t, val)
+			}
+		}
+	})
+}
