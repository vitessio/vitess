+// appendUintPadded appends v in base 10, left-padded with zeroes to at least
+// width digits. It produces the same output as fmt's "%0*d" (and "%.*d") verbs
+// for non-negative values: a value with more digits than width is not truncated.
+func appendUintPadded(b []byte, v uint64, width int) []byte {
+	if width == 2 && v < 100 {
+		return append(b, digitPairs[v*2], digitPairs[v*2+1])
+	}
+	var buf [20]byte
+	i := len(buf)
+	for v >= 100 {
+		q := v / 100
+		r := v - q*100
+		i -= 2
+		buf[i], buf[i+1] = digitPairs[r*2], digitPairs[r*2+1]
+		v = q
+	}
+	if v >= 10 {
