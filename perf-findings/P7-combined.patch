diff --git a/go/mysql/json/escape.go b/go/mysql/json/escape.go
new file mode 100644
index 0000000000..167e43d74f
--- /dev/null
+++ b/go/mysql/json/escape.go
@@ -0,0 +1,188 @@
+/*
