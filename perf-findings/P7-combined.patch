+}
+
+// blockingShardResult sends each of its rows in a separate result. Before
+// sending a row after the first, it waits until the consumer of the merged
+// stream has received the previous row.
+type blockingShardResult struct {
+	shardRoute
+
+	fields []*querypb.Field
+	ids    []int64
+	seen   func(id int64) chan struct{}
+}
+
+func (sr *blockingShardResult) StreamExecute(ctx context.Context, _ VCursor, _ map[string]*querypb.BindVariable, _ bool, _ bool, callback func(*sqltypes.Result) error) error {
+	if err := callback(&sqltypes.Result{Fields: sr.fields}); err != nil {
+		return err
+	}
+	for i, id := range sr.ids {
+		if i > 0 {
+			select {
+			case <-sr.seen(sr.ids[i-1]):
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+		}
+		if err := callback(&sqltypes.Result{Rows: [][]sqltypes.Value{{sqltypes.NewInt64(id)}}}); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// TestMergeSortFlushesBeforeWaiting tests that MergeSort sends the rows it has
+// merged so far before it waits for more rows from a shard, so that a slow
+// shard doesn't hold back rows that can already be returned.
+func TestMergeSortFlushesBeforeWaiting(t *testing.T) {
+	fields := sqltypes.MakeTestFields("id", "int64")
+	var mu sync.Mutex
+	seenCh := map[int64]chan struct{}{}
+	seen := func(id int64) chan struct{} {
+		mu.Lock()
+		defer mu.Unlock()
+		ch, ok := seenCh[id]
+		if !ok {
+			ch = make(chan struct{})
+			seenCh[id] = ch
+		}
+		return ch
+	}
+	ms := MergeSort{
+		Primitives: []StreamExecutor{
+			&blockingShardResult{fields: fields, ids: []int64{1, 3, 5}, seen: seen},
+			&blockingShardResult{fields: fields, ids: []int64{2, 4, 6}, seen: seen},
+		},
+		OrderBy: int64OrderBy,
+	}
+
+	ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
+	defer cancel()
+	var got []int64
+	err := ms.TryStreamExecute(ctx, &noopVCursor{}, nil, false, func(qr *sqltypes.Result) error {
+		for _, row := range qr.Rows {
+			v, err := row[0].ToInt64()
+			require.NoError(t, err)
+			got = append(got, v)
+			close(seen(v))
+		}
+		return nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, []int64{1, 2, 3, 4, 5, 6}, got)
+}
+
+// TestMergeSortStopsOnCallbackError tests that MergeSort stops as soon as the
+// callback returns an error, e.g. io.EOF from a Limit that has enough rows.
+func TestMergeSortStopsOnCallbackError(t *testing.T) {
+	fields := sqltypes.MakeTestFields("id", "int64")
+	ids := make([]int64, 10*mergeSortBatchSize)
+	for i := range ids {
+		ids[i] = int64(i)
+	}
+	ms := MergeSort{
+		Primitives: []StreamExecutor{&reusingShardResult{fields: fields, ids: ids, chunk: 100}},
+		OrderBy:    int64OrderBy,
+	}
+	calls := 0
+	err := ms.TryStreamExecute(t.Context(), &noopVCursor{}, nil, false, func(qr *sqltypes.Result) error {
+		calls++
+		return io.EOF
+	})
+	require.ErrorIs(t, err, io.EOF)
+	require.Equal(t, 1, calls)
+}
diff --git a/go/vt/vtgate/evalengine/api_compare.go b/go/vt/vtgate/evalengine/api_compare.go
index 70629cca24..0c9a888f69 100644
--- a/go/vt/vtgate/evalengine/api_compare.go
+++ b/go/vt/vtgate/evalengine/api_compare.go
@@ -305,11 +305,89 @@ func (cmp Comparison) SortResult(out *sqltypes.Result) (err error) {
 }
 
 func (cmp Comparison) Sort(out []sqltypes.Row) {
+	if cmp.mergeRuns(out) {
+		return
+	}
 	slices.SortFunc(out, func(a, b sqltypes.Row) int {
 		return cmp.Compare(a, b)
 	})
 }
 
+// maxMergeRuns is the largest number of ascending runs for which Sort merges
+// the runs instead of sorting from scratch.
+const maxMergeRuns = 64
+
+// mergeRuns sorts out if it consists of at most maxMergeRuns ascending runs,
+// and reports whether it did. A scatter query with an ORDER BY returns rows
+// that are already sorted within each shard, and the shard results are
+// concatenated, so the input usually has one run per shard. Merging k runs
+// takes n-1 comparisons to find them plus about n*log2(k) comparisons to merge,
+// instead of about n*log2(n) for a full sort. The merge is stable. Random input
+// is detected after about 2*maxMergeRuns comparisons.
+func (cmp Comparison) mergeRuns(out []sqltypes.Row) bool {
+	n := len(out)
+	if n < 2 {
+		return true
+	}
+	var boundsBuf [maxMergeRuns + 1]int
+	bounds := append(boundsBuf[:0], 0)
+	for i := 1; i < n; i++ {
+		if cmp.Compare(out[i-1], out[i]) > 0 {
+			if len(bounds) == maxMergeRuns {
+				return false
+			}
+			bounds = append(bounds, i)
+		}
+	}
+	if len(bounds) == 1 {
+		// already sorted
+		return true
+	}
+	bounds = append(bounds, n)
+
+	src, dst := out, make([]sqltypes.Row, n)
+	for len(bounds) > 2 {
+		next := 0
+		for i := 0; i+1 < len(bounds); i += 2 {
+			lo, mid := bounds[i], bounds[i+1]
+			if i+2 < len(bounds) {
+				hi := bounds[i+2]
+				cmp.merge(dst[lo:hi], src[lo:mid], src[mid:hi])
+			} else {
+				copy(dst[lo:mid], src[lo:mid])
+			}
+			// bounds is rewritten in place: every pass keeps every other boundary.
+			bounds[next] = lo
+			next++
+		}
+		bounds[next] = n
+		bounds = bounds[:next+1]
+		src, dst = dst, src
+	}
+	if &src[0] != &out[0] {
+		copy(out, src)
+	}
+	return true
+}
+
+// merge merges the sorted slices a and b into dst, which must have room for
+// len(a)+len(b) rows. Rows from a come first among equal rows.
+func (cmp Comparison) merge(dst, a, b []sqltypes.Row) {
+	i, j, k := 0, 0, 0
+	for i < len(a) && j < len(b) {
+		if cmp.Compare(b[j], a[i]) < 0 {
+			dst[k] = b[j]
+			j++
+		} else {
+			dst[k] = a[i]
+			i++
+		}
+		k++
+	}
+	k += copy(dst[k:], a[i:])
+	copy(dst[k:], b[j:])
+}
+
 type Sorter struct {
 	Compare Comparison
 	Limit   int
