 import (
 	"testing"
+	"time"
 
+	"github.com/stretchr/testify/assert"
 	"github.com/stretchr/testify/require"
 )
 
@@ -80,3 +82,19 @@ func TestDoorKeeperDynamicSize(t *testing.T) {
 	}
 	require.Greater(t, shard.doorkeeper.Capacity, 100000)
 }
+
+// TestUsedCapacityIncludesPolicy verifies that UsedCapacity counts the entries that were moved from the
+// shards' admission windows to the main policy, and not only the entries still in the windows.
+func TestUsedCapacityIncludesPolicy(t *testing.T) {
+	store := NewStore[keyint, cachedint](20000, false)
+	t.Cleanup(store.Close)
+
+	const n = 5000
+	for i := range keyint(n) {
+		require.True(t, store.Set(i, cachedint(i), 0, 0))
+	}
+	// Every entry costs 1, and the cache is large enough to hold all of them.
+	assert.Eventually(t, func() bool {
+		return store.Len() == n && store.UsedCapacity() == n
+	}, 30*time.Second, 10*time.Millisecond, "len %d, used capacity %d", store.Len(), store.UsedCapacity())
+}
