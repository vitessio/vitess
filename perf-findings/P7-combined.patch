+		lit.Format(buf)
+		require.Equal(t, want.String(), buf.String(), "Format(%q)", val)
+	}
+
+	for _, val := range []string{
+		"", "a", "'", "\\", "\\%", "\\_", "a\\%b\\_c\\", "\\\\%", "it's", "\x00\b\n\r\t\x1a",
+		"\xff\xfe", "caf\xc3\xa9", "\xc3", "\xe4\xb8", "日本語", "abc\x80def",
+		strings.Repeat("the quick brown fox ", 64),
+	} {
+		check(val)
+	}
+
+	// All strings of length <= 2 over all byte values.
+	for i := range 256 {
+		check(string([]byte{byte(i)}))
+		for j := range 256 {
+			check(string([]byte{byte(i), byte(j)}))
+		}
+	}
+
+	// Random strings biased towards bytes that need special handling.
+	special := []byte{0, '\'', '"', '\\', '%', '_', '\b', '\n', '\r', '\t', 0x1a, 0x80, 0xc3, 0xff}
+	r := rand.New(rand.NewPCG(1, 2))
+	for range 20000 {
+		b := make([]byte, r.IntN(64))
+		for k := range b {
+			if r.IntN(3) == 0 {
+				b[k] = special[r.IntN(len(special))]
+			} else {
+				b[k] = byte(r.IntN(256))
+			}
+		}
+		check(string(b))
+	}
+}
+
+func TestTrackedBufferWriteInt(t *testing.T) {
+	for _, v := range []int64{0, 1, -1, 9, 10, 99, 100, -100, 12345, math.MaxInt32, math.MinInt32, math.MaxInt64, math.MinInt64} {
+		buf := NewTrackedBuffer(nil)
+		buf.WriteInt(v)
+		assert.Equal(t, strconv.FormatInt(v, 10), buf.String())
+	}
+	for _, v := range []uint64{0, 1, 99, 100, 12345, math.MaxUint32, math.MaxUint64} {
+		buf := NewTrackedBuffer(nil)
+		buf.WriteUint(v)
+		assert.Equal(t, strconv.FormatUint(v, 10), buf.String())
+	}
+
+	buf := NewTrackedBuffer(nil)
+	buf.Grow(64)
+	allocs := testing.AllocsPerRun(100, func() {
+		buf.Reset()
+		buf.Grow(64)
+		buf.WriteInt(math.MinInt64)
+		buf.WriteUint(math.MaxUint64)
+	})
+	// Reset drops the underlying buffer, so the only allocation is the Grow.
+	assert.EqualValues(t, 1, allocs)
+}
+
+func TestTypeName(t *testing.T) {
+	for v := range querypb.Type_name {
+		typ := sqltypes.Type(v)
+		assert.Equal(t, typ.String(), typeName(typ), "type %d", v)
+	}
+	// Values that are not valid types must fall back to the protobuf formatting.
+	for _, v := range []int32{1, 255, 256, 257 | 0x10000, 12345, math.MaxInt32} {
+		typ := sqltypes.Type(v)
+		assert.Equal(t, typ.String(), typeName(typ), "type %d", v)
+	}
+}
+
+func TestStringWithSizeHint(t *testing.T) {
+	parser := NewTestParser()
+	for _, sql := range []string{
+		"select 1 from dual",
+		"select * from t where a = :a /* DECIMAL(4,2) */ and b = CAST(:b AS DATETIME(6)) and c in ::c",
+		"kill query 18446744073709551615",
+	} {
+		stmt, err := parser.Parse(sql)
+		require.NoError(t, err)
+		expected := String(stmt)
+		for _, hint := range []int{-1, 0, 1, len(sql), 10 * len(sql)} {
+			assert.Equal(t, expected, StringWithSizeHint(stmt, hint))
+		}
+	}
+	assert.Equal(t, "<nil>", StringWithSizeHint(nil, 10))
+}
