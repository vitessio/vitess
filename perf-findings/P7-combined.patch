+func BenchmarkFormatStringLiteral(b *testing.B) {
+	parser := NewTestParser()
+	short := "abcdefghij"
+	long := strings.Repeat("the quick brown fox jumps over the lazy dog ", 24)[:1024]
+	cases := []struct{ name, sql string }{
+		{"select-10B", "select * from t where a = '" + short + "' and b = 'x'"},
+		{"select-1KiB", "select * from t where a = '" + long + "'"},
+		{"insert-5x10B", "insert into t(a,b,c,d,e) values ('" + short + "', '" + short + "', '" + short + "', '" + short + "', '" + short + "')"},
+		{"insert-5x240B", "insert into t(a,b,c,d,e) values ('" + long[:240] + "', '" + long[:240] + "', '" + long[:240] + "', '" + long[:240] + "', '" + long[:240] + "')"},
+		{"select-noliteral", "select a, b, c from t where id = 1 and x > 5 order by a"},
+	}
+	for _, c := range cases {
+		stmt, err := parser.Parse(c.sql)
+		require.NoError(b, err)
+		b.Run("String/"+c.name, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				_ = String(stmt)
+			}
+		})
+		b.Run("Format/"+c.name, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				buf := NewTrackedBuffer(nil)
+				stmt.Format(buf)
+				_ = buf.String()
+			}
+		})
+	}
+	for _, c := range cases {
+		b.Run("Redact/"+c.name, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				_, err := parser.RedactSQLQuery(c.sql)
+				if err != nil {
+					b.Fatal(err)
+				}
+			}
+		})
+	}
+}
