+
+// getShardForKeyspaceIDLinear is the reference linear-scan implementation of
+// GetShardForKeyspaceID. It is used to verify equivalence and as the baseline
+// in benchmarks.
+func getShardForKeyspaceIDLinear(allShards []*topodatapb.ShardReference, keyspaceID []byte) (string, error) {
+	if len(allShards) == 0 {
+		return "", vterrors.Errorf(vtrpcpb.Code_UNAVAILABLE, "no shard in keyspace")
+	}
+
+	for _, shardReference := range allShards {
+		if KeyRangeContains(shardReference.KeyRange, keyspaceID) {
+			return shardReference.Name, nil
+		}
+	}
+	return "", vterrors.Errorf(vtrpcpb.Code_INVALID_ARGUMENT, "KeyspaceId %v didn't match any shards %+v", hex.EncodeToString(keyspaceID), allShards)
+}
+
+// evenShardReferences returns n contiguous, sorted shard references that
+// evenly split the keyspace, as produced by a keyspace rebuild.
+func evenShardReferences(tb testing.TB, n int) []*topodatapb.ShardReference {
+	names, err := GenerateShardRanges(n, 0)
+	require.NoError(tb, err)
+	refs := make([]*topodatapb.ShardReference, 0, len(names))
+	for _, name := range names {
+		krs, err := ParseShardingSpec(name)
+		require.NoError(tb, err)
+		require.Len(tb, krs, 1)
+		refs = append(refs, &topodatapb.ShardReference{Name: name, KeyRange: krs[0]})
+	}
+	return refs
+}
+
+func randomKeyspaceIDs(n int) [][]byte {
+	r := rand.New(rand.NewPCG(1, 2))
+	ksids := make([][]byte, n)
+	for i := range ksids {
+		ksids[i] = binary.BigEndian.AppendUint64(nil, r.Uint64())
+	}
+	return ksids
+}
+
+func BenchmarkGetShardForKeyspaceID(b *testing.B) {
+	ksids := randomKeyspaceIDs(1024)
+	for _, n := range []int{2, 4, 8, 32, 128, 256} {
+		shards := evenShardReferences(b, n)
+		for _, impl := range []struct {
+			name string
+			fn   func([]*topodatapb.ShardReference, []byte) (string, error)
+		}{
+			{"linear", getShardForKeyspaceIDLinear},
+			{"current", GetShardForKeyspaceID},
+		} {
+			b.Run(fmt.Sprintf("shards=%d/impl=%s", n, impl.name), func(b *testing.B) {
+				b.ReportAllocs()
+				i := 0
+				for b.Loop() {
+					if _, err := impl.fn(shards, ksids[i&1023]); err != nil {
+						b.Fatal(err)
+					}
+					i++
+				}
+			})
+		}
+	}
+}
+
+// randomShardReferences returns n contiguous shard references with random
+// boundaries of random length, some of them with trailing zero bytes, sorted
+// the way topo.OrderAndCheckPartitions sorts them.
+func randomShardReferences(r *rand.Rand, n int) []*topodatapb.ShardReference {
+	seen := map[string]bool{}
+	var bounds [][]byte
+	for len(bounds) < n-1 {
+		b := make([]byte, 1+r.IntN(3))
+		for i := range b {
+			b[i] = byte(r.IntN(256))
+		}
+		if r.IntN(4) == 0 {
+			// Unnormalized boundary: same value as without the trailing zero.
+			b = append(b, 0)
+		}
+		nb := string(Normalize(b))
+		if nb == "" || seen[nb] {
+			continue
+		}
+		seen[nb] = true
+		bounds = append(bounds, b)
+	}
+	slices.SortFunc(bounds, Compare)
+	refs := make([]*topodatapb.ShardReference, n)
+	var start []byte
+	for i := range refs {
+		var end []byte
+		if i < len(bounds) {
+			end = bounds[i]
+		}
+		refs[i] = &topodatapb.ShardReference{
+			Name:     fmt.Sprintf("%x-%x", start, end),
+			KeyRange: &topodatapb.KeyRange{Start: start, End: end},
+		}
+		start = end
+	}
+	return refs
+}
+
+// probeKeyspaceIDs returns keyspace ids at and around every shard boundary,
+// plus a few random and extreme ones.
+func probeKeyspaceIDs(r *rand.Rand, shards []*topodatapb.ShardReference) [][]byte {
+	probes := [][]byte{nil, {}, {0}, {0, 0}, {0xff}, {0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff}}
+	for _, s := range shards {
+		for _, b := range [][]byte{s.GetKeyRange().GetStart(), s.GetKeyRange().GetEnd()} {
+			if len(b) == 0 {
+				continue
+			}
+			probes = append(probes, b, append(slices.Clone(b), 0), append(slices.Clone(b), 1))
+			if b[len(b)-1] > 0 {
+				below := slices.Clone(b)
+				below[len(below)-1]--
+				probes = append(probes, below, append(below, 0xff))
+			}
+		}
+	}
+	for range 64 {
+		probes = append(probes, binary.BigEndian.AppendUint64(nil, r.Uint64()))
+	}
+	return probes
+}
+
+func assertSameAsLinear(t *testing.T, shards []*topodatapb.ShardReference, ksid []byte) {
+	t.Helper()
+	want, wantErr := getShardForKeyspaceIDLinear(shards, ksid)
+	got, gotErr := GetShardForKeyspaceID(shards, ksid)
+	if wantErr != nil {
+		require.EqualError(t, gotErr, wantErr.Error(), "ksid %x", ksid)
+		require.Equal(t, vterrors.Code(wantErr), vterrors.Code(gotErr))
+		return
+	}
+	require.NoError(t, gotErr, "ksid %x", ksid)
+	require.Equal(t, want, got, "ksid %x", ksid)
+}
+
+// TestGetShardForKeyspaceIDMatchesLinearScan checks that the binary search in
+// GetShardForKeyspaceID returns the same shard, or the same error, as a plain
+// linear scan for every shard list whose KeyRanges are disjoint: sorted,
+// unsorted, with gaps, unnormalized boundaries, nil KeyRanges and empty lists.
+func TestGetShardForKeyspaceIDMatchesLinearScan(t *testing.T) {
+	r := rand.New(rand.NewPCG(3, 4))
+
+	_, err := GetShardForKeyspaceID(nil, []byte{1})
+	require.EqualError(t, err, "no shard in keyspace")
+
+	var cases [][]*topodatapb.ShardReference
+	cases = append(cases,
+		[]*topodatapb.ShardReference{{Name: "0"}},
+		[]*topodatapb.ShardReference{{Name: "0", KeyRange: &topodatapb.KeyRange{}}},
+		// Custom sharding: every KeyRange is nil, so the first shard wins.
+		[]*topodatapb.ShardReference{{Name: "a"}, {Name: "b"}, {Name: "c"}},
+	)
+	for _, n := range []int{1, 2, 3, 4, 8, 32, 128, 256} {
+		cases = append(cases, evenShardReferences(t, n))
+	}
+	for range 200 {
+		cases = append(cases, randomShardReferences(r, 1+r.IntN(64)))
+	}
+
+	for _, sorted := range cases {
+		variants := [][]*topodatapb.ShardReference{sorted}
+		// Unsorted, as AddSrvKeyspacePartitions can leave a partition.
+		shuffled := slices.Clone(sorted)
+		r.Shuffle(len(shuffled), func(i, j int) { shuffled[i], shuffled[j] = shuffled[j], shuffled[i] })
+		variants = append(variants, shuffled)
+		// Gapped, as DeleteSrvKeyspacePartitions can leave a partition.
+		if len(sorted) > 1 {
+			i := r.IntN(len(sorted) - 1)
+			gapped := slices.Delete(slices.Clone(sorted), i, i+1+r.IntN(len(sorted)-1-i))
+			variants = append(variants, gapped, sorted[1:], sorted[:len(sorted)-1])
+		}
+		for _, shards := range variants {
+			for _, ksid := range probeKeyspaceIDs(r, sorted) {
+				assertSameAsLinear(t, shards, ksid)
+			}
+		}
+	}
+}
+
+// TestGetShardForKeyspaceIDOverlapping documents the behavior for shard lists
+// with overlapping KeyRanges, which topo.OrderAndCheckPartitions rejects: the
+// returned shard always contains the keyspace id, but when several shards do,
+// it isn't necessarily the first one in the list.
+func TestGetShardForKeyspaceIDOverlapping(t *testing.T) {
+	shards := initShardArray(t, "-40-80-c0-")
+	shards = append(shards, &topodatapb.ShardReference{Name: "80-", KeyRange: &topodatapb.KeyRange{Start: []byte{0x80}}})
+	for _, ksid := range [][]byte{{0x10}, {0x50}, {0x90}, {0xd0}} {
+		got, err := GetShardForKeyspaceID(shards, ksid)
+		require.NoError(t, err)
+		idx := slices.IndexFunc(shards, func(s *topodatapb.ShardReference) bool { return s.Name == got })
+		require.True(t, KeyRangeContains(shards[idx].KeyRange, ksid))
+	}
+}
