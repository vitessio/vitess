+// a nested-loop Join runs at the same time for one query. The right-hand side
+// runs once per left-hand side row; running those executions one after the
+// other makes the query latency grow linearly with the number of LHS rows.
+// 1 disables concurrent execution.
+var JoinRHSConcurrency = 8
+
+// canRunJoinRHSConcurrently reports whether the RHS executions of a join can
+// run concurrently. Queries inside a transaction or on a reserved connection
+// must run one at a time on their shard connections.
+func canRunJoinRHSConcurrently(vcursor VCursor, lhsRows int) bool {
+	if JoinRHSConcurrency <= 1 || lhsRows <= 1 {
+		return false
+	}
+	session := vcursor.Session()
+	return !session.InTransaction() && !session.InReservedConn()
+}
+
+// executeRHSConcurrently is the concurrent version of the nested loop in
+// TryExecute: it runs the RHS for every LHS row with up to JoinRHSConcurrency
+// executions at a time, then assembles the output in LHS row order.
+func (jn *Join) executeRHSConcurrently(ctx context.Context, vcursor VCursor, bindVars map[string]*querypb.BindVariable, wantfields bool, lresult *sqltypes.Result) (*sqltypes.Result, error) {
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+
+	rresults := make([]*sqltypes.Result, len(lresult.Rows))
+	var (
+		wg       sync.WaitGroup
+		errOnce  sync.Once
+		firstErr error
+		rowCount atomic.Int64
+	)
+	sem := make(chan struct{}, JoinRHSConcurrency)
+	for i, lrow := range lresult.Rows {
+		select {
+		case sem <- struct{}{}:
+		case <-ctx.Done():
+		}
+		if ctx.Err() != nil {
+			break
+		}
+		joinVars := make(map[string]*querypb.BindVariable, len(jn.Vars))
+		for k, col := range jn.Vars {
+			joinVars[k] = sqltypes.ValueBindVariable(lrow[col])
+		}
+		vars := combineVars(bindVars, joinVars)
+		// Only the first RHS execution needs to return the fields.
+		wantRHSFields := wantfields && i == 0
+		wg.Go(func() {
+			defer func() { <-sem }()
+			rresult, err := vcursor.ExecutePrimitive(ctx, jn.Right, vars, wantRHSFields)
+			if err == nil && vcursor.ExceedsMaxMemoryRows(int(rowCount.Add(int64(len(rresult.Rows))))) {
+				err = fmt.Errorf("in-memory row count exceeded allowed limit of %d", vcursor.MaxMemoryRows())
+			}
+			if err != nil {
+				errOnce.Do(func() {
+					firstErr = err
+					cancel()
+				})
+				return
+			}
+			rresults[i] = rresult
+		})
+	}
+	wg.Wait()
+	if firstErr != nil {
+		return nil, firstErr
+	}
+
+	result := &sqltypes.Result{}
+	for i, lrow := range lresult.Rows {
+		rresult := rresults[i]
+		if rresult == nil {
+			// the loop above stopped early because the context was canceled
+			if err := context.Cause(ctx); err != nil {
+				return nil, err
+			}
+			return nil, vterrors.VT13001("missing join RHS result")
+		}
+		if wantfields && i == 0 {
+			result.Fields = joinFields(lresult.Fields, rresult.Fields, jn.Cols)
+		}
+		for _, rrow := range rresult.Rows {
+			result.Rows = append(result.Rows, joinRows(lrow, rrow, jn.Cols))
+		}
+		if jn.Opcode == LeftJoin && len(rresult.Rows) == 0 {
+			result.Rows = append(result.Rows, joinRows(lrow, nil, jn.Cols))
+		}
+		if vcursor.ExceedsMaxMemoryRows(len(result.Rows)) {
+			return nil, fmt.Errorf("in-memory row count exceeded allowed limit of %d", vcursor.MaxMemoryRows())
+		}
+	}
+	return result, nil
+}
+
 func combineVars(bv1, bv2 map[string]*querypb.BindVariable) map[string]*querypb.BindVariable {
 	out := make(map[string]*querypb.BindVariable)
 	maps.Copy(out, bv1)
