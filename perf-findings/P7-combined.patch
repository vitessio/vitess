+
+// genericValidate is the decoding loop used by charset.Validate for charsets
+// that do not implement Validate themselves.
+func genericValidate(cs types.Charset, input []byte) bool {
+	for len(input) > 0 {
+		_, size, ok := cs.DecodeRune(input)
+		if !ok {
+			return false
+		}
+		input = input[size:]
+	}
+	return true
+}
+
+// genericSlice is the decoding loop used by charset.Slice for charsets
+// that do not implement Slice themselves.
+func genericSlice(cs types.Charset, input []byte, from, to int) []byte {
+	iter := input
+	start := 0
+	for i := range to {
+		_, size, ok := cs.DecodeRune(iter)
+		if !ok {
+			break
+		}
+		if i < from {
+			start += size
+		}
+		iter = iter[size:]
+	}
+	return input[start : len(input)-len(iter)]
+}
+
+// interesting bytes cover every boundary of the UTF-8 lead and continuation byte ranges.
+var interestingBytes = []byte{
+	0x00, 0x41, 0x7F, 0x80, 0x8F, 0x90, 0x9F, 0xA0, 0xBF,
+	0xC0, 0xC1, 0xC2, 0xDF, 0xE0, 0xE1, 0xEC, 0xED, 0xEE, 0xEF,
+	0xF0, 0xF1, 0xF4, 0xF5, 0xF7, 0xF8, 0xFF,
+}
+
+func TestUTF8mb3ValidateExhaustive(t *testing.T) {
+	cs := Charset_utf8mb3{}
+	// Prefixes of different lengths so that the tested bytes land at every
+	// position of an 8-byte word as well as in the scalar tail.
+	prefixes := [][]byte{nil, []byte("abc"), []byte("abcdefg"), []byte("abcdefgh")}
+
+	check := func(buf []byte) {
+		if cs.Validate(buf) != genericValidate(cs, buf) {
+			require.Failf(t, "Validate mismatch", "input %x: Validate=%v, generic=%v", buf, cs.Validate(buf), genericValidate(cs, buf))
+		}
+	}
+
+	// All sequences of 1 to 3 bytes.
+	for _, prefix := range prefixes {
+		buf := append(bytes.Clone(prefix), 0, 0, 0)
+		p := len(prefix)
+		for b0 := range 256 {
+			buf[p] = byte(b0)
+			check(buf[:p+1])
+			for b1 := range 256 {
+				buf[p+1] = byte(b1)
+				check(buf[:p+2])
+				if prefix != nil && len(prefix) != 3 {
+					continue
+				}
+				for b2 := range 256 {
+					buf[p+2] = byte(b2)
+					check(buf[:p+3])
+				}
+			}
+		}
+	}
+
+	// 4-byte sequences: every leading byte, followed by all combinations of interesting bytes.
+	for _, prefix := range prefixes {
+		buf := append(bytes.Clone(prefix), 0, 0, 0, 0)
+		p := len(prefix)
+		for b0 := range 256 {
+			buf[p] = byte(b0)
+			for _, b1 := range interestingBytes {
+				buf[p+1] = b1
+				for _, b2 := range interestingBytes {
+					buf[p+2] = b2
+					for _, b3 := range interestingBytes {
+						buf[p+3] = b3
+						check(buf)
+					}
+				}
+			}
+		}
+	}
+}
+
+func TestUTF8mb3Validate(t *testing.T) {
+	cs := Charset_utf8mb3{}
+	testCases := []struct {
+		in   string
+		want bool
+	}{
+		{"", true},
+		{"hello world, this is ascii", true},
+		{"ñandú 日本語", true},
+		{"\uFFFD", true},
+		{"\xED\x9F\xBF", true},      // U+D7FF
+		{"\xED\xA0\x80", false},     // U+D800 surrogate
+		{"\xED\xBF\xBF", false},     // U+DFFF surrogate
+		{"\xE0\x80\x80", false},     // overlong
+		{"\xC0\x80", false},         // overlong NUL
+		{"\xF0\x9F\x98\x8A", false}, // U+1F60A needs 4 bytes
+		{"abcdefgh\xF0\x9F\x98\x8A", false},
+		{"\xE6\x97", false}, // truncated
+		{"\x80", false},     // lone continuation
+	}
+	for _, tc := range testCases {
+		assert.Equalf(t, tc.want, cs.Validate([]byte(tc.in)), "Validate(%q)", tc.in)
+		assert.Equalf(t, tc.want, genericValidate(cs, []byte(tc.in)), "genericValidate(%q)", tc.in)
+	}
+}
+
+// fragments used to build random, possibly invalid, UTF-8 strings.
+var fragments = [][]byte{
+	[]byte("a"), []byte("0123456789"), []byte("ñ"), []byte("日"), []byte("😊"),
+	[]byte("\uFFFD"),
+	{0xED, 0xA0, 0x80}, // surrogate
+	{0xE0, 0x80, 0x80}, // overlong
+	{0xC0, 0x80},       // overlong
+	{0x80},             // lone continuation
+	{0xE6, 0x97},       // truncated
+	{0xF0, 0x9F},       // truncated
+	{0xFF},
+}
+
+func randomUTF8ish(r *rand.Rand) []byte {
+	var buf []byte
+	n := r.IntN(12)
+	for range n {
+		f := fragments[r.IntN(len(fragments))]
+		// bias towards ASCII so that the fast paths are exercised with long prefixes.
+		if r.IntN(3) == 0 {
+			f = fragments[r.IntN(2)]
+		}
+		buf = append(buf, f...)
+	}
+	return buf
+}
+
+func TestUTF8SliceEquivalence(t *testing.T) {
+	r := rand.New(rand.NewPCG(1, 2))
+	charsets := []interface {
+		types.Charset
+		Slice([]byte, int, int) []byte
+	}{Charset_utf8mb3{}, Charset_utf8mb4{}}
+
+	for range 200000 {
+		in := randomUTF8ish(r)
+		if r.IntN(10) == 0 {
+			in = nil
+		}
+		n := len(in)
+		from := r.IntN(n+6) - 3
+		to := r.IntN(n+6) - 3
+		for _, cs := range charsets {
+			got := cs.Slice(in, from, to)
+			want := genericSlice(cs, in, from, to)
+			if !bytes.Equal(got, want) || cap(got) != cap(want) || (got == nil) != (want == nil) {
+				require.Failf(t, "Slice mismatch", "%s.Slice(%x, %d, %d) = %x (cap %d), want %x (cap %d)",
+					cs.Name(), in, from, to, got, cap(got), want, cap(want))
+			}
+		}
+	}
+}
+
+func TestUTF8mb3ValidateRandom(t *testing.T) {
+	r := rand.New(rand.NewPCG(3, 4))
+	cs := Charset_utf8mb3{}
+	for range 200000 {
+		in := randomUTF8ish(r)
+		require.Equalf(t, genericValidate(cs, in), cs.Validate(in), "Validate(%x)", in)
+	}
+}
+
+func FuzzUTF8Slice(f *testing.F) {
+	for _, frag := range fragments {
+		f.Add(frag, 0, 2)
+	}
+	f.Add([]byte("abcdefghij\xE6\x97\xA5klmnop"), 3, 14)
+	f.Fuzz(func(t *testing.T, in []byte, from, to int) {
+		for _, cs := range []interface {
+			types.Charset
+			Slice([]byte, int, int) []byte
+		}{Charset_utf8mb3{}, Charset_utf8mb4{}} {
+			got := cs.Slice(in, from, to)
+			want := genericSlice(cs, in, from, to)
+			require.Equal(t, want, got)
+			require.Equal(t, cap(want), cap(got))
+		}
+		require.Equal(t, genericValidate(Charset_utf8mb3{}, in), Charset_utf8mb3{}.Validate(in))
+	})
+}
+
+func TestUTF8LengthEquivalence(t *testing.T) {
+	r := rand.New(rand.NewPCG(5, 6))
+	for range 200000 {
+		in := randomUTF8ish(r)
+		require.Equalf(t, utf8.RuneCount(in), Charset_utf8mb3{}.Length(in), "Length(%x)", in)
+		require.Equalf(t, utf8.RuneCount(in), Charset_utf8mb4{}.Length(in), "Length(%x)", in)
+	}
+}
