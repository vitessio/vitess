+// runExpireWorker calls worker every interval while clients are waiting for a connection. While the
+// waitlist is empty it sleeps without a ticker: otherwise every idle pool wakes up every interval, and a
+// vttablet has more than twenty pools.
+func (pool *ConnPool[C]) runExpireWorker(closeChan <-chan struct{}, interval time.Duration, worker func()) {
+	pool.workers.Add(1)
+
+	go func() {
+		defer pool.workers.Done()
+
+		for {
+			select {
+			case <-pool.wait.wake:
+			case <-closeChan:
+				return
+			}
+
+			tick := time.NewTicker(interval)
+			for pool.wait.waiting() > 0 {
+				select {
+				case <-tick.C:
+					worker()
+				case <-closeChan:
+					tick.Stop()
+					return
+				}
+			}
+			tick.Stop()
+		}
+	}()
+}
