+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package servenv
+
+import (
+	"math/bits"
+	"sync"
+
+	"google.golang.org/grpc/mem"
+)
+
+const (
+	// codecPoolMinExp and codecPoolMaxExp bound the power-of-two buffer tiers of
+	// codecBufferPool: 256 B .. 16 MiB. Larger buffers are allocated directly and
+	// not pooled.
+	codecPoolMinExp = 8
+	codecPoolMaxExp = 24
+)
+
+// codecBufferPool is the mem.BufferPool used by the vtproto codec for the
+// buffers it marshals into and unmarshals from.
+//
+// gRPC's default pool is a poor fit for Vitess result messages, for two reasons:
+//   - Its tiers are 256 B, 4 KiB, 16 KiB, 32 KiB and 1 MiB. A streaming result
+//     chunk is slightly larger than --queryserver-config-stream-buffer-size
+//     (32 KiB by default), so every chunk is served from the 1 MiB tier.
+//   - It zeroes the whole capacity of every pooled buffer it hands out.
+//
+// Together that clears 1 MiB of memory for every ~33 KiB streamed message, on
+// both the vttablet (marshal) and the vtgate (unmarshal) side.
+//
+// The codec always overwrites the full requested length before reading
+// (MarshalToSizedBufferVT fills [:size], MaterializeToBuffer copies [:size]),
+// and never reads past it, so zeroing is unnecessary. This pool uses one tier
+// per power of two, which bounds the over-allocation to 2x, and does not zero.
+type codecBufferPool struct {
+	tiers [codecPoolMaxExp - codecPoolMinExp + 1]sync.Pool
+}
+
+var _ mem.BufferPool = (*codecBufferPool)(nil)
+
+// tierForGet returns the index of the smallest tier that fits size, or -1 if
+// size is larger than the largest tier.
+func tierForGet(size int) int {
+	exp := bits.Len(uint(size - 1))
+	if exp < codecPoolMinExp {
+		exp = codecPoolMinExp
+	}
+	if exp > codecPoolMaxExp {
+		return -1
+	}
+	return exp - codecPoolMinExp
+}
+
+// Get returns a buffer of length size. Its contents are undefined.
+func (p *codecBufferPool) Get(size int) *[]byte {
+	if size <= 0 {
+		b := []byte{}
+		return &b
+	}
+	t := tierForGet(size)
+	if t < 0 {
+		b := make([]byte, size)
+		return &b
+	}
+	if buf, ok := p.tiers[t].Get().(*[]byte); ok {
+		*buf = (*buf)[:size]
+		return buf
+	}
+	b := make([]byte, size, 1<<(t+codecPoolMinExp))
+	return &b
+}
+
+// Put returns a buffer to the pool. Buffers whose capacity is not one of the
+// tier sizes are dropped.
+func (p *codecBufferPool) Put(buf *[]byte) {
+	c := cap(*buf)
+	if c == 0 || c&(c-1) != 0 {
+		return
+	}
+	exp := bits.Len(uint(c)) - 1
+	if exp < codecPoolMinExp || exp > codecPoolMaxExp {
+		return
+	}
+	p.tiers[exp-codecPoolMinExp].Put(buf)
+}
