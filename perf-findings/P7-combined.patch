+// rewriteInteger rewrites a '%d' directive into an allocation-free call to
+// TrackedBuffer.WriteInt or TrackedBuffer.WriteUint, depending on the signedness
+// of the argument. The argument must have an integer underlying type; this is
+// checked at code generation time.
+func (r *Rewriter) rewriteInteger(rcv ast.Expr, arg ast.Expr) ast.Stmt {
+	argT := r.pkg.TypesInfo.Types[arg].Type
+	if argT == nil {
+		panic("'%d' directive requires an argument with a known type")
+	}
+	basic, ok := argT.Underlying().(*types.Basic)
+	if !ok || basic.Info()&types.IsInteger == 0 {
+		panic(fmt.Sprintf("'%%d' directive requires an integer argument, got %s", argT))
+	}
+
+	method, conv := "WriteInt", types.Typ[types.Int64]
+	if basic.Info()&types.IsUnsigned != 0 {
+		method, conv = "WriteUint", types.Typ[types.Uint64]
+	}
+	if !types.Identical(argT, conv) {
+		arg = &ast.CallExpr{
+			Fun:  &ast.Ident{Name: conv.Name()},
+			Args: []ast.Expr{arg},
+		}
+	}
+	return r.rewriteLiteral(rcv, method, arg)
+}
