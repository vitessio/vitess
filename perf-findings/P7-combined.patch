+		sqltypes.NewVarBinary("\x00\x01\x02"),
+	}
+	for _, vindexType := range []string{
+		"hash", "xxhash", "numeric", "binary", "binary_md5", "reverse_bits",
+		"unicode_loose_md5", "unicode_loose_xxhash",
+	} {
+		vindex, err := vindexes.CreateVindex(vindexType, vindexType, nil)
+		require.NoError(t, err)
+		_, isHashing := vindex.(vindexes.Hashing)
+		require.True(t, isHashing, "%s must implement vindexes.Hashing to exercise the fast path", vindexType)
+		for _, value := range values {
+			// Put the vindex column in the middle of the row.
+			row := []sqltypes.Value{sqltypes.NewInt64(7), value, sqltypes.NewVarChar("x")}
+			want, wantErr := getKeyspaceIDSlow(row, vindex, []int{1})
+			got, gotErr := getKeyspaceID(row, vindex, []int{1}, nil)
+			if wantErr != nil {
+				assert.EqualError(t, gotErr, wantErr.Error(), "%s(%v)", vindexType, value)
+				continue
+			}
+			require.NoError(t, gotErr, "%s(%v)", vindexType, value)
+			assert.Equal(t, want, got, "%s(%v)", vindexType, value)
+		}
+	}
+}
+
+// TestMapValuesReusesBuffer confirms that mapValues writes every output column
+// when it reuses the caller's buffer, so no value of a previous row leaks into
+// the next one.
+func TestMapValuesReusesBuffer(t *testing.T) {
+	hash, err := vindexes.CreateVindex("hash", "hash", nil)
+	require.NoError(t, err)
+	plan := &Plan{
+		Table: &Table{Name: "t1"},
+		ColExprs: []ColExpr{
+			{ColNum: 1},
+			{ColNum: -1, FixedValue: sqltypes.NewInt64(5)},
+			{ColNum: 0, Vindex: hash, VindexColumns: []int{0}},
+			{ColNum: 0},
+		},
+	}
+	stale := sqltypes.NewVarChar("stale")
+	buf := []sqltypes.Value{stale, stale, stale, stale, stale}
+	row := []sqltypes.Value{sqltypes.NewInt64(1), sqltypes.NULL}
+
+	got, err := plan.mapValues(row, buf)
+	require.NoError(t, err)
+	assert.Equal(t, []sqltypes.Value{
+		sqltypes.NULL,
+		sqltypes.NewInt64(5),
+		sqltypes.MakeTrusted(sqltypes.VarBinary, []byte("\x16k@\xb4J\xbaK\xd6")),
+		sqltypes.NewInt64(1),
+	}, got)
+	// The buffer is large enough, so it is reused.
+	assert.Same(t, &buf[0], &got[0])
+
+	// A buffer that is too small is not used.
+	got, err = plan.mapValues(row, buf[:1:1])
+	require.NoError(t, err)
+	assert.Len(t, got, 4)
+	assert.NotSame(t, &buf[0], &got[0])
+}
