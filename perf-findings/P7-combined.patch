+// many duplicates, column 1 is the row's position in the input.
+func runsInput(r *rand.Rand, cmp Comparison, n, k int) []sqltypes.Row {
+	rows := make([]sqltypes.Row, n)
+	for i := range rows {
+		rows[i] = sqltypes.Row{sqltypes.NewInt64(r.Int64N(int64(n/4 + 1)))}
+	}
+	for run := range k {
+		lo, hi := run*n/k, (run+1)*n/k
+		slices.SortFunc(rows[lo:hi], func(a, b sqltypes.Row) int { return cmp.Compare(a, b) })
+	}
+	for i := range rows {
+		rows[i] = append(rows[i], sqltypes.NewInt64(int64(i)))
+	}
+	return rows
+}
+
+func TestSortMergesSortedRuns(t *testing.T) {
+	r := rand.New(rand.NewPCG(1, 2))
+	for _, desc := range []bool{false, true} {
+		cmp := Comparison{{Col: 0, WeightStringCol: -1, Desc: desc, Type: NewType(sqltypes.Int64, collations.CollationBinaryID)}}
+		for _, n := range []int{0, 1, 2, 3, 10, 1000} {
+			for _, k := range []int{1, 2, 3, 4, 7, maxMergeRuns, maxMergeRuns + 1, 200} {
+				if k > max(n, 1) {
+					continue
+				}
+				t.Run(fmt.Sprintf("desc=%v/n=%d/k=%d", desc, n, k), func(t *testing.T) {
+					rows := runsInput(r, cmp, n, max(k, 1))
+					want := slices.Clone(rows)
+					slices.SortStableFunc(want, func(a, b sqltypes.Row) int { return cmp.Compare(a, b) })
+
+					merged := k <= maxMergeRuns
+					got := slices.Clone(rows)
+					assert.Equal(t, merged, cmp.mergeRuns(got), "mergeRuns should only handle up to %d runs", maxMergeRuns)
+
+					got = slices.Clone(rows)
+					cmp.Sort(got)
+					require.Len(t, got, len(want))
+					for i := range want {
+						if merged {
+							// the merge is stable: equal keys keep their input order
+							require.Equal(t, want[i], got[i], "row %d", i)
+						} else {
+							require.Zero(t, cmp.Compare(want[i], got[i]), "row %d", i)
+						}
+					}
+				})
+			}
+		}
+	}
+}
+
+func TestSortRandomInputFallsBack(t *testing.T) {
+	r := rand.New(rand.NewPCG(3, 4))
+	cmp := Comparison{{Col: 0, WeightStringCol: -1, Type: NewType(sqltypes.Int64, collations.CollationBinaryID)}}
+	rows := make([]sqltypes.Row, 10000)
+	for i := range rows {
+		rows[i] = sqltypes.Row{sqltypes.NewInt64(r.Int64())}
+	}
+	assert.False(t, cmp.mergeRuns(slices.Clone(rows)))
+	cmp.Sort(rows)
+	assert.True(t, slices.IsSortedFunc(rows, func(a, b sqltypes.Row) int { return cmp.Compare(a, b) }))
+}
+
+func BenchmarkSortShardRuns(b *testing.B) {
+	cmp := Comparison{{Col: 0, WeightStringCol: -1, Type: NewType(sqltypes.Int64, collations.CollationBinaryID)}}
+	for _, k := range []int{2, 4, 16} {
+		rows := runsInput(rand.New(rand.NewPCG(5, 6)), cmp, 10000, k)
+		work := make([]sqltypes.Row, len(rows))
+		b.Run(fmt.Sprintf("runs=%d/merge", k), func(b *testing.B) {
+			for b.Loop() {
+				copy(work, rows)
+				cmp.Sort(work)
+			}
+		})
+		b.Run(fmt.Sprintf("runs=%d/pdqsort", k), func(b *testing.B) {
+			for b.Loop() {
+				copy(work, rows)
+				slices.SortFunc(work, func(a, b sqltypes.Row) int { return cmp.Compare(a, b) })
+			}
+		})
+	}
+}
