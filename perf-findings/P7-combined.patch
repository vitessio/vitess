+// TestMergeSortManyRows tests that a large number of rows from several shards,
+// sent in chunks whose rows slice is reused by the sender, are merged in order
+// and are returned in results of at most mergeSortBatchSize rows.
+func TestMergeSortManyRows(t *testing.T) {
+	fields := sqltypes.MakeTestFields("id", "int64")
+	const shards, rowsPerShard = 5, 1000
+	prims := make([]StreamExecutor, 0, shards)
+	for s := range shards {
+		ids := make([]int64, 0, rowsPerShard)
+		for i := range rowsPerShard {
+			ids = append(ids, int64(i*shards+s))
+		}
+		prims = append(prims, &reusingShardResult{fields: fields, ids: ids, chunk: 37 + s})
+	}
+	ms := MergeSort{Primitives: prims, OrderBy: int64OrderBy}
+
+	var got []int64
+	err := ms.TryStreamExecute(t.Context(), &noopVCursor{}, nil, true, func(qr *sqltypes.Result) error {
+		require.LessOrEqual(t, len(qr.Rows), mergeSortBatchSize)
+		for _, row := range qr.Rows {
+			v, err := row[0].ToInt64()
+			require.NoError(t, err)
+			got = append(got, v)
+		}
