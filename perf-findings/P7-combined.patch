+// TestMetroHashFixedWidthWrites checks that the Write8/16/32/64 helpers hash
+// the same byte stream as a single Write, at every alignment of the pending
+// input block.
+func TestMetroHashFixedWidthWrites(t *testing.T) {
+	rng := rand.New(rand.NewPCG(1, 2))
+	for iter := 0; iter < 2000; iter++ {
+		var m Metro128
+		m.Init(uint64(iter))
+		var stream []byte
+
+		ops := rng.IntN(64)
+		for range ops {
+			switch rng.IntN(5) {
+			case 0:
+				u := uint8(rng.Uint32())
+				m.Write8(u)
+				stream = append(stream, u)
+			case 1:
+				u := uint16(rng.Uint32())
+				m.Write16(u)
+				stream = binary.LittleEndian.AppendUint16(stream, u)
+			case 2:
+				u := rng.Uint32()
+				m.Write32(u)
+				stream = binary.LittleEndian.AppendUint32(stream, u)
+			case 3:
+				u := rng.Uint64()
+				m.Write64(u)
+				stream = binary.LittleEndian.AppendUint64(stream, u)
+			case 4:
+				buf := make([]byte, rng.IntN(70))
+				for i := range buf {
+					buf[i] = byte(rng.Uint32())
+				}
+				_, _ = m.Write(buf)
+				stream = append(stream, buf...)
+			}
+		}
+
+		var want Metro128
+		want.Init(uint64(iter))
+		_, _ = want.Write(stream)
+		require.Equal(t, want.Sum128(), m.Sum128(), "iteration %d, %d bytes", iter, len(stream))
+	}
+}
