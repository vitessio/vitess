+// TestProto3ToRowsSlabIsCapped checks that proto3ToRows does not put the
+// values of more than proto3ToRowsSlabRows rows in one backing array, so
+// that retaining one row cannot pin the values of a whole large result.
+func TestProto3ToRowsSlabIsCapped(t *testing.T) {
+	fields := []*querypb.Field{{Name: "a", Type: Int64}, {Name: "b", Type: VarChar}}
+	var rows [][]Value
+	for i := range 3*proto3ToRowsSlabRows + 7 {
+		rows = append(rows, []Value{NewInt64(int64(i)), NewVarChar("x")})
+	}
+	got := proto3ToRows(fields, RowsToProto3(rows))
+	require.Equal(t, rows, got)
+
+	// adjacent reports whether b starts right where a ends in memory.
+	adjacent := func(a, b []Value) bool {
+		end := unsafe.Add(unsafe.Pointer(unsafe.SliceData(a)), uintptr(len(a))*unsafe.Sizeof(Value{}))
+		return end == unsafe.Pointer(unsafe.SliceData(b))
+	}
+	for i := 1; i < len(got); i++ {
+		// Rows are carved out of one slab back to back, and a new slab
+		// starts every proto3ToRowsSlabRows rows.
+		assert.Equal(t, i%proto3ToRowsSlabRows != 0, adjacent(got[i-1], got[i]), "row %d", i)
+	}
+}
