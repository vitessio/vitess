+func TestRowsToProto3SlabEquivalence(t *testing.T) {
+	rng := rand.New(rand.NewPCG(1, 2))
+	for _, shape := range [][2]int{{1, 0}, {1, 1}, {3, 0}, {1, 5}, {10, 3}, {100, 7}, {500, 1}} {
+		for range 20 {
+			qr := randomSlabResult(rng, shape[0], shape[1])
+
+			got := RowsToProto3(qr.Rows)
+			want := rowsToProto3PerRow(qr.Rows)
+			require.Len(t, got, len(want))
+			for i := range want {
+				require.True(t, proto.Equal(want[i], got[i]), "row %d", i)
+				// Sub-slices must be capped so that appends cannot clobber neighbours.
+				assert.Equal(t, len(got[i].Lengths), cap(got[i].Lengths))
+				assert.Equal(t, len(got[i].Values), cap(got[i].Values))
+				assert.NotNil(t, got[i].Lengths)
+				assert.NotNil(t, got[i].Values)
+			}
+
+			back := proto3ToRows(qr.Fields, got)
+			wantBack := proto3ToRowsPerRow(qr.Fields, want)
+			require.Equal(t, wantBack, back)
+			for i := range back {
+				assert.Equal(t, len(back[i]), cap(back[i]))
+			}
+		}
+	}
+}
