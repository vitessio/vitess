+package sqlparser
+
+import (
+	"runtime"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"vitess.io/vitess/go/race"
+)
+
+// parseOnNewGoroutines parses query on n new goroutines, keeps them alive, and returns the average growth of
+// the stack memory in use per goroutine.
+func parseOnNewGoroutines(t *testing.T, parser *Parser, query string, n int) uint64 {
+	var ready, parked sync.WaitGroup
+	release := make(chan struct{})
+	errs := make(chan error, n)
+
+	runtime.GC()
+	var before, after runtime.MemStats
+	runtime.ReadMemStats(&before)
+	for range n {
+		ready.Add(1)
+		parked.Add(1)
+		go func() {
+			defer parked.Done()
+			if _, err := parser.Parse(query); err != nil {
+				errs <- err
+			}
+			ready.Done()
+			<-release
+		}()
+	}
+	ready.Wait()
+	runtime.ReadMemStats(&after)
+	close(release)
+	parked.Wait()
+	close(errs)
+	for err := range errs {
+		require.NoError(t, err)
+	}
+	if after.StackInuse < before.StackInuse {
+		return 0
+	}
+	return (after.StackInuse - before.StackInuse) / uint64(n)
+}
+
+// TestParseStackUsage verifies that parsing a simple query fits in the 8 KiB stack of a new goroutine.
+// Every vtgate MySQL connection parses its queries on its own goroutine, so the stack that Parse needs is
+// kept by every open connection. The generated parser's Parse function used to have a stack frame of about
+// 23 KB (one spill slot per inlined yySymType accessor), which grew every such goroutine to 32 KiB, and the GC
+// shrank and regrew these stacks all the time on connections that are idle between queries.
+func TestParseStackUsage(t *testing.T) {
+	if race.Enabled {
+		t.Skip("the race detector changes stack usage")
+	}
+	parser := NewTestParser()
+	const n = 1000
+	perGoroutine := parseOnNewGoroutines(t, parser, "select c from sbtest1 where id = 1", n)
+	t.Logf("stack in use per goroutine after Parse: %d bytes", perGoroutine)
+	assert.Less(t, perGoroutine, uint64(16<<10), "Parse grows a new goroutine's stack beyond 8 KiB")
+}
