+	return buf.String(), end + 1, nil
+}
+
+func TestWriteStringContentMatchesReference(t *testing.T) {
+	check := func(t *testing.T, body string) {
+		for _, tail := range []string{`"`, `", 1`, ``, `\`} {
+			data := []byte(`"` + body + tail)
+			want, wantPos, wantErr := writeStringContentRef(data)
+
+			w := sqlWriter{data: data, buf: &bytes2.Buffer{}}
+			gotErr := w.writeStringContent()
+			if wantErr != nil {
+				require.Error(t, gotErr, "input %q", data)
+				assert.Equal(t, wantErr.Error(), gotErr.Error(), "input %q", data)
+				continue
+			}
+			require.NoError(t, gotErr, "input %q", data)
+			assert.Equal(t, want, w.buf.String(), "input %q", data)
+			assert.Equal(t, wantPos, w.pos, "input %q", data)
+		}
+	}
+	for _, s := range escapeEdgeCases() {
+		check(t, s)
+	}
+	r := rand.New(rand.NewPCG(3, 4))
+	for range 20000 {
+		check(t, randomEscapeInput(r, 30))
+	}
+}
+
+func TestUnescapeJSONMatchesReference(t *testing.T) {
+	check := func(t *testing.T, s string) {
+		want, wantErr := unescapeJSONRef([]byte("p"), []byte(s))
+		got, gotErr := unescapeJSON([]byte("p"), []byte(s))
+		if wantErr != nil {
+			require.Error(t, gotErr, "input %q", s)
+			assert.Equal(t, wantErr.Error(), gotErr.Error(), "input %q", s)
+			return
+		}
+		require.NoError(t, gotErr, "input %q", s)
+		assert.Equal(t, string(want), string(got), "input %q", s)
+	}
+	for _, s := range escapeEdgeCases() {
+		check(t, s)
+	}
+	r := rand.New(rand.NewPCG(5, 6))
+	for range 20000 {
+		check(t, randomEscapeInput(r, 30))
+	}
+}
+
+func FuzzEscapeString(f *testing.F) {
+	for _, s := range escapeEdgeCases() {
+		f.Add(s)
+	}
+	f.Fuzz(func(t *testing.T, s string) {
+		require.Equal(t, string(escapeStringRef(nil, s)), string(escapeString(nil, s)))
+
+		want, wantErr := unescapeJSONRef(nil, []byte(s))
+		got, gotErr := unescapeJSON(nil, []byte(s))
+		require.Equal(t, wantErr == nil, gotErr == nil)
+		if wantErr == nil {
+			require.Equal(t, want, got)
+		}
+
+		data := []byte(`"` + s)
+		wantSQL, wantPos, wantErr := writeStringContentRef(data)
+		w := sqlWriter{data: data, buf: &bytes2.Buffer{}}
+		gotErr = w.writeStringContent()
+		require.Equal(t, wantErr == nil, gotErr == nil)
+		if wantErr == nil {
+			require.Equal(t, wantSQL, w.buf.String())
+			require.Equal(t, wantPos, w.pos)
+		}
+	})
+}
