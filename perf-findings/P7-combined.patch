+package charset_test
+
+import (
+	"bytes"
+	"fmt"
+	"math/rand/v2"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"vitess.io/vitess/go/mysql/collations"
+	"vitess.io/vitess/go/mysql/collations/charset"
+	"vitess.io/vitess/go/mysql/collations/colldata"
+)
+
+// allCharsets returns one instance of every charset that a MySQL 8.0
+// collation uses, plus the Unicode charsets that no collation list covers.
+func allCharsets(t testing.TB) []charset.Charset {
+	seen := map[string]bool{}
+	var out []charset.Charset
+	add := func(cs charset.Charset) {
+		if !seen[cs.Name()] {
+			seen[cs.Name()] = true
+			out = append(out, cs)
+		}
+	}
+	for _, coll := range colldata.All(collations.MySQL8()) {
+		add(coll.Charset())
+	}
+	for _, cs := range []charset.Charset{
+		charset.Charset_utf8mb3{},
+		charset.Charset_utf8mb4{},
+		charset.Charset_utf16{},
+		charset.Charset_utf16le{},
+		charset.Charset_ucs2{},
+		charset.Charset_utf32{},
+		charset.Charset_binary{},
+		charset.Charset_latin1{},
+	} {
+		add(cs)
+	}
+	require.Greater(t, len(out), 30)
+	return out
+}
+
+func charsetByName(t testing.TB, name string) charset.Charset {
+	for _, cs := range allCharsets(t) {
+		if cs.Name() == name {
+			return cs
+		}
+	}
+	require.FailNow(t, "missing charset", name)
+	return nil
+}
+
+// TestASCIICompatibility checks every charset that the conversion fast path
+// treats as ASCII compatible against its DecodeRune and EncodeRune.
+func TestASCIICompatibility(t *testing.T) {
+	for _, cs := range allCharsets(t) {
+		decodes, encodes := true, true
+		for c := range byte(utf8.RuneSelf) {
+			// The trailing bytes check that DecodeRune does not look past
+			// an ASCII byte.
+			for _, in := range [][]byte{{c}, {c, 0x80}, {c, 0xA1, 0xA1}, {c, 0xFF}} {
+				cp, width, ok := cs.DecodeRune(in)
+				if !ok || width != 1 || cp != rune(c) {
+					decodes = false
+				}
+			}
+			var buf [utf8.UTFMax]byte
+			if w := cs.EncodeRune(buf[:], rune(c)); w != 1 || buf[0] != c {
+				encodes = false
+			}
+		}
+		if charset.ASCIIDecoder(cs) {
+			assert.True(t, decodes, "%s is not an ASCII decoder", cs.Name())
+		}
+		if charset.ASCIIEncoder(cs) {
+			assert.True(t, encodes, "%s is not an ASCII encoder", cs.Name())
+		}
+	}
+
+	for name, want := range map[string][2]bool{
+		"utf8mb4":  {true, true},
+		"utf8mb3":  {true, true},
+		"latin1":   {true, true},
+		"ascii":    {true, true},
+		"latin2":   {true, true},
+		"cp1251":   {true, true},
+		"gb18030":  {true, true},
+		"gb2312":   {true, true},
+		"euckr":    {true, true},
+		"cp932":    {true, true},
+		"ujis":     {true, true},
+		"eucjpms":  {true, true},
+		"koi8r":    {true, true},
+		"macroman": {true, true},
+		"sjis":     {true, false},
+		"swe7":     {false, false},
+		"utf16":    {false, false},
+		"utf16le":  {false, false},
+		"ucs2":     {false, false},
+		"utf32":    {false, false},
+		"binary":   {false, false},
+	} {
+		cs := charsetByName(t, name)
+		assert.Equal(t, want[0], charset.ASCIIDecoder(cs), "ASCIIDecoder(%s)", name)
+		assert.Equal(t, want[1], charset.ASCIIEncoder(cs), "ASCIIEncoder(%s)", name)
+	}
+}
+
+func TestASCIIPrefix(t *testing.T) {
+	for n := range 40 {
+		for pos := 0; pos <= n; pos++ {
+			in := bytes.Repeat([]byte{'a'}, n)
+			want, wantCount := n, 0
+			if pos < n {
+				in[pos] = 0x80 | byte(pos)
+				want, wantCount = pos, 1
+			}
+			assert.Equal(t, want, charset.ASCIIPrefix(in), "n=%d pos=%d", n, pos)
+			assert.Equal(t, wantCount, charset.CountNonASCII(in), "n=%d pos=%d", n, pos)
+		}
+	}
+	assert.Equal(t, 17, charset.CountNonASCII(bytes.Repeat([]byte{0xFF}, 17)))
+}
+
+var sampleRunes = []rune(
+	"abcdefghijklmnopqrstuvwxyz0123456789 \\~?\x00\x7f" +
+		"àéîõüßÆØÅ€£¥©" +
+		"ĄČĘŁŃŚŹŻ" +
+		"ЖЗИЙКЛМжзий" +
+		"日本語漢字テキストカタカナｱｲｳ" +
+		"中文简体字符" +
+		"한국어글자" +
+		"😀🎉" +
+		"\uFFFD\u2028")
+
+// convertInputs returns inputs in the native encoding of cs: ASCII only,
+// mostly ASCII, mostly non-ASCII, and random bytes that are often invalid.
+func convertInputs(rng *rand.Rand, cs charset.Charset) [][]byte {
+	var inputs [][]byte
+	for _, n := range []int{0, 1, 7, 8, 9, 15, 16, 17, 31, 64, 200} {
+		ascii := make([]byte, n)
+		for i := range ascii {
+			ascii[i] = byte(rng.IntN(utf8.RuneSelf))
+		}
+		inputs = append(inputs, ascii)
+
+		for _, nonASCII := range []int{2, 50} {
+			var sb strings.Builder
+			for range n {
+				if rng.IntN(100) < nonASCII {
+					sb.WriteRune(sampleRunes[rng.IntN(len(sampleRunes))])
+				} else {
+					sb.WriteByte(byte('a' + rng.IntN(26)))
+				}
+			}
+			// Characters that cs cannot encode become '?', which is
+			// what a stored value would hold.
+			native, _ := charset.LegacyConvert(nil, cs, []byte(sb.String()), charset.Charset_utf8mb4{})
+			inputs = append(inputs, native)
+		}
+
+		random := make([]byte, n)
+		for i := range random {
+			if rng.IntN(3) == 0 {
+				random[i] = byte(rng.IntN(256))
+			} else {
+				random[i] = byte(rng.IntN(utf8.RuneSelf))
+			}
+		}
+		inputs = append(inputs, random)
+	}
+	return inputs
+}
+
+func requireSameConversion(t *testing.T, dst []byte, dstCS charset.Charset, src []byte, srcCS charset.Charset) {
+	t.Helper()
+	var legacyDst, newDst []byte
+	if dst != nil {
+		legacyDst = append(make([]byte, 0, cap(dst)), dst...)
+		newDst = append(make([]byte, 0, cap(dst)), dst...)
+	}
+	srcCopy := bytes.Clone(src)
+	want, wantErr := charset.LegacyConvert(legacyDst, dstCS, src, srcCS)
+	got, gotErr := charset.Convert(newDst, dstCS, src, srcCS)
+	msg := fmt.Sprintf("%s -> %s, dst=%q, src=%#v", srcCS.Name(), dstCS.Name(), dst, src)
+	require.Equal(t, srcCopy, src, msg)
+	require.Equal(t, want, got, msg)
+	if wantErr == nil {
+		require.NoError(t, gotErr, msg)
+	} else {
+		require.EqualError(t, gotErr, wantErr.Error(), msg)
+	}
+}
+
+// TestConvertMatchesLegacy compares Convert with the implementation that
+// predates the ASCII fast path, for every pair of charsets.
+func TestConvertMatchesLegacy(t *testing.T) {
+	rng := rand.New(rand.NewPCG(1, 2))
+	css := allCharsets(t)
+	for _, srcCS := range css {
+		inputs := convertInputs(rng, srcCS)
+		for _, dstCS := range css {
+			for _, in := range inputs {
+				requireSameConversion(t, nil, dstCS, in, srcCS)
+			}
+			// Append to a destination with spare capacity.
+			for _, in := range inputs[len(inputs)-8:] {
+				requireSameConversion(t, make([]byte, 3, 8), dstCS, in, srcCS)
+				requireSameConversion(t, []byte("prefix"), dstCS, in, srcCS)
+			}
+		}
+	}
+}
+
+// TestConvertSmallDestination checks that a non-nil destination with less
+// than utf8.UTFMax bytes of capacity works. The legacy implementation panics
+// on it.
+func TestConvertSmallDestination(t *testing.T) {
+	src := []byte("h\xe9llo w\xf6rld")
+	for _, dst := range [][]byte{{}, make([]byte, 1), make([]byte, 0, 1), make([]byte, 2, 3)} {
+		got, err := charset.Convert(dst, charset.Charset_utf8mb4{}, src, charset.Charset_latin1{})
+		require.NoError(t, err)
+		assert.Equal(t, append(bytes.Clone(dst), "héllo wörld"...), got)
+	}
+}
+
+func FuzzConvertMatchesLegacy(f *testing.F) {
+	css := allCharsets(f)
+	f.Add([]byte("hello world"), uint8(0), uint8(1))
+	f.Add([]byte("h\xe9llo \x81\x40 w\xf6rld \xff"), uint8(3), uint8(7))
+	f.Add([]byte("日本語 and ASCII \\ tail"), uint8(5), uint8(2))
+	f.Fuzz(func(t *testing.T, in []byte, from, to uint8) {
+		srcCS := css[int(from)%len(css)]
+		dstCS := css[int(to)%len(css)]
+		requireSameConversion(t, nil, dstCS, in, srcCS)
+		requireSameConversion(t, []byte("prefix"), dstCS, in, srcCS)
+	})
+}
