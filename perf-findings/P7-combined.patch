+// rowDestinationsOld is the per-row allocating version of rowDestinations,
+// kept as the reference for equivalence and as the benchmark baseline.
+func rowDestinationsOld(keyspaceIDs [][]byte) ([]*querypb.Value, []key.ShardDestination) {
+	var indexes []*querypb.Value
+	var destinations []key.ShardDestination
+	for i, ksid := range keyspaceIDs {
+		if ksid != nil {
+			indexes = append(indexes, &querypb.Value{
+				Value: strconv.AppendInt(nil, int64(i), 10),
+			})
+			destinations = append(destinations, key.DestinationKeyspaceID(ksid))
+		}
+	}
+	return indexes, destinations
+}
+
+func TestRowDestinations(t *testing.T) {
+	for _, n := range []int{0, 1, 9, 10, 11, 99, 100, 101, 1234} {
+		ksids := make([][]byte, n)
+		for i := range ksids {
+			// Every third row has a nil keyspace id, as with INSERT IGNORE.
+			if i%3 != 1 {
+				ksids[i] = []byte(strconv.Itoa(i))
+			}
+		}
+		wantIdx, wantDst := rowDestinationsOld(ksids)
+		gotIdx, gotDst := rowDestinations(ksids)
+		require.Equal(t, wantDst, gotDst, "n=%d", n)
+		require.Len(t, gotIdx, len(wantIdx), "n=%d", n)
+		for i := range wantIdx {
+			require.Equal(t, string(wantIdx[i].Value), string(gotIdx[i].Value), "n=%d", n)
+			// Values must not share capacity, so appending to one can't
+			// overwrite the next.
+			require.Equal(t, len(gotIdx[i].Value), cap(gotIdx[i].Value))
+		}
+	}
+}
+
+func BenchmarkRowDestinations(b *testing.B) {
+	ksids := make([][]byte, 1000)
+	for i := range ksids {
+		ksids[i] = []byte{byte(i >> 8), byte(i)}
+	}
+	for _, impl := range []struct {
+		name string
+		fn   func([][]byte) ([]*querypb.Value, []key.ShardDestination)
+	}{
+		{"old", rowDestinationsOld},
+		{"new", rowDestinations},
+	} {
+		b.Run("impl="+impl.name, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				indexes, _ := impl.fn(ksids)
+				for _, v := range indexes {
+					if _, err := strconv.ParseInt(string(v.Value), 0, 64); err != nil {
+						b.Fatal(err)
+					}
+				}
+			}
+		})
+	}
+}
