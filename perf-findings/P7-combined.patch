+)
+
+// benchASCII is a stand-in for the ascii charset of colldata, which this
+// package cannot import.
+var benchASCII = func() *Charset_8bit {
+	var toUnicode [256]uint16
+	for i := range 128 {
+		toUnicode[i] = uint16(i)
+	}
+	fromUnicode := make([]byte, 128)
+	for i := range fromUnicode {
+		fromUnicode[i] = byte(i)
+	}
+	return &Charset_8bit{
+		Name_:       "ascii",
+		ToUnicode:   &toUnicode,
+		FromUnicode: []eightbit.UnicodeMapping{{From: 0, To: 127, Range: fromUnicode}},
+	}
+}()
+
+func benchText(size int, nonASCII string) []byte {
+	var sb strings.Builder
+	words := []string{"lorem ", "ipsum ", "dolor ", "sit ", "amet ", "consectetur "}
+	for i := 0; sb.Len() < size; i++ {
+		if nonASCII != "" && i%12 == 1 {
+			sb.WriteString(nonASCII)
+		}
+		sb.WriteString(words[i%len(words)])
+	}
+	return []byte(sb.String())
+}
+
+// BenchmarkConvertPairs runs Convert, or the legacy implementation when
+// CONVERT_IMPL=legacy, so that benchstat can compare two runs.
+func BenchmarkConvertPairs(b *testing.B) {
+	convert := Convert
+	if os.Getenv("CONVERT_IMPL") == "legacy" {
+		convert = legacyConvert
+	}
+	utf8mb4 := Charset_utf8mb4{}
+	cases := []struct {
+		name     string
+		from, to Charset
+		text     string // non-ASCII text mixed into ASCII words
+	}{
+		{"latin1-utf8mb4/ascii", Charset_latin1{}, utf8mb4, ""},
+		{"latin1-utf8mb4/mostly", Charset_latin1{}, utf8mb4, "é"},
+		{"utf8mb4-latin1/ascii", utf8mb4, Charset_latin1{}, ""},
+		{"utf8mb4-latin1/mostly", utf8mb4, Charset_latin1{}, "é"},
+		{"utf8mb4-utf8mb3/mostly", utf8mb4, Charset_utf8mb3{}, "日本"},
+		{"ascii-utf8mb4/ascii", benchASCII, utf8mb4, ""},
+		{"utf8mb4-ascii/ascii", utf8mb4, benchASCII, ""},
+		{"sjis-utf8mb4/cjk", Charset_sjis{}, utf8mb4, "日本語のテキスト"},
+		{"utf16-utf8mb4/ascii", Charset_utf16{}, utf8mb4, ""},
+		{"latin1-utf16/ascii", Charset_latin1{}, Charset_utf16{}, ""},
+	}
+	for _, tc := range cases {
+		for _, size := range []int{10, 1024} {
+			src, err := legacyConvert(nil, tc.from, benchText(size, tc.text), utf8mb4)
+			if err != nil {
+				b.Fatal(err)
+			}
+			b.Run(tc.name+"/"+map[int]string{10: "10B", 1024: "1KB"}[size], func(b *testing.B) {
+				b.ReportAllocs()
+				b.SetBytes(int64(len(src)))
+				for b.Loop() {
+					if _, err := convert(nil, tc.to, src, tc.from); err != nil {
+						b.Fatal(err)
+					}
+				}
+			})
+		}
+	}
+}
