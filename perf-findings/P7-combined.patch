+		require.NoError(t, c.writePacket(data))
+	}))
+}
+
+func TestF30BitmapBitCountEquivalence(t *testing.T) {
+	for count := 0; count <= 70; count++ {
+		for _, fill := range []byte{0x00, 0xff, 0xa5, 0x5a} {
+			data := make([]byte, (count+7)/8)
+			for i := range data {
+				data[i] = fill ^ byte(i*37)
+			}
+			bm, _ := newBitmap(data, 0, count)
+			want := 0
+			for i := range count {
+				if bm.Bit(i) {
+					want++
+				}
+			}
+			require.Equal(t, want, bm.BitCount(), "count=%d fill=%x", count, fill)
+		}
+	}
+}
