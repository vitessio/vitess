+// asciiLower lowercases the ASCII letters of s and leaves every other byte as is,
+// which is the case folding that keyword lookups use.
+func asciiLower(s string) string {
+	b := []byte(s)
+	for i, c := range b {
+		if 'A' <= c && c <= 'Z' {
+			b[i] = c + 'a' - 'A'
+		}
+	}
+	return string(b)
+}
+
+// TestKeywordLookupMatchesReference checks keywordLookupTable against a plain map of
+// the keywords for every keyword in many spellings, for near misses of every keyword,
+// and for random identifiers.
+func TestKeywordLookupMatchesReference(t *testing.T) {
+	reference := make(map[string]int, len(keywords))
+	for _, kw := range keywords {
+		reference[kw.name] = kw.id
+	}
+	checked := 0
+	check := func(name string) {
+		checked++
+		wantID, wantFound := reference[asciiLower(name)]
+		gotID, gotFound := keywordLookupTable.LookupString(name)
+		if gotFound != wantFound || gotID != wantID {
+			require.Failf(t, "lookup mismatch", "LookupString(%q) = (%d, %v), want (%d, %v)", name, gotID, gotFound, wantID, wantFound)
+		}
+	}
+
+	rng := rand.New(rand.NewPCG(1, 2))
+	// Bytes that equal a keyword byte once ORed with 0x20 without being its upper case
+	// form, and non-ASCII bytes.
+	lookalikes := []byte{0x7f, 0x10, 0x19, '@', '[', ']', '^', 0xc0, 0xe1, 0xff, '$', '0', 'Z'}
+	for _, kw := range keywords {
+		name := kw.name
+		check(name)
+		check(strings.ToUpper(name))
+		// Every combination of upper and lower case for short keywords, random ones for long keywords.
+		if len(name) <= 12 {
+			for mask := 0; mask < 1<<len(name); mask++ {
+				b := []byte(name)
+				for i := range b {
+					if mask&(1<<i) != 0 {
+						b[i] = strings.ToUpper(string(b[i]))[0]
+					}
+				}
+				check(string(b))
+			}
+		} else {
+			for range 256 {
+				b := []byte(name)
+				for i := range b {
+					if rng.IntN(2) == 0 {
+						b[i] = strings.ToUpper(string(b[i]))[0]
+					}
+				}
+				check(string(b))
+			}
+		}
+		// Near misses: every byte replaced, and the name shortened and extended.
+		for i := range len(name) {
+			for _, c := range lookalikes {
+				b := []byte(name)
+				b[i] = c
+				check(string(b))
+			}
+		}
+		check(name[1:])
+		check(name[:len(name)-1])
+		check(name + "x")
+		check("x" + name)
+		check(name + "_")
+		check(name + "K") // KELVIN SIGN lowercases to 'k' in Unicode, but not in ASCII
+	}
+
+	const identChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$"
+	for range 200_000 {
+		b := make([]byte, 1+rng.IntN(40))
+		for i := range b {
+			b[i] = identChars[rng.IntN(len(identChars))]
+		}
+		check(string(b))
+	}
+	for _, name := range []string{"", "a", "k", "K", "é", "sélect", "select\x00", "\x00", strings.Repeat("a", 300)} {
+		check(name)
+	}
+	t.Logf("checked %d names", checked)
+}
+
+var keywordLookupBenchmarks = []struct {
+	name  string
+	names []string
+}{
+	{"keywords", []string{"select", "FROM", "where", "AND", "order", "by", "Limit", "group", "join", "on", "in", "is", "null", "as", "insert", "into", "values", "update", "set", "delete"}},
+	{"long_keywords", []string{"current_timestamp", "SQL_CALC_FOUND_ROWS", "st_linestringfromtext", "character_set_client", "localtimestamp", "straight_join"}},
+	{"short_idents", []string{"id", "t", "a", "b", "c1", "x", "u", "ts", "name", "col", "val", "pk"}},
+	{"idents", []string{"user_id", "customer", "OrderLines", "created_at", "tenant_id", "shipment", "amount", "Warehouse", "district", "status"}},
+	{"long_idents", []string{"customer_order_total_amount", "a_very_long_column_name_that_is_not_a_keyword_at_all", "shipping_address_line_two", "is_primary_contact_for_account"}},
+	{"lookalikes", []string{"selects", "fromm", "wher", "orders", "limits", "groups", "joined", "values2", "updates"}},
+}
+
+func BenchmarkKeywordLookup(b *testing.B) {
+	for _, bm := range keywordLookupBenchmarks {
+		b.Run(bm.name, func(b *testing.B) {
+			for b.Loop() {
+				for _, n := range bm.names {
+					keywordLookupTable.LookupString(n)
+				}
+			}
+		})
+	}
+}
