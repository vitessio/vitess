+type sqlEscapeBenchCase struct {
+	name string
+	val  []byte
+}
+
+func sqlEscapeBenchCases() []sqlEscapeBenchCase {
+	text := func(n int) []byte {
+		const words = "the quick brown fox jumps over the lazy dog "
+		return []byte(strings.Repeat(words, n/len(words)+1)[:n])
+	}
+	withEscapes := func(n, every int) []byte {
+		b := text(n)
+		for i := every - 1; i < n; i += every {
+			b[i] = '\''
+		}
+		return b
+	}
+	binary := func(n int) []byte {
+		r := rand.New(rand.NewPCG(3, 4))
+		b := make([]byte, n)
+		for i := range b {
+			b[i] = byte(r.IntN(256))
+		}
+		return b
+	}
+	return []sqlEscapeBenchCase{
+		{"8B", text(8)},
+		{"32B", text(32)},
+		{"128B", text(128)},
+		{"1KiB", text(1024)},
+		{"16KiB", text(16 << 10)},
+		{"1KiB-esc64", withEscapes(1024, 64)},
+		{"1KiB-esc8", withEscapes(1024, 8)},
+		{"1KiB-esc1", withEscapes(1024, 1)},
+		{"1KiB-utf8", []byte(strings.Repeat("héllo wörld 日本 ", 1024/20+1)[:1020])},
+		{"1KiB-binary", binary(1024)},
+	}
+}
