+	querypb "vitess.io/vitess/go/vt/proto/query"
+)
+
+// rowsToProto3PerRow is the per-row allocating reference implementation.
+func rowsToProto3PerRow(rows [][]Value) []*querypb.Row {
+	if len(rows) == 0 {
+		return nil
+	}
+	result := make([]*querypb.Row, len(rows))
+	for i, r := range rows {
+		result[i] = RowToProto3(r)
+	}
+	return result
+}
+
+// proto3ToRowsPerRow is the per-row allocating reference implementation.
+func proto3ToRowsPerRow(fields []*querypb.Field, rows []*querypb.Row) [][]Value {
+	if len(rows) == 0 {
+		return [][]Value{}
+	}
+	result := make([][]Value, len(rows))
+	for i, r := range rows {
+		result[i] = MakeRowTrusted(fields, r)
+	}
+	return result
+}
+
+func randomSlabResult(rng *rand.Rand, numRows, numCols int) *Result {
+	fields := make([]*querypb.Field, numCols)
+	for i := range fields {
+		fields[i] = &querypb.Field{Name: "c" + strconv.Itoa(i), Type: Int64}
+		if i%2 == 1 {
+			fields[i].Type = VarChar
+		}
+	}
+	rows := make([]Row, numRows)
+	for i := range rows {
+		row := make(Row, numCols)
+		for j := range row {
+			switch rng.IntN(4) {
+			case 0:
+				row[j] = NULL
+			case 1:
+				row[j] = MakeTrusted(fields[j].Type, []byte{})
+			default:
+				if fields[j].Type == Int64 {
+					row[j] = NewInt64(rng.Int64())
+				} else {
+					b := make([]byte, rng.IntN(40))
+					for k := range b {
+						b[k] = byte('a' + rng.IntN(26))
+					}
+					row[j] = NewVarChar(string(b))
+				}
+			}
+		}
+		rows[i] = row
+	}
+	return &Result{Fields: fields, Rows: rows}
+}
