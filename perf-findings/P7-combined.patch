+// TestSendDoesNotWaitForSubscriptionChanges verifies that Send delivers to the current subscribers without
+// taking the logger's mutex, which Subscribe and Unsubscribe hold. Send runs for every query, so a mutex
+// there serializes all queries of the process.
+func TestSendDoesNotWaitForSubscriptionChanges(t *testing.T) {
+	logger := New[*logMessage]("logger", 10)
+	ch := logger.Subscribe("test")
+	t.Cleanup(func() { logger.Unsubscribe(ch) })
+
+	logger.mu.Lock()
+	sent := make(chan struct{})
+	go func() {
+		logger.Send(&logMessage{"hello"})
+		close(sent)
+	}()
+	assert.Eventually(t, func() bool {
+		select {
+		case <-sent:
+			return true
+		default:
+			return false
+		}
+	}, 30*time.Second, 10*time.Millisecond)
+	logger.mu.Unlock()
+
+	msg := <-ch
+	assert.Equal(t, "hello", msg.val)
+}
