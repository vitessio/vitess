+package stats
+
+import (
+	"bytes"
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func histMarshalOld(h *Histogram) []byte {
+	b := bytes.NewBuffer(make([]byte, 0, 4096))
+	fmt.Fprintf(b, "{")
+	totalCount := int64(0)
+	for i, label := range h.labels {
+		count := h.buckets[i].Load()
+		totalCount += count
+		fmt.Fprintf(b, "\"%v\": %v, ", label, count)
+	}
+	fmt.Fprintf(b, "\"%s\": %v, ", h.countLabel, totalCount)
+	fmt.Fprintf(b, "\"%s\": %v", h.totalLabel, h.total.Load())
+	fmt.Fprintf(b, "}")
+	return b.Bytes()
+}
+
+func f30Hist() *Histogram {
+	h := NewGenericHistogram("", "", []int64{500000, 1000000, 5000000, 10000000, 50000000, 100000000, 500000000, 1000000000, 5000000000, 10000000000}, []string{"500000", "1000000", "5000000", "10000000", "50000000", "100000000", "500000000", "1000000000", "5000000000", "10000000000", "inf"}, "Count", "Time")
+	for i := int64(0); i < 1000; i++ {
+		h.Add(i * i * 12345)
+		h.Add(-i)
+	}
+	return h
+}
+
+func TestF30HistogramMarshalEquivalence(t *testing.T) {
+	h := f30Hist()
+	got, err := h.MarshalJSON()
+	assert.NoError(t, err)
+	assert.Equal(t, string(histMarshalOld(h)), string(got))
+}
+
+// TestF30TimingsResetConcurrentAdd must be run with -race: Reset used to
+// replace the histograms map while holding only the read lock.
+func TestF30TimingsResetConcurrentAdd(t *testing.T) {
+	tm := NewTimings("", "", "")
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for range 1000 {
+			tm.Add("a", 1)
+		}
+	}()
+	for range 1000 {
+		tm.Reset()
+	}
+	<-done
+}
+
+func BenchmarkF30HistMarshalOld(b *testing.B) {
+	h := f30Hist()
+	b.ReportAllocs()
+	for b.Loop() {
+		histMarshalOld(h)
+	}
+}
+
+func BenchmarkF30HistMarshalNew(b *testing.B) {
+	h := f30Hist()
+	b.ReportAllocs()
+	for b.Loop() {
+		_, _ = h.MarshalJSON()
+	}
+}
