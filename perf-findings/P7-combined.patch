+// checkSQLEscapeEquivalence checks that every entry point of the SQL string
+// escaper produces the same output as the byte-at-a-time implementation that
+// it replaced.
+func checkSQLEscapeEquivalence(t *testing.T, in []byte) {
+	var want bytes2.Buffer
+	legacyEncodeBytesSQLBytes2(in, &want)
+
+	var got bytes2.Buffer
+	encodeBytesSQLBytes2(in, &got)
+	require.Equal(t, want.String(), got.String(), "encodeBytesSQLBytes2(%q)", in)
+
+	var wantSB, gotSB strings.Builder
+	legacyEncodeBytesSQLStringBuilder(in, &wantSB)
+	encodeBytesSQLStringBuilder(in, &gotSB)
+	require.Equal(t, wantSB.String(), gotSB.String(), "encodeBytesSQLStringBuilder(%q)", in)
+	require.Equal(t, want.String(), gotSB.String())
+
+	// BinWriter path, for the generic writer and the specialized buffers.
+	var wantBW, gotBW bytes.Buffer
+	legacyEncodeBytesSQL(in, &wantBW)
+	encodeBytesSQL(in, &gotBW)
+	require.Equal(t, wantBW.String(), gotBW.String(), "encodeBytesSQL(%q)", in)
+	var gotSB2 strings.Builder
+	encodeBytesSQL(in, &gotSB2)
+	require.Equal(t, want.String(), gotSB2.String())
+
+	// Prefilled buffers, to catch any mixup between the buffer and the value offsets.
+	var pre bytes2.Buffer
+	pre.WriteString("prefix ")
+	encodeBytesSQLBytes2(in, &pre)
+	require.Equal(t, "prefix "+want.String(), pre.String())
+
+	s := string(in)
+	var wantStr, gotStr strings.Builder
+	legacyBufEncodeStringSQL(&wantStr, s)
+	BufEncodeStringSQL(&gotStr, s)
+	require.Equal(t, wantStr.String(), gotStr.String(), "BufEncodeStringSQL(%q)", s)
+	require.Equal(t, wantStr.String(), EncodeStringSQL(s))
+}
+
+func TestSQLEscapeEquivalence(t *testing.T) {
+	for _, seed := range sqlEscapeSeeds {
+		checkSQLEscapeEquivalence(t, []byte(seed))
+	}
+
+	// Every byte value at every position within and around a SWAR word, with
+	// neighbours that exercise the \% and \_ exception.
+	for pos := range 18 {
+		for c := range 256 {
+			for _, next := range []byte{'a', '%', '_', '\\', 0} {
+				in := bytes.Repeat([]byte{'a'}, 18)
+				in[pos] = byte(c)
+				if pos+1 < len(in) {
+					in[pos+1] = next
+				}
+				checkSQLEscapeEquivalence(t, in)
+				checkSQLEscapeEquivalence(t, in[:pos+1])
+			}
+		}
+	}
+
+	// Random inputs drawn from an alphabet that is dense in special bytes.
+	alphabet := []byte("\x00\b\n\r\t\x1a'\\%_\"a\x01\x1f\x7f\x80\xc3\xa9\xe6\x97\xa5\xff")
+	r := rand.New(rand.NewPCG(1, 2))
+	for range 20000 {
+		in := make([]byte, r.IntN(70))
+		for i := range in {
+			in[i] = alphabet[r.IntN(len(alphabet))]
+		}
+		checkSQLEscapeEquivalence(t, in)
+	}
+}
+
+func TestNextSQLEscapeCandidate(t *testing.T) {
+	// The candidate set must include every byte that SQLEncodeMap escapes.
+	for c := range 256 {
+		isCandidate := c < 0x20 || c == '\'' || c == '\\'
+		if SQLEncodeMap[c] != DontEscape {
+			assert.True(t, isCandidate, "byte %#x is escaped but is not a candidate", c)
+		}
+		for pos := range 17 {
+			in := bytes.Repeat([]byte{'a'}, 17)
+			in[pos] = byte(c)
+			want := len(in)
+			if isCandidate {
+				want = pos
+			}
+			assert.Equal(t, want, nextSQLEscapeCandidate(in, 0), "byte %#x at %d", c, pos)
+			assert.Equal(t, want, nextSQLEscapeCandidate(string(in), 0), "byte %#x at %d", c, pos)
+		}
+	}
+}
+
+func FuzzSQLEscapeEquivalence(f *testing.F) {
+	for _, seed := range sqlEscapeSeeds {
+		f.Add([]byte(seed))
+	}
+	f.Fuzz(func(t *testing.T, in []byte) {
+		checkSQLEscapeEquivalence(t, in)
+	})
+}
