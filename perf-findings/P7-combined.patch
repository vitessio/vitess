+// coalesceRowResults appends qr to results, merging its rows into the last
+// result if both only contain rows. MergeSort batches rows depending on the
+// timing of its input streams, so tests compare the coalesced rows.
+func coalesceRowResults(results []*sqltypes.Result, qr *sqltypes.Result) []*sqltypes.Result {
+	if len(results) > 0 && len(qr.Fields) == 0 && len(results[len(results)-1].Fields) == 0 {
+		last := results[len(results)-1]
+		last.Rows = append(last.Rows, qr.Rows...)
+		return results
+	}
+	return append(results, qr)
+}
+
+// reusingShardResult streams rows through a single result whose rows slice
+// is reused after each callback returns, like vttablet's pooled stream
+// results do when vtgate and vttablet run in the same process.
+type reusingShardResult struct {
+	shardRoute
+
+	fields []*querypb.Field
+	ids    []int64
+	chunk  int
+}
+
+func (sr *reusingShardResult) StreamExecute(_ context.Context, _ VCursor, _ map[string]*querypb.BindVariable, _ bool, _ bool, callback func(*sqltypes.Result) error) error {
+	if err := callback(&sqltypes.Result{Fields: sr.fields}); err != nil {
+		return err
+	}
+	qr := &sqltypes.Result{Rows: make([][]sqltypes.Value, 0, sr.chunk)}
+	for i, id := range sr.ids {
+		qr.Rows = append(qr.Rows, []sqltypes.Value{sqltypes.NewInt64(id)})
+		if len(qr.Rows) == sr.chunk || i == len(sr.ids)-1 {
+			if err := callback(qr); err != nil {
+				return err
+			}
+			// Overwrite the rows slice in place, as a pooled result would be.
+			for j := range qr.Rows {
+				qr.Rows[j] = []sqltypes.Value{sqltypes.NewInt64(-1)}
+			}
+			qr.Rows = qr.Rows[:0]
+		}
+	}
+	return nil
+}
+
+var int64OrderBy = evalengine.Comparison{{Col: 0, WeightStringCol: -1, Type: evalengine.NewType(sqltypes.Int64, collations.Unknown)}}
