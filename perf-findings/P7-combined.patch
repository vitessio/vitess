+// copyInsertBindVars copies the named bind variables from bindVars into shardBindVars,
+// failing on the first one that is missing.
+func copyInsertBindVars(shardBindVars, bindVars map[string]*querypb.BindVariable, names []string) error {
+	for _, name := range names {
+		bv, exists := bindVars[name]
+		if !exists {
+			return vterrors.VT03026(name)
+		}
+		shardBindVars[name] = bv
+	}
