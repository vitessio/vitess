+// requestPosFlush asks the stream with the given id, if it is running, to save
+// its current position without waiting for idleTimeout.
+func (vre *Engine) requestPosFlush(id int32) {
+	vre.mu.Lock()
+	ct := vre.controllers[id]
+	vre.mu.Unlock()
+	if ct != nil {
+		ct.requestPosFlush()
+	}
