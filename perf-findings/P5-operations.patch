+// discoveryDedupWindow returns how long DiscoverInstance skips an instance after
+// it was last attempted. Instances are polled from a one-second health tick, so
+// the window is a little shorter than --instance-poll-time: an instance polled on
+// one tick is due again on the tick --instance-poll-time later, and a window of
+// exactly --instance-poll-time would expire a few milliseconds after that tick and
+// delay the poll to the next one. The tick still keeps the period at
+// --instance-poll-time or more.
+func discoveryDedupWindow() time.Duration {
+	pollTime := config.GetInstancePollTime()
+	return pollTime - min(pollTime/2, 500*time.Millisecond)
+}
