+// Otherwise DiscoverInstance skips it and it is polled a second late.
+func TestReadInstanceIsUpToDate(t *testing.T) {
+	oldVal := config.GetInstancePollTime()
+	t.Cleanup(func() {
+		config.SetInstancePollTime(oldVal)
+		db.ClearVTOrcDatabase()
+	})
+	config.SetInstancePollTime(60 * time.Second)
+
+	for _, query := range initialSQL {
+		_, err := db.ExecVTOrc(query)
+		require.NoError(t, err)
+	}
+	tabletAlias := &topodatapb.TabletAlias{Cell: "zone1", Uid: 100}
+
+	_, err := db.ExecVTOrc("update database_instance set last_checked = DATETIME('now') where alias = 'zone1-0000000100'")
+	require.NoError(t, err)
+	instance, found, err := ReadInstance(tabletAlias)
+	require.NoError(t, err)
+	require.True(t, found)
+	assert.True(t, instance.IsUpToDate)
+
+	_, err = db.ExecVTOrc("update database_instance set last_checked = DATETIME('now', '-60 second') where alias = 'zone1-0000000100'")
+	require.NoError(t, err)
+	instance, found, err = ReadInstance(tabletAlias)
+	require.NoError(t, err)
+	require.True(t, found)
+	assert.False(t, instance.IsUpToDate)
+}
