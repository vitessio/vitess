+// closePooledConnections closes the connections of the dba and app pools
+// without closing the pools, which open new connections on demand once mysqld
+// is running again. On shutdown, mysqld waits two seconds for any connected
+// client before it forces the connection closed, and these pools keep idle
+// connections open. It waits at most closePooledConnectionsTimeout for
+// connections that are in use to be returned.
+func (mysqld *Mysqld) closePooledConnections(ctx context.Context) {
+	ctx, cancel := context.WithTimeout(ctx, closePooledConnectionsTimeout)
+	defer cancel()
+	for _, pool := range []*dbconnpool.ConnectionPool{mysqld.dbaPool, mysqld.appPool} {
+		if pool == nil || !pool.IsOpen() {
+			continue
+		}
+		capacity := pool.Capacity()
+		if err := pool.SetCapacity(ctx, 0); err != nil {
+			log.Warn("could not close all pooled MySQL connections before shutdown", slog.Any("error", err))
+		}
+		if err := pool.SetCapacity(context.Background(), capacity); err != nil {
+			log.Warn("could not restore the MySQL connection pool capacity", slog.Any("error", err))
+		}
+	}
+}
