+// TestClosePooledConnections checks that the helper Shutdown calls before it
+// stops mysqld closes the idle connections of the dba pool, which would
+// otherwise make mysqld wait two seconds before forcing them closed, and that
+// the pool still hands out connections afterwards.
+func TestClosePooledConnections(t *testing.T) {
+	db := fakesqldb.New(t)
+	t.Cleanup(db.Close)
+	db.AddQuery("SELECT 1", &sqltypes.Result{})
+	db.AddQuery("set @x = 1", &sqltypes.Result{})
+
+	params := db.ConnParams()
+	cp := *params
+	dbc := dbconfigs.NewTestDBConfigs(cp, cp, "fakesqldb")
+	testMysqld := NewMysqld(dbc)
+	t.Cleanup(testMysqld.Close)
+	ctx := t.Context()
+
+	require.NoError(t, testMysqld.ExecuteSuperQuery(ctx, "set @x = 1"))
+	ids := db.QueryConnIDs("set @x = 1")
+	require.Len(t, ids, 1)
+	require.True(t, db.IsConnectionOpen(ids[0]), "the pool keeps its connection open while idle")
+
+	testMysqld.closePooledConnections(ctx)
+	assert.Eventually(t, func() bool {
+		return !db.IsConnectionOpen(ids[0])
+	}, 30*time.Second, 10*time.Millisecond)
+
+	require.NoError(t, testMysqld.ExecuteSuperQuery(ctx, "set @x = 1"))
+}
