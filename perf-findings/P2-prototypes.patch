+// P2 prototype (env P2_SEQ_BLOCK=N): vtgate reserves N sequence values per
+// round trip to the sequence tablet and hands them out locally.
+var (
+	prototypeSeqBlock = func() int64 {
+		n, _ := strconv.ParseInt(os.Getenv("P2_SEQ_BLOCK"), 10, 64)
+		return n
+	}()
+	prototypeSeqMu    sync.Mutex
+	prototypeSeqCache = map[string]*[2]int64{} // next, end (exclusive)
+)
+
 func (ic *InsertCommon) execGenerate(ctx context.Context, vcursor VCursor, loggingPrimitive Primitive, count int64) (int64, error) {
+	if prototypeSeqBlock <= 0 {
+		return ic.execGenerateRPC(ctx, vcursor, loggingPrimitive, count)
+	}
+	key := ic.Generate.Keyspace.Name + "." + ic.Generate.Query
+	prototypeSeqMu.Lock()
+	defer prototypeSeqMu.Unlock()
+	c := prototypeSeqCache[key]
+	if c == nil || c[1]-c[0] < count {
+		n := max(count, prototypeSeqBlock)
+		first, err := ic.execGenerateRPC(ctx, vcursor, loggingPrimitive, n)
+		if err != nil {
+			return 0, err
+		}
+		c = &[2]int64{first, first + n}
+		prototypeSeqCache[key] = c
+	}
+	first := c[0]
+	c[0] += count
+	return first, nil
+}
+
