+// keeps the data intact and does not allocate a copy buffer per block.
+func TestStripeCopyReusesBuffer(t *testing.T) {
+	const (
+		dataSize  = 1 << 20
+		blockSize = 4096
+		stripes   = 4
+		blocks    = dataSize / blockSize
+	)
+	input := make([]byte, dataSize)
+	rand.Read(input)
+
+	buffers := make([]bytes.Buffer, stripes)
+	writers := make([]io.Writer, stripes)
+	for i := range buffers {
+		buffers[i].Grow(dataSize/stripes + blockSize)
+		writers[i] = writeOnly{&buffers[i]}
+	}
