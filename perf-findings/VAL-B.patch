+#!/bin/bash
+# VAL-B / BUGS #5: load identical rows into the sharded keyspace (via vtgate) and the reference schema.
+# Hash vindex placement for BIGINT ids: -80 = {1,2,3,5}, 80- = {4,6,7,8}.
+set -euo pipefail
+REF_SOCK=/home/vt/perf/c40000/vt_0000000100/mysql.sock
+# 'a ' (id 1, shard -80), 'a' (id 4, shard 80-), 'A ' (id 6, 80-), 'b' on both shards (control).
+ROWS="(1,'a ',1),(4,'a',10),(6,'A ',100),(2,'b',1000),(7,'b',10000)"
+ROWS2="(5,'a',1),(8,'a  ',2)"  # join partner table: 'a' on -80, 'a  ' on 80-
+for t in gen lat uni bin ai mb3; do
+  mysql -h 127.0.0.1 -P 40003 -u root sbtest -e "delete from t_$t; insert into t_$t(id,v,n) values $ROWS"
+  mysql -S "$REF_SOCK" -u vt_dba ref -e "SET sql_log_bin=0; delete from t_$t; insert into t_$t(id,v,n) values $ROWS"
+done
+mysql -h 127.0.0.1 -P 40003 -u root sbtest -e "delete from t_gen2; insert into t_gen2(id,v,n) values $ROWS2"
+mysql -S "$REF_SOCK" -u vt_dba ref -e "SET sql_log_bin=0; delete from t_gen2; insert into t_gen2(id,v,n) values $ROWS2"
+echo loaded
diff --git a/perf-findings/VAL-B/matrix.sh b/perf-findings/VAL-B/matrix.sh
