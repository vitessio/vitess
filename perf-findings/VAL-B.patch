index 0000000000..f3d271152a
--- /dev/null
+++ b/perf-findings/VAL-B/queries.sh
@@ -0,0 +1,68 @@
+#!/bin/bash
+# VAL-B / BUGS #5: run each query shape through vtgate (2 shards) and against the reference schema
+# holding the same rows on a single MySQL; print DIFF/same per query.
+REF_SOCK=/home/vt/perf/c40000/vt_0000000100/mysql.sock
+TABLES=${TABLES:-"gen lat uni bin mb3 ai"}
+VTG_PORT=${VTG_PORT:-40003}
+
+# Queries use T as the table placeholder. Only collation-independent output is printed
+# (counts/sums/ids), because the representative value of a group is arbitrary.
+QUERIES=(
+  "Q01 group by + count|select count(*) c, sum(n) s from T group by v order by s"
+  "Q02 count(distinct v)|select count(distinct v) from T"
+  "Q03 select distinct v (row count)|select count(*) from (select distinct v from T) x"
+  "Q04 distinct v, raw rows|select distinct concat('[',v,']') from T order by 1"
+  "Q05 union distinct across shards|select count(*) from (select v from T where id = 1 union select v from T where id = 4) x"
+  "Q06 union distinct, raw rows|select v from T where id = 1 union select v from T where id = 4"
+  "Q07 order by v, id (merge sort)|select id from T order by v, id"
+  "Q08 order by v desc, id|select id from T order by v desc, id"
+  "Q09 filter on derived aggregate at vtgate|select x.s from (select v, sum(n) s from T group by v) x where x.v = 'a' order by x.s"
+  "Q10 having max(v) = 'a'|select sum(n) s from T group by n > 500 having max(v) = 'a' order by s"
+  "Q11 filter pushed to MySQL (control)|select id from T where v = 'a' order by id"
+  "Q12 group by v with limit (ordered aggregate)|select count(*) c from T group by v order by c desc limit 1"
+  "Q13 count(distinct v) grouped|select n > 500 g, count(distinct v) from T group by g order by g"
+  "Q14 min(v)/max(v) as hex|select hex(min(v)), hex(max(v)) from T where v < 'b'"
+)
+
+run_vtg() { mysql -h 127.0.0.1 -P "$VTG_PORT" -u root sbtest -N -B -e "$1" 2>&1 | tr '\n' ';'; }
+run_ref() { mysql -S "$REF_SOCK" -u vt_dba ref -N -B -e "$1" 2>&1 | tr '\n' ';'; }
+
+for t in $TABLES; do
+  echo "=== t_$t"
+  for q in "${QUERIES[@]}"; do
+    name=${q%%|*}; sql=${q#*|}; sql=${sql//T/t_$t}
+    a=$(run_vtg "$sql"); b=$(run_ref "$sql")
+    if [[ $a == "$b" ]]; then st=same; else st=DIFF; fi
+    printf '%-4s %-45s vtgate=%-28s mysql=%s\n' "$st" "$name" "$a" "$b"
+  done
+done
+
+echo "=== joins (t_gen.v = t_gen2.v, general_ci): expected (1,5),(1,8),(4,5),(4,8),(6,5),(6,8)"
+J=(
+  "J1 nested-loop join|select a.id, b.id from t_gen a join t_gen2 b on a.v = b.v order by a.id, b.id"
+  "J2 hash join hint|select /*vt+ ALLOW_HASH_JOIN */ a.id, b.id from t_gen a join t_gen2 b on a.v = b.v order by a.id, b.id"
+  "J3 left join|select a.id, b.id from t_gen a left join t_gen2 b on a.v = b.v order by a.id, b.id"
+  "J4 in-subquery|select id from t_gen where v in (select v from t_gen2) order by id"
+  "J6 hash join (LIMIT on both sides)|select a.id, b.id from (select id, v from t_gen limit 10) a join (select id, v from t_gen2 limit 10) b on a.v = b.v order by a.id, b.id"
+  "J7 hash left join (LIMIT on RHS)|select a.id, b.id from t_gen a left join (select id, v from t_gen2 limit 10) b on a.v = b.v order by a.id, b.id"
+  "J5 join on derived aggregates|select x.v is not null, y.c from (select v, count(*) c from t_gen group by v) x join (select v, count(*) c from t_gen2 group by v) y on x.v = y.v order by y.c"
+)
+for q in "${J[@]}"; do
+  name=${q%%|*}; sql=${q#*|}
+  a=$(run_vtg "$sql"); b=$(run_ref "$sql")
+  if [[ $a == "$b" ]]; then st=same; else st=DIFF; fi
+  printf '%-4s %-45s vtgate=%-28s mysql=%s\n' "$st" "$name" "$a" "$b"
+done
+
+echo "=== literal comparisons evaluated by vtgate (select without FROM)"
+L=(
+  "L1 general_ci literal|select _utf8mb4'a' collate utf8mb4_general_ci = _utf8mb4'a '"
+  "L2 latin1 literal|select _latin1'a' collate latin1_swedish_ci = _latin1'a '"
+  "L3 0900 literal (NO PAD control)|select _utf8mb4'a' collate utf8mb4_0900_ai_ci = _utf8mb4'a '"
+)
+for q in "${L[@]}"; do
+  name=${q%%|*}; sql=${q#*|}
+  a=$(run_vtg "$sql"); b=$(run_ref "$sql")
+  if [[ $a == "$b" ]]; then st=same; else st=DIFF; fi
+  printf '%-4s %-45s vtgate=%-28s mysql=%s\n' "$st" "$name" "$a" "$b"
+done
