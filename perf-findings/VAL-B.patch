+#!/bin/bash
+# VAL-B / BUGS #28: make control characters reach stats labels on a live cluster (BASE=40000) and
+# check whether /debug/vars on vtgate and vttablet still parses as JSON.
+check() {
+  for port in 40001 40100 40101; do
+    curl -s "http://localhost:$port/debug/vars" | python3 -c '
+import json, sys
+raw = sys.stdin.buffer.read()
+try:
+    json.loads(raw)
+    print(sys.argv[1], "valid JSON,", len(raw), "bytes")
+except Exception as e:
+    print(sys.argv[1], "INVALID JSON:", e)
+    pos = getattr(e, "pos", None)
+    if pos is not None:
+        print("   context:", raw[max(0, pos-120):pos+40])
+' "$port"
+  done
+}
+echo "== before"; check
+
+echo "== 1) table name with a control character (U+0001) created and queried through vtgate"
+TNAME=$(printf 't\001x')
+mysql -h 127.0.0.1 -P 40003 -u root sbtest -e "create table if not exists \`$TNAME\` (id bigint primary key, v varchar(10))" 2>&1
+mysql -h 127.0.0.1 -P 40003 -u root 'sbtest:-80' -e "select * from \`$TNAME\`" 2>&1
+check
+
+echo "== 2) user name with a control character (U+0007), vtgate --mysql-auth-server-impl none"
+UNAME=$(printf 'bob\007')
+mysql -h 127.0.0.1 -P 40003 -u "$UNAME" sbtest -e "select count(*) from t_gen" 2>&1
+check
