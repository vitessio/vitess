diff --git a/perf-findings/VAL-B/setup.sh b/perf-findings/VAL-B/setup.sh
new file mode 100644
index 0000000000..c874777a49
--- /dev/null
+++ b/perf-findings/VAL-B/setup.sh
@@ -0,0 +1,23 @@
+#!/bin/bash
+# VAL-B / BUGS #5: create PAD SPACE test tables in the 2-shard cluster (BASE=40000),
+# and the same tables in an unsharded reference schema `ref` on one mysqld.
+set -euo pipefail
+VTCTLD=localhost:40021
+REF_SOCK=/home/vt/perf/c40000/vt_0000000100/mysql.sock
+
+SQL=""
+VS='{"sharded":true,"vindexes":{"hash":{"type":"hash"}},"tables":{"sbtest1":{"column_vindexes":[{"column":"id","name":"hash"}]}'
+for t in gen:utf8mb4:utf8mb4_general_ci gen2:utf8mb4:utf8mb4_general_ci lat:latin1:latin1_swedish_ci \
+  uni:utf8mb4:utf8mb4_unicode_ci bin:utf8mb4:utf8mb4_bin ai:utf8mb4:utf8mb4_0900_ai_ci mb3:utf8mb3:utf8mb3_general_ci; do
+  IFS=: read -r n cs co <<<"$t"
+  SQL+="CREATE TABLE IF NOT EXISTS t_$n (id BIGINT NOT NULL PRIMARY KEY, v VARCHAR(20) CHARACTER SET $cs COLLATE $co NOT NULL, n INT NOT NULL DEFAULT 1) ENGINE=InnoDB;"
+  VS+=",\"t_$n\":{\"column_vindexes\":[{\"column\":\"id\",\"name\":\"hash\"}]}"
+done
+VS+='}}'
+
+/home/vt/bin/vtctldclient --server "$VTCTLD" ApplySchema --sql "$SQL" sbtest >/dev/null
+/home/vt/bin/vtctldclient --server "$VTCTLD" ApplyVSchema --vschema "$VS" sbtest >/dev/null
+
+mysql -S "$REF_SOCK" -u vt_dba -e "SET sql_log_bin=0; CREATE DATABASE IF NOT EXISTS ref"
+mysql -S "$REF_SOCK" -u vt_dba ref -e "SET sql_log_bin=0; $SQL"
+echo setup done
