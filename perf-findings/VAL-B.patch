+#!/bin/bash
+# Second vtgate on the BASE=40000 cluster with schema tracking disabled, so vtgate has no column
+# types/collations and must fall back to weight_string() from MySQL. MySQL port 40033.
+cd /home/vt/perf
+exec runuser -u vt -- env HOME=/home/vt /home/vt/bin/vtgate --topo-implementation etcd2 \
+  --topo-global-server-address localhost:40010 --topo-global-root /vitess/global \
+  --cell zone1 --cells-to-watch zone1 --tablet-types-to-wait PRIMARY,REPLICA \
+  --port 40031 --grpc-port 40032 --mysql-server-port 40033 \
+  --mysql-server-socket-path /home/vt/perf/c40000/vtgate2.sock --service-map grpc-vtgateservice \
+  --mysql-auth-server-impl none --log-format text --config-file-not-found-handling=ignore \
+  --schema-change-signal=false >/home/vt/perf/c40000/logs/vtgate2.log 2>&1
