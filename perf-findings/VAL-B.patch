+package colldata
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"vitess.io/vitess/go/vt/vthash"
+)
+
+// TestCollationBinaryHashNumCodepointsLongerThanInput checks that Collation_binary.Hash accepts a
+// numCodepoints larger than the input. binary is a NO PAD collation, so the Collation interface says
+// numCodepoints is ignored, and the hash must equal the hash with numCodepoints = 0.
+func TestCollationBinaryHashNumCodepointsLongerThanInput(t *testing.T) {
+	coll := testcollation(t, "binary")
+	src := []byte("ab")
+
+	h := vthash.New()
+	coll.Hash(&h, src, 0)
+	want := h.Sum128() // Sum128 finalizes the hasher, so call it once.
+
+	for _, n := range []int{len(src), len(src) + 1, 40} {
+		got := vthash.New()
+		assert.NotPanics(t, func() { coll.Hash(&got, src, n) }, "Hash(%q, numCodepoints=%d)", src, n)
+		assert.Equal(t, want, got.Sum128(), "Hash(%q, numCodepoints=%d)", src, n)
+	}
+}
diff --git a/go/mysql/collations/colldata/padspace_test.go b/go/mysql/collations/colldata/padspace_test.go
new file mode 100644
index 0000000000..8f71fb4b44
--- /dev/null
+++ b/go/mysql/collations/colldata/padspace_test.go
@@ -0,0 +1,100 @@
+/*
+Copyright 2026 The Vitess Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package colldata
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"vitess.io/vitess/go/mysql/collations/charset"
+	"vitess.io/vitess/go/vt/vthash"
+)
+
+func sign(n int) int {
+	switch {
+	case n < 0:
+		return -1
+	case n > 0:
+		return 1
+	}
+	return 0
+}
+
+// TestPadSpaceCollateAndHash checks that Collate and Hash follow MySQL's PAD SPACE semantics:
+// in a PAD SPACE collation the shorter string is compared as if padded with spaces, so 'a' = 'a '.
+// NO PAD collations (the 0900 family) must keep comparing trailing spaces.
+//
+// The expected signs are STRCMP(l COLLATE c, r COLLATE c) from MySQL 8.0.46, and the PAD_ATTRIBUTE
+// of every collation below comes from information_schema.COLLATIONS.
+func TestPadSpaceCollateAndHash(t *testing.T) {
+	pairs := [][2]string{
+		{"a", "a "},
+		{"a ", "a"},
+		{"a", "a   "},
+		{"", "  "},
+		{"a\t", "a"}, // TAB sorts before the pad character
+		{"a b", "a"}, // an inner space is not padding
+		{"ab", "a "},
+		{"A ", "a"},
+	}
+	padSpaceCI := []int{0, 0, 0, 0, -1, 1, 1, 0}
+	padSpaceBin := []int{0, 0, 0, 0, -1, 1, 1, -1}
+
+	cases := []struct {
+		collation string
+		expected  []int
+	}{
+		{"utf8mb4_general_ci", padSpaceCI},
+		{"utf8mb3_general_ci", padSpaceCI},
+		{"latin1_swedish_ci", padSpaceCI},
+		{"latin1_bin", padSpaceBin},
+		{"utf8mb4_unicode_ci", padSpaceCI},
+		{"utf8mb4_unicode_520_ci", padSpaceCI},
+		{"utf8mb4_bin", padSpaceBin},
+		{"utf8mb3_bin", padSpaceBin},
+		{"gbk_chinese_ci", padSpaceCI},
+		{"gbk_bin", padSpaceBin},
+		{"ascii_general_ci", padSpaceCI},
+		// NO PAD controls.
+		{"utf8mb4_0900_ai_ci", []int{-1, 1, -1, -1, 1, 1, 1, 1}},
+		{"utf8mb4_0900_bin", []int{-1, 1, -1, -1, 1, 1, 1, -1}},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.collation, func(t *testing.T) {
+			coll := testcollation(t, tc.collation)
+			for i, p := range pairs {
+				left, err := charset.ConvertFromUTF8(nil, coll.Charset(), []byte(p[0]))
+				require.NoError(t, err)
+				right, err := charset.ConvertFromUTF8(nil, coll.Charset(), []byte(p[1]))
+				require.NoError(t, err)
+
+				got := sign(coll.Collate(left, right, false))
+				assert.Equal(t, tc.expected[i], got, "Collate(%q, %q) in %s", p[0], p[1], tc.collation)
+
+				if tc.expected[i] == 0 {
+					h1, h2 := vthash.New(), vthash.New()
+					coll.Hash(&h1, left, 0)
+					coll.Hash(&h2, right, 0)
+					assert.Equal(t, h1.Sum128(), h2.Sum128(), "Hash(%q) != Hash(%q) in %s, but the strings are equal", p[0], p[1], tc.collation)
+				}
+			}
+		})
+	}
+}
diff --git a/go/stats/counters_test.go b/go/stats/counters_test.go
index 25fd75024e..b55ae30e53 100644
--- a/go/stats/counters_test.go
+++ b/go/stats/counters_test.go
@@ -17,8 +17,11 @@ limitations under the License.
 package stats
 
 import (
+	"encoding/json"
 	"expvar"
 	"fmt"
+	"net/http"
+	"net/http/httptest"
 	"slices"
 	"strings"
 	"sync"
@@ -273,3 +276,47 @@ func TestCountersCombineDimension(t *testing.T) {
 	c4.Add([]string{"c4", "c2", "c5"}, 1)
 	assert.Equal(t, `{"all.c2.all": 2}`, c4.String())
 }
+
+// TestCountersStringIsValidJSONForControlCharacters checks that the /debug/vars output of labelled
+// counters stays valid JSON when a label value holds characters that Go's %q escapes differently
+// from JSON (control characters, DEL, invalid UTF-8).
+func TestCountersStringIsValidJSONForControlCharacters(t *testing.T) {
+	clearStats()
+	t.Cleanup(clearStats)
+
+	labels := []string{"a\x01b", "tab\there", "bell\a", "vt\v", "del\x7f", "nul\x00"}
+	c := NewCountersWithSingleLabel("counters_json_control_chars", "help", "label")
+	m := NewCountersWithMultiLabels("counters_json_control_chars_multi", "help", []string{"table", "user"})
+	f := NewCountersFuncWithMultiLabels("counters_json_control_chars_func", "help", []string{"label"}, func() map[string]int64 {
+		out := make(map[string]int64, len(labels))
+		for i, l := range labels {
+			out[l] = int64(i + 1)
+		}
+		return out
+	})
+	for i, l := range labels {
+		c.Add(l, int64(i+1))
+		m.Add([]string{l, "user"}, int64(i+1))
+	}
+	c.Add("bad\xffutf8", 100)
+
+	for name, v := range map[string]fmt.Stringer{"single": c, "multi": m, "func": f} {
+		var decoded map[string]int64
+		if !assert.NoError(t, json.Unmarshal([]byte(v.String()), &decoded), "%s: %s", name, v.String()) {
+			continue
+		}
+		for i, l := range labels {
+			key := l
+			if name == "multi" {
+				key = l + ".user"
+			}
+			assert.Equal(t, int64(i+1), decoded[key], "%s: label %q", name, l)
+		}
+	}
+
+	// The whole /debug/vars document must parse as well.
+	rec := httptest.NewRecorder()
+	expvar.Handler().ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/debug/vars", nil))
+	var vars map[string]any
+	assert.NoError(t, json.Unmarshal(rec.Body.Bytes(), &vars))
+}
