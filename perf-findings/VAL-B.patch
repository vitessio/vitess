index 0000000000..000242a507
--- /dev/null
+++ b/perf-findings/VAL-B/matrix.sh
@@ -0,0 +1,17 @@
+#!/bin/bash
+# Ask MySQL for STRCMP sign of PAD SPACE-relevant pairs per collation (golden values for the unit test).
+SOCK=/home/vt/perf/c40000/vt_0000000100/mysql.sock
+PAIRS=("a|a " "a |a" "a|a   " "|  " "a\t|a" "a b|a" "ab|a " "A |a")
+for c in utf8mb4:utf8mb4_general_ci utf8mb3:utf8mb3_general_ci latin1:latin1_swedish_ci latin1:latin1_bin \
+  utf8mb4:utf8mb4_unicode_ci utf8mb4:utf8mb4_unicode_520_ci utf8mb4:utf8mb4_bin utf8mb3:utf8mb3_bin gbk:gbk_chinese_ci gbk:gbk_bin \
+  ascii:ascii_general_ci utf8mb4:utf8mb4_0900_ai_ci utf8mb4:utf8mb4_0900_bin binary:binary; do
+  cs=${c%%:*}; co=${c#*:}
+  sel=""
+  for p in "${PAIRS[@]}"; do
+    l=${p%%|*}; r=${p#*|}
+    sel+="strcmp(convert(_utf8mb4'$l' using $cs) collate $co, convert(_utf8mb4'$r' using $cs) collate $co),"
+  done
+  sel+="(select PAD_ATTRIBUTE from information_schema.COLLATIONS where COLLATION_NAME='$co')"
+  printf '%-24s ' "$co"
+  mysql -S "$SOCK" -u vt_dba -N -B -e "select $sel" 2>&1
+done
diff --git a/perf-findings/VAL-B/queries.sh b/perf-findings/VAL-B/queries.sh
