+
+// TestUpdateTableProgressRowCounts confirms that the live VDiffRowsCompared
+// value for a table is the number of rows compared so far, and not the sum of
+// the cumulative counts reported at every progress update.
+func TestUpdateTableProgressRowCounts(t *testing.T) {
+	wd := &workflowDiffer{
+		ct: &controller{
+			id:                 1,
+			TableDiffRowCounts: stats.NewCountersWithSingleLabel("", "", "Rows"),
+		},
+		opts: &tabletmanagerdatapb.VDiffOptions{
+			CoreOptions: &tabletmanagerdatapb.VDiffCoreOptions{},
+		},
+	}
+	table := &tabletmanagerdatapb.TableDefinition{Name: "test"}
+	td := &tableDiffer{
+		wd:        wd,
+		table:     table,
+		tablePlan: &tablePlan{table: table},
+	}
+
+	dbc := binlogplayer.NewMockDBClient(t)
+	for _, processed := range []int64{10000, 20000, 30000} {
+		dbc.ExpectRequestRE("update _vt.vdiff_table set rows_compared = .*", &sqltypes.Result{}, nil)
+		dr := &DiffReport{TableName: table.Name, ProcessedRows: processed}
+		require.NoError(t, td.updateTableProgress(dbc, dr, nil))
+		require.Equal(t, processed, wd.ct.TableDiffRowCounts.Counts()[table.Name])
+	}
+	dbc.Wait()
+}
