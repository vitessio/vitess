+// compliantName returns in with every rune that is not allowed in a bind
+// variable name replaced by '_'. A rune is allowed if it is a letter, '_' or
+// '$', or a digit anywhere but at the start. When in is already compliant,
+// which is the common case, it is returned unchanged without allocating.
 func compliantName(in string) string {
+	for i := 0; i < len(in); i++ {
+		c := in[i]
+		if c >= utf8.RuneSelf {
+			return compliantNameSlow(in, i)
+		}
+		if !isLetter(uint16(c)) && (i == 0 || !isDigit(uint16(c))) {
+			return compliantNameSlow(in, i)
+		}
+	}
+	return in
+}
+
+// compliantNameSlow builds the compliant name for in, whose first prefix bytes
+// are ASCII and already compliant. Runes are checked after truncation to
+// uint16 to match how the tokenizer classifies them.
+func compliantNameSlow(in string, prefix int) string {
 	var buf strings.Builder
-	for i, c := range in {
+	buf.Grow(len(in))
+	buf.WriteString(in[:prefix])
+	for i, c := range in[prefix:] {
 		if !isLetter(uint16(c)) {
-			if i == 0 || !isDigit(uint16(c)) {
+			if prefix+i == 0 || !isDigit(uint16(c)) {
 				buf.WriteByte('_')
 				continue
 			}
