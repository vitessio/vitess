+package sqlparser
+
+import (
+	"strings"
+	"testing"
+	"unsafe"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// referenceCompliantName is the rune-by-rune implementation that compliantName
+// must stay equivalent to.
+func referenceCompliantName(in string) string {
+	var buf strings.Builder
+	for i, c := range in {
+		if !isLetter(uint16(c)) {
+			if i == 0 || !isDigit(uint16(c)) {
+				buf.WriteByte('_')
+				continue
+			}
+		}
+		buf.WriteRune(c)
+	}
+	return buf.String()
+}
+
+var compliantNameCases = []string{
+	"",
+	"a",
+	"_",
+	"$",
+	"1",
+	"a1",
+	"1a",
+	"id",
+	"user_id",
+	"$col",
+	"a.b",
+	".ab",
+	"a b",
+	"a-b",
+	"a`b",
+	"é",
+	"aé1",
+	"1é",
+	"\xff",
+	"a\xffb",
+	"a\xc3",
+	"\U00010061",  // truncates to 'a' as uint16: kept as-is
+	"a\U00010031", // truncates to '1' as uint16: kept after the first rune
+	"\U00010031a", // truncates to '1' as uint16 at the start: replaced
+	"\U0001005f",  // truncates to '_' as uint16: kept as-is
+	"xš",          // 0x161 is not a letter
+	"col\x00umn",
+	"abc\U0001F600",
+}
+
+func TestCompliantNameEquivalence(t *testing.T) {
+	for _, in := range compliantNameCases {
+		assert.Equalf(t, referenceCompliantName(in), compliantName(in), "compliantName(%q)", in)
+	}
+}
+
+func TestCompliantNameNoCopyWhenCompliant(t *testing.T) {
+	in := "user_id1"
+	out := compliantName(in)
+	require.Equal(t, in, out)
+	assert.Equal(t, unsafe.StringData(in), unsafe.StringData(out))
+	assert.Zero(t, testing.AllocsPerRun(10, func() { _ = compliantName(in) }))
+}
+
+func FuzzCompliantName(f *testing.F) {
+	for _, in := range compliantNameCases {
+		f.Add(in)
+	}
+	f.Fuzz(func(t *testing.T, in string) {
+		require.Equal(t, referenceCompliantName(in), compliantName(in))
+	})
+}
+
+func TestReserveVariableSequence(t *testing.T) {
+	r := NewReservedVars("vtg", BindVars{"id": {}, "id2": {}})
+	assert.Equal(t, "id1", r.ReserveVariable("id"))
+	assert.Equal(t, "id3", r.ReserveVariable("id"))
+	assert.Equal(t, "id4", r.ReserveVariable("id"))
+	assert.Equal(t, "name", r.ReserveVariable("name"))
+	assert.Equal(t, "name1", r.ReserveVariable("name"))
+	assert.Equal(t, "", r.ReserveVariable(""))
+	assert.Equal(t, "1", r.ReserveVariable(""))
+}
+
+func TestReserveColNameSequence(t *testing.T) {
+	r := NewReservedVars("vtg", BindVars{"id": {}})
+	assert.Equal(t, "id1", r.ReserveColName(NewColName("id")))
+	assert.Equal(t, "t_id", r.ReserveColName(NewColNameWithQualifier("id", NewTableName("t"))))
+	assert.Equal(t, "t_id1", r.ReserveColName(NewColNameWithQualifier("id", NewTableName("t"))))
+	assert.Equal(t, "_vtg1", r.ReserveColName(NewColName("vtg1")))
+	assert.Equal(t, "a_b", r.ReserveColName(NewColName("a.b")))
+	assert.Equal(t, "a_b1", r.ReserveColName(NewColName("a.b")))
+}
+
+func TestReserveColNameDoesNotAliasQuery(t *testing.T) {
+	sql := "select 1 from t where user_id = 5"
+	stmt, bvs, err := NewTestParser().Parse2(sql)
+	require.NoError(t, err)
+	col := stmt.(*Select).Where.Expr.(*ComparisonExpr).Left.(*ColName)
+
+	r := NewReservedVars("vtg", bvs)
+	name := r.ReserveColName(col)
+	require.Equal(t, "user_id", name)
+
+	start := uintptr(unsafe.Pointer(unsafe.StringData(sql)))
+	p := uintptr(unsafe.Pointer(unsafe.StringData(name)))
+	assert.False(t, p >= start && p < start+uintptr(len(sql)), "bind variable name must not alias the query text")
+}
+
+func BenchmarkCompliantName(b *testing.B) {
+	for _, in := range []string{"c_w_id", "user_id", "a.b"} {
+		b.Run(in, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				_ = compliantName(in)
+			}
+		})
+	}
+}
+
+func BenchmarkReserveColName(b *testing.B) {
+	cols := []*ColName{
+		NewColName("c_w_id"),
+		NewColName("c_d_id"),
+		NewColName("c_id"),
+		NewColNameWithQualifier("w_id", NewTableName("w")),
+	}
+	b.ReportAllocs()
+	for b.Loop() {
+		r := NewReservedVars("vtg", BindVars{"c_id": {}})
+		for _, col := range cols {
+			_ = r.ReserveColName(col)
+		}
+		_ = r.ReserveColName(cols[0])
+	}
+}
