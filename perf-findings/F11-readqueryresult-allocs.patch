+package mysql
+
+import (
+	"bytes"
+	"fmt"
+	"net"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"vitess.io/vitess/go/sqltypes"
+	querypb "vitess.io/vitess/go/vt/proto/query"
+)
+
+// bufNetConn is a net.Conn that reads from r and writes to w.
+type bufNetConn struct {
+	net.Conn
+	r *bytes.Reader
+	w *bytes.Buffer
+}
+
+func (b *bufNetConn) Read(p []byte) (int, error)  { return b.r.Read(p) }
+func (b *bufNetConn) Write(p []byte) (int, error) { return b.w.Write(p) }
+func (b *bufNetConn) Close() error                { return nil }
+
+// encodeResultStream returns the wire bytes of a text protocol result set,
+// as a server with the given capabilities would send it.
+func encodeResultStream(t testing.TB, qr *sqltypes.Result, capabilities uint32) []byte {
+	out := &bytes.Buffer{}
+	sc := newConn(&bufNetConn{w: out}, 0, 0)
+	sc.Capabilities = capabilities
+	require.NoError(t, sc.writeFields(qr))
+	require.NoError(t, sc.writeRows(qr))
+	require.NoError(t, sc.writeEndResult(false, 0, 0, 0))
+	return out.Bytes()
+}
+
+// newStreamConn returns a client Conn that reads stream, and a function that
+// rewinds it to the start of stream.
+func newStreamConn(stream []byte, capabilities uint32) (*Conn, func()) {
+	nc := &bufNetConn{r: bytes.NewReader(stream)}
+	c := newConn(nc, 0, 0)
+	c.Capabilities = capabilities
+	return c, func() {
+		nc.r.Reset(stream)
+		c.bufferedReader.Reset(nc)
+		c.sequence = 0
+	}
+}
+
+func makeBenchResult(cols, rows, valLen int) *sqltypes.Result {
+	qr := &sqltypes.Result{}
+	for i := range cols {
+		qr.Fields = append(qr.Fields, &querypb.Field{Name: fmt.Sprintf("c%d", i), Type: sqltypes.VarChar})
+	}
+	for r := range rows {
+		row := make([]sqltypes.Value, cols)
+		for c := range cols {
+			v := strings.Repeat(string(rune('a'+(r+c)%26)), valLen)
+			row[c] = sqltypes.NewVarChar(v)
+		}
+		qr.Rows = append(qr.Rows, row)
+	}
+	return qr
+}
+
+// TestReadQueryResultMatchesReference checks that ReadQueryResult returns the
+// same results and errors as the previous implementation, which copied every
+// column value, for NULL, empty, small and large values, and every maxrows mode.
+func TestReadQueryResultMatchesReference(t *testing.T) {
+	qr := &sqltypes.Result{
+		Fields: []*querypb.Field{
+			{Name: "id", Type: sqltypes.Int64},
+			{Name: "name", Type: sqltypes.VarChar},
+			{Name: "data", Type: sqltypes.Blob},
+		},
+		Rows: [][]sqltypes.Value{
+			{sqltypes.NewInt64(1), sqltypes.NewVarChar("a"), sqltypes.NULL},
+			{sqltypes.NewInt64(2), sqltypes.NewVarChar(""), sqltypes.MakeTrusted(sqltypes.Blob, []byte{})},
+			{sqltypes.NULL, sqltypes.NULL, sqltypes.NULL},
+			{sqltypes.NewInt64(4), sqltypes.NewVarChar(strings.Repeat("x", 300)), sqltypes.MakeTrusted(sqltypes.Blob, bytes.Repeat([]byte{0xfb}, 70000))},
+		},
+	}
+	for _, capabilities := range []uint32{0, CapabilityClientDeprecateEOF} {
+		stream := encodeResultStream(t, qr, capabilities)
+		for _, maxrows := range []int{FETCH_ALL_ROWS, FETCH_NO_ROWS, 0, 1, 3, 4, 10} {
+			for _, wantfields := range []bool{false, true} {
+				t.Run(fmt.Sprintf("caps=%d/maxrows=%d/wantfields=%v", capabilities, maxrows, wantfields), func(t *testing.T) {
+					c, rewind := newStreamConn(stream, capabilities)
+					rewind()
+					want, wantMore, wantWarnings, wantErr := c.readQueryResultRef(maxrows, wantfields, false)
+					rewind()
+					got, gotMore, gotWarnings, gotErr := c.ReadQueryResult(maxrows, wantfields)
+					if wantErr != nil {
+						require.EqualError(t, gotErr, wantErr.Error())
+						return
+					}
+					require.NoError(t, gotErr)
+					assert.Equal(t, wantMore, gotMore)
+					assert.Equal(t, wantWarnings, gotWarnings)
+					require.Equal(t, want, got)
+					for i, row := range got.Rows {
+						for j, v := range row {
+							assert.Equal(t, want.Rows[i][j].IsNull(), v.IsNull(), "row %d col %d", i, j)
+						}
+					}
+				})
+			}
+		}
+	}
+}
+
+// TestReadQueryResultValuesDoNotAlias checks that a value returned by
+// ReadQueryResult has its capacity limited to its length, so that appending
+// to one value cannot overwrite the value that follows it in the same row.
+func TestReadQueryResultValuesDoNotAlias(t *testing.T) {
+	qr := makeBenchResult(3, 2, 4)
+	stream := encodeResultStream(t, qr, 0)
+	c, rewind := newStreamConn(stream, 0)
+	rewind()
+	got, _, _, err := c.ReadQueryResult(FETCH_ALL_ROWS, true)
+	require.NoError(t, err)
+	for _, row := range got.Rows {
+		for _, v := range row {
+			assert.Equal(t, len(v.Raw()), cap(v.Raw()))
+		}
+	}
+	_ = append(got.Rows[0][0].Raw(), "zzzz"...)
+	assert.Equal(t, qr.Rows, got.Rows)
+}
+
+func BenchmarkReadQueryResult(b *testing.B) {
+	cases := []struct {
+		name             string
+		cols, rows, vlen int
+	}{
+		{"narrow3x8_1row", 3, 1, 8},
+		{"narrow3x8_1000rows", 3, 1000, 8},
+		{"wide20x12_1000rows", 20, 1000, 12},
+		{"blob1x64K_20rows", 1, 20, 64 << 10},
+	}
+	impls := []struct {
+		name string
+		read func(c *Conn) (*sqltypes.Result, bool, uint16, error)
+	}{
+		{"impl=copyPerColumn", func(c *Conn) (*sqltypes.Result, bool, uint16, error) {
+			return c.readQueryResultRef(FETCH_ALL_ROWS, false, false)
+		}},
+		{"impl=clonePerRow", func(c *Conn) (*sqltypes.Result, bool, uint16, error) {
+			return c.readQueryResultRef(FETCH_ALL_ROWS, false, true)
+		}},
+		{"impl=ownPacket", func(c *Conn) (*sqltypes.Result, bool, uint16, error) {
+			return c.ReadQueryResult(FETCH_ALL_ROWS, false)
+		}},
+	}
+	for _, tc := range cases {
+		stream := encodeResultStream(b, makeBenchResult(tc.cols, tc.rows, tc.vlen), 0)
+		for _, impl := range impls {
+			b.Run(tc.name+"/"+impl.name, func(b *testing.B) {
+				c, rewind := newStreamConn(stream, 0)
+				b.SetBytes(int64(len(stream)))
+				b.ReportAllocs()
+				for b.Loop() {
+					rewind()
+					qr, _, _, err := impl.read(c)
+					if err != nil || len(qr.Rows) != tc.rows {
+						b.Fatal(err)
+					}
+				}
+			})
+		}
+	}
+}
