+// readLenEncStringAsBytesCapped is like readLenEncStringAsBytes, but the
+// returned slice has its capacity limited to its length, so that appending to
+// it can never overwrite the bytes that follow it in data.
+func readLenEncStringAsBytesCapped(data []byte, pos int) ([]byte, int, bool) {
+	size, pos, ok := readLenEncInt(data, pos)
+	if !ok {
+		return nil, 0, false
+	}
+	s := int(size)
+	if pos+s-1 >= len(data) {
+		return nil, 0, false
+	}
+	return data[pos : pos+s : pos+s], pos + s, true
+}
