+package onlineddl
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/encoding/protojson"
+	"google.golang.org/protobuf/encoding/prototext"
+	"google.golang.org/protobuf/proto"
+
+	binlogdatapb "vitess.io/vitess/go/vt/proto/binlogdata"
+
+	"vitess.io/vitess/go/vt/schemadiff"
+	"vitess.io/vitess/go/vt/sqlparser"
+	"vitess.io/vitess/go/vt/vtenv"
+)
+
+func TestVALAScratchFilter(t *testing.T) {
+	venv := vtenv.NewTestEnv()
+	senv := schemadiff.NewTestEnv()
+	cases := []struct{ from, to, alter string }{
+		{
+			"create table t (id int primary key, g varchar(64), x varchar(64))",
+			"create table t (id int primary key, h varchar(64), x varchar(64), g varchar(64) as (concat(h,'!')) virtual)",
+			"alter table t change column g h varchar(64), add column g varchar(64) as (concat(h,'!')) virtual",
+		},
+		{
+			"create table t (id int primary key, g varchar(64), x varchar(64))",
+			"create table t (id int primary key, h varchar(64), x varchar(64), g varchar(64) as (concat(h,'!')) virtual)",
+			"alter table t rename column g to h, add column g varchar(64) as (concat(h,'!')) virtual",
+		},
+		{
+			"create table t (id int primary key, g varchar(64) charset utf8mb4, x varchar(64))",
+			"create table t (id int primary key, g varchar(64) charset latin1, x varchar(64))",
+			"alter table t modify column g varchar(64) charset latin1",
+		},
+		{
+			"create table t (id int primary key, a varchar(64))",
+			"create table t (id int primary key, b varchar(64))",
+			"alter table t rename column a to b",
+		},
+	}
+	for _, c := range cases {
+		from, err := schemadiff.NewCreateTableEntityFromSQL(senv, c.from)
+		require.NoError(t, err)
+		to, err := schemadiff.NewCreateTableEntityFromSQL(senv, c.to)
+		require.NoError(t, err)
+		stmt, err := sqlparser.NewTestParser().Parse(c.alter)
+		require.NoError(t, err)
+		v, err := NewVRepl(venv, "wf", "ks", "0", "db", from.CreateTable, to.CreateTable, stmt.(*sqlparser.AlterTable), false)
+		require.NoError(t, err)
+		require.NoError(t, v.analyzeAlter())
+		require.NoError(t, v.analyzeTables())
+		err = v.generateFilterQuery()
+		v.analyzeBinlogSource(t.Context())
+		fmt.Printf("ALTER: %s\n  filter=%q err=%v\n  rule=%v\n", c.alter, v.filterQuery, err, v.bls.Filter.Rules[0])
+	}
+}
+
+func TestVALAScratchNilCharset(t *testing.T) {
+	for _, txt := range []string{
+		`filter:{rules:{match:"t" filter:"select * from t" convert_charset:{key:"g"}}}`,
+		`filter:{rules:{match:"t" filter:"select * from t" convert_charset:{key:"g" value:{}}}}`,
+	} {
+		bls := &binlogdatapb.BinlogSource{}
+		err := prototext.Unmarshal([]byte(txt), bls)
+		v, ok := bls.GetFilter().GetRules()[0].ConvertCharset["g"]
+		fmt.Printf("prototext %q: err=%v ok=%v nil=%v\n", txt, err, ok, v == nil)
+		b, err := bls.MarshalVT()
+		require.NoError(t, err)
+		bls2 := &binlogdatapb.BinlogSource{}
+		require.NoError(t, bls2.UnmarshalVT(b))
+		v, ok = bls2.GetFilter().GetRules()[0].ConvertCharset["g"]
+		fmt.Printf("  vtproto roundtrip: ok=%v nil=%v\n", ok, v == nil)
+		bls3 := &binlogdatapb.BinlogSource{}
+		require.NoError(t, proto.Unmarshal(b, bls3))
+		v, ok = bls3.GetFilter().GetRules()[0].ConvertCharset["g"]
+		fmt.Printf("  proto roundtrip: ok=%v nil=%v\n", ok, v == nil)
+	}
+	bls4 := &binlogdatapb.BinlogSource{}
+	err := protojson.Unmarshal([]byte(`{"filter":{"rules":[{"match":"t","convertCharset":{"g":null}}]}}`), bls4)
+	fmt.Printf("json null value: err=%v\n", err)
+	if err == nil {
+		v, ok := bls4.GetFilter().GetRules()[0].ConvertCharset["g"]
+		fmt.Printf("  json null: ok=%v nil=%v\n", ok, v == nil)
+	}
+	// A Go map entry set to nil and then marshalled.
+	bls := &binlogdatapb.BinlogSource{Filter: &binlogdatapb.Filter{Rules: []*binlogdatapb.Rule{{Match: "t", ConvertCharset: map[string]*binlogdatapb.CharsetConversion{"g": nil}}}}}
+	txt, err := prototext.Marshal(bls)
+	fmt.Printf("prototext of nil entry: %q err=%v\n", txt, err)
+	b, err := bls.MarshalVT()
+	fmt.Printf("vtproto marshal of nil entry: err=%v\n", err)
+	bls2 := &binlogdatapb.BinlogSource{}
+	require.NoError(t, bls2.UnmarshalVT(b))
+	v, ok := bls2.GetFilter().GetRules()[0].ConvertCharset["g"]
+	fmt.Printf("  roundtrip nil entry: ok=%v nil=%v\n", ok, v == nil)
+	bls5 := &binlogdatapb.BinlogSource{}
+	require.NoError(t, prototext.Unmarshal(txt, bls5))
+	v, ok = bls5.GetFilter().GetRules()[0].ConvertCharset["g"]
+	fmt.Printf("  prototext roundtrip nil entry: ok=%v nil=%v\n", ok, v == nil)
+}
