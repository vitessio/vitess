+// buildTestExecutionPlan builds the execution plan exactly as vcopier and
+// vplayer do: buildReplicatorPlan from the rule and the target's column info,
+// then buildExecutionPlan from the fields that the source sends.
+func buildTestExecutionPlan(t *testing.T, rule *binlogdatapb.Rule, targetColInfos []*ColumnInfo, sourceTable string, sourceFields []*querypb.Field) *TablePlan {
+	t.Helper()
+	vttablet.InitVReplicationConfigDefaults()
+	vr := &vreplicator{
+		workflowConfig: vttablet.DefaultVReplicationConfig,
+	}
+	colInfoMap := map[string][]*ColumnInfo{rule.Match: targetColInfos}
+	source := getSource(&binlogdatapb.Filter{Rules: []*binlogdatapb.Rule{rule}})
+	rp, err := vr.buildReplicatorPlan(source, colInfoMap, nil, binlogplayer.NewStats(), collations.MySQL8(), sqlparser.NewTestParser())
+	require.NoError(t, err)
+	tp, err := rp.buildExecutionPlan(&binlogdatapb.FieldEvent{TableName: sourceTable, Fields: sourceFields})
+	require.NoError(t, err)
+	return tp
+}
+
+// copyPhaseInsert returns the statement that the copy phase (vcopier) executes
+// for the given rows. A panic is reported as an error so that the test fails
+// instead of crashing the test binary.
+func copyPhaseInsert(tp *TablePlan, rows ...[]sqltypes.Value) (query string, err error) {
+	defer func() {
+		if x := recover(); x != nil {
+			err = fmt.Errorf("panic: %v", x)
+		}
+	}()
+	protoRows := make([]*querypb.Row, 0, len(rows))
+	for _, row := range rows {
+		protoRows = append(protoRows, sqltypes.RowToProto3(row))
+	}
+	_, err = tp.applyBulkInsert(&bytes2.Buffer{}, protoRows, func(sql string) (*sqltypes.Result, error) {
+		query = sql
+		return &sqltypes.Result{RowsAffected: uint64(len(rows))}, nil
+	}, 0)
+	return query, err
+}
+
+// runningPhaseInsert returns the statement that the running phase (vplayer)
+// executes for a single-row insert. A panic is reported as an error.
+func runningPhaseInsert(tp *TablePlan, row []sqltypes.Value) (query string, err error) {
+	defer func() {
+		if x := recover(); x != nil {
+			err = fmt.Errorf("panic: %v", x)
+		}
+	}()
+	_, err = tp.applyChange(&binlogdatapb.RowChange{After: sqltypes.RowToProto3(row)}, func(sql string) (*sqltypes.Result, error) {
+		query = sql
+		return &sqltypes.Result{RowsAffected: 1}, nil
+	})
+	return query, err
+}
+
+// TestExplicitColumnListWithTargetGeneratedColumnName covers an explicit column
+// list in which a *source* column has the same name as a column that is
+// GENERATED on the target. FieldsToSkip holds the target's generated columns,
+// but appendFromRow checks it against the source field names, so it skips a
+// field that the INSERT does bind and shifts every later value one position
+// to the left. Online DDL generates exactly such a rule for
+//
+//	ALTER TABLE t CHANGE COLUMN g h ..., ADD COLUMN g ... AS (...)
+//
+// (rename a column and keep its old name as a generated alias), whose filter
+// is "select `id` as `id`, `g` as `h`, `x` as `x` from `t`".
+func TestExplicitColumnListWithTargetGeneratedColumnName(t *testing.T) {
+	fields := []*querypb.Field{
+		{Name: "id", Type: querypb.Type_INT32},
+		{Name: "g", Type: querypb.Type_VARCHAR},
+		{Name: "x", Type: querypb.Type_VARCHAR},
+	}
+	row := []sqltypes.Value{sqltypes.NewInt32(1), sqltypes.NewVarChar("renamed-value"), sqltypes.NewVarChar("x-value")}
+
+	t.Run("online ddl: rename a column and add a generated column with its old name", func(t *testing.T) {
+		rule := &binlogdatapb.Rule{
+			Match:                        "dst",
+			Filter:                       "select `id` as `id`, `g` as `h`, `x` as `x` from `src`",
+			SourceUniqueKeyColumns:       "id",
+			TargetUniqueKeyColumns:       "id",
+			SourceUniqueKeyTargetColumns: "id",
+		}
+		colInfos := []*ColumnInfo{
+			{Name: "id", IsPK: true},
+			{Name: "h"},
+			{Name: "x"},
+			{Name: "g", IsGenerated: true},
+		}
+		tp := buildTestExecutionPlan(t, rule, colInfos, "src", fields)
+		want := "insert into dst(id,h,x) values (1,'renamed-value','x-value')"
+
+		// The running phase binds by name and gets it right.
+		got, err := runningPhaseInsert(tp, row)
+		require.NoError(t, err)
+		assert.Equal(t, want, got, "running phase")
+
+		// The copy phase must produce the same statement. On main it skips
+		// field "g" (because the target has a generated "g"), binds "x-value"
+		// into h, and then indexes past the end of the fields and panics.
+		got, err = copyPhaseInsert(tp, row)
+		require.NoError(t, err, "copy phase")
+		assert.Equal(t, want, got, "copy phase")
+	})
+
+	t.Run("materialize: the filter selects a column that is generated on the target", func(t *testing.T) {
+		rule := &binlogdatapb.Rule{
+			Match:  "dst",
+			Filter: "select id, g, x from src",
+		}
+		colInfos := []*ColumnInfo{
+			{Name: "id", IsPK: true},
+			{Name: "g", IsGenerated: true},
+			{Name: "x"},
+		}
+		tp := buildTestExecutionPlan(t, rule, colInfos, "src", fields)
+		// Either the generated column is skipped, as it is for "select *", or
+		// the copy fails with an error. It must not panic, and it must not bind
+		// the value of one column to another.
+		got, err := copyPhaseInsert(tp, row)
+		require.NotContains(t, fmt.Sprint(err), "panic", "copy phase")
+		if err == nil {
+			assert.Equal(t, "insert into dst(id,x) values (1,'x-value')", got, "copy phase")
+		}
+	})
+}
+
+// TestSelectStarRuleKeepsConversions checks that a "select *" rule applies the
+// rule's ConvertCharset and ConvertIntToEnum exactly like the equivalent
+// explicit column list does, in both the copy and the running phase.
+func TestSelectStarRuleKeepsConversions(t *testing.T) {
+	fields := []*querypb.Field{
+		{Name: "id", Type: querypb.Type_INT32},
+		{Name: "val", Type: querypb.Type_VARCHAR},
+		{Name: "e", Type: querypb.Type_INT32},
+	}
+	colInfos := []*ColumnInfo{
+		{Name: "id", IsPK: true},
+		{Name: "val"},
+		{Name: "e"},
+	}
+	// "é" is 0xC3 0xA9 in utf8mb4 and 0xE9 in latin1.
+	row := []sqltypes.Value{sqltypes.NewInt32(1), sqltypes.NewVarChar("é"), sqltypes.NewInt32(2)}
+	newRule := func(filter string) *binlogdatapb.Rule {
+		return &binlogdatapb.Rule{
+			Match:  "dst",
+			Filter: filter,
+			ConvertCharset: map[string]*binlogdatapb.CharsetConversion{
+				"val": {FromCharset: "utf8mb4", ToCharset: "latin1"},
+			},
+			ConvertIntToEnum: map[string]bool{"e": true},
+		}
+	}
+
+	explicit := buildTestExecutionPlan(t, newRule("select id, val, e from src"), colInfos, "src", fields)
+	star := buildTestExecutionPlan(t, newRule("select * from src"), colInfos, "src", fields)
+
+	wantCopy, err := copyPhaseInsert(explicit, row)
+	require.NoError(t, err)
+	wantRun, err := runningPhaseInsert(explicit, row)
+	require.NoError(t, err)
+	require.Equal(t, "insert into dst(id,val,e) values (1,'\xe9','2')", wantRun)
+
+	assert.Equal(t, explicit.ConvertCharset, star.ConvertCharset)
+	assert.Equal(t, explicit.ConvertIntToEnum, star.ConvertIntToEnum)
+	gotCopy, err := copyPhaseInsert(star, row)
+	require.NoError(t, err)
+	assert.Equal(t, wantCopy, gotCopy, "copy phase")
+	gotRun, err := runningPhaseInsert(star, row)
+	require.NoError(t, err)
+	assert.Equal(t, wantRun, gotRun, "running phase")
+}
+
+// TestNilCharsetConversionEntry checks that a ConvertCharset entry that maps a
+// column to nil does not crash the stream. No rule that is parsed from its
+// text or binary form can hold a nil entry (an empty value parses to an empty,
+// non-nil CharsetConversion), so this only guards in-process callers.
+func TestNilCharsetConversionEntry(t *testing.T) {
+	fields := []*querypb.Field{
+		{Name: "id", Type: querypb.Type_INT32},
+		{Name: "val", Type: querypb.Type_VARCHAR},
+	}
+	colInfos := []*ColumnInfo{
+		{Name: "id", IsPK: true},
+		{Name: "val"},
+	}
+	row := []sqltypes.Value{sqltypes.NewInt32(1), sqltypes.NewVarChar("abc")}
+	rule := &binlogdatapb.Rule{
+		Match:          "dst",
+		Filter:         "select id, val from src",
+		ConvertCharset: map[string]*binlogdatapb.CharsetConversion{"val": nil},
+	}
+	tp := buildTestExecutionPlan(t, rule, colInfos, "src", fields)
+
+	_, err := copyPhaseInsert(tp, row)
+	assert.NotContains(t, fmt.Sprint(err), "panic", "copy phase")
+	_, err = runningPhaseInsert(tp, row)
+	assert.NotContains(t, fmt.Sprint(err), "panic", "running phase")
+
+	// For comparison: the empty conversion that a rule parsed from text or
+	// binary holds instead is rejected with an error.
+	rule.ConvertCharset = map[string]*binlogdatapb.CharsetConversion{"val": {}}
+	tp = buildTestExecutionPlan(t, rule, colInfos, "src", fields)
+	_, err = copyPhaseInsert(tp, row)
+	assert.ErrorContains(t, err, "character set  not supported for column val")
+}
