+package vreplication
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"vitess.io/vitess/go/vt/binlog/binlogplayer"
+
+	binlogdatapb "vitess.io/vitess/go/vt/proto/binlogdata"
+)
+
+// startCopyWorkflow creates a vreplication stream that copies and then
+// replicates, and deletes it when the test ends.
+func startCopyWorkflow(t *testing.T, rule *binlogdatapb.Rule) int {
+	t.Helper()
+	doNotLogDBQueries = true
+	bls := &binlogdatapb.BinlogSource{
+		Keyspace: env.KeyspaceName,
+		Shard:    env.ShardName,
+		Filter:   &binlogdatapb.Filter{Rules: []*binlogdatapb.Rule{rule}},
+		OnDdl:    binlogdatapb.OnDDLAction_IGNORE,
+	}
+	query := binlogplayer.CreateVReplicationState("test", bls, "", binlogdatapb.VReplicationWorkflowState_Init, playerEngine.dbName, 0, 0)
+	qr, err := playerEngine.Exec(query)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		// Deleting the stream stops its controller. If the controller is stuck,
+		// the engine stays locked and every later test would hang, so fail
+		// loudly instead.
+		done := make(chan error, 1)
+		go func() {
+			_, err := playerEngine.Exec(fmt.Sprintf("delete from _vt.vreplication where id = %d", qr.InsertID))
+			done <- err
+		}()
+		select {
+		case err := <-done:
+			assert.NoError(t, err)
+		case <-time.After(30 * time.Second):
+			panic(fmt.Sprintf("%s: stream %d did not stop within 30s; its controller is stuck and the vreplication engine is locked", t.Name(), qr.InsertID))
+		}
+		drainDBQueries()
+		doNotLogDBQueries = false
+	})
+	return int(qr.InsertID)
+}
+
+// dropTablesOnCleanup drops the tables when the test ends. Cleanups run after
+// t.Context() is canceled, so this uses a background context.
+func dropTablesOnCleanup(t *testing.T, tables ...string) {
+	t.Helper()
+	t.Cleanup(func() {
+		for _, table := range tables {
+			assert.NoError(t, env.Mysqld.ExecuteSuperQuery(context.Background(), "drop table if exists "+table))
+		}
+	})
+}
+
+// assertEventuallyData waits for the query to return the wanted rows. On
+// failure it reports the stream's state and message, and returns false.
+func assertEventuallyData(t *testing.T, id int, query string, want [][]string) bool {
+	t.Helper()
+	var lastErr error
+	if assert.Eventually(t, func() bool {
+		lastErr = compareQueryResults(t, query, want, env.Mysqld.FetchSuperQuery)
+		return lastErr == nil
+	}, 30*time.Second, 100*time.Millisecond) {
+		return true
+	}
+	qr, err := env.Mysqld.FetchSuperQuery(t.Context(), fmt.Sprintf("select state, message from _vt.vreplication where id = %d", id))
+	require.NoError(t, err)
+	return assert.Fail(t, "target has incorrect data", "%v\nstream: %v", lastErr, qr.Rows)
+}
+
+// TestPlayerCopyExplicitListWithTargetGeneratedColumnName runs the rule that
+// Online DDL generates for
+//
+//	ALTER TABLE t CHANGE COLUMN g h varchar(64), ADD COLUMN g varchar(64) AS (concat(h, '!'))
+//
+// The source column g is renamed to h, and the target gets a new generated
+// column with the old name. The target's FieldsToSkip then holds "g", which
+// the copy phase wrongly matches against the source field "g".
+func TestPlayerCopyExplicitListWithTargetGeneratedColumnName(t *testing.T) {
+	defer deleteTablet(addTablet(100))
+	execStatements(t, []string{
+		"create table src_gen_rename(id int, g varchar(64), x varchar(64), primary key(id))",
+		"insert into src_gen_rename values (1, 'aaa', 'x1'), (2, 'bbb', 'x2')",
+		fmt.Sprintf("create table %s.dst_gen_rename(id int, h varchar(64), x varchar(64), g varchar(64) as (concat(h, '!')) virtual, primary key(id))", vrepldb),
+	})
+	dropTablesOnCleanup(t, "src_gen_rename", vrepldb+".dst_gen_rename")
+
+	id := startCopyWorkflow(t, &binlogdatapb.Rule{
+		Match:                        "dst_gen_rename",
+		Filter:                       "select `id` as `id`, `g` as `h`, `x` as `x` from `src_gen_rename`",
+		SourceUniqueKeyColumns:       "id",
+		TargetUniqueKeyColumns:       "id",
+		SourceUniqueKeyTargetColumns: "id",
+		ForceUniqueKey:               "PRIMARY",
+	})
+	query := fmt.Sprintf("select id, h, x, g from %s.dst_gen_rename order by id", vrepldb)
+
+	// Copy phase.
+	require.True(t, assertEventuallyData(t, id, query, [][]string{
+		{"1", "aaa", "x1", "aaa!"},
+		{"2", "bbb", "x2", "bbb!"},
+	}), "copy phase")
+
+	// Running phase: a single-row and a multi-row insert.
+	execStatements(t, []string{
+		"insert into src_gen_rename values (3, 'ccc', 'x3')",
+		"insert into src_gen_rename values (4, 'ddd', 'x4'), (5, 'eee', 'x5')",
+	})
+	assertEventuallyData(t, id, query, [][]string{
+		{"1", "aaa", "x1", "aaa!"},
+		{"2", "bbb", "x2", "bbb!"},
+		{"3", "ccc", "x3", "ccc!"},
+		{"4", "ddd", "x4", "ddd!"},
+		{"5", "eee", "x5", "eee!"},
+	})
+}
+
+// TestPlayerSelectStarRuleConvertsCharset checks that a rule's ConvertCharset
+// is applied whether the rule lists its columns or uses "select *". The source
+// column is utf8mb4 and the target column is latin1. Without the conversion
+// the utf8mb4 bytes of "é" (0xC3 0xA9) are written as two latin1 characters
+// ("Ã©"), without any error.
+func TestPlayerSelectStarRuleConvertsCharset(t *testing.T) {
+	for _, filter := range []string{
+		"select id, val from src_cs",
+		"select * from src_cs",
+	} {
+		t.Run(filter, func(t *testing.T) {
+			defer deleteTablet(addTablet(100))
+			execStatements(t, []string{
+				"create table src_cs(id int, val varchar(64) character set utf8mb4, primary key(id))",
+				"insert into src_cs values (1, 'café')",
+				fmt.Sprintf("create table %s.dst_cs(id int, val varchar(64) character set latin1, primary key(id))", vrepldb),
+			})
+			dropTablesOnCleanup(t, "src_cs", vrepldb+".dst_cs")
+
+			id := startCopyWorkflow(t, &binlogdatapb.Rule{
+				Match:  "dst_cs",
+				Filter: filter,
+				ConvertCharset: map[string]*binlogdatapb.CharsetConversion{
+					"val": {FromCharset: "utf8mb4", ToCharset: "latin1"},
+				},
+			})
+			query := "select id, val, hex(val) from " + vrepldb + ".dst_cs where id = %d"
+
+			// Copy phase.
+			assertEventuallyData(t, id, fmt.Sprintf(query, 1), [][]string{
+				{"1", "café", "636166E9"},
+			})
+
+			// Running phase.
+			execStatements(t, []string{"insert into src_cs values (2, 'naïve')"})
+			assertEventuallyData(t, id, fmt.Sprintf(query, 2), [][]string{
+				{"2", "naïve", "6E61EF7665"},
+			})
+		})
+	}
+}
