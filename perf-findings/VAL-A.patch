+#!/bin/bash
+# Side check: Online DDL (vitess strategy) with RENAME COLUMN.
+M="mysql -h 127.0.0.1 -P 30003 -u root sbtest"
+S="mysql -N -S /home/vt/perf/c30000/vt_0000000100/mysql.sock -u vt_dba"
+V="/home/vt/bin/vtctldclient --server localhost:30021"
+$M -e "drop table if exists vala_r; create table vala_r(id int primary key, a varchar(64)); insert into vala_r values (1,'one'),(2,'two')"
+uuid=$($V ApplySchema --ddl-strategy vitess --sql "alter table vala_r rename column a to b" sbtest 2>&1 | tail -1)
+echo "uuid=$uuid"
+for i in $(seq 1 90); do
+  st=$($S -e "select migration_status from _vt.schema_migrations where migration_uuid='$uuid'")
+  [[ $st == complete || $st == failed || $st == cancelled ]] && break
+  sleep 1
+done
+$S -e "select migration_status, message from _vt.schema_migrations where migration_uuid='$uuid'"
+$M -e "show create table vala_r\G; select * from vala_r"
