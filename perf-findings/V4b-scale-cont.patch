+
+// TestVStreamCoalescesEmptyTransactions streams a backlog of transactions that are empty for
+// the stream's filter around one that is not. With coalescing enabled, the stream must send
+// fewer GTIDs than there are transactions, still end at the latest position, and send the
+// position of the empty transaction right before the non-empty one ahead of it, so that a
+// consumer that stops at that position does not apply the next transaction.
+func TestVStreamCoalescesEmptyTransactions(t *testing.T) {
+	execStatements(t, []string{
+		"create table coalesce_in(id int, val varbinary(128), primary key(id))",
+		"create table coalesce_out(id int, val varbinary(128), primary key(id))",
+	})
+	t.Cleanup(func() {
+		execStatements(t, []string{
+			"drop table coalesce_in",
+			"drop table coalesce_out",
+		})
+	})
+
+	old := vttablet.VStreamerCoalesceEmptyTransactions
+	vttablet.VStreamerCoalesceEmptyTransactions = true
+	t.Cleanup(func() { vttablet.VStreamerCoalesceEmptyTransactions = old })
+
+	startPos := primaryPosition(t)
+	const before, after = 60, 20
+	for i := range before {
+		execStatement(t, fmt.Sprintf("insert into coalesce_out values (%d, 'x')", i))
+	}
+	posBeforeIn := primaryPosition(t)
+	execStatement(t, "insert into coalesce_in values (1, 'in')")
+	for i := range after {
+		execStatement(t, fmt.Sprintf("insert into coalesce_out values (%d, 'y')", before+i))
+	}
+	endPos, err := replication.DecodePosition(primaryPosition(t))
+	require.NoError(t, err)
+	wantBeforeIn, err := replication.DecodePosition(posBeforeIn)
+	require.NoError(t, err)
+
+	coalesced0 := engine.vstreamerEmptyTransactionsCoalesced.Get()
+	filter := &binlogdatapb.Filter{Rules: []*binlogdatapb.Rule{{Match: "coalesce_in", Filter: "select * from coalesce_in"}}}
+	ctx, cancel := context.WithCancel(t.Context())
+	wg, ch := startStream(ctx, t, filter, startPos, nil)
+	defer wg.Wait()
+	defer cancel()
+
+	// Hold the first message for a moment, so that the binlog events queue up behind it.
+	var first []*binlogdatapb.VEvent
+	select {
+	case first = <-ch:
+	case <-time.After(30 * time.Second):
+		require.FailNow(t, "no events received")
+	}
+	time.Sleep(500 * time.Millisecond)
+
+	var (
+		gtids       int
+		lastPos     replication.Position
+		posAtRow    replication.Position
+		sawRow      bool
+		reachedEnd  bool
+		handleBatch = func(evs []*binlogdatapb.VEvent) {
+			for _, ev := range evs {
+				switch ev.Type {
+				case binlogdatapb.VEventType_GTID:
+					gtids++
+					pos, err := replication.DecodePosition(ev.Gtid)
+					require.NoError(t, err)
+					lastPos = pos
+					if pos.AtLeast(endPos) {
+						reachedEnd = true
+					}
+				case binlogdatapb.VEventType_ROW:
+					if ev.RowEvent.TableName == "coalesce_in" {
+						sawRow = true
+						posAtRow = lastPos
+					}
+				}
+			}
+		}
+	)
+	handleBatch(first)
+	for !reachedEnd {
+		select {
+		case evs, ok := <-ch:
+			require.True(t, ok, "stream ended before reaching the end position")
+			handleBatch(evs)
+		case <-time.After(30 * time.Second):
+			require.FailNow(t, "timed out waiting for the end position")
+		}
+	}
+
+	require.True(t, sawRow, "the row of coalesce_in was not streamed")
+	// The empty transaction right before the row's transaction must have been sent before the row.
+	assert.True(t, posAtRow.AtLeast(wantBeforeIn), "position before the row: got %v, want at least %v", posAtRow, wantBeforeIn)
+	assert.Less(t, gtids, before+1+after, "no transaction was coalesced")
+	assert.Greater(t, engine.vstreamerEmptyTransactionsCoalesced.Get(), coalesced0)
+}
+
+// TestVStreamCoalescesEmptyTransactionsWithinWindow checks that a stream that has caught up
+// with the binlog holds the transactions that are empty for its filter for up to
+// --vstream-coalesce-empty-transactions-window, and then sends the latest position once,
+// instead of sending every one of them as it arrives.
+func TestVStreamCoalescesEmptyTransactionsWithinWindow(t *testing.T) {
+	execStatements(t, []string{
+		"create table coalesce_win_in(id int, val varbinary(128), primary key(id))",
+		"create table coalesce_win_out(id int, val varbinary(128), primary key(id))",
+	})
+	t.Cleanup(func() {
+		execStatements(t, []string{
+			"drop table coalesce_win_in",
+			"drop table coalesce_win_out",
+		})
+	})
+
+	oldCoalesce, oldWindow := vttablet.VStreamerCoalesceEmptyTransactions, vttablet.VStreamerCoalesceEmptyTransactionsWindow
+	vttablet.VStreamerCoalesceEmptyTransactions = true
+	vttablet.VStreamerCoalesceEmptyTransactionsWindow = 2 * time.Second
+	t.Cleanup(func() {
+		vttablet.VStreamerCoalesceEmptyTransactions = oldCoalesce
+		vttablet.VStreamerCoalesceEmptyTransactionsWindow = oldWindow
+	})
+
+	startPos := primaryPosition(t)
+	filter := &binlogdatapb.Filter{Rules: []*binlogdatapb.Rule{{Match: "coalesce_win_in", Filter: "select * from coalesce_win_in"}}}
+	ctx, cancel := context.WithCancel(t.Context())
+	wg, ch := startStream(ctx, t, filter, startPos, nil)
+	defer wg.Wait()
+	defer cancel()
+
+	const n = 10
+	for i := range n {
+		execStatement(t, fmt.Sprintf("insert into coalesce_win_out values (%d, 'x')", i))
+	}
+	endPos, err := replication.DecodePosition(primaryPosition(t))
+	require.NoError(t, err)
+
+	gtids := 0
+	for reachedEnd := false; !reachedEnd; {
+		select {
+		case evs, ok := <-ch:
+			require.True(t, ok, "stream ended before reaching the end position")
+			for _, ev := range evs {
+				if ev.Type != binlogdatapb.VEventType_GTID {
+					continue
+				}
+				gtids++
+				pos, err := replication.DecodePosition(ev.Gtid)
+				require.NoError(t, err)
+				reachedEnd = pos.AtLeast(endPos)
+			}
+		case <-time.After(30 * time.Second):
+			require.FailNow(t, "timed out waiting for the end position")
+		}
+	}
+	assert.Less(t, gtids, n, "the empty transactions were not coalesced")
+}
