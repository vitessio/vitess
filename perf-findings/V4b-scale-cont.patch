+// tableRuleMatcher returns the same rule as MatchTable, for many table names: the rules
+// that match a table by name are indexed, and the regular expressions are compiled once.
+// A MoveTables workflow has one rule per table, so matching every table of the schema with
+// MatchTable is quadratic in the number of tables.
+type tableRuleMatcher struct {
+	rules []*binlogdatapb.Rule
+	// exact maps a table name to the index of the first rule that names it.
+	exact map[string]int
+	// regexps holds the indexes of the regular expression rules, in order.
+	regexps []int
+	// compiled holds the compiled regular expression of each regexps entry, or the
+	// error from compiling it.
+	compiled    []*regexp.Regexp
+	compileErrs []error
+}
+
+func newTableRuleMatcher(filter *binlogdatapb.Filter) *tableRuleMatcher {
+	m := &tableRuleMatcher{
+		rules: filter.Rules,
+		exact: make(map[string]int, len(filter.Rules)),
+	}
+	for i, rule := range filter.Rules {
+		if strings.HasPrefix(rule.Match, "/") {
+			re, err := regexp.Compile(strings.Trim(rule.Match, "/"))
+			m.regexps = append(m.regexps, i)
+			m.compiled = append(m.compiled, re)
+			m.compileErrs = append(m.compileErrs, err)
+			continue
+		}
+		if _, ok := m.exact[rule.Match]; !ok {
+			m.exact[rule.Match] = i
+		}
+	}
+	return m
+}
+
+// match returns the first rule that matches tableName, like MatchTable.
+func (m *tableRuleMatcher) match(tableName string) (*binlogdatapb.Rule, error) {
+	first, ok := m.exact[tableName]
+	if !ok {
+		first = len(m.rules)
+	}
+	for j, i := range m.regexps {
+		if i > first {
+			break
+		}
+		if m.compileErrs[j] != nil {
+			return nil, m.compileErrs[j]
+		}
+		if m.compiled[j].MatchString(tableName) {
+			return m.rules[i], nil
+		}
+	}
+	if ok {
+		return m.rules[first], nil
+	}
+	return nil, nil
+}
