+
+package throttle
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"vitess.io/vitess/go/vt/vttablet/tabletserver/throttle/throttlerapp"
+)
+
+// TestCheckExemptedAppDoesNotMutateSharedResult verifies that a check by an exempted app returns a
+// result of its own, and does not write the app name into the package-level okMetricCheckResult that
+// every exempted check and every check against a stopped throttler returns.
+func TestCheckExemptedAppDoesNotMutateSharedResult(t *testing.T) {
+	origAppName := okMetricCheckResult.AppName
+	t.Cleanup(func() { okMetricCheckResult.AppName = origAppName })
+
+	throttler := newTestThrottler()
+	throttler.isOpen.Store(true)
+	throttler.isEnabled.Store(true)
+	require.True(t, throttler.IsRunning())
+
+	// A dynamically exempted app, as set by `UpdateThrottlerConfig --throttle-app-exempt`.
+	throttler.ThrottleApp("my-exempt-app", time.Now().Add(time.Hour), DefaultThrottleRatio, true)
+
+	schemaTracker := throttler.Check(t.Context(), throttlerapp.SchemaTrackerName.String(), nil, &CheckFlags{})
+	require.True(t, schemaTracker.IsOK())
+	require.Equal(t, throttlerapp.SchemaTrackerName.String(), schemaTracker.AppName)
+
+	messager := throttler.Check(t.Context(), throttlerapp.MessagerName.String(), nil, &CheckFlags{})
+	require.True(t, messager.IsOK())
+	assert.Equal(t, throttlerapp.MessagerName.String(), messager.AppName)
+
+	// The earlier result must not change under its holder's feet.
+	assert.Equal(t, throttlerapp.SchemaTrackerName.String(), schemaTracker.AppName, "an earlier exempted check result was overwritten by a later check")
+	assert.NotSame(t, schemaTracker, messager)
+	// The shared global must stay pristine.
+	assert.Equal(t, origAppName, okMetricCheckResult.AppName, "okMetricCheckResult.AppName was mutated")
+
+	// Once the throttler stops, a non-exempt app receives the shared OK result. It must not carry the
+	// name of whichever exempted app checked last.
+	throttler.isEnabled.Store(false)
+	vreplication := throttler.Check(t.Context(), throttlerapp.VReplicationName.String(), nil, &CheckFlags{})
+	require.True(t, vreplication.IsOK())
+	assert.NotEqual(t, throttlerapp.MessagerName.String(), vreplication.AppName, "a check on a stopped throttler reports a previous exempted app's name")
+	assert.Equal(t, origAppName, vreplication.AppName)
+}
+
+// TestCheckExemptedAppConcurrentRace issues concurrent checks by different exempted apps. On a
+// build with -race this reports a data race on okMetricCheckResult.AppName when the exempted path
+// writes to the shared global. Without -race, it checks that each caller gets its own app name back.
+func TestCheckExemptedAppConcurrentRace(t *testing.T) {
+	origAppName := okMetricCheckResult.AppName
+	t.Cleanup(func() { okMetricCheckResult.AppName = origAppName })
+
+	throttler := newTestThrottler()
+	throttler.isOpen.Store(true)
+	throttler.isEnabled.Store(true)
+
+	apps := []string{
+		throttlerapp.SchemaTrackerName.String(),
+		throttlerapp.MessagerName.String(),
+		throttlerapp.BinlogWatcherName.String(),
+	}
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	mismatches := 0
+	for _, app := range apps {
+		wg.Go(func() {
+			for range 1000 {
+				res := throttler.Check(t.Context(), app, nil, &CheckFlags{})
+				if res.AppName != app {
+					mu.Lock()
+					mismatches++
+					mu.Unlock()
+				}
+			}
+		})
+	}
+	wg.Wait()
+	assert.Zero(t, mismatches, "exempted checks returned another app's name")
+}
