+
+package vreplication
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	binlogdatapb "vitess.io/vitess/go/vt/proto/binlogdata"
+)
+
+// TestRelayLogSendNoStallAfterFetchDrains verifies that a blocked Send does not report
+// "relay log I/O stalled" once a Fetch has drained the relay log, even when the Send's stall
+// timer expires at the same moment as the Fetch.
+//
+// To line the two events up, the test holds the relay log mutex while both the Fetch and the
+// expired stall timer queue up behind it, which is what happens when the timer fires while
+// Fetch is inside its critical section. Which of the two runs first after the release is up to
+// the scheduler, so the scenario is repeated.
+func TestRelayLogSendNoStallAfterFetchDrains(t *testing.T) {
+	oldProgressDeadline := vplayerProgressDeadline
+	t.Cleanup(func() { vplayerProgressDeadline = oldProgressDeadline })
+	const deadline = 20 * time.Millisecond
+	vplayerProgressDeadline = deadline
+
+	events := []*binlogdatapb.VEvent{{Type: binlogdatapb.VEventType_GTID}}
+	const iterations = 50
+	spurious := 0
+	for range iterations {
+		ctx, cancel := context.WithCancel(t.Context())
+		rl := newRelayLog(ctx, 1, 10, nil)
+		// Fill the log: with maxItems=1 the next Send waits for a Fetch.
+		require.NoError(t, rl.Send(events))
+
+		sendResult := make(chan error, 1)
+		go func() {
+			sendResult <- rl.Send(events)
+		}()
+		// Let the Send reach its wait; it is well inside its stall deadline.
+		time.Sleep(deadline / 4)
+
+		rl.mu.Lock()
+		fetchResult := make(chan int, 1)
+		go func() {
+			items, err := rl.Fetch()
+			assert.NoError(t, err)
+			fetchResult <- len(items)
+		}()
+		// Keep the lock until the Send's stall timer has expired and is waiting for the lock too.
+		time.Sleep(3 * deadline)
+		rl.mu.Unlock()
+
+		require.Equal(t, 1, <-fetchResult, "the Fetch drains the item that blocked the Send")
+		var err error
+		select {
+		case err = <-sendResult:
+		case <-time.After(30 * time.Second):
+			require.FailNow(t, "Send did not return")
+		}
+		if err != nil {
+			require.ErrorContains(t, err, relayLogIOStalledMsg)
+			spurious++
+		}
+		cancel()
+	}
+	assert.Zero(t, spurious, "%d/%d Sends reported %q although a Fetch had drained the relay log", spurious, iterations, relayLogIOStalledMsg)
+}
diff --git a/go/vt/vttablet/tabletserver/stream_consolidator_fetchnext_test.go b/go/vt/vttablet/tabletserver/stream_consolidator_fetchnext_test.go
