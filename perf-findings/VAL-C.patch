+package mysql
+
+import (
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"vitess.io/vitess/go/sqltypes"
+	querypb "vitess.io/vitess/go/vt/proto/query"
+)
+
+// TestFetchNextValuesHaveCappedCapacity verifies that the values returned by the streaming FetchNext
+// own exactly their bytes: each value's capacity equals its length, so appending to one value
+// reallocates instead of overwriting the columns that follow it in the row packet.
+func TestFetchNextValuesHaveCappedCapacity(t *testing.T) {
+	listener, sConn, cConn := createSocketPair(t)
+	t.Cleanup(func() {
+		listener.Close()
+		sConn.Close()
+		cConn.Close()
+	})
+
+	result := &sqltypes.Result{
+		Fields: []*querypb.Field{
+			{Name: "a", Type: querypb.Type_VARCHAR},
+			{Name: "b", Type: querypb.Type_VARCHAR},
+			{Name: "c", Type: querypb.Type_VARCHAR},
+		},
+		Rows: [][]sqltypes.Value{{
+			sqltypes.NewVarChar("aaa"),
+			sqltypes.NewVarChar("bbb"),
+			sqltypes.NewVarChar("ccc"),
+		}},
+	}
+
+	var wg sync.WaitGroup
+	var (
+		row      []sqltypes.Value
+		fetchErr error
+	)
+	wg.Go(func() {
+		if fetchErr = cConn.ExecuteStreamFetch("select a, b, c from t"); fetchErr != nil {
+			return
+		}
+		row, fetchErr = cConn.FetchNext(nil)
+		cConn.CloseResult()
+	})
+	handler := testHandler{result: result}
+	require.True(t, sConn.handleNextCommand(&handler))
+	wg.Wait()
+	require.NoError(t, fetchErr)
+	require.Len(t, row, 3)
+
+	for i, v := range row {
+		assert.Equal(t, v.Len(), cap(v.Raw()), "column %d: capacity runs past the value into the rest of the packet", i)
+	}
+
+	// A caller that extends a value's bytes (e.g. to build a key or pad a string) must not clobber
+	// the next column.
+	extended := append(row[0].Raw(), "XYZ"...)
+	assert.Equal(t, "aaaXYZ", string(extended))
+	assert.Equal(t, "bbb", row[1].ToString(), "appending to column 0 overwrote column 1")
+	assert.Equal(t, "ccc", row[2].ToString())
+}
