+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package tabletserver
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"vitess.io/vitess/go/mysql/fakesqldb"
+	"vitess.io/vitess/go/sqltypes"
+	"vitess.io/vitess/go/vt/dbconfigs"
+	"vitess.io/vitess/go/vt/dbconnpool"
+	"vitess.io/vitess/go/vt/vttablet/tabletserver/tabletenv"
+)
+
+// exactCapacityCopy returns a deep copy of the result whose values own exactly their bytes.
+func exactCapacityCopy(result *sqltypes.Result) *sqltypes.Result {
+	out := &sqltypes.Result{Fields: result.Fields, Rows: make([][]sqltypes.Value, 0, cap(result.Rows))}
+	for _, row := range result.Rows {
+		newRow := make([]sqltypes.Value, len(row), cap(row))
+		for i, v := range row {
+			if v.IsNull() {
+				continue
+			}
+			b := make([]byte, v.Len())
+			copy(b, v.Raw())
+			newRow[i] = sqltypes.MakeTrusted(v.Type(), b)
+		}
+		out.Rows = append(out.Rows, newRow)
+	}
+	return out
+}
+
+// admittedToCatchup feeds the results through a streamInFlight with the given limits and returns how
+// many results were stored for late followers before catching up was disabled.
+func admittedToCatchup(results []*sqltypes.Result, maxMemoryQuery, maxMemoryTotal int64) (admitted int, memory int64) {
+	s := &streamInFlight{catchupAllowed: true}
+	for _, r := range results {
+		memory += s.update(r, false, maxMemoryQuery, maxMemoryTotal)
+	}
+	return len(s.catchup), memory
+}
+
+// TestStreamConsolidatorAccountsStreamedRowsExactly verifies that the stream consolidator's memory
+// accounting of rows read by the streaming FetchNext path matches the memory those rows use. When
+// FetchNext hands out values whose capacity runs to the end of the row packet, Result.CachedSize
+// counts every later column again for each value, the per-query catch-up budget
+// (--consolidator-stream-query-size) is exhausted several times sooner, and late followers can no
+// longer join the stream.
+func TestStreamConsolidatorAccountsStreamedRowsExactly(t *testing.T) {
+	db := fakesqldb.New(t)
+	t.Cleanup(db.Close)
+
+	const (
+		numCols = 20
+		colLen  = 32
+		numRows = 5000
+	)
+	names := make([]string, numCols)
+	types := make([]string, numCols)
+	for i := range numCols {
+		names[i] = fmt.Sprintf("c%d", i)
+		types[i] = "varchar"
+	}
+	fields := sqltypes.MakeTestFields(strings.Join(names, "|"), strings.Join(types, "|"))
+	rows := make([][]sqltypes.Value, numRows)
+	for r := range numRows {
+		row := make([]sqltypes.Value, numCols)
+		for c := range numCols {
+			row[c] = sqltypes.NewVarChar(fmt.Sprintf("%0*d", colLen, r*numCols+c))
+		}
+		rows[r] = row
+	}
+	const query = "select * from t"
+	db.AddQuery(query, &sqltypes.Result{Fields: fields, Rows: rows})
+
+	conn, err := dbconnpool.NewDBConnection(t.Context(), dbconfigs.New(db.ConnParams()))
+	require.NoError(t, err)
+	t.Cleanup(conn.Close)
+
+	defaults := tabletenv.NewDefaultConfig()
+	var streamed []*sqltypes.Result
+	err = conn.ExecuteStreamFetch(query, func(r *sqltypes.Result) error {
+		if len(r.Rows) > 0 {
+			streamed = append(streamed, r)
+		}
+		return nil
+	}, func() *sqltypes.Result { return &sqltypes.Result{} }, defaults.StreamBufferSize)
+	require.NoError(t, err)
+	require.NotEmpty(t, streamed)
+
+	exact := make([]*sqltypes.Result, len(streamed))
+	var accounted, actual int64
+	for i, r := range streamed {
+		exact[i] = exactCapacityCopy(r)
+		accounted += r.CachedSize(true)
+		actual += exact[i].CachedSize(true)
+	}
+
+	gotAdmitted, gotMemory := admittedToCatchup(streamed, defaults.ConsolidatorStreamQuerySize, defaults.ConsolidatorStreamTotalSize)
+	wantAdmitted, wantMemory := admittedToCatchup(exact, defaults.ConsolidatorStreamQuerySize, defaults.ConsolidatorStreamTotalSize)
+	t.Logf("%d results of %d rows x %d cols x %d bytes: CachedSize %d vs exact %d (%.1fx); catch-up admits %d results (%d bytes accounted) vs %d (%d bytes)",
+		len(streamed), numRows/len(streamed), numCols, colLen, accounted, actual, float64(accounted)/float64(actual),
+		gotAdmitted, gotMemory, wantAdmitted, wantMemory)
+
+	assert.Equal(t, actual, accounted, "the consolidator accounts streamed rows as larger than they are")
+	assert.Equal(t, wantAdmitted, gotAdmitted, "the catch-up buffer is abandoned early")
+}
