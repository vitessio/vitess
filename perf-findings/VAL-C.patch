diff --git a/perf-findings/VAL-C-scripts/repro4.sh b/perf-findings/VAL-C-scripts/repro4.sh
new file mode 100755
index 0000000000..354ccc0fba
--- /dev/null
+++ b/perf-findings/VAL-C-scripts/repro4.sh
@@ -0,0 +1,70 @@
+#!/bin/bash
+# VAL-C BUGS #4 repro: MoveTables copy with --vreplication-parallel-insert-workers on a non-UTC target.
+# Cluster: /home/vt/VAL-C/c.sh up (BASE 30000, keyspaces src:0 dstoff:0 dston:0 dstflag:0).
+# Usage: repro4.sh setup | mt <workflow> <target-ks> [extra MoveTables flags...] | compare <target-ks> | post
+set -uo pipefail
+C=/home/vt/VAL-C/c30000
+VC="/home/vt/VAL-C/c.sh vtctldclient"
+sock() { case $1 in src) echo $C/vt_0000000100/mysql.sock ;; dstoff) echo $C/vt_0000000101/mysql.sock ;;
+  dston) echo $C/vt_0000000102/mysql.sock ;; dstflag) echo $C/vt_0000000103/mysql.sock ;; esac; }
+q() { local ks=$1; shift; mysql -N -S "$(sock "$ks")" -u vt_dba "vt_$ks" -e "$*"; }
+
+setup() {
+  q src "SET time_zone='+00:00';
+    CREATE TABLE tz_t (
+      id INT NOT NULL PRIMARY KEY,
+      ts TIMESTAMP(6) NULL,
+      dt DATETIME(6) NULL,
+      l1 VARCHAR(32) CHARACTER SET latin1 NULL,
+      u8 VARCHAR(32) CHARACTER SET utf8mb4 NULL,
+      vb VARBINARY(32) NULL
+    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
+    INSERT INTO tz_t VALUES
+      (1, '2024-01-01 00:00:00', '2024-01-01 00:00:00', X'E9', X'68C3A96C6C6F20F09F9880', X'FF00E9'),
+      (2, '2024-06-15 12:34:56.123456', '2024-06-15 12:34:56.123456', X'C3A9', X'C3A9', X'C3A9'),
+      (3, '1970-01-01 05:30:00', '1970-01-01 05:30:00', 'plain ascii', 'plain ascii', 'plain'),
+      (4, '2038-01-19 03:14:07', '2038-01-19 03:14:07', X'E4F6FC', X'C3A4C3B6C3BC', X'E4F6FC');
+    INSERT INTO tz_t SELECT 100 + seq, '2024-03-10 01:02:03' + INTERVAL seq MINUTE, '2024-03-10 01:02:03' + INTERVAL seq MINUTE,
+      CONCAT('r', seq, X'E9'), CONCAT('r', seq), UNHEX(HEX(seq)) FROM
+      (WITH RECURSIVE s(seq) AS (SELECT 1 UNION ALL SELECT seq + 1 FROM s WHERE seq < 900) SELECT seq FROM s) x;"
+  $VC ReloadSchemaKeyspace src >/dev/null
+  for ks in dstoff dston dstflag; do q "$ks" "SET GLOBAL time_zone='+05:00'"; done
+  for ks in src dstoff dston dstflag; do echo "$ks global time_zone: $(q "$ks" 'select @@global.time_zone')"; done
+}
+
+mt() {
+  local wf=$1 ks=$2; shift 2
+  $VC MoveTables --workflow "$wf" --target-keyspace "$ks" create --source-keyspace src --tables tz_t "$@" || exit 1
+  for _ in $(seq 1 240); do
+    local n s
+    n=$(q "$ks" "select count(*) from _vt.copy_state")
+    s=$(q "$ks" "select state from _vt.vreplication where workflow='$wf'")
+    [[ $s == Error ]] && { q "$ks" "select message from _vt.vreplication where workflow='$wf'"; exit 1; }
+    [[ $n == 0 && $s == Running ]] && { echo "$wf -> $ks: copy done"; return 0; }
+    sleep 0.5
+  done
+  echo "timeout"; exit 1
+}
+
+rows() { q "$1" "SET time_zone='+00:00'; SELECT id, UNIX_TIMESTAMP(ts), ts, dt, HEX(l1), HEX(u8), HEX(vb) FROM tz_t ORDER BY id"; }
+
+compare() {
+  local ks=$1
+  echo "== $ks vs src: CHECKSUM TABLE src=$(q src 'checksum table tz_t' | cut -f2) $ks=$(q "$ks" 'checksum table tz_t' | cut -f2)"
+  diff <(rows src) <(rows "$ks") >/tmp/val-c-diff-$ks.txt
+  echo "differing rows: $(grep -c '^>' /tmp/val-c-diff-$ks.txt) of $(q src 'select count(*) from tz_t')"
+  echo "-- src (first 4 rows, session tz UTC): id unix_ts ts dt hex(l1) hex(u8) hex(vb)"
+  rows src | head -4
+  echo "-- $ks"
+  rows "$ks" | head -4
+}
+
+post() {
+  q src "SET time_zone='+00:00'; INSERT INTO tz_t VALUES (9999, '2024-01-01 00:00:00', '2024-01-01 00:00:00', X'E9', X'C3A9', X'E9')"
+  sleep 3
+  for ks in "$@"; do echo "$ks post-copy row: $(q "$ks" "SET time_zone='+00:00'; SELECT id, UNIX_TIMESTAMP(ts), HEX(l1) FROM tz_t WHERE id = 9999")"; done
