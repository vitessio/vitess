 	return false
 }
 
+// Validate returns whether p is a valid utf8mb3 string. This is equivalent to
+// decoding p with DecodeRune until it fails: utf8mb3 is exactly well-formed
+// UTF-8 (no overlong encodings, no surrogates) restricted to sequences of at
+// most 3 bytes. In well-formed UTF-8, a byte >= 0xF0 can only be the leading
+// byte of a 4-byte sequence, so it suffices to reject any such byte.
+func (Charset_utf8mb3) Validate(p []byte) bool {
+	return utf8.Valid(p) && !hasFourByteLead(p)
+}
+
+// Slice returns the runes of src in the range [from, to), with the same
+// semantics as the generic charset.Slice helper: slicing stops at the first
+// invalid sequence.
+func (Charset_utf8mb3) Slice(src []byte, from, to int) []byte {
+	return sliceUTF8(src, from, to, true)
+}
+
 func (Charset_utf8mb3) Length(src []byte) int {
-	return utf8.RuneCount(src)
+	return runeCount(src)
 }
 
 func (Charset_utf8mb3) MaxWidth() int {
@@ -219,10 +236,115 @@ func (Charset_utf8mb4) Validate(p []byte) bool {
 	return utf8.Valid(p)
 }
 
+// Slice returns the runes of src in the range [from, to), with the same
+// semantics as the generic charset.Slice helper: slicing stops at the first
+// invalid sequence.
+func (Charset_utf8mb4) Slice(src []byte, from, to int) []byte {
+	return sliceUTF8(src, from, to, false)
+}
+
 func (Charset_utf8mb4) Length(src []byte) int {
-	return utf8.RuneCount(src)
+	return runeCount(src)
 }
 
 func (Charset_utf8mb4) MaxWidth() int {
 	return 4
 }
+
+const highBits = 0x8080808080808080
+
+// hasFourByteLead returns whether p contains any byte >= 0xF0.
+func hasFourByteLead(p []byte) bool {
+	for len(p) >= 8 {
+		w := binary.LittleEndian.Uint64(p)
+		// The top bit of each byte is set iff its 4 top bits are all set.
+		if w&(w<<1)&(w<<2)&(w<<3)&highBits != 0 {
+			return true
+		}
+		p = p[8:]
+	}
+	for _, c := range p {
+		if c >= 0xF0 {
+			return true
+		}
+	}
+	return false
+}
+
+// asciiPrefixLen returns the number of leading ASCII bytes in p.
+func asciiPrefixLen(p []byte) int {
+	i := 0
+	for ; i+8 <= len(p); i += 8 {
+		if binary.LittleEndian.Uint64(p[i:])&highBits != 0 {
+			break
+		}
+	}
+	for i < len(p) && p[i] < utf8.RuneSelf {
+		i++
+	}
+	return i
+}
+
+// runeCount is equivalent to utf8.RuneCount, but it skips leading ASCII
+// bytes 8 at a time, and it does not allocate: utf8.RuneCount converts the
+// non-ASCII tail of its input to a string, which allocates for inputs
+// longer than 32 bytes.
+func runeCount(p []byte) int {
+	i := asciiPrefixLen(p)
+	n := i
+	for i < len(p) {
+		if p[i] < utf8.RuneSelf {
+			i++
+		} else {
+			_, size := utf8.DecodeRune(p[i:])
+			i += size
+		}
+		n++
+	}
+	return n
+}
+
+// sliceUTF8 implements Slice for utf8mb3 and utf8mb4. It must behave exactly
+// like the generic charset.Slice helper, which decodes at most `to` runes,
+// stops at the first invalid sequence, and returns the bytes of the runes
+// with index in [from, to) that were decoded successfully.
+func sliceUTF8(src []byte, from, to int, mb3 bool) []byte {
+	if to <= 0 {
+		return src[:0]
+	}
+	from = max(from, 0)
+
+	// Fast path: the leading ASCII bytes are one rune each.
+	end := asciiPrefixLen(src[:min(to, len(src))])
+	start := -1
+	if from <= end {
+		start = from
+	}
+
+	for n := end; n < to && end < len(src); n++ {
+		if n == from {
+			start = end
+		}
+		size := 1
+		if src[end] >= utf8.RuneSelf {
+			var ok bool
+			if mb3 {
+				_, size, ok = Charset_utf8mb3{}.DecodeRune(src[end:])
+			} else {
+				var r rune
+				r, size = utf8.DecodeRune(src[end:])
+				ok = r != utf8.RuneError || size > 1
+			}
+			if !ok {
+				break
+			}
+		}
+		end += size
+	}
+
+	if start < 0 {
+		// We stopped before reaching rune `from`.
+		start = end
+	}
+	return src[start:end]
+}
