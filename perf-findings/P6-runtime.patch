@@ -0,0 +1,29 @@
+#!/bin/bash
+# ab.sh ROUNDS MATRIXFILE CFG1 CFG2 ...: for each round and config: restart vtgate+vttablets with the config
+# (a file setting BIN / GATE_ENV / TABLET_ENV / VTGATE_EXTRA_FLAGS / VTTABLET_EXTRA_FLAGS), warm up, then run
+# every matrix line ("label-suffix loadgen-args...") through run.sh.
+set -u
+ROUNDS=$1; MATRIX=$2; shift 2
+D=/home/vt/perf/P6
+for r in $(seq 1 "$ROUNDS"); do
+  for cfg in "$@"; do
+    name=$(basename "$cfg" .cfg)
+    (
+      unset BIN GATE_ENV TABLET_ENV VTGATE_EXTRA_FLAGS VTTABLET_EXTRA_FLAGS
+      # shellcheck disable=SC1090
+      source "$cfg"
+      export BIN GATE_ENV TABLET_ENV VTGATE_EXTRA_FLAGS VTTABLET_EXTRA_FLAGS
+      $D/c.sh restart >/dev/null 2>&1
+    )
+    # shellcheck disable=SC1090
+    LG_ARGS=$(unset LG_ARGS; source "$cfg"; echo "${LG_ARGS:-}")
+    bash $D/purge.sh
+    # shellcheck disable=SC2086
+    $D/loadgen -conns 16 -rate 0 -duration 4s -warmup 0s $LG_ARGS >/dev/null 2>&1
+    while read -r lab args; do
+      [[ -z ${lab:-} || $lab == \#* ]] && continue
+      # shellcheck disable=SC2086
+      $D/run.sh "r$r-$name-$lab" $args $LG_ARGS
+    done <"$MATRIX"
+  done
+done
diff --git a/perf-findings/harness/P6-agg.py b/perf-findings/harness/P6-agg.py
new file mode 100644
index 0000000..5b4d033
--- /dev/null
+++ b/perf-findings/harness/P6-agg.py
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""agg.py FILE [FIELD...]: average run.sh lines by "<config>-<label>" (the r<N>- prefix is dropped).
+Prints n, the mean of each field and, for CPU fields, [min-max]."""
+import os
+import re
+import sys
+from collections import OrderedDict
+
+DEFAULT = ["qps", "lat_avg", "lat_p50", "lat_p99", "lat_p999", "svc_p99", "svc_p999", "gate_us", "tab_us", "my_us",
+           "gate_gc", "gate_pause_max", "mid_gate_rss", "mid_gate_stack", "mid_gate_heap", "load"]
+fields = sys.argv[2:] or DEFAULT
+MEDIAN = os.environ.get("MEDIAN") == "1"  # median instead of mean
+groups = OrderedDict()
+for line in open(sys.argv[1]):
+    toks = line.split()
+    if not toks or not re.match(r"r\d+-", toks[0]):
+        continue
+    key = toks[0].split("-", 1)[1]
+    kv = {}
+    for t in toks[1:]:
+        if "=" in t:
+            k, v = t.split("=", 1)
+            m = re.match(r"^-?[0-9.]+", v)
+            if m:
+                kv[k] = float(m.group(0))
+    groups.setdefault(key, []).append(kv)
+
+print("| config-label | n | " + " | ".join(fields) + " |")
+print("|" + "---|" * (len(fields) + 2))
+for key, rows in groups.items():
+    cells = []
+    for f in fields:
+        vals = [r[f] for r in rows if f in r]
+        if not vals:
+            cells.append("-")
+            continue
+        if MEDIAN:
+            sv = sorted(vals)
+            mean = sv[len(sv) // 2] if len(sv) % 2 else (sv[len(sv) // 2 - 1] + sv[len(sv) // 2]) / 2
+        else:
+            mean = sum(vals) / len(vals)
+        fmt = "{:.0f}" if mean >= 100 else ("{:.2f}" if mean < 10 else "{:.1f}")
+        s = fmt.format(mean)
+        if f.endswith("_us") and len(vals) > 1:
+            s += " [" + fmt.format(min(vals)) + "-" + fmt.format(max(vals)) + "]"
+        cells.append(s)
+    print(f"| {key} | {len(rows)} | " + " | ".join(cells) + " |")
