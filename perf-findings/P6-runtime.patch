@@ -237,3 +237,43 @@ func TestWatcherShouldOnlyNotifyOnActualChanges(t *testing.T) {
 		return callCount.Load() > callsAfterSameUpdate
 	}, 1*time.Second, 10*time.Millisecond)
 }
+
+// TestGetValueWhileRunningDoesNotTakeEntryLock verifies that reading the value of a running watch does not
+// wait for the entry's mutex. getValue runs for every query (GetSrvKeyspace), so waiting on the mutex of the
+// keyspace's entry serialized all the queries of a keyspace.
+func TestGetValueWhileRunningDoesNotTakeEntryLock(t *testing.T) {
+	counts := stats.NewCountersWithSingleLabel("", "running watch test", "type")
+	rw := &resilientWatcher{
+		counts:  counts,
+		entries: make(map[string]*watchEntry),
+	}
+	key := &srvKeyspaceKey{"cell", "ks"}
+	entry := rw.getEntry(key)
+
+	entry.mutex.Lock()
+	entry.onValueLocked("value")
+
+	done := make(chan any, 1)
+	go func() {
+		v, err := rw.getValue(t.Context(), key)
+		assert.NoError(t, err)
+		done <- v
+	}()
+	var got any
+	assert.Eventually(t, func() bool {
+		select {
+		case got = <-done:
+			return true
+		default:
+			return false
+		}
+	}, 30*time.Second, 10*time.Millisecond)
+	entry.mutex.Unlock()
+	assert.Equal(t, "value", got)
+
+	// After an error the watch is no longer running, and getValue takes the locked path again.
+	entry.mutex.Lock()
+	entry.onErrorLocked(t.Context(), errors.New("watch failed"), false)
+	entry.mutex.Unlock()
+	assert.Nil(t, entry.running.Load())
+}
