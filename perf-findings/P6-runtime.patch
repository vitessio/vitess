+#!/bin/bash
+# idle.sh ROUNDS SECONDS CFG...: restart with each config, let it settle, then report idle CPU (ms per second)
+# per process over SECONDS.
+set -u
+R=$1; S=$2; shift 2
+D=/home/vt/perf/P6
+for r in $(seq 1 "$R"); do
+  for cfg in "$@"; do
+    name=$(basename "$cfg" .cfg)
+    (
+      unset BIN GATE_ENV TABLET_ENV VTGATE_EXTRA_FLAGS VTTABLET_EXTRA_FLAGS
+      # shellcheck disable=SC1090
+      source "$cfg"
+      export BIN GATE_ENV TABLET_ENV VTGATE_EXTRA_FLAGS VTTABLET_EXTRA_FLAGS
+      $D/c.sh restart >/dev/null 2>&1
+    )
+    sleep 15
+    a=$($D/c.sh cpu)
+    sleep "$S"
+    b=$($D/c.sh cpu)
+    echo "r$r-$name $(paste <(echo "$a") <(echo "$b") | awk -v s="$S" '{printf "%s=%.2f ", $1, ($4-$2)*1000/s}') load=$(cut -d' ' -f1 /proc/loadavg)"
+  done
+done
diff --git a/perf-findings/harness/P6-loadgen/main.go b/perf-findings/harness/P6-loadgen/main.go
