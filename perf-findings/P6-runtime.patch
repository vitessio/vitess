diff --git a/perf-findings/P6-goyacc-noinline.patch b/perf-findings/P6-goyacc-noinline.patch
new file mode 100644
index 0000000..1d89f93
--- /dev/null
+++ b/perf-findings/P6-goyacc-noinline.patch
@@ -0,0 +1,24 @@
+Patch for github.com/vitessio/goyacc (the generator of go/vt/sqlparser/sql.go), version
+v0.0.0-20260327210057-9f3cb834a13f. It makes the generator emit the same //go:noinline directive that
+this change adds to the checked-in go/vt/sqlparser/sql.go, so that `make parser` keeps it.
+
+Each inlined yySymType getter (yyDollar[i].expr(), ...) gets its own spill slot in the frame of
+(*yyParserImpl).Parse, one per call site: the frame was 22,928 bytes (locals=0x5990), so every goroutine
+that parses a query grows its stack to 32 KiB. With the getters not inlined the frame is 5,928 bytes and a
+parse fits in a new goroutine's 8 KiB stack. Parse throughput is unchanged (BenchmarkParseStress,
+BenchmarkParseTraces/django within +-3%).
+
+--- a/goyacc.go
++++ b/goyacc.go
+@@ -1191,7 +1191,10 @@
+ 		tt := gotypes[member]
+
+ 		// Getter: read from uintptr data via unsafe cast.
+-		fmt.Fprintf(ftable, "\nfunc (st *%sSymType) %s() %s {\n", prefix, member, tt.typename)
++		// Not inlined: every inlined call site gets its own spill slot in the frame of Parse, which
++		// then needs a 32 KiB goroutine stack.
++		fmt.Fprintf(ftable, "\n//go:noinline\n")
++		fmt.Fprintf(ftable, "func (st *%sSymType) %s() %s {\n", prefix, member, tt.typename)
+ 		fmt.Fprintf(ftable, "\treturn *(*%s)(__yyunsafe__.Pointer(&st.data))\n", tt.typename)
+ 		fmt.Fprintf(ftable, "}\n")
+
