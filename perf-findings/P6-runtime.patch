+#!/bin/bash
+# mprof.sh PREFIX SECONDS [loadgen args...]: run loadgen and, from 4 s in, collect CPU, mutex and block profiles
+# (vtgate and vttablet 0) for SECONDS. Enables mutex (fraction 10) and block (rate 10 us) profiling first.
+set -u
+P=$1; S=$2; shift 2
+D=/home/vt/perf/P6
+for port in 30001 30100; do
+  curl -s "localhost:$port/debug/mutexprofilefraction?fraction=10" >/dev/null
+  curl -s "localhost:$port/debug/blockprofilerate?rate=10000" >/dev/null
+done
+$D/loadgen -label "$P" "$@" > "$D/$P.loadgen.txt" 2>&1 &
+lg=$!
+sleep 4
+for port in 30001 30100; do
+  curl -s -o "$D/$P-$port-mutex0.pprof" "localhost:$port/debug/pprof/mutex"
+  curl -s -o "$D/$P-$port-block0.pprof" "localhost:$port/debug/pprof/block"
+done
+curl -s -o "$D/$P-30001-cpu.pprof" "localhost:30001/debug/pprof/profile?seconds=$S" &
+c1=$!
+curl -s -o "$D/$P-30100-cpu.pprof" "localhost:30100/debug/pprof/profile?seconds=$S" &
+c2=$!
+wait $c1 $c2
+for port in 30001 30100; do
+  curl -s -o "$D/$P-$port-mutex1.pprof" "localhost:$port/debug/pprof/mutex"
+  curl -s -o "$D/$P-$port-block1.pprof" "localhost:$port/debug/pprof/block"
+  curl -s -o "$D/$P-$port-goroutine.txt" "localhost:$port/debug/pprof/goroutine?debug=1"
+  curl -s "localhost:$port/debug/mutexprofilefraction?fraction=0" >/dev/null
+  curl -s "localhost:$port/debug/blockprofilerate?rate=0" >/dev/null
+done
+wait $lg
+cat "$D/$P.loadgen.txt"
diff --git a/perf-findings/harness/P6-run.sh b/perf-findings/harness/P6-run.sh
new file mode 100755
index 0000000..24917d5
--- /dev/null
+++ b/perf-findings/harness/P6-run.sh
@@ -0,0 +1,18 @@
+#!/bin/bash
+# run.sh LABEL [loadgen args...]: one measured loadgen run against the P6 cluster plus the stats diff. One line out.
+# CPU per query is computed over the whole run (warm-up included) using n_all. MID=seconds: when to take the
+# mid-run memory/goroutine snapshot (default 10).
+set -u
+LABEL=$1; shift
+D=/home/vt/perf/P6
+A=$(mktemp); B=$(mktemp); M=$(mktemp)
+$D/st.py snap > "$A"
+( sleep "${MID:-10}"; $D/st.py mid > "$M" ) &
+mp=$!
+out=$($D/loadgen -label "$LABEL" "$@" 2>/tmp/p6lg.err)
+wait $mp
+$D/st.py snap > "$B"
+n=$(echo "$out" | sed -n 's/.* n_all=\([0-9]*\).*/\1/p')
+st=$($D/st.py diff "$A" "$B" "${n:-1}")
+echo "$out $st $(cat "$M") load=$(cut -d' ' -f1 /proc/loadavg)"
+rm -f "$A" "$B" "$M"
diff --git a/perf-findings/harness/P6-st.py b/perf-findings/harness/P6-st.py
new file mode 100755
index 0000000..3869b1d
--- /dev/null
+++ b/perf-findings/harness/P6-st.py
@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""st.py snap > file | st.py diff before after QUERIES
+Snapshot of runtime stats of the P6 cluster (BASE 30000): CPU (from /proc), RSS, Go memstats, goroutines,
+GC count/pause, vttablet pool waits, vtgate plan cache. diff prints per-query CPU and deltas."""
+import json, sys, os, re, urllib.request
+
+BASE = int(os.environ.get("BASE", "30000"))
+ROOT = f"/home/vt/perf/c{BASE}"
+TCK = os.sysconf("SC_CLK_TCK")
+
+
+def get(port, path="/debug/vars"):
+    try:
+        with urllib.request.urlopen(f"http://localhost:{port}{path}", timeout=5) as r:
+            return r.read()
+    except Exception:
+        return b""
+
+
+def pids():
+    out = {}
+    try:
+        out["vtgate"] = (int(open(f"{ROOT}/vtgate.pid").read()), BASE + 1)
+    except Exception:
+        pass
+    for i, uid in enumerate((100, 101)):
+        d = f"{ROOT}/vt_{uid:010d}"
+        try:
+            out[f"vttablet{i}"] = (int(open(f"{d}/vttablet.pid").read()), BASE + 100 + i)
+        except Exception:
+            pass
+        try:
+            out[f"mysqld{i}"] = (int(open(f"{d}/mysql.pid").read()), None)
+        except Exception:
+            pass
+    return out
+
+
+def proc(pid):
+    s = open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()
+    cpu = (int(s[11]) + int(s[12])) / TCK
+    rss = 0
+    for l in open(f"/proc/{pid}/status"):
+        if l.startswith("VmRSS:"):
+            rss = int(l.split()[1]) * 1024
+    return cpu, rss
+
+
+def snap():
+    out = {}
+    for name, (pid, port) in pids().items():
+        try:
+            cpu, rss = proc(pid)
+        except Exception:
+            continue
+        e = {"cpu": cpu, "rss": rss}
+        if port:
+            try:
+                v = json.loads(get(port))
+            except Exception:
+                v = {}
+            m = v.get("memstats", {})
+            for k in ("NumGC", "PauseTotalNs", "HeapInuse", "HeapAlloc", "StackInuse", "Sys", "TotalAlloc", "Mallocs"):
+                e[k] = m.get(k, 0)
+            e["pauses"] = m.get("PauseNs", [])
+            g = get(port, "/debug/pprof/goroutine?debug=1")[:100].decode(errors="ignore")
+            mm = re.search(r"total (\d+)", g)
+            e["goroutines"] = int(mm.group(1)) if mm else -1
+            if name == "vtgate":
+                for k in ("QueryPlanCacheHits", "QueryPlanCacheMisses", "QueryPlanCacheLength", "QueryPlanCacheSize",
+                          "QueryPlanCacheEvictions", "MysqlServerConnAccepted"):
+                    e[k] = v.get(k, 0)
+            else:
+                for k in ("ConnPoolWaitCount", "ConnPoolWaitTime", "ConnPoolGet", "QueryEnginePlanCacheHits", "QueryEnginePlanCacheMisses",
+                          "QueryEnginePlanCacheLength"):
+                    e[k] = v.get(k, 0)
+        out[name] = e
+    json.dump(out, sys.stdout)
+
+
+def diff(a, b, q):
+    a, b = json.load(open(a)), json.load(open(b))
+    q = max(q, 1)
+    parts = []
+
+    def d(n, k):
+        return b.get(n, {}).get(k, 0) - a.get(n, {}).get(k, 0)
+
+    g = d("vtgate", "cpu") * 1e6 / q
+    t = (d("vttablet0", "cpu") + d("vttablet1", "cpu")) * 1e6 / q
+    m = (d("mysqld0", "cpu") + d("mysqld1", "cpu")) * 1e6 / q
+    parts.append(f"gate_us={g:.0f} tab_us={t:.0f} my_us={m:.0f}")
+    vg = b.get("vtgate", {})
+    ngc = d("vtgate", "NumGC")
+    pt = d("vtgate", "PauseTotalNs")
+    maxp = 0
+    if ngc > 0 and vg.get("pauses"):
+        n2 = vg["NumGC"]
+        ring = vg["pauses"]
+        for i in range(max(n2 - min(ngc, 256), 0), n2):
+            maxp = max(maxp, ring[(i + 255) % 256])
+    parts.append(f"gate_gc={ngc} gate_pause_avg={pt / max(ngc, 1) / 1e3:.0f}us gate_pause_max={maxp / 1e3:.0f}us "
+                 f"gate_alloc/q={d('vtgate', 'TotalAlloc') / q:.0f}B")
+    tgc = d("vttablet0", "NumGC") + d("vttablet1", "NumGC")
+    parts.append(f"tab_gc={tgc} tab_alloc/q={(d('vttablet0', 'TotalAlloc') + d('vttablet1', 'TotalAlloc')) / q:.0f}B")
+    parts.append(f"gate_rss={vg.get('rss', 0) / 2**20:.0f}M gate_heap={vg.get('HeapInuse', 0) / 2**20:.0f}M "
+                 f"gate_stack={vg.get('StackInuse', 0) / 2**20:.1f}M gate_gor={vg.get('goroutines', 0)}")
+    tb = b.get("vttablet0", {})
+    parts.append(f"tab0_rss={tb.get('rss', 0) / 2**20:.0f}M tab0_gor={tb.get('goroutines', 0)}")
+    wc = d("vttablet0", "ConnPoolWaitCount") + d("vttablet1", "ConnPoolWaitCount")
+    wt = d("vttablet0", "ConnPoolWaitTime") + d("vttablet1", "ConnPoolWaitTime")
+    parts.append(f"poolwait={wc} poolwait_avg={wt / max(wc, 1) / 1e6:.2f}ms")
+    h = d("vtgate", "QueryPlanCacheHits")
+    mi = d("vtgate", "QueryPlanCacheMisses")
+    parts.append(f"plan_hit={h / max(h + mi, 1) * 100:.1f}% plan_miss={mi} plan_len={vg.get('QueryPlanCacheLength', 0)} "
+                 f"plan_size={vg.get('QueryPlanCacheSize', 0) / 2**20:.1f}M plan_evict={d('vtgate', 'QueryPlanCacheEvictions')}")
+    th = d("vttablet0", "QueryEnginePlanCacheHits") + d("vttablet1", "QueryEnginePlanCacheHits")
+    tm = d("vttablet0", "QueryEnginePlanCacheMisses") + d("vttablet1", "QueryEnginePlanCacheMisses")
+    parts.append(f"tplan_hit={th / max(th + tm, 1) * 100:.1f}% tplan_len={tb.get('QueryEnginePlanCacheLength', 0)}")
+    print(" ".join(parts))
+
+
+def mid():
+    """one-line snapshot of vtgate/vttablet0 memory and goroutines while a run is in progress"""
+    out = []
+    for name, (pid, port) in pids().items():
+        if not port or name == "vttablet1":
+            continue
+        cpu, rss = proc(pid)
+        try:
+            m = json.loads(get(port)).get("memstats", {})
+        except Exception:
+            m = {}
+        g = get(port, "/debug/pprof/goroutine?debug=1")[:100].decode(errors="ignore")
+        mm = re.search(r"total (\d+)", g)
+        short = "gate" if name == "vtgate" else "tab0"
+        out.append(f"mid_{short}_rss={rss / 2**20:.0f}M mid_{short}_heap={m.get('HeapInuse', 0) / 2**20:.0f}M "
+                   f"mid_{short}_stack={m.get('StackInuse', 0) / 2**20:.1f}M mid_{short}_gor={mm.group(1) if mm else -1}")
+    print(" ".join(out))
+
+
+if sys.argv[1] == "snap":
+    snap()
+elif sys.argv[1] == "mid":
+    mid()
+else:
+    diff(sys.argv[2], sys.argv[3], int(sys.argv[4]))
diff --git a/perf-findings/harness/P6-strace1.sh b/perf-findings/harness/P6-strace1.sh
new file mode 100644
index 0000000..3af89ee
--- /dev/null
+++ b/perf-findings/harness/P6-strace1.sh
@@ -0,0 +1,11 @@
+#!/bin/bash
+# strace1.sh OUT [loadgen args]: strace vtgate network syscalls while loadgen runs briefly
+OUT=$1; shift
+PID=$(cat /home/vt/perf/c30000/vtgate.pid)
+strace -f -tt -e trace=read,write,accept4,close,setsockopt,getsockname,getpeername,epoll_ctl,futex -p "$PID" -o "$OUT" &
+SP=$!
+sleep 1
+/home/vt/perf/P6/loadgen "$@"
+sleep 0.5
+kill "$SP"
+wait
diff --git a/perf-findings/harness/P6-stracec.sh b/perf-findings/harness/P6-stracec.sh
new file mode 100644
index 0000000..6009927
--- /dev/null
+++ b/perf-findings/harness/P6-stracec.sh
@@ -0,0 +1,5 @@
+#!/bin/bash
+# stracec.sh PIDFILE SECONDS OUT: syscall summary (strace -c -f) of a process for SECONDS
+PID=$(cat "$1")
+timeout -s INT "$2" strace -c -f -p "$PID" -o "$3" >/dev/null 2>&1
+cat "$3"
