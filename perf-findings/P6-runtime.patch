index 0000000..6037dd0
--- /dev/null
+++ b/perf-findings/harness/P6-loadgen/main.go
@@ -0,0 +1,331 @@
+// Command P6-loadgen is an open-loop MySQL load generator used by the P6 runtime investigation.
+//
+// It runs a fixed total query rate (-rate) over a fixed number of client connections (-conns) and reports
+// latency percentiles measured from the scheduled start of each query (so queueing in the client is
+// included and coordinated omission is avoided), plus the pure service time. With -churn K every
+// "session" opens a new connection, runs K queries and closes it; connect time and time-to-first-query
+// are then reported too.
+//
+// Workloads (-mode):
+//
+//	point   SELECT c FROM sbtest<1..T> WHERE id=?
+//	shapes  SELECT c AS a<i> FROM sbtest1 WHERE id=?, i uniform in [0, -shapes): N distinct normalized queries
+//	inlist  SELECT c FROM sbtest1 WHERE id IN (?,...), list length uniform in [1, -inmax]
+//	range   SELECT c FROM sbtest1 WHERE id BETWEEN ? AND ?+(-rows-1) (larger results)
+//
+// -ps prepares statements once per connection (server-side prepared statements); otherwise the driver
+// interpolates parameters and sends text queries.
+package main
+
+import (
+	"context"
+	"crypto/tls"
+	"database/sql"
+	"flag"
+	"fmt"
+	"math/rand/v2"
+	"os"
+	"slices"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/go-sql-driver/mysql"
+)
+
+var (
+	addr     = flag.String("addr", "127.0.0.1:30003", "vtgate mysql address")
+	user     = flag.String("user", "root", "user")
+	pass     = flag.String("pass", "", "password")
+	dbName   = flag.String("db", "sbtest", "database")
+	tlsMode  = flag.String("tls", "", "tls mode for the driver: skip-verify, or resume (skip-verify plus a client session cache, so reconnects resume the TLS session)")
+	conns    = flag.Int("conns", 8, "number of concurrent client connections (workers)")
+	rate     = flag.Float64("rate", 1000, "total queries per second (open loop); 0 = closed loop")
+	duration = flag.Duration("duration", 20*time.Second, "run duration")
+	warmup   = flag.Duration("warmup", 2*time.Second, "warm-up (not measured)")
+	mode     = flag.String("mode", "point", "point|shapes|inlist|range")
+	ps       = flag.Bool("ps", false, "use server-side prepared statements (prepared once per connection)")
+	churn    = flag.Int("churn", 0, "if >0, reconnect after this many queries (new connection per session)")
+	tables   = flag.Int("tables", 4, "number of sbtest tables")
+	tsize    = flag.Int("table-size", 100000, "rows per table")
+	nshapes  = flag.Int("shapes", 1000, "number of distinct query shapes for -mode shapes")
+	inmax    = flag.Int("inmax", 50, "max IN-list length for -mode inlist")
+	rows     = flag.Int("rows", 100, "rows per query for -mode range")
+	label    = flag.String("label", "run", "label printed with the results")
+	qualify  = flag.String("qualify", "", "if set, qualify table names with this database (use with -db '')")
+)
+
+type sample struct {
+	sched   time.Duration // from scheduled start to completion
+	service time.Duration // from actual start to completion
+}
+
+type worker struct {
+	lat      []sample
+	all      int             // completed queries including warm-up
+	connect  []time.Duration // connect (dial + handshake) time per session
+	ttfq     []time.Duration // connect + first query
+	errs     int
+	lastErr  error
+	sessions int
+}
+
+func dsn() string {
+	cfg := mysql.NewConfig()
+	cfg.User = *user
+	cfg.Passwd = *pass
+	cfg.Net = "tcp"
+	cfg.Addr = *addr
+	cfg.DBName = *dbName
+	cfg.InterpolateParams = !*ps
+	cfg.AllowNativePasswords = true
+	cfg.AllowCleartextPasswords = true
+	if *tlsMode != "" {
+		cfg.TLSConfig = *tlsMode
+	}
+	return cfg.FormatDSN()
+}
+
+func qual() string {
+	if *qualify == "" {
+		return ""
+	}
+	return *qualify + "."
+}
+
+func query(r *rand.Rand) (string, []any) {
+	switch *mode {
+	case "point":
+		return fmt.Sprintf("SELECT c FROM %ssbtest%d WHERE id=?", qual(), 1+r.IntN(*tables)), []any{1 + r.IntN(*tsize)}
+	case "shapes":
+		return fmt.Sprintf("SELECT c AS a%d FROM sbtest1 WHERE id=?", r.IntN(*nshapes)), []any{1 + r.IntN(*tsize)}
+	case "inlist":
+		n := 1 + r.IntN(*inmax)
+		args := make([]any, n)
+		for i := range args {
+			args[i] = 1 + r.IntN(*tsize)
+		}
+		return "SELECT c FROM sbtest1 WHERE id IN (" + strings.Repeat("?,", n-1) + "?)", args
+	case "range":
+		start := 1 + r.IntN(*tsize-*rows)
+		return "SELECT id, k, c, pad FROM sbtest1 WHERE id BETWEEN ? AND ?", []any{start, start + *rows - 1}
+	}
+	panic("unknown mode " + *mode)
+}
+
+type session struct {
+	conn  *sql.Conn
+	stmts map[string]*sql.Stmt
+}
+
+func (s *session) close() {
+	for _, st := range s.stmts {
+		st.Close()
+	}
+	s.conn.Close()
+}
+
+func (s *session) run(ctx context.Context, r *rand.Rand) error {
+	q, args := query(r)
+	var rs *sql.Rows
+	var err error
+	if *ps {
+		st := s.stmts[q]
+		if st == nil {
+			st, err = s.conn.PrepareContext(ctx, q)
+			if err != nil {
+				return err
+			}
+			s.stmts[q] = st
+		}
+		rs, err = st.QueryContext(ctx, args...)
+	} else {
+		rs, err = s.conn.QueryContext(ctx, q, args...)
+	}
+	if err != nil {
+		return err
+	}
+	for rs.Next() {
+	}
+	rs.Close()
+	return rs.Err()
+}
+
+func main() {
+	flag.Parse()
+	if *tlsMode == "resume" {
+		if err := mysql.RegisterTLSConfig("resume", &tls.Config{
+			InsecureSkipVerify: true,
+			ClientSessionCache: tls.NewLRUClientSessionCache(1024),
+		}); err != nil {
+			panic(err)
+		}
+	}
+	db, err := sql.Open("mysql", dsn())
+	if err != nil {
+		panic(err)
+	}
+	db.SetMaxOpenConns(*conns)
+	if *churn > 0 {
+		db.SetMaxIdleConns(0) // every released connection is closed: a new connection per session
+	} else {
+		db.SetMaxIdleConns(*conns)
+	}
+	db.SetConnMaxLifetime(0)
+
+	ctx := context.Background()
+	total := *warmup + *duration
+	start := time.Now().Add(200 * time.Millisecond)
+	measureFrom := start.Add(*warmup)
+	end := start.Add(total)
+
+	// Open-loop dispatcher: one scheduled start time per query, handed to whichever worker is free.
+	ticks := make(chan time.Time, 1<<20)
+	if *rate > 0 {
+		go func() {
+			interval := time.Duration(float64(time.Second) / *rate)
+			r := rand.New(rand.NewPCG(1, 2))
+			next := start
+			for next.Before(end) {
+				if d := time.Until(next); d > 0 {
+					time.Sleep(d)
+				}
+				// Emit every tick that is due (the sleep may overshoot).
+				now := time.Now()
+				for !next.After(now) && next.Before(end) {
+					ticks <- next
+					// Poisson arrivals.
+					next = next.Add(time.Duration(r.ExpFloat64() * float64(interval)))
+				}
+			}
+			close(ticks)
+		}()
+	}
+
+	var ws []*worker
+	var wg sync.WaitGroup
+	var inflight atomic.Int64
+	for i := 0; i < *conns; i++ {
+		w := &worker{}
+		ws = append(ws, w)
+		wg.Add(1)
+		go func(id int) {
+			defer wg.Done()
+			r := rand.New(rand.NewPCG(uint64(id), 7))
+			var s *session
+			left := 0
+			for {
+				var sched time.Time
+				if *rate > 0 {
+					t, ok := <-ticks
+					if !ok {
+						break
+					}
+					sched = t
+				} else {
+					sched = time.Now()
+					if sched.After(end) {
+						break
+					}
+				}
+				measured := sched.After(measureFrom)
+				began := time.Now()
+				var ttfqStart time.Time
+				if s == nil {
+					c, err := db.Conn(ctx)
+					if err != nil {
+						w.errs++
+						w.lastErr = err
+						continue
+					}
+					if measured {
+						w.connect = append(w.connect, time.Since(began))
+					}
+					ttfqStart = began
+					s = &session{conn: c, stmts: map[string]*sql.Stmt{}}
+					left = *churn
+					w.sessions++
+				}
+				qStart := time.Now()
+				inflight.Add(1)
+				err := s.run(ctx, r)
+				inflight.Add(-1)
+				done := time.Now()
+				if err != nil {
+					w.errs++
+					w.lastErr = err
+					s.close()
+					s = nil
+					continue
+				}
+				w.all++
+				if measured {
+					w.lat = append(w.lat, sample{sched: done.Sub(sched), service: done.Sub(qStart)})
+					if !ttfqStart.IsZero() {
+						w.ttfq = append(w.ttfq, done.Sub(ttfqStart))
+					}
+				}
+				if *churn > 0 {
+					left--
+					if left == 0 {
+						s.close()
+						s = nil
+					}
+				}
+			}
+			if s != nil {
+				s.close()
+			}
+		}(i)
+	}
+	wg.Wait()
+
+	var sched, service, connect, ttfq []time.Duration
+	errs, all := 0, 0
+	var lastErr error
+	for _, w := range ws {
+		all += w.all
+		for _, s := range w.lat {
+			sched = append(sched, s.sched)
+			service = append(service, s.service)
+		}
+		connect = append(connect, w.connect...)
+		ttfq = append(ttfq, w.ttfq...)
+		errs += w.errs
+		if w.lastErr != nil {
+			lastErr = w.lastErr
+		}
+	}
+	elapsed := end.Sub(measureFrom).Seconds()
+	fmt.Printf("%s mode=%s ps=%v conns=%d rate=%.0f churn=%d n_all=%d n=%d qps=%.0f errs=%d %s %s",
+		*label, *mode, *ps, *conns, *rate, *churn, all, len(sched), float64(len(sched))/elapsed, errs,
+		pcts("lat", sched), pcts("svc", service))
+	if *churn > 0 {
+		fmt.Printf(" %s %s", pcts("conn", connect), pcts("ttfq", ttfq))
+	}
+	fmt.Println()
+	if lastErr != nil {
+		fmt.Fprintln(os.Stderr, "last error:", lastErr)
+	}
+}
+
+func pcts(name string, d []time.Duration) string {
+	if len(d) == 0 {
+		return name + "=none"
+	}
+	slices.Sort(d)
+	p := func(q float64) float64 {
+		i := int(q * float64(len(d)))
+		if i >= len(d) {
+			i = len(d) - 1
+		}
+		return float64(d[i]) / 1e6
+	}
+	var sum time.Duration
+	for _, x := range d {
+		sum += x
+	}
+	return fmt.Sprintf("%s_avg=%.3f %s_p50=%.3f %s_p99=%.3f %s_p999=%.3f %s_max=%.3f",
+		name, float64(sum)/float64(len(d))/1e6, name, p(0.5), name, p(0.99), name, p(0.999), name, float64(d[len(d)-1])/1e6)
+}
