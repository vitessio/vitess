+#!/bin/bash
+# Background write load on src: ~RATE single-row inserts per second into `other` (not in any workflow) for SECS seconds.
+S=/home/vt/perf/c30000/vt_0000000100/mysql.sock
+RATE=${RATE:-50}
+SECS=${SECS:-120}
+TABLE=${TABLE:-other}
+python3 -c "
+import sys
+rate, secs, table = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
