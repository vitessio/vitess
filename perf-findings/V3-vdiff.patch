+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package vdiff
+
+import (
+	"context"
+
+	"vitess.io/vitess/go/sqltypes"
+	"vitess.io/vitess/go/vt/vterrors"
+	"vitess.io/vitess/go/vt/vtgate/evalengine"
+)
+
+// rowIterator returns the rows of one side of a table diff in primary key
+// order. next returns a nil row, and a nil error, once all rows were returned.
+type rowIterator interface {
+	next() ([]sqltypes.Value, error)
+}
+
+var (
+	_ rowIterator = (*primitiveExecutor)(nil)
+	_ rowIterator = (*shardRowIterator)(nil)
+	_ rowIterator = (*mergeRowIterator)(nil)
+)
+
+// newShardsRowIterator returns a rowIterator that reads the batches of rows
+// sent by the given shard streamers, which each return their rows in primary
+// key order, directly in the calling goroutine. With one streamer the rows
+// are returned as they are, otherwise they are merged using orderBy.
+//
+// Unlike an engine.MergeSort executed through a primitiveExecutor, this does
+// not pass every row through two channels and two more goroutines, which cost
+// more than the comparison of the row itself.
+func newShardsRowIterator(ctx context.Context, streamers []*shardStreamer, orderBy evalengine.Comparison) rowIterator {
+	shards := make([]*shardRowIterator, len(streamers))
+	for i, streamer := range streamers {
+		shards[i] = &shardRowIterator{ctx: ctx, streamer: streamer}
+	}
+	if len(shards) == 1 {
+		return shards[0]
+	}
+	return &mergeRowIterator{shards: shards, merger: &evalengine.Merger{Compare: orderBy}}
+}
+
+// shardRowIterator returns the rows of one shard streamer.
+type shardRowIterator struct {
+	ctx      context.Context
+	streamer *shardStreamer
+	rows     [][]sqltypes.Value
+}
+
+func (it *shardRowIterator) next() ([]sqltypes.Value, error) {
+	for len(it.rows) == 0 {
+		select {
+		case qr, ok := <-it.streamer.result:
+			if !ok {
+				// The streamer sets its error before it closes the channel.
+				return nil, it.streamer.err
+			}
+			it.rows = qr.Rows
+		case <-it.ctx.Done():
+			return nil, vterrors.Wrap(it.ctx.Err(), "row stream")
+		}
+	}
+	row := it.rows[0]
+	it.rows = it.rows[1:]
+	return row, nil
+}
+
+// mergeRowIterator merges the rows of several shards, each in primary key
+// order, into one stream in primary key order.
+type mergeRowIterator struct {
+	shards []*shardRowIterator
+	merger *evalengine.Merger
+	primed bool
+}
+
+func (it *mergeRowIterator) next() (row []sqltypes.Value, err error) {
+	// The comparison panics on errors, like it does for engine.MergeSort.
+	defer evalengine.PanicHandler(&err)
+	m := it.merger
+	if !it.primed {
+		it.primed = true
+		for i, shard := range it.shards {
+			r, err := shard.next()
+			if err != nil {
+				return nil, err
+			}
+			if r != nil {
+				m.Push(r, i)
+			}
+		}
+		m.Init()
+	} else if m.Len() > 0 {
+		// Replace the row returned last time with the next row of its shard.
+		_, i := m.Peek()
+		r, err := it.shards[i].next()
+		if err != nil {
+			return nil, err
+		}
+		if r == nil {
+			m.Pop()
+		} else {
+			m.ReplaceMin(r, i)
+		}
+	}
+	if m.Len() == 0 {
+		return nil, nil
+	}
+	row, _ = m.Peek()
+	return row, nil
+}
