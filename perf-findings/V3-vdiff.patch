--- /dev/null
+++ b/perf-findings/V3-scripts/ab.sh
@@ -0,0 +1,27 @@
+#!/bin/bash
+# A/B VDiff runs. Usage: ab.sh PREFIX ROUNDS ARM...   where ARM is NAME=BIN[:VDIFF_V3_OFF]
+# e.g. ab.sh r 3 base=/home/vt/bin all=/home/vt/bin-V3 fast=/home/vt/bin-V3:merge,steal
+# Restarts the vttablets for every arm (outside of the bench lock), then runs vd.sh inside the lock.
+set -uo pipefail
+D=/home/vt/perf/V3
+DR=/home/vt/perf/c30000
+PREFIX=$1; ROUNDS=$2; shift 2
+q() { mysql -N -S "$1" -u vt_dba -e "$2" 2>/dev/null; }
+for r in $(seq 1 "$ROUNDS"); do
+  for arm in "$@"; do
+    name=${arm%%=*}; spec=${arm#*=}; bin=${spec%%:*}; off=""
+    [[ $spec == *:* ]] && off=${spec#*:}
+    # Only the target tablets run the vdiff: restarting the source too makes the streams' tablet picker sleep 30 s.
+    for i in 1 2; do
+      BIN=$bin VDIFF_V3_OFF=$off VTTABLET_EXTRA_FLAGS="${VTTABLET_EXTRA_FLAGS:-}" "$D/c.sh" restart-tablet $i >/dev/null 2>&1
+    done
+    for _ in $(seq 1 150); do
+      s1=$(q $DR/vt_0000000101/mysql.sock "select state from _vt.vreplication where workflow='wf'")
+      s2=$(q $DR/vt_0000000102/mysql.sock "select state from _vt.vreplication where workflow='wf'")
+      [[ $s1 == Running && $s2 == Running ]] && break
+      sleep 0.2
+    done
+    sleep 8
+    flock -o /home/vt/perf/bench.lock env WF=${WF:-wf} VD_FLAGS="${VD_FLAGS:-}" VERBOSE=${VERBOSE:-0} "$D/vd.sh" "${PREFIX}-$name-$r" "${PROF:-0}" | head -8
+  done
+done
