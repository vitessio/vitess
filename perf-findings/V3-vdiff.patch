+#!/bin/bash
+# Create N small tables (small1..smallN, 1000 rows each) and an unrelated table `other` in src,
+# add them to the dst vschema, and MoveTables them in workflow wf2.
+set -euo pipefail
+D=/home/vt/perf/V3
+S=/home/vt/perf/c30000/vt_0000000100/mysql.sock
+N=${N:-30}
+q() { mysql -S $S -u vt_dba vt_src -e "$1"; }
+q "create table if not exists other (id bigint not null auto_increment primary key, v varchar(64)) engine=InnoDB"
+tl=""
+for i in $(seq 1 "$N"); do
+  q "create table if not exists small$i (id bigint not null primary key, a int, b varchar(64), c datetime) engine=InnoDB;
+     set session cte_max_recursion_depth=100000;
+     insert ignore into small$i with recursive seq(n) as (select 1 union all select n+1 from seq where n < 1000)
+     select n, n*7, md5(n), now() - interval n minute from seq"
+  tl+="small$i,"
+done
+tl=${tl%,}
+vs=$("$D/c.sh" vtctldclient GetVSchema dst)
+vs=$(python3 -c '
+import json, sys
+vs = json.loads(sys.argv[1])
+for i in range(1, int(sys.argv[2]) + 1):
+    vs["tables"]["small%d" % i] = {"column_vindexes": [{"column": "id", "name": "hash"}]}
+print(json.dumps(vs))' "$vs" "$N")
+"$D/c.sh" vtctldclient ApplyVSchema --vschema "$vs" dst >/dev/null
+"$D/c.sh" vtctldclient MoveTables --workflow wf2 --target-keyspace dst create --source-keyspace src --tables "$tl"
diff --git a/perf-findings/V3-scripts/summ.py b/perf-findings/V3-scripts/summ.py
new file mode 100644
index 0000000000..b64d8c4d23
--- /dev/null
+++ b/perf-findings/V3-scripts/summ.py
@@ -0,0 +1,34 @@
+#!/usr/bin/env python3
+"""Summarize vd.sh runs: summ.py PREFIX -> per arm: wall times, rows/s, CPU s/1M rows per process (mean of target tablets)."""
+import glob
+import os
+import re
+import sys
+from collections import defaultdict
+
+prefix = sys.argv[1]
+arms = defaultdict(list)
+for d in sorted(glob.glob(f"/home/vt/perf/V3/out/{prefix}-*")):
+    f = os.path.join(d, "summary")
+    if not os.path.exists(f):
+        continue
+    name = os.path.basename(d)[len(prefix) + 1:]
+    arm = name.rsplit("-", 1)[0]
+    txt = open(f).read()
+    m = re.search(r"rows=(\d+) mismatch_tables=(\d+) dur=([\d.]+)s", txt)
+    load = re.search(r"load average: ([\d.]+)", txt).group(1)
+    cpu = dict(re.findall(r"^\s+(\S+)\s+[\d.]+ s\s+([\d.]+) s/1M rows", txt, re.M))
+    arms[arm].append((float(m.group(3)), int(m.group(1)), int(m.group(2)), {k: float(v) for k, v in cpu.items()}, load))
+
+print(f"{'arm':10} {'n':>2} {'wall s (each)':30} {'tgt tablet':>10} {'src tablet':>10} {'src mysqld':>10} {'tgt mysqld':>10} {'total':>7}  loads")
+for arm, runs in arms.items():
+    walls = " ".join(f"{r[0]:.2f}" for r in runs)
+    def avg(keys):
+        return sum(sum(r[3].get(k, 0) for k in keys) / len(keys) for r in runs) / len(runs)
+    tt = avg(["vttablet_101", "vttablet_102"])
+    st = avg(["vttablet_100"])
+    sm = avg(["mysqld_100"])
+    tm = avg(["mysqld_101", "mysqld_102"])
+    tot = st + sm + 2 * tt + 2 * tm
+    mm = sum(r[2] for r in runs)
+    print(f"{arm:10} {len(runs):>2} {walls:30} {tt:10.2f} {st:10.2f} {sm:10.2f} {tm:10.2f} {tot:7.2f}  {' '.join(r[4] for r in runs)}{'  MISMATCH' if mm else ''}")
diff --git a/perf-findings/V3-scripts/vd.sh b/perf-findings/V3-scripts/vd.sh
new file mode 100755
index 0000000000..aae8c5d5a8
--- /dev/null
+++ b/perf-findings/V3-scripts/vd.sh
@@ -0,0 +1,91 @@
+#!/bin/bash
+# Time one VDiff of workflow dst.wf (targets: tablets 101, 102), with CPU per process, MySQL counters per mysqld,
+# VDiff phase timings and optional pprof of the target vttablet 101.
+# Usage: vd.sh LABEL [PROFILE_SECONDS]
+# Env: VD_FLAGS extra flags for `VDiff create`; VERBOSE=1 prints MySQL counters.
+set -uo pipefail
+LABEL=${1:-run}
+PROF=${2:-0}
+D=/home/vt/perf/V3
+DR=/home/vt/perf/c30000
+OUT=$D/out/$LABEL
+rm -rf "$OUT"; mkdir -p "$OUT"
+VC="$D/c.sh vtctldclient"
+TSOCK1=$DR/vt_0000000101/mysql.sock
+TSOCK2=$DR/vt_0000000102/mysql.sock
+q() { mysql -N -S "$1" -u vt_dba -e "$2" 2>/dev/null; }
+VARS="Handler_read_next Handler_read_key Handler_read_first Handler_read_rnd_next Handler_write Handler_update Innodb_rows_read Innodb_data_written Innodb_os_log_written Com_insert Com_update Com_select Com_commit Com_begin Com_lock_tables Com_unlock_tables Com_show_binlogs Com_flush Questions Bytes_received Bytes_sent Sort_rows Created_tmp_tables"
+inlist=$(printf "'%s'," $VARS); inlist=${inlist%,}
+snap() { # $1 suffix
+  for u in 100 101 102; do
+    q $DR/vt_0000000$u/mysql.sock "show global status where variable_name in ($inlist)" >"$OUT/st_${u}_$1"
+  done
+}
+UUID=$(cat /proc/sys/kernel/random/uuid)
+"$D/c.sh" cpu >"$OUT/cpu0"
+snap 0
+uptime >"$OUT/uptime0"
+t0=$(date +%s.%N)
+$VC VDiff --workflow ${WF:-wf} --target-keyspace dst create ${VD_FLAGS:-} "$UUID" >"$OUT/create.log" 2>&1 || { cat "$OUT/create.log"; exit 1; }
+if [[ $PROF -gt 0 ]]; then
+  sleep 1
+  curl -s -o "$OUT/dst1.pprof" "http://localhost:30101/debug/pprof/profile?seconds=$PROF" &
+  curl -s -o "$OUT/src.pprof" "http://localhost:30100/debug/pprof/profile?seconds=$PROF" &
+fi
+if [[ ${PERF:-0} -gt 0 ]]; then
+  sleep 1
+  for u in 100 101; do
+    /usr/lib/linux-tools-6.8.0-142/perf record -e cpu-clock -F 499 -g -o "$OUT/mysqld$u.perf" -p "$(cat $DR/vt_0000000$u/mysql.pid)" -- sleep "$PERF" >/dev/null 2>&1 &
+  done
+fi
+n=0
+while :; do
+  s1=$(q $TSOCK1 "select state from _vt.vdiff where vdiff_uuid='$UUID'")
+  s2=$(q $TSOCK2 "select state from _vt.vdiff where vdiff_uuid='$UUID'")
+  [[ $s1 == completed && -z ${t1a:-} ]] && t1a=$(date +%s.%N)
+  [[ $s2 == completed && -z ${t2a:-} ]] && t2a=$(date +%s.%N)
+  if [[ $s1 == completed && $s2 == completed ]]; then break; fi
+  if ((n > 900)); then echo "TIMEOUT"; break; fi
+  if [[ $s1 == error || $s2 == error ]]; then echo "ERROR"; q $TSOCK1 "select last_error from _vt.vdiff where vdiff_uuid='$UUID'"; q $TSOCK2 "select last_error from _vt.vdiff where vdiff_uuid='$UUID'"; break; fi
+  if ((n % 5 == 0)); then
+    curl -s http://localhost:30101/debug/vars >"$OUT/vars101.json.tmp" && mv "$OUT/vars101.json.tmp" "$OUT/vars101.json"
+    curl -s http://localhost:30102/debug/vars >"$OUT/vars102.json.tmp" && mv "$OUT/vars102.json.tmp" "$OUT/vars102.json"
+  fi
+  n=$((n + 1))
+  sleep 0.2
+done
+t1=$(date +%s.%N)
+"$D/c.sh" cpu >"$OUT/cpu1"
+snap 1
+uptime >"$OUT/uptime1"
+curl -s http://localhost:30101/debug/vars >"$OUT/vars101_end.json"
+curl -s http://localhost:30102/debug/vars >"$OUT/vars102_end.json"
+wait
+$VC VDiff --workflow ${WF:-wf} --target-keyspace dst show "$UUID" >"$OUT/show.txt" 2>&1
+rows=$(( $(q $TSOCK1 "select sum(rows_compared) from _vt.vdiff_table t join _vt.vdiff v on v.id=t.vdiff_id where v.vdiff_uuid='$UUID'") + $(q $TSOCK2 "select sum(rows_compared) from _vt.vdiff_table t join _vt.vdiff v on v.id=t.vdiff_id where v.vdiff_uuid='$UUID'") ))
+mm=$(( $(q $TSOCK1 "select sum(mismatch) from _vt.vdiff_table t join _vt.vdiff v on v.id=t.vdiff_id where v.vdiff_uuid='$UUID'") + $(q $TSOCK2 "select sum(mismatch) from _vt.vdiff_table t join _vt.vdiff v on v.id=t.vdiff_id where v.vdiff_uuid='$UUID'") ))
+dur=$(echo "$t1 - $t0" | bc)
+echo "$LABEL uuid=$UUID rows=$rows mismatch_tables=$mm dur=${dur}s shard1=$(echo "${t1a:-$t1} - $t0" | bc)s shard2=$(echo "${t2a:-$t1} - $t0" | bc)s rows/s=$(echo "$rows / $dur" | bc) load: $(cut -d, -f3- "$OUT/uptime1")" | tee "$OUT/summary"
+paste -d' ' "$OUT/cpu0" "$OUT/cpu1" | awk -v r="$rows" '{d=$4-$2; printf "  %-14s %7.2f s  %6.2f s/1M rows\n", $1, d, d*1e6/r}' | tee -a "$OUT/summary"
+python3 - "$OUT" "$UUID" <<'EOF' | tee -a "$OUT/summary"
+import json, sys
+out, uuid = sys.argv[1], sys.argv[2]
+for t in ("101", "102"):
+    try:
+        v = json.load(open(f"{out}/vars{t}_end.json"))
+    except Exception:
+        continue
+    pt = {k: x for k, x in v.get("VDiffPhaseTimings", {}).items() if uuid in k}
+    if not pt:
+        v = json.load(open(f"{out}/vars{t}.json"))
+        pt = {k: x for k, x in v.get("VDiffPhaseTimings", {}).items() if uuid in k}
+    print(f"  phases tablet {t} (ms):", ", ".join(f"{k.split(uuid + '.')[1]}={x / 1e6:.0f}" for k, x in sorted(pt.items())))
+    rc = {k: x for k, x in v.get("VDiffRowsCompared", {}).items() if uuid in k}
+    print(f"  VDiffRowsCompared {t}:", rc, "VDiffRowsComparedTotal:", v.get("VDiffRowsComparedTotal"))
+EOF
+if [[ ${VERBOSE:-0} == 1 ]]; then
+  for u in 100 101 102; do
+    echo "  mysqld_$u counters per 1M rows compared:" | tee -a "$OUT/summary"
+    join <(sort "$OUT/st_${u}_0") <(sort "$OUT/st_${u}_1") | awk -v r="$rows" '{d=$3-$2; if (d != 0) printf "    %-26s %14.0f\n", $1, d*1e6/r}' | tee -a "$OUT/summary"
+  done
+fi
