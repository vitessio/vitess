+// TestWaitForVDiff tests that waiting for a vdiff returns as soon as the vdiff
+// is seen completed, rather than on the next wait update interval, and that
+// the progress is displayed every update interval and once completed.
+func TestWaitForVDiff(t *testing.T) {
+	savedInitial, savedMax := initialWaitCheckInterval, maxWaitCheckInterval
+	t.Cleanup(func() {
+		initialWaitCheckInterval, maxWaitCheckInterval = savedInitial, savedMax
+	})
+	initialWaitCheckInterval, maxWaitCheckInterval = 10*time.Millisecond, 20*time.Millisecond
+
+	// show reports the vdiff as started until its completeAfter-th call.
+	newShow := func(completeAfter int) (func(io.Writer) (vdiff.VDiffState, error), *int) {
+		calls := 0
+		return func(out io.Writer) (vdiff.VDiffState, error) {
+			calls++
+			state := vdiff.StartedState
+			if calls >= completeAfter {
+				state = vdiff.CompletedState
+			}
+			_, err := fmt.Fprintf(out, "%s\n", state)
+			return state, err
+		}, &calls
+	}
+
+	t.Run("completes before the first update", func(t *testing.T) {
+		show, calls := newShow(3)
+		var out bytes.Buffer
+		start := time.Now()
+		require.NoError(t, waitForVDiff(t.Context(), &out, time.Hour, show))
+		require.Less(t, time.Since(start), 30*time.Second)
+		require.Equal(t, 3, *calls)
+		// Only the final summary is displayed.
+		require.Equal(t, "completed\n", out.String())
+	})
+
+	t.Run("displays the progress every update interval", func(t *testing.T) {
+		show, calls := newShow(20)
+		var out bytes.Buffer
+		require.NoError(t, waitForVDiff(t.Context(), &out, 50*time.Millisecond, show))
+		require.Equal(t, 20, *calls)
+		lines := strings.Split(strings.TrimSuffix(out.String(), "\n"), "\n")
+		require.Greater(t, len(lines), 1)
+		require.Less(t, len(lines), 20)
+		require.Equal(t, "completed", lines[len(lines)-1])
+		for _, line := range lines[:len(lines)-1] {
+			require.Equal(t, "started", line)
+		}
+	})
+
+	t.Run("invalid update interval", func(t *testing.T) {
+		show, calls := newShow(1)
+		require.ErrorContains(t, waitForVDiff(t.Context(), io.Discard, 0, show), "invalid wait update interval")
+		require.Zero(t, *calls)
+	})
+}
