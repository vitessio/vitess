+
+// newTestShardStreamer returns a shardStreamer that sends the given batches of
+// rows, as streamOneShard does, and then ends with err.
+func newTestShardStreamer(t *testing.T, err error, batches ...[][]sqltypes.Value) *shardStreamer {
+	sm := &shardStreamer{result: make(chan *sqltypes.Result, 1)}
+	go func() {
+		defer close(sm.result)
+		for i, rows := range batches {
+			qr := &sqltypes.Result{Rows: rows}
+			if i == 0 {
+				qr.Fields = drainTestFields
+			}
+			select {
+			case sm.result <- qr:
+			case <-t.Context().Done():
+				return
+			}
+		}
+		sm.err = err
+	}()
+	return sm
+}
+
+func readAllRows(it rowIterator) ([][]sqltypes.Value, error) {
+	var rows [][]sqltypes.Value
+	for {
+		row, err := it.next()
+		if err != nil {
+			return rows, err
+		}
+		if row == nil {
+			return rows, nil
+		}
+		rows = append(rows, row)
+	}
+}
+
+func TestShardsRowIterator(t *testing.T) {
+	row := drainTestRow
+	// Order by c2, a varchar column with a case insensitive collation: the
+	// merged order must follow the collation, not the bytes ("B" < "c").
+	orderBy := pkOrderBy([]compareColInfo{{colIndex: 1, collation: collations.CollationUtf8mb4ID, isPK: true}}, collations.MySQL8())
+	streamErr := errors.New("stream failed")
+
+	testCases := []struct {
+		name    string
+		shards  func(t *testing.T) []*shardStreamer
+		want    [][]sqltypes.Value
+		wantErr error
+	}{{
+		name: "one shard, several batches, some empty",
+		shards: func(t *testing.T) []*shardStreamer {
+			return []*shardStreamer{newTestShardStreamer(t, nil,
+				[][]sqltypes.Value{row(1, "a"), row(2, "B")},
+				nil,
+				[][]sqltypes.Value{row(3, "c")},
+			)}
+		},
+		want: [][]sqltypes.Value{row(1, "a"), row(2, "B"), row(3, "c")},
+	}, {
+		name: "several shards merged in collation order",
+		shards: func(t *testing.T) []*shardStreamer {
+			return []*shardStreamer{
+				newTestShardStreamer(t, nil, [][]sqltypes.Value{row(1, "a")}, [][]sqltypes.Value{row(4, "d")}),
+				newTestShardStreamer(t, nil, [][]sqltypes.Value{row(2, "B"), row(5, "E")}),
+				newTestShardStreamer(t, nil),
+				newTestShardStreamer(t, nil, nil, [][]sqltypes.Value{row(3, "c"), row(6, "f")}),
+			}
+		},
+		want: [][]sqltypes.Value{row(1, "a"), row(2, "B"), row(3, "c"), row(4, "d"), row(5, "E"), row(6, "f")},
+	}, {
+		name: "no rows",
+		shards: func(t *testing.T) []*shardStreamer {
+			return []*shardStreamer{newTestShardStreamer(t, nil), newTestShardStreamer(t, nil)}
+		},
+	}, {
+		name: "one shard fails",
+		shards: func(t *testing.T) []*shardStreamer {
+			return []*shardStreamer{newTestShardStreamer(t, streamErr, [][]sqltypes.Value{row(1, "a")})}
+		},
+		want:    [][]sqltypes.Value{row(1, "a")},
+		wantErr: streamErr,
+	}, {
+		name: "one of several shards fails",
+		shards: func(t *testing.T) []*shardStreamer {
+			return []*shardStreamer{
+				newTestShardStreamer(t, nil, [][]sqltypes.Value{row(1, "a"), row(3, "c")}),
+				newTestShardStreamer(t, streamErr, [][]sqltypes.Value{row(2, "B")}),
+			}
+		},
+		// The error is returned when the next row of the failed shard is needed.
+		want:    [][]sqltypes.Value{row(1, "a"), row(2, "B")},
+		wantErr: streamErr,
+	}}
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			rows, err := readAllRows(newShardsRowIterator(t.Context(), tc.shards(t), orderBy))
+			require.ErrorIs(t, err, tc.wantErr)
+			require.Equal(t, tc.want, rows)
+		})
+	}
+
+	t.Run("canceled", func(t *testing.T) {
+		ctx, cancel := context.WithCancel(t.Context())
+		cancel()
+		// This streamer never sends anything.
+		sm := &shardStreamer{result: make(chan *sqltypes.Result)}
+		_, err := newShardsRowIterator(ctx, []*shardStreamer{sm}, orderBy).next()
+		require.ErrorContains(t, err, context.Canceled.Error())
+	})
+}
+
+// TestDiffShardStreamers tests a diff that reads the rows of the shard
+// streamers directly: two source shards are merged and compared with the
+// target shard.
+func TestDiffShardStreamers(t *testing.T) {
+	row := drainTestRow
+	dbc := binlogplayer.NewMockDBClient(t)
+	td := newDrainTestDiffer(dbc, nil, nil)
+	td.sourceStreamers = []*shardStreamer{
+		newTestShardStreamer(t, nil, [][]sqltypes.Value{row(1, "a"), row(3, "c")}, [][]sqltypes.Value{row(5, "e")}),
+		newTestShardStreamer(t, nil, [][]sqltypes.Value{row(2, "b")}, [][]sqltypes.Value{row(4, "d")}),
+	}
+	td.targetStreamers = []*shardStreamer{
+		newTestShardStreamer(t, nil, [][]sqltypes.Value{row(1, "a"), row(2, "B")}, [][]sqltypes.Value{row(3, "c"), row(5, "e"), row(6, "f")}),
+	}
+
+	stateQuery, err := sqlparser.ParseAndBind(sqlGetVDiffTable,
+		sqltypes.Int64BindVariable(td.wd.ct.id),
+		sqltypes.StringBindVariable(td.table.Name),
+	)
+	require.NoError(t, err)
+	dbc.ExpectRequest(stateQuery, sqltypes.MakeTestResult(sqltypes.MakeTestFields(
+		"lastpk|mismatch|report",
+		"varbinary|int64|varbinary",
+	), "|0|{}"), nil)
+	dbc.ExpectRequestRE("update _vt.vdiff_table set mismatch = .*", &sqltypes.Result{}, nil)
+	dbc.ExpectRequestRE("update _vt.vdiff_table set rows_compared = .*", &sqltypes.Result{}, nil)
+
+	dr, err := td.diff(t.Context(), &tabletmanagerdatapb.VDiffCoreOptions{MaxRows: 100, MaxExtraRowsToCompare: 100},
+		&tabletmanagerdatapb.VDiffReportOptions{MaxSampleRows: 10}, nil)
+	require.NoError(t, err)
+	require.Equal(t, int64(6), dr.ProcessedRows)
+	require.Equal(t, int64(3), dr.MatchingRows)
+	// c2 is compared as binary: "b" != "B".
+	require.Equal(t, int64(1), dr.MismatchedRows)
+	require.Equal(t, int64(1), dr.ExtraRowsSource)
+	require.Equal(t, int64(1), dr.ExtraRowsTarget)
+	dbc.Wait()
+}
