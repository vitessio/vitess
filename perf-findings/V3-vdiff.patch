+#!/usr/bin/env python3
+"""Per-table phase times (s), averaged over the runs and target shards of an A/B prefix: phases.py PREFIX"""
+import collections
+import glob
+import json
+import sys
+
+prefix = sys.argv[1]
+res = collections.defaultdict(lambda: collections.defaultdict(list))
+for d in sorted(glob.glob(f"/home/vt/perf/V3/out/{prefix}-*")):
+    arm = d.rsplit("/", 1)[1][len(prefix) + 1:].rsplit("-", 1)[0]
+    uuid = open(d + "/summary").read().split("uuid=")[1].split()[0]
+    for t in ("101", "102"):
+        pt = {}
+        for f in (f"{d}/vars{t}_end.json", f"{d}/vars{t}.json"):
+            try:
+                v = json.load(open(f))
+            except Exception:
+                continue
+            pt = {k: x for k, x in v.get("VDiffPhaseTimings", {}).items() if uuid in k}
+            if pt:
+                break
+        for k, x in pt.items():
+            tbl, phase = k.split(uuid + ".")[1].rsplit(".", 1)
+            res[arm][(tbl, phase)].append(x / 1e9)
+for arm, r in res.items():
+    tables = sorted({k[0] for k in r})
+    for tbl in tables:
+        parts = []
+        for phase in ("initializing", "syncing_target_streams", "diffing_table"):
+            xs = r.get((tbl, phase), [])
+            if xs:
+                parts.append(f"{phase}={sum(xs) / len(xs):.2f}")
+        print(f"{arm:8} {tbl:10} " + " ".join(parts))
