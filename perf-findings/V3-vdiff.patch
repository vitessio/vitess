+#!/bin/bash
+# Load the V3 dataset into src: sbtest1 (1M rows), wide (250k rows, TEXT+JSON, 3 secondary keys),
+# coll (250k rows, utf8mb4_general_ci varchar PK, a unicode_ci column).
+set -euo pipefail
+D=/home/vt/perf/V3
+S=/home/vt/perf/c30000/vt_0000000100/mysql.sock
+q() { mysql -S $S -u vt_dba vt_src -e "$1"; }
+TABLES=1 "$D/c.sh" load
+q "insert into sbtest1 (k, c, pad) select k, c, pad from sbtest1 order by id"
+q "truncate table wide"
+for b in $(seq 0 4); do
+  q "set session cte_max_recursion_depth=100000; insert into wide (user_id, created_at, status, title, amount, body, attrs)
+     with recursive seq(n) as (select 1 union all select n+1 from seq where n < 50000)
+     select floor(rand()*100000), now(6) - interval floor(rand()*1e8) second, elt(1+floor(rand()*4),'new','paid','shipped','cancelled'),
+       concat('title ', md5(rand()), ' ', n), round(rand()*10000, 2),
+       concat_ws(' ', md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()),
+                      md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand()), md5(rand())),
+       json_object('n', n, 'batch', $b, 'h', md5(rand()), 'tags', json_array(md5(rand()), floor(rand()*1000), true), 'nested', json_object('x', rand(), 'y', 'yy')) from seq"
+done
+q "truncate table coll"
+for b in $(seq 0 4); do
+  q "set session cte_max_recursion_depth=100000; insert into coll (name, grp, val, note)
+     with recursive seq(n) as (select 1 union all select n+1 from seq where n < 50000)
+     select concat(elt(1+(n%6),'Ångström','zebra','Éclair','apple','Über','ñandú'), ' ', if(n%2,upper(md5(n*7+$b)),md5(n*7+$b)), ' ', $b, '-', n),
+       elt(1+floor(rand()*5),'Alpha','beta','GAMMA','délta','Epsilon'), floor(rand()*1e6),
+       concat('Nöte ', md5(rand()), ' ', md5(rand())) from seq"
+done
+q "analyze table sbtest1, wide, coll; select table_name, table_rows, round(data_length/1e6) data_mb, round(index_length/1e6) idx_mb from information_schema.tables where table_schema='vt_src'"
+"$D/c.sh" purge-binlogs 0
