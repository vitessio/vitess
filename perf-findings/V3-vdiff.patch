+func TestTakeVStreamRowsResponse(t *testing.T) {
+	newResponse := func(gtid string, vals ...string) *binlogdatapb.VStreamRowsResponse {
+		result := sqltypes.MakeTestResult(drainTestFields)
+		for i, val := range vals {
+			result.Rows = append(result.Rows, drainTestRow(int64(i), val))
+		}
+		qr := sqltypes.ResultToProto3(result)
+		return &binlogdatapb.VStreamRowsResponse{Fields: qr.Fields, Rows: qr.Rows, Gtid: gtid}
+	}
+	first := newResponse("pos1", "aaaa", "bbbb")
+	second := newResponse("pos2", "cccc", "dddd", "eeee")
+	firstBytes, err := first.MarshalVT()
+	require.NoError(t, err)
+	secondBytes, err := second.MarshalVT()
+	require.NoError(t, err)
+
+	vsr := binlogdatapb.VStreamRowsResponseFromVTPool()
+	defer vsr.ReturnToVTPool()
+	require.NoError(t, vsr.UnmarshalVT(firstBytes))
+	taken := takeVStreamRowsResponse(vsr)
+	vsr.ResetVT()
+	require.NoError(t, vsr.UnmarshalVT(secondBytes))
+
+	require.True(t, proto.Equal(first, taken), "taken: %v, want: %v", taken, first)
