+func TestCollateUnicodeGeneralCIFastPathEquivalence(t *testing.T) {
+	var tested int
+	for _, coll := range testall() {
+		c, ok := coll.(*Collation_unicode_general_ci)
+		if !ok {
+			continue
+		}
+		tested++
+		t.Run(c.Name(), func(t *testing.T) {
+			collatePairs(t, c.charset, func(left, right []byte) {
+				for _, isPrefix := range []bool{false, true} {
+					want := c.collateGeneric(left, right, isPrefix)
+					got := c.Collate(left, right, isPrefix)
+					if want != got {
+						require.Equal(t, want, got, "Collate(%q, %q, %v)", left, right, isPrefix)
+					}
+				}
+			})
+		})
+	}
+	assert.Equal(t, 6, tested)
+}
+
+func TestCollate8bitSimpleCIFastPathEquivalence(t *testing.T) {
+	var tested int
+	for _, coll := range testall() {
+		c, ok := coll.(*Collation_8bit_simple_ci)
+		if !ok {
+			continue
+		}
+		tested++
+		t.Run(c.Name(), func(t *testing.T) {
+			collatePairs(t, c.charset, func(left, right []byte) {
+				for _, isPrefix := range []bool{false, true} {
+					want := referenceCollate8bitSimpleCI(c, left, right, isPrefix)
+					got := c.Collate(left, right, isPrefix)
+					if want != got {
+						require.Equal(t, want, got, "Collate(%q, %q, %v)", left, right, isPrefix)
+					}
+				}
+			})
+		})
+	}
+	assert.Positive(t, tested)
+}
+
+func TestCommonPrefix(t *testing.T) {
+	cases := []struct {
+		a, b  string
+		n     int
+		ascii bool
+	}{
+		{"", "", 0, true},
+		{"abc", "", 0, true},
+		{"abcdefgh", "abcdefgh", 8, true},
+		{"abcdefghi", "abcdefgh", 8, true},
+		{"abcdefgXi", "abcdefgYi", 7, true},
+		{"abcdefghijklmnoX", "abcdefghijklmnoY", 15, true},
+		{"éabcdefgX", "éabcdefgY", 9, false},
+		{"abcdefgéX", "abcdefgéY", 9, false},
+		{"abcé", "abcè", 4, false},
+		{"Xé", "Yé", 0, true},
+		{"abcdefghijklmnopé", "abcdefghijklmnopè", 17, false},
+	}
+	for _, tc := range cases {
+		n, ascii := commonPrefix([]byte(tc.a), []byte(tc.b))
+		assert.Equal(t, tc.n, n, "commonPrefix(%q, %q)", tc.a, tc.b)
+		assert.Equal(t, tc.ascii, ascii, "commonPrefix(%q, %q)", tc.a, tc.b)
+	}
+}
+
+func BenchmarkCollateFastPath(b *testing.B) {
+	type input struct {
+		name        string
+		left, right string
+	}
+	mk := func(base string, n int) string {
+		var out []byte
+		for len(out) < n {
+			out = append(out, base...)
+		}
+		return string(out[:n])
+	}
+	var inputs []input
+	for _, n := range []int{8, 44, 256} {
+		ascii := mk("The quick brown fox jumps over the lazy dog. ", n)
+		// accented Latin text, truncated at a rune boundary
+		latin := []rune(mk("Très vite, le renard brun saute par-dessus le chien paresseux. ", n))
+		latinStr := string(latin[:n])
+		inputs = append(inputs,
+			input{fmt.Sprintf("ascii/equal/%d", n), ascii, ascii},
+			input{fmt.Sprintf("ascii/diff-end/%d", n), ascii, ascii[:n-1] + "!"},
+			input{fmt.Sprintf("ascii/diff-start/%d", n), ascii, "!" + ascii[1:]},
+			input{fmt.Sprintf("ascii/case/%d", n), ascii, string(bytes.ToUpper([]byte(ascii)))},
+			input{fmt.Sprintf("latin/equal/%d", n), latinStr, latinStr},
+			input{fmt.Sprintf("latin/diff-end/%d", n), latinStr, latinStr[:len(latinStr)-1] + "!"},
+			input{fmt.Sprintf("latin/case/%d", n), latinStr, string(bytes.ToUpper([]byte(latinStr)))},
+		)
+	}
+
+	general := Lookup(collations.MySQL8().LookupByName("utf8mb4_general_ci")).(*Collation_unicode_general_ci)
+	general3 := Lookup(collations.MySQL8().LookupByName("utf8mb3_general_ci")).(*Collation_unicode_general_ci)
+	latin1 := Lookup(collations.MySQL8().LookupByName("latin1_swedish_ci")).(*Collation_8bit_simple_ci)
+
+	for _, in := range inputs {
+		l, r := []byte(in.left), []byte(in.right)
+		ll, err := charset.ConvertFromUTF8(nil, latin1.charset, l)
+		require.NoError(b, err)
+		rr, err := charset.ConvertFromUTF8(nil, latin1.charset, r)
+		require.NoError(b, err)
+
+		for _, impl := range []string{"old", "new"} {
+			old := impl == "old"
+			b.Run(fmt.Sprintf("coll=utf8mb4_general_ci/in=%s/impl=%s", in.name, impl), func(b *testing.B) {
+				b.SetBytes(int64(len(l)))
+				for b.Loop() {
+					if old {
+						_ = general.collateGeneric(l, r, false)
+					} else {
+						_ = general.Collate(l, r, false)
+					}
+				}
+			})
+			b.Run(fmt.Sprintf("coll=utf8mb3_general_ci/in=%s/impl=%s", in.name, impl), func(b *testing.B) {
+				b.SetBytes(int64(len(l)))
+				for b.Loop() {
+					if old {
+						_ = general3.collateGeneric(l, r, false)
+					} else {
+						_ = general3.Collate(l, r, false)
+					}
+				}
+			})
+			b.Run(fmt.Sprintf("coll=latin1_swedish_ci/in=%s/impl=%s", in.name, impl), func(b *testing.B) {
+				b.SetBytes(int64(len(ll)))
+				for b.Loop() {
+					if old {
+						_ = referenceCollate8bitSimpleCI(latin1, ll, rr, false)
+					} else {
+						_ = latin1.Collate(ll, rr, false)
+					}
+				}
+			})
+		}
+	}
+}
