 func (c *Collation_unicode_general_ci) Collate(left, right []byte, isPrefix bool) int {
+	switch c.charset.(type) {
+	case charset.Charset_utf8mb4:
+		return c.collateUTF8(left, right, isPrefix, true)
+	case charset.Charset_utf8mb3:
+		return c.collateUTF8(left, right, isPrefix, false)
+	}
+	return c.collateGeneric(left, right, isPrefix)
+}
+
+// collateUTF8 is the Collate implementation for the utf8mb3 and utf8mb4 charsets.
+// It returns exactly the same results as collateGeneric, but it skips the longest
+// common byte prefix of both strings first, and then decodes the remaining runes
+// without going through the charset interface.
+//
+// Skipping the common prefix is safe because identical bytes decode into identical
+// runes, and hence identical weights, as long as the skipped prefix is valid in the
+// charset and ends at a rune boundary. When the prefix contains an invalid sequence,
+// the generic implementation would fall back to a byte comparison at that point, so
+// we let it handle the input from the start.
+func (c *Collation_unicode_general_ci) collateUTF8(left, right []byte, isPrefix, mb4 bool) int {
+	n, ascii := commonPrefix(left, right)
+
+	// Back up to the start of the rune that contains the first differing byte.
+	for n > 0 && ((n < len(left) && !utf8.RuneStart(left[n])) || (n < len(right) && !utf8.RuneStart(right[n]))) {
+		n--
+	}
+	if !ascii && !validUTF8Prefix(left[:n], mb4) {
+		return c.collateGeneric(left, right, isPrefix)
+	}
+	left = left[n:]
+	right = right[n:]
+
+	unicaseInfo := c.unicase
+	for len(left) > 0 && len(right) > 0 {
+		var (
+			l, r           rune
+			lWidth, rWidth int
+		)
+		if l0, r0 := left[0], right[0]; l0|r0 < utf8.RuneSelf {
+			l, r, lWidth, rWidth = rune(l0), rune(r0), 1, 1
+		} else {
+			var lOK, rOK bool
+			if mb4 {
+				l, lWidth, lOK = charset.Charset_utf8mb4{}.DecodeRune(left)
+				r, rWidth, rOK = charset.Charset_utf8mb4{}.DecodeRune(right)
+			} else {
+				l, lWidth, lOK = charset.Charset_utf8mb3{}.DecodeRune(left)
+				r, rWidth, rOK = charset.Charset_utf8mb3{}.DecodeRune(right)
+			}
+			if !lOK || !rOK {
+				return bytes.Compare(left, right)
+			}
+		}
+
+		if l != r {
+			lRune := unicaseInfo.unicodeSort(l)
+			rRune := unicaseInfo.unicodeSort(r)
+
+			if lRune > rRune {
+				return 1
+			} else if lRune < rRune {
+				return -1
+			}
+		}
+
+		left = left[lWidth:]
+		right = right[rWidth:]
+	}
+	if isPrefix {
+		return len(right)
+	}
+	return len(left) - len(right)
+}
+
+// validUTF8Prefix reports whether p consists only of complete, valid runes
+// as decoded by the utf8mb4 (mb4 == true) or utf8mb3 charsets.
+func validUTF8Prefix(p []byte, mb4 bool) bool {
+	if !utf8.Valid(p) {
+		return false
+	}
+	if !mb4 {
+		// utf8mb3 does not support 4-byte sequences, which all start with a byte >= 0xF0,
+		// i.e. a byte with its 4 high bits set.
+		const hibits = 0x8080808080808080
+		for len(p) >= 8 {
+			x := binary.LittleEndian.Uint64(p)
+			if x&(x<<1)&(x<<2)&(x<<3)&hibits != 0 {
+				return false
+			}
+			p = p[8:]
+		}
+		for _, b := range p {
+			if b >= 0xF0 {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// commonPrefix returns the length of the longest common prefix of a and b,
+// and whether all the bytes in that prefix are ASCII.
+func commonPrefix(a, b []byte) (n int, ascii bool) {
+	const hibits = 0x8080808080808080
+	var acc uint64
+
+	limit := min(len(a), len(b))
+	a, b = a[:limit], b[:limit]
+	for len(a) >= 8 && len(b) >= 8 {
+		x := binary.LittleEndian.Uint64(a)
+		y := binary.LittleEndian.Uint64(b)
+		if d := x ^ y; d != 0 {
+			eq := bits.TrailingZeros64(d) >> 3
+			acc |= x & (1<<(8*eq) - 1)
+			return n + eq, acc&hibits == 0
+		}
+		acc |= x
+		n += 8
+		a, b = a[8:], b[8:]
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			break
+		}
+		acc |= uint64(a[i])
+		n++
+	}
+	return n, acc&hibits == 0
+}
+
+// collateGeneric is the Collate implementation for all the charsets.
+func (c *Collation_unicode_general_ci) collateGeneric(left, right []byte, isPrefix bool) int {
 	unicaseInfo := c.unicase
 	cs := c.charset
 
