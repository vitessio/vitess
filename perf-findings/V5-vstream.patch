+// TestVStreamCoalescesTransactions checks that with the CoalesceTransactions option, a stream
+// that is behind the binlog sends several complete transactions per send, in order.
+func TestVStreamCoalescesTransactions(t *testing.T) {
+	execStatements(t, []string{"create table coalesce_t(id int, val varbinary(128), primary key(id))"})
+	t.Cleanup(func() { execStatements(t, []string{"drop table coalesce_t"}) })
+	require.NoError(t, engine.se.Reload(t.Context()))
+
+	pos := primaryPosition(t)
+	const numTrx = 200
+	queries := make([]string, 0, numTrx)
+	for i := 1; i <= numTrx; i++ {
+		queries = append(queries, fmt.Sprintf("insert into coalesce_t values (%d, 'val%d')", i, i))
+	}
+	execStatements(t, queries)
+
+	filter := &binlogdatapb.Filter{Rules: []*binlogdatapb.Rule{{Match: "coalesce_t", Filter: "select * from coalesce_t"}}}
+	ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
+	defer cancel()
+	var ids []int
+	sends, maxTrxPerSend := 0, 0
+	err := engine.Stream(ctx, pos, nil, filter, throttlerapp.VStreamerName, func(evs []*binlogdatapb.VEvent) error {
+		if sends == 0 {
+			// Let the binlog events queue up behind the first send.
+			time.Sleep(200 * time.Millisecond)
+		}
+		sends++
+		trx, rowsInTrx := 0, false
+		for _, ev := range evs {
+			switch ev.Type {
+			case binlogdatapb.VEventType_ROW:
+				for _, rc := range ev.RowEvent.RowChanges {
+					id, err := strconv.Atoi(string(rc.After.Values[:rc.After.Lengths[0]]))
+					require.NoError(t, err)
+					ids = append(ids, id)
+				}
+				rowsInTrx = true
+			case binlogdatapb.VEventType_COMMIT:
+				if rowsInTrx {
+					trx++
+				}
+				rowsInTrx = false
+			}
+		}
+		maxTrxPerSend = max(maxTrxPerSend, trx)
+		if len(ids) >= numTrx {
+			return io.EOF
+		}
+		return nil
+	}, &binlogdatapb.VStreamOptions{CoalesceTransactions: true})
+	requireNoErrorOrEOF(t, err)
+	require.Len(t, ids, numTrx)
+	for i, id := range ids {
+		require.Equal(t, i+1, id)
+	}
+	require.Greater(t, maxTrxPerSend, 1, "no send had more than one transaction")
+	require.Less(t, sends, numTrx)
+}
+
+// TestVStreamCopyBatchCopyRows checks that with the BatchCopyRows option, the copy phase sends
+// each batch of copied rows as one ROW event.
+func TestVStreamCopyBatchCopyRows(t *testing.T) {
+	execStatements(t, []string{"create table batch_copy_t(id int, val varbinary(128), primary key(id))"})
+	t.Cleanup(func() { execStatements(t, []string{"drop table batch_copy_t"}) })
+	const numRows = 10
+	queries := make([]string, 0, numRows)
+	for i := 1; i <= numRows; i++ {
+		queries = append(queries, fmt.Sprintf("insert into batch_copy_t values (%d, 'val%d')", i, i))
+	}
+	execStatements(t, queries)
+	require.NoError(t, engine.se.Reload(t.Context()))
+
+	filter := &binlogdatapb.Filter{Rules: []*binlogdatapb.Rule{{Match: "batch_copy_t", Filter: "select * from batch_copy_t"}}}
+	ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
+	defer cancel()
+	var rowEvents []*binlogdatapb.RowEvent
+	err := engine.Stream(ctx, "", nil, filter, throttlerapp.VStreamerName, func(evs []*binlogdatapb.VEvent) error {
+		for _, ev := range evs {
+			switch ev.Type {
+			case binlogdatapb.VEventType_ROW:
+				rowEvents = append(rowEvents, ev.RowEvent)
+			case binlogdatapb.VEventType_COPY_COMPLETED:
+				return io.EOF
+			}
+		}
+		return nil
+	}, &binlogdatapb.VStreamOptions{BatchCopyRows: true})
+	requireNoErrorOrEOF(t, err)
+	// The table is small enough to be copied in one batch.
+	require.Len(t, rowEvents, 1)
+	require.Equal(t, "batch_copy_t", rowEvents[0].TableName)
+	require.Len(t, rowEvents[0].RowChanges, numRows)
+	for i, rc := range rowEvents[0].RowChanges {
+		require.Nil(t, rc.Before)
+		require.Equal(t, strconv.Itoa(i+1), string(rc.After.Values[:rc.After.Lengths[0]]))
+	}
+}
+
+// TestVStreamCopySkipsCatchupAfterRecentSnapshot checks that the copy of a table does not start
+// with a catchup when the snapshot of the previous table's copy is recent: the catchup waited for
+// at least a heartbeat on an idle source, for every table after the first.
+func TestVStreamCopySkipsCatchupAfterRecentSnapshot(t *testing.T) {
+	tables := []string{"skip_catchup_t1", "skip_catchup_t2", "skip_catchup_t3"}
+	filter := &binlogdatapb.Filter{}
+	for _, table := range tables {
+		execStatements(t, []string{
+			fmt.Sprintf("create table %s(id int, primary key(id))", table),
+			fmt.Sprintf("insert into %s values (1), (2)", table),
+		})
+		t.Cleanup(func() { execStatements(t, []string{"drop table " + table}) })
+		filter.Rules = append(filter.Rules, &binlogdatapb.Rule{Match: table, Filter: "select * from " + table})
+	}
+	require.NoError(t, engine.se.Reload(t.Context()))
+
+	skippedBefore := engine.vstreamerCopyCatchupsSkipped.Get()
+	ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
+	defer cancel()
+	copied := map[string]bool{}
+	err := engine.Stream(ctx, "", nil, filter, throttlerapp.VStreamerName, func(evs []*binlogdatapb.VEvent) error {
+		for _, ev := range evs {
+			if ev.Type == binlogdatapb.VEventType_ROW {
+				copied[ev.RowEvent.TableName] = true
+			}
+		}
+		if len(copied) == len(tables) {
+			return io.EOF
+		}
+		return nil
+	}, nil)
+	requireNoErrorOrEOF(t, err)
+	require.Len(t, copied, len(tables))
+	// The catchups before the second and the third table were skipped.
+	require.Equal(t, int64(len(tables)-1), engine.vstreamerCopyCatchupsSkipped.Get()-skippedBefore)
+}
+
+// requireNoErrorOrEOF accepts the io.EOF that a stream may return after its callback ended it.
+func requireNoErrorOrEOF(t *testing.T, err error) {
+	t.Helper()
+	if err != nil {
+		require.ErrorIs(t, err, io.EOF)
+	}
+}
