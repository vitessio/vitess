new file mode 100755
index 0000000000..48afbdd282
--- /dev/null
+++ b/perf-findings/V5-scripts/ab.sh
@@ -0,0 +1,18 @@
+#!/bin/bash
+# A/B drain: for each round, for each arm (a bin dir suffix: base=/home/vt/bin, X=/home/vt/bin-V5X),
+# restart vtgate+vttablets with that arm (outside the lock), then drain the recorded backlog under the lock.
+# Usage: ab.sh TAG ROUNDS "ARMS" NCLIENTS [vsclient flags...]
+# The backlog is out/$TAG.start .. out/$TAG.stop; results are appended to out/ab.$TAG.txt.
+set -uo pipefail
+TAG=$1; R=$2; ARMS=$3; N=$4; shift 4
+O=/home/vt/perf/V5/out
+for r in $(seq 1 "$R"); do
+  for arm in $ARMS; do
+    if [[ $arm == base ]]; then B=/home/vt/bin; else B=/home/vt/bin-V5$arm; fi
+    [[ -x $B/vttablet ]] || { echo "no binaries in $B" >&2; exit 1; }
+    BIN=$B /home/vt/perf/V5/c.sh restart >/dev/null 2>&1
+    sleep 3
+    echo "=== $TAG arm=$arm round=$r flags=[$*]" | tee -a "$O/ab.$TAG.txt"
+    flock -o /home/vt/perf/bench.lock /home/vt/perf/V5/drain.sh "$arm" "$O/$TAG.start" "$O/$TAG.stop" "$N" "$@" | tee -a "$O/ab.$TAG.txt"
+  done
+done
