+#!/bin/bash
+# Drain a recorded backlog through vtgate VStream and print the client summary plus CPU seconds per process.
+# Usage: drain.sh LABEL STARTFILE STOPFILE NCLIENTS [vsclient flags...]
+set -uo pipefail
+L=$1; S=$2; E=$3; N=$4; shift 4
+C=/home/vt/perf/V5/c.sh
+before=$($C cpu | tr '\n' ' ')
+t0=$(date +%s.%N)
+pids=()
+for i in $(seq 1 "$N"); do
+  /home/vt/perf/V5/bin/vsclient -mode drain -start "$S" -stop "$E" -label "$L#$i" -quiet "$@" > /home/vt/perf/V5/out/drain.$i.txt &
+  pids+=($!)
+done
+for p in "${pids[@]}"; do wait "$p"; done
+t1=$(date +%s.%N)
+after=$($C cpu | tr '\n' ' ')
+for i in $(seq 1 "$N"); do cat /home/vt/perf/V5/out/drain.$i.txt; done
+python3 /home/vt/perf/V5/cpudiff.py "$before" "$after" "$t0" "$t1"
+echo "uptime: $(uptime)"
