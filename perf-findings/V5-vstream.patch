diff --git a/perf-findings/V5-scripts/vsclient.go.txt b/perf-findings/V5-scripts/vsclient.go.txt
new file mode 100644
index 0000000000..6e267c2463
--- /dev/null
+++ b/perf-findings/V5-scripts/vsclient.go.txt
@@ -0,0 +1,434 @@
+// Command vsclient is a VStream (CDC) benchmark client for vtgate.
+//
+// Modes:
+//
+//	pos    stream from "current" until every shard has a real position, write that VGTID to -out, exit.
+//	drain  stream from the VGTID in -start until every shard's position contains the one in -stop.
+//	copy   stream from an empty position (full table copy) until the final COPY_COMPLETED event.
+//	live   stream from "current" for -duration, optionally inserting probe rows into -probe-table
+//	       every -probe-interval and measuring the commit->receive latency of each probe row.
+//
+// It prints one summary line (key=value) on stdout.
+package main
+
+import (
+	"context"
+	"flag"
+	"fmt"
+	"io"
+	"log"
+	"math"
+	"os"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"vitess.io/vitess/go/mysql/replication"
+	binlogdatapb "vitess.io/vitess/go/vt/proto/binlogdata"
+	querypb "vitess.io/vitess/go/vt/proto/query"
+	topodatapb "vitess.io/vitess/go/vt/proto/topodata"
+	vtgatepb "vitess.io/vitess/go/vt/proto/vtgate"
+	_ "vitess.io/vitess/go/vt/vtgate/grpcvtgateconn"
+	"vitess.io/vitess/go/vt/vtgate/vtgateconn"
+)
+
+var (
+	server        = flag.String("server", "localhost:30002", "vtgate grpc address")
+	keyspace      = flag.String("keyspace", "sbtest", "keyspace")
+	mode          = flag.String("mode", "live", "pos|drain|copy|live")
+	startFile     = flag.String("start", "", "drain: file with the start VGTID")
+	stopFile      = flag.String("stop", "", "drain: file with the stop VGTID")
+	outFile       = flag.String("out", "", "pos: output file for the VGTID")
+	tables        = flag.String("tables", "", "comma separated tables to stream (default: all, /.*)")
+	minimizeSkew  = flag.Bool("minimize-skew", false, "VStreamFlags.minimize_skew")
+	heartbeat     = flag.Uint("heartbeat", 0, "VStreamFlags.heartbeat_interval (s)")
+	ksHeartbeats  = flag.Bool("keyspace-heartbeats", false, "VStreamFlags.stream_keyspace_heartbeats")
+	journalEvents = flag.Bool("journal-events", false, "VStreamFlags.include_reshard_journal_events")
+	chunkSize     = flag.Int64("chunk-size", 0, "VStreamFlags.transaction_chunk_size (bytes)")
+	excludeKs     = flag.Bool("exclude-ks", false, "VStreamFlags.exclude_keyspace_from_table_name")
+	batchCopy     = flag.Bool("batch-copy", false, "VStreamFlags.batch_copy_rows")
+	coalesce      = flag.Bool("coalesce", false, "VStreamFlags.coalesce_transactions")
+	duration      = flag.Duration("duration", 30*time.Second, "live: how long to stream")
+	timeout       = flag.Duration("timeout", 10*time.Minute, "overall timeout")
+	probeTable    = flag.String("probe-table", "", "live: table (id bigint, ts bigint) to insert probe rows into")
+	probeInterval = flag.Duration("probe-interval", 50*time.Millisecond, "live: probe insert interval")
+	probeBase     = flag.Int64("probe-base", 0, "live: first probe id (use distinct ranges for concurrent clients)")
+	label         = flag.String("label", "", "label printed with the summary")
+	quiet         = flag.Bool("quiet", false, "do not print per-second progress to stderr")
+	tabletType    = flag.String("tablet-type", "primary", "tablet type")
+)
+
+type stats struct {
+	responses, events, rowChanges, bytes atomic.Int64
+	byType                               [32]atomic.Int64
+	lagSumMs, lagN, lagMax               atomic.Int64 // seconds-granularity event lag, ms
+}
+
+func main() {
+	flag.Parse()
+	ctx, cancel := context.WithTimeout(context.Background(), *timeout)
+	defer cancel()
+
+	conn, err := vtgateconn.Dial(ctx, *server)
+	if err != nil {
+		log.Fatal(err)
+	}
+	defer conn.Close()
+
+	var vgtid *binlogdatapb.VGtid
+	switch *mode {
+	case "pos", "live":
+		vgtid = &binlogdatapb.VGtid{ShardGtids: []*binlogdatapb.ShardGtid{{Keyspace: *keyspace, Gtid: "current"}}}
+	case "copy":
+		vgtid = &binlogdatapb.VGtid{ShardGtids: []*binlogdatapb.ShardGtid{{Keyspace: *keyspace, Gtid: ""}}}
+	case "drain":
+		vgtid = readVGtid(*startFile)
+	default:
+		log.Fatalf("unknown mode %s", *mode)
+	}
+	var stopPos map[string]replication.Position
+	stopSeq := map[string]int64{}
+	if *mode == "drain" {
+		stopPos = map[string]replication.Position{}
+		for _, sg := range readVGtid(*stopFile).ShardGtids {
+			p, err := replication.DecodePosition(sg.Gtid)
+			if err != nil {
+				log.Fatal(err)
+			}
+			stopPos[sg.Keyspace+"/"+sg.Shard] = p
+			if seq, ok := gtidSeq(sg.Gtid); ok {
+				stopSeq[sg.Keyspace+"/"+sg.Shard] = seq
+			}
+		}
+	}
+
+	filter := &binlogdatapb.Filter{}
+	if *tables == "" {
+		filter.Rules = []*binlogdatapb.Rule{{Match: "/.*"}}
+	} else {
+		for _, t := range strings.Split(*tables, ",") {
+			if strings.HasPrefix(t, "/") {
+				filter.Rules = append(filter.Rules, &binlogdatapb.Rule{Match: t})
+				continue
+			}
+			filter.Rules = append(filter.Rules, &binlogdatapb.Rule{Match: t, Filter: "select * from " + t})
+		}
+	}
+	flags := &vtgatepb.VStreamFlags{
+		MinimizeSkew:                 *minimizeSkew,
+		HeartbeatInterval:            uint32(*heartbeat),
+		StreamKeyspaceHeartbeats:     *ksHeartbeats,
+		IncludeReshardJournalEvents:  *journalEvents,
+		TransactionChunkSize:         *chunkSize,
+		ExcludeKeyspaceFromTableName: *excludeKs,
+		BatchCopyRows:                *batchCopy,
+		CoalesceTransactions:         *coalesce,
+	}
+	tt, ok := topodatapb.TabletType_value[strings.ToUpper(*tabletType)]
+	if !ok {
+		log.Fatalf("bad tablet type %s", *tabletType)
+	}
+
+	var st stats
+	var latMu sync.Mutex
+	var latencies []float64 // ms
+	probeSent := map[int64]int64{}
+	probeTableName := *probeTable
+	if !*excludeKs && probeTableName != "" {
+		probeTableName = *keyspace + "." + probeTableName
+	}
+
+	start := time.Now()
+	var ru0 syscall.Rusage
+	_ = syscall.Getrusage(syscall.RUSAGE_SELF, &ru0)
+
+	sctx, scancel := context.WithCancel(ctx)
+	defer scancel()
+	reader, err := conn.VStream(sctx, topodatapb.TabletType(tt), vgtid, filter, flags)
+	if err != nil {
+		log.Fatal(err)
+	}
+
+	// Progress reporter.
+	var lastVGtid atomic.Pointer[binlogdatapb.VGtid]
+	done := make(chan struct{})
+	var firstEvent atomic.Int64
+	go func() {
+		tk := time.NewTicker(time.Second)
+		defer tk.Stop()
+		var prevEv, prevRows int64
+		for {
+			select {
+			case <-done:
+				return
+			case <-tk.C:
+				ev, rows := st.events.Load(), st.rowChanges.Load()
+				if !*quiet {
+					fmt.Fprintf(os.Stderr, "%s t=%.0fs events/s=%d rows/s=%d\n", *label, time.Since(start).Seconds(), ev-prevEv, rows-prevRows)
+				}
+				prevEv, prevRows = ev, rows
+			}
+		}
+	}()
+
+	// Probe writer.
+	var probeWG sync.WaitGroup
+	if *mode == "live" && *probeTable != "" {
+		probeWG.Go(func() {
+			sess := conn.Session(*keyspace+"@primary", nil)
+			id := *probeBase
+			tk := time.NewTicker(*probeInterval)
+			defer tk.Stop()
+			for {
+				select {
+				case <-sctx.Done():
+					return
+				case <-tk.C:
+				}
+				id++
+				now := time.Now().UnixNano()
+				latMu.Lock()
+				probeSent[id] = now
+				latMu.Unlock()
+				_, err := sess.Execute(sctx, fmt.Sprintf("insert into %s(id, ts) values (%d, %d)", *probeTable, id, now), nil, false)
+				if err != nil && sctx.Err() == nil {
+					log.Printf("probe insert: %v", err)
+				}
+			}
+		})
+	}
+
+	// Stop checker for drain/pos modes.
+	reachedStop := func(v *binlogdatapb.VGtid) bool {
+		if v == nil {
+			return false
+		}
+		n := 0
+		for _, sg := range v.ShardGtids {
+			key := sg.Keyspace + "/" + sg.Shard
+			sp, ok := stopPos[key]
+			if !ok {
+				continue
+			}
+			p, err := replication.DecodePosition(sg.Gtid)
+			if err != nil || !p.AtLeast(sp) {
+				return false
+			}
+			n++
+		}
+		return n == len(stopPos)
+	}
+	var stopOnce sync.Once
+	var endTime atomic.Int64
+	stopNow := func() {
+		stopOnce.Do(func() {
+			endTime.Store(time.Now().UnixNano())
+			scancel()
+		})
+	}
+	if *mode == "drain" {
+		go func() {
+			tk := time.NewTicker(20 * time.Millisecond)
+			defer tk.Stop()
+			for {
+				select {
+				case <-sctx.Done():
+					return
+				case <-tk.C:
+					if reachedStop(lastVGtid.Load()) {
+						stopNow()
+						return
+					}
+				}
+			}
+		}()
+	}
+	if *mode == "live" {
+		time.AfterFunc(*duration, stopNow)
+	}
+
+	copyDone := false
+	stopAfterCommit := false
+recvLoop:
+	for {
+		evs, err := reader.Recv()
+		if err != nil {
+			if err == io.EOF || sctx.Err() != nil {
+				break
+			}
+			log.Fatalf("recv: %v", err)
+		}
+		now := time.Now().UnixNano()
+		if firstEvent.Load() == 0 {
+			firstEvent.Store(now)
+		}
+		st.responses.Add(1)
+		for _, ev := range evs {
+			st.events.Add(1)
+			st.bytes.Add(int64(ev.SizeVT()))
+			if int(ev.Type) < len(st.byType) {
+				st.byType[ev.Type].Add(1)
+			}
+			if ev.Timestamp > 0 && ev.Type == binlogdatapb.VEventType_COMMIT {
+				lag := now/1e6 - ev.Timestamp*1000
+				st.lagSumMs.Add(lag)
+				st.lagN.Add(1)
+				if lag > st.lagMax.Load() {
+					st.lagMax.Store(lag)
+				}
+			}
+			if stopAfterCommit && ev.Type == binlogdatapb.VEventType_COMMIT {
+				stopNow()
+				break recvLoop
+			}
+			switch ev.Type {
+			case binlogdatapb.VEventType_ROW:
+				st.rowChanges.Add(int64(len(ev.RowEvent.RowChanges)))
+				if probeTableName != "" && ev.RowEvent.TableName == probeTableName {
+					for _, rc := range ev.RowEvent.RowChanges {
+						if rc.After == nil {
+							continue
+						}
+						id, ts := probeValues(rc.After)
+						latMu.Lock()
+						if _, ok := probeSent[id]; ok {
+							latencies = append(latencies, float64(now-ts)/1e6)
+							delete(probeSent, id)
+						}
+						latMu.Unlock()
+					}
+				}
+			case binlogdatapb.VEventType_VGTID:
+				lastVGtid.Store(ev.Vgtid)
+				if *mode == "drain" && len(stopSeq) == len(stopPos) && !stopAfterCommit {
+					// Fast, exact stop check for single-source GTID sets: the stream stops
+					// counting at the COMMIT of the transaction that reaches the stop position.
+					n := 0
+					for _, sg := range ev.Vgtid.ShardGtids {
+						if want, ok := stopSeq[sg.Keyspace+"/"+sg.Shard]; ok {
+							if seq, ok := gtidSeq(sg.Gtid); ok && seq >= want {
+								n++
+							}
+						}
+					}
+					if n == len(stopSeq) {
+						stopAfterCommit = true
+					}
+				}
+				if *mode == "pos" {
+					complete := true
+					for _, sg := range ev.Vgtid.ShardGtids {
+						if sg.Gtid == "current" || sg.Gtid == "" {
+							complete = false
+						}
+					}
+					if complete {
+						b, err := ev.Vgtid.MarshalVT()
+						if err != nil {
+							log.Fatal(err)
+						}
+						if err := os.WriteFile(*outFile, b, 0o644); err != nil {
+							log.Fatal(err)
+						}
+						stopNow()
+					}
+				}
+			case binlogdatapb.VEventType_COPY_COMPLETED:
+				if *mode == "copy" && ev.Keyspace == "" && ev.Shard == "" {
+					copyDone = true
+					stopNow()
+				}
+			}
+		}
+		if sctx.Err() != nil {
+			break
+		}
+	}
+	close(done)
+	scancel()
+	probeWG.Wait()
+	end := endTime.Load()
+	if end == 0 {
+		end = time.Now().UnixNano()
+	}
+	elapsed := time.Duration(end - start.UnixNano())
+	var ru1 syscall.Rusage
+	_ = syscall.Getrusage(syscall.RUSAGE_SELF, &ru1)
+	cpu := tv(ru1.Utime) + tv(ru1.Stime) - tv(ru0.Utime) - tv(ru0.Stime)
+
+	if *mode == "pos" {
+		return
+	}
+	secs := elapsed.Seconds()
+	var b strings.Builder
+	fmt.Fprintf(&b, "label=%s mode=%s elapsed=%.2fs first_event=%.2fs responses=%d events=%d rows=%d bytes=%d ev/s=%.0f rows/s=%.0f MB/s=%.1f client_cpu=%.2fs",
+		*label, *mode, secs, float64(firstEvent.Load()-start.UnixNano())/1e9, st.responses.Load(), st.events.Load(), st.rowChanges.Load(), st.bytes.Load(),
+		float64(st.events.Load())/secs, float64(st.rowChanges.Load())/secs, float64(st.bytes.Load())/secs/1e6, cpu)
+	if *mode == "copy" {
+		fmt.Fprintf(&b, " copy_done=%v", copyDone)
+	}
+	for t := range st.byType {
+		if v := st.byType[t].Load(); v > 0 {
+			fmt.Fprintf(&b, " %s=%d", binlogdatapb.VEventType(t).String(), v)
+		}
+	}
+	if n := st.lagN.Load(); n > 0 {
+		fmt.Fprintf(&b, " commit_lag_avg_ms=%d commit_lag_max_ms=%d", st.lagSumMs.Load()/n, st.lagMax.Load())
+	}
+	if len(latencies) > 0 {
+		slices.Sort(latencies)
+		fmt.Fprintf(&b, " probes=%d probe_lost=%d probe_p50_ms=%.1f probe_p90_ms=%.1f probe_p99_ms=%.1f probe_max_ms=%.1f",
+			len(latencies), len(probeSent), pct(latencies, 50), pct(latencies, 90), pct(latencies, 99), latencies[len(latencies)-1])
+	}
+	fmt.Println(b.String())
+}
+
+func tv(t syscall.Timeval) float64 { return float64(t.Sec) + float64(t.Usec)/1e6 }
+
+func pct(s []float64, p float64) float64 {
+	i := int(math.Ceil(p/100*float64(len(s)))) - 1
+	if i < 0 {
+		i = 0
+	}
+	return s[i]
+}
+
+// probeValues decodes a (id bigint, ts bigint) row.
+func probeValues(r *querypb.Row) (int64, int64) {
+	if len(r.Lengths) < 2 {
+		return 0, 0
+	}
+	l0 := int(r.Lengths[0])
+	id, _ := strconv.ParseInt(string(r.Values[:l0]), 10, 64)
+	ts, _ := strconv.ParseInt(string(r.Values[l0:l0+int(r.Lengths[1])]), 10, 64)
+	return id, ts
+}
+
+// gtidSeq returns N for a GTID set of a single source "flavor/uuid:1-N".
+func gtidSeq(gtid string) (int64, bool) {
+	if strings.Contains(gtid, ",") {
+		return 0, false
+	}
+	i := strings.LastIndexAny(gtid, ":-")
+	if i < 0 {
+		return 0, false
+	}
+	n, err := strconv.ParseInt(gtid[i+1:], 10, 64)
+	return n, err == nil
+}
+
+func readVGtid(file string) *binlogdatapb.VGtid {
+	b, err := os.ReadFile(file)
+	if err != nil {
+		log.Fatal(err)
+	}
+	v := &binlogdatapb.VGtid{}
+	if err := v.UnmarshalVT(b); err != nil {
+		log.Fatal(err)
+	}
+	return v
+}
diff --git a/proto/binlogdata.proto b/proto/binlogdata.proto
index 37424c0f9f..ffc29c1370 100644
--- a/proto/binlogdata.proto
+++ b/proto/binlogdata.proto
@@ -528,6 +528,12 @@ message VStreamOptions {
   bool no_timeouts = 4;
   // Only stream events for these types. If not provided, the default behavior is to send all event types.
   repeated VEventType event_types = 5;
+  // In the replication phase, the stream may send several transactions in one response
+  // when more binlog events are already waiting to be processed.
+  bool coalesce_transactions = 6;
+  // In the copy phase, send the rows of each batch of copied rows in one ROW event with many
+  // row changes, instead of one ROW event per copied row.
+  bool batch_copy_rows = 7;
 }
 
 // VStreamRequest is the payload for VStreamer
diff --git a/proto/vtgate.proto b/proto/vtgate.proto
index 1ecb3627e6..bd644cc5e1 100644
--- a/proto/vtgate.proto
+++ b/proto/vtgate.proto
@@ -387,6 +387,14 @@ message VStreamFlags {
   // A random jitter of +/-10% is added to spread out reconnections.
   // 0 means no maximum age.
   uint32 max_stream_age_seconds = 12;
+  // In the copy phase, send the rows of each batch of copied rows in one ROW event with many
+  // row changes, instead of one ROW event per copied row. Tablets that do not support it
+  // ignore it and send one ROW event per row.
+  bool batch_copy_rows = 13;
+  // Allow VTGate to send several transactions in one VStreamResponse when they are
+  // ready to be sent at the same time. Transactions are still complete (unless chunked)
+  // and in order. This lowers the CPU cost and the number of messages at high event rates.
+  bool coalesce_transactions = 14;
 }
 
 // VStreamRequest is the payload for VStream.
