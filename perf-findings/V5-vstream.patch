+// skewEvent returns an event whose commit timestamp is secondsAgo seconds in the past, as
+// computeSkew sees it.
+func skewEvent(secondsAgo int64) *binlogdatapb.VEvent {
+	now := time.Now()
+	return &binlogdatapb.VEvent{Type: binlogdatapb.VEventType_COMMIT, Timestamp: now.Unix() - secondsAgo, CurrentTime: now.UnixNano()}
+}
+
+func newSkewTestVStream(t *testing.T) *vstream {
+	if vstreamSkewDelayCount == nil {
+		vstreamSkewDelayCount = stats.NewCounter("VStreamEventsDelayedBySkewAlignment",
+			"Number of events that had to wait because the skew across shards was too high")
+	}
+	// Other tests expect the delay counter to start at 0.
+	t.Cleanup(vstreamSkewDelayCount.Reset)
+	return &vstream{timestamps: make(map[string]int64), vsm: &vstreamManager{}}
+}
+
+// TestComputeSkewDoesNotPauseStreamsCloseToTheLaggard checks that, when a skew is detected, a
+// stream that is not the laggard but within MaxSkew of it keeps going. It used to pause as well,
+// because the laggard's timestamp (lowestTS) was never set. If that stream is as slow as the
+// laggard, it can then never catch up, and all streams stay paused until the skew timeout.
+func TestComputeSkewDoesNotPauseStreamsCloseToTheLaggard(t *testing.T) {
+	vs := newSkewTestVStream(t)
+	require.False(t, vs.computeSkew("ks/a", skewEvent(100)))
+	require.False(t, vs.computeSkew("ks/b", skewEvent(100)))
+	// ks/c is far ahead of both: skew, and ks/c must pause.
+	require.True(t, vs.computeSkew("ks/c", skewEvent(0)))
+	require.Contains(t, []string{"ks/a", "ks/b"}, vs.laggard)
+	other := "ks/a"
+	if vs.laggard == "ks/a" {
+		other = "ks/b"
+	}
+	// The other slow stream is within MaxSkew of the laggard: it must not pause.
+	require.False(t, vs.computeSkew(other, skewEvent(99)))
+}
+
+// TestComputeSkewLaggardOvertakesPausedStream checks that when the laggard moves past a paused
+// stream (e.g. after a gap in its binlog timestamps), the paused streams are woken up and the
+// slowest stream becomes the laggard. The paused stream used to stay paused until the skew
+// timeout (10 minutes), since the skew could never be fixed while it was paused.
+func TestComputeSkewLaggardOvertakesPausedStream(t *testing.T) {
+	vs := newSkewTestVStream(t)
+	require.False(t, vs.computeSkew("ks/a", skewEvent(100)))
+	require.True(t, vs.computeSkew("ks/b", skewEvent(50)))
+	require.Equal(t, "ks/a", vs.laggard)
+	pausedCh := vs.skewCh
+
+	// ks/a jumps ahead of the paused ks/b: ks/b is woken up and becomes the laggard, and
+	// ks/a now waits for it.
+	require.True(t, vs.computeSkew("ks/a", skewEvent(10)))
+	select {
+	case <-pausedCh:
+	default:
+		require.Fail(t, "the paused streams were not woken up")
+	}
+	require.Equal(t, "ks/b", vs.laggard)
+	require.False(t, vs.computeSkew("ks/b", skewEvent(50)))
+}
