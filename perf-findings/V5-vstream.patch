+++ b/perf-findings/V5-scripts/live.sh
@@ -0,0 +1,28 @@
+#!/bin/bash
+# Steady-state CDC under a fixed-rate sysbench load through vtgate: N VStream consumers from "current"
+# (the first one also inserts probe rows every 50 ms and reports the commit->receive latency),
+# CPU seconds per process over the run.
+# Usage: live.sh LABEL NCLIENTS RATE SECONDS SBTEST [vsclient flags...]
+set -uo pipefail
+L=$1; N=$2; RATE=$3; SECS=$4; T=$5; shift 5
+C=/home/vt/perf/V5/c.sh
+O=/home/vt/perf/V5/out
+pids=()
+for i in $(seq 1 "$N"); do
+  PROBE=""
+  if [[ $i == 1 ]]; then PROBE="-probe-table v5probe -probe-base $(( $(date +%s%N) / 1000 ))"; fi
+  # shellcheck disable=SC2086
+  /home/vt/perf/V5/bin/vsclient -mode live -duration $((SECS + 4))s -label "$L#$i" -quiet $PROBE "$@" > "$O/live.$i.txt" &
+  pids+=($!)
+done
+sleep 2
+before=$($C cpu | tr '\n' ' ')
+t0=$(date +%s.%N)
+$C sb "$T" --threads=8 --time="$SECS" --rate="$RATE" --report-interval=0 run 2>&1 | grep -E 'transactions:|queries:|avg:|95th' | tr -s ' ' | tr '\n' ' '
+echo
+t1=$(date +%s.%N)
+after=$($C cpu | tr '\n' ' ')
+for p in "${pids[@]}"; do wait "$p"; done
+for i in $(seq 1 "$N"); do cat "$O/live.$i.txt"; done
+python3 /home/vt/perf/V5/cpudiff.py "$before" "$after" "$t0" "$t1"
+echo "uptime: $(uptime)"
diff --git a/perf-findings/V5-scripts/livestats.py b/perf-findings/V5-scripts/livestats.py
new file mode 100644
index 0000000000..117dc0ae74
--- /dev/null
+++ b/perf-findings/V5-scripts/livestats.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Summarize ablive.sh logs: per arm, sysbench trx/s, probe latency, CPU us per sysbench transaction."""
+import re
+import statistics
+import sys
+from collections import defaultdict
+
+runs = defaultdict(list)
+arm = None
+cur = None
+for line in open(sys.argv[1]):
+    m = re.match(r"=== \S+ arm=(\S+) round=(\d+)", line)
+    if m:
+        arm = m.group(1)
+        cur = {"clients": []}
+        continue
+    if "transactions:" in line:
+        m = re.search(r"transactions: (\d+) \(([\d.]+) per sec", line)
+        cur["trx"] = float(m.group(1))
+        cur["tps"] = float(m.group(2))
+        m = re.search(r"avg: ([\d.]+)", line)
+        cur["sb_avg"] = float(m.group(1)) if m else 0
+        m = re.search(r"95th percentile: ([\d.]+)", line)
+        cur["sb_p95"] = float(m.group(1)) if m else 0
+    elif line.startswith("label="):
+        cur["clients"].append(dict(re.findall(r"(\S+?)=(\S+)", line)))
+    elif line.startswith("cpu wall=") and cur and "trx" in cur:
+        kv = dict(re.findall(r"(\S+?)=([\d.]+)s?", line))
+        n = cur["trx"]
+        c0 = cur["clients"][0] if cur["clients"] else {}
+        runs[arm].append({
+            "tps": cur["tps"], "sb_avg": cur["sb_avg"], "sb_p95": cur["sb_p95"],
+            "vtgate": float(kv["vtgate"]) / n * 1e6, "vttablet": float(kv["vttablets"]) / n * 1e6,
+            "mysqld": float(kv["mysqlds"]) / n * 1e6,
+            "p50": float(c0.get("probe_p50_ms", "nan")), "p99": float(c0.get("probe_p99_ms", "nan")),
+            "pmax": float(c0.get("probe_max_ms", "nan")),
+        })
+
+cols = ["tps", "sb_avg", "sb_p95", "vtgate", "vttablet", "mysqld", "p50", "p99", "pmax"]
+print("arm        n " + " ".join(f"{c:>20}" for c in cols))
+for arm, rs in runs.items():
+    out = []
+    for c in cols:
+        v = [r[c] for r in rs]
+        out.append(f"{statistics.median(v):.1f} [{min(v):.1f}-{max(v):.1f}]")
+    print(f"{arm:10} {len(rs)} " + " ".join(f"{o:>20}" for o in out))
