+sleep "$DELAY"
+curl -s -o "$O/$NAME.vtgate.pprof" "http://localhost:30001/debug/pprof/profile?seconds=$SECS" &
+curl -s -o "$O/$NAME.vttablet.pprof" "http://localhost:30100/debug/pprof/profile?seconds=$SECS" &
