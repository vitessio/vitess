--- /dev/null
+++ b/perf-findings/V5-scripts/ablive.sh
@@ -0,0 +1,21 @@
+#!/bin/bash
+# A/B steady state: for each round and arm, restart once, then run live.sh cases (each locked).
+# Cases file lines: NAME NCLIENTS RATE SECONDS SYSBENCH_TEST [vsclient flags...]
+# Usage: ablive.sh NAME ROUNDS "ARMS" CASEFILE      Results: out/abl.NAME.CASENAME.log
+set -uo pipefail
+NAME=$1; R=$2; ARMS=$3; CASES=$4
+O=/home/vt/perf/V5/out
+for r in $(seq 1 "$R"); do
+  for arm in $ARMS; do
+    if [[ $arm == base ]]; then B=/home/vt/bin; else B=/home/vt/bin-V5$arm; fi
+    [[ -x $B/vttablet ]] || { echo "no binaries in $B" >&2; exit 1; }
+    BIN=$B /home/vt/perf/V5/c.sh restart >/dev/null 2>&1
+    sleep 3
+    while read -r cname n rate secs test flags; do
+      [[ -z $cname || $cname == \#* ]] && continue
+      echo "=== $cname arm=$arm round=$r flags=[$flags]" >> "$O/abl.$NAME.$cname.log"
+      # shellcheck disable=SC2086
+      flock -o /home/vt/perf/bench.lock /home/vt/perf/V5/live.sh "$arm" "$n" "$rate" "$secs" "$test" $flags >> "$O/abl.$NAME.$cname.log" 2>&1 < /dev/null
+    done < "$CASES"
+  done
+done
