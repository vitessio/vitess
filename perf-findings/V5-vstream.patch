+#!/bin/bash
+# Generate a binlog backlog directly on every shard primary's mysqld.
+# Usage: gen.sh WORKLOAD EVENTS_PER_SHARD   (WORKLOAD: write_only | update_non_index | upd100)
+set -euo pipefail
+W=$1; N=$2
+D=/home/vt/perf/c30000
+pids=()
+for s in $D/vt_*/mysql.sock; do
+  case $W in
+    write_only) T=oltp_write_only ;;
+    update_non_index) T=oltp_update_non_index ;;
+    upd100) T=/home/vt/perf/V5/upd100.lua ;;
+  esac
+  sysbench --db-driver=mysql --mysql-socket=$s --mysql-user=vt_dba --mysql-db=vt_sbtest --tables=4 --table-size=250000 \
+    --threads=4 --events=$N --time=0 $T run >/dev/null 2>&1 &
+  pids+=($!)
+done
+for p in "${pids[@]}"; do wait $p; done
