diff --git a/perf-findings/V5-scripts/abstats.py b/perf-findings/V5-scripts/abstats.py
new file mode 100644
index 0000000000..0ff043b46c
--- /dev/null
+++ b/perf-findings/V5-scripts/abstats.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Summarize ab.sh / abcopy.sh logs: per arm, median and range of wall time and CPU per unit.
+
+Usage: abstats.py LOG [unit]   unit: trx (COMMIT events, default for drains) or rows.
+"""
+import re
+import statistics
+import sys
+from collections import defaultdict
+
+log = sys.argv[1]
+unit = sys.argv[2] if len(sys.argv) > 2 else "trx"
+runs = defaultdict(list)
+arm = None
+cur = {}
+for line in open(log):
+    m = re.match(r"=== \S+ arm=(\S+) round=(\d+)", line)
+    if m:
+        arm = m.group(1)
+        cur = {}
+        continue
+    if line.startswith("label="):
+        kv = dict(re.findall(r"(\S+?)=(\S+)", line))
+        cur.setdefault("clients", []).append(kv)
+    elif line.startswith("cpu wall="):
+        kv = dict(re.findall(r"(\S+?)=([\d.]+)s?", line))
+        c = cur.get("clients", [])
+        if not c:
+            continue
+        n = float(c[0]["COMMIT"]) if unit == "trx" else float(c[0]["rows"])
+        runs[arm].append({
+            "wall": max(float(x["elapsed"].rstrip("s")) for x in c),
+            "vtgate": float(kv["vtgate"]) / n * 1e6,
+            "vttablet": float(kv["vttablets"]) / n * 1e6,
+            "mysqld": float(kv["mysqlds"]) / n * 1e6,
+            "client": sum(float(x["client_cpu"].rstrip("s")) for x in c) / n * 1e6,
+            "resp": sum(float(x["responses"]) for x in c) / len(c),
+            "bytes": float(c[0]["bytes"]) / n,
+        })
+
+print(f"{'arm':10} {'n':>2} {'wall s':>18} {'vtgate us/'+unit:>22} {'vttablets us/'+unit:>22} {'client us/'+unit:>20} {'responses':>10} {'B/'+unit:>7}")
+for arm, rs in runs.items():
+    def f(k, fmt="%.2f"):
+        v = [r[k] for r in rs]
+        return (fmt % statistics.median(v)) + " [" + (fmt % min(v)) + "-" + (fmt % max(v)) + "]"
+    print(f"{arm:10} {len(rs):>2} {f('wall'):>18} {f('vtgate'):>22} {f('vttablet'):>22} {f('client'):>20} {statistics.median([r['resp'] for r in rs]):>10.0f} {statistics.median([r['bytes'] for r in rs]):>7.0f}")
