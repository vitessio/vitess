+func TestCoalesceQueuedEvents(t *testing.T) {
+	coalesceFlags := &vtgatepb.VStreamFlags{CoalesceTransactions: true}
+	trx := func(gtid string, valueBytes int) []*binlogdatapb.VEvent {
+		return []*binlogdatapb.VEvent{
+			{Type: binlogdatapb.VEventType_BEGIN},
+			{Type: binlogdatapb.VEventType_ROW, RowEvent: &binlogdatapb.RowEvent{
+				RowChanges: []*binlogdatapb.RowChange{{After: &querypb.Row{Values: make([]byte, valueBytes)}}},
+			}},
+			{Type: binlogdatapb.VEventType_VGTID, Vgtid: &binlogdatapb.VGtid{ShardGtids: []*binlogdatapb.ShardGtid{{Gtid: gtid}}}},
+			{Type: binlogdatapb.VEventType_COMMIT},
+		}
+	}
+	gtids := func(evs []*binlogdatapb.VEvent) []string {
+		var res []string
+		for _, ev := range evs {
+			if ev.Type == binlogdatapb.VEventType_VGTID {
+				res = append(res, ev.Vgtid.ShardGtids[0].Gtid)
+			}
+		}
+		return res
+	}
+
+	t.Run("merges the queued transactions in order", func(t *testing.T) {
+		vs := &vstream{eventCh: make(chan []*binlogdatapb.VEvent, vstreamEventQueueSize), flags: coalesceFlags}
+		first := trx("1", 10)
+		vs.eventCh <- trx("2", 10)
+		vs.eventCh <- trx("3", 10)
+		evs, closed := vs.coalesceQueuedEvents(first)
+		require.False(t, closed)
+		assert.Equal(t, []string{"1", "2", "3"}, gtids(evs))
+		assert.Len(t, evs, 12)
+		assert.Len(t, first, 4, "the first batch must not be modified")
+		assert.Empty(t, vs.eventCh)
+	})
+
+	t.Run("stops at the size limit", func(t *testing.T) {
+		vs := &vstream{eventCh: make(chan []*binlogdatapb.VEvent, vstreamEventQueueSize), flags: coalesceFlags}
+		vs.eventCh <- trx("2", maxCoalescedSendBytes)
+		vs.eventCh <- trx("3", 10)
+		evs, closed := vs.coalesceQueuedEvents(trx("1", 10))
+		require.False(t, closed)
+		assert.Equal(t, []string{"1", "2"}, gtids(evs))
+		require.Len(t, vs.eventCh, 1)
+	})
+
+	t.Run("reports a closed channel", func(t *testing.T) {
+		vs := &vstream{eventCh: make(chan []*binlogdatapb.VEvent, vstreamEventQueueSize), flags: coalesceFlags}
+		vs.eventCh <- trx("2", 10)
+		close(vs.eventCh)
+		evs, closed := vs.coalesceQueuedEvents(trx("1", 10))
+		require.True(t, closed)
+		assert.Equal(t, []string{"1", "2"}, gtids(evs))
+	})
+
+	t.Run("does nothing unless the client allows it", func(t *testing.T) {
+		vs := &vstream{eventCh: make(chan []*binlogdatapb.VEvent, vstreamEventQueueSize), flags: &vtgatepb.VStreamFlags{}}
+		vs.eventCh <- trx("2", 10)
+		evs, closed := vs.coalesceQueuedEvents(trx("1", 10))
+		require.False(t, closed)
+		assert.Equal(t, []string{"1"}, gtids(evs))
+		require.Len(t, vs.eventCh, 1)
+	})
+
+	t.Run("does nothing on an unbuffered channel", func(t *testing.T) {
+		vs := &vstream{eventCh: make(chan []*binlogdatapb.VEvent), flags: coalesceFlags}
+		evs, closed := vs.coalesceQueuedEvents(trx("1", 10))
+		require.False(t, closed)
+		assert.Equal(t, []string{"1"}, gtids(evs))
+	})
+}
