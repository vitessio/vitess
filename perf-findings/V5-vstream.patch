+package servenv
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc/mem"
+	"google.golang.org/protobuf/proto"
+
+	querypb "vitess.io/vitess/go/vt/proto/query"
+)
+
+func TestCodecBufferPool(t *testing.T) {
+	p := newCodecBufferPool()
+	for _, length := range []int{0, 1, 255, 256, 257, 4096, 40 << 10, 250_000, 1 << 20, (1 << 20) + 1, 20 << 20} {
+		buf := p.Get(length)
+		require.Len(t, *buf, length)
+		for i := range *buf {
+			(*buf)[i] = 1
+		}
+		p.Put(buf)
+		// Whatever buffer we get back, it has the requested length.
+		buf = p.Get(length)
+		require.Len(t, *buf, length)
+		p.Put(buf)
+	}
+	// A buffer is only reused for lengths it can hold.
+	small := p.Get(300)
+	assert.Equal(t, 512, cap(*small))
+	p.Put(small)
+	big := p.Get(513)
+	assert.GreaterOrEqual(t, cap(*big), 513)
+}
+
+func TestCodecRoundTrip(t *testing.T) {
+	c := &Codec{}
+	msg := &querypb.QueryResult{RowsAffected: 7, Rows: []*querypb.Row{{Lengths: []int64{3}, Values: make([]byte, 100_000)}}}
+	for i := range msg.Rows[0].Values {
+		msg.Rows[0].Values[i] = byte(i)
+	}
+	data, err := c.Marshal(msg)
+	require.NoError(t, err)
+	// Split the data into frames, as the transport does.
+	flat := data.Materialize()
+	data.Free()
+	var frames mem.BufferSlice
+	for len(flat) > 0 {
+		n := min(len(flat), 16<<10)
+		frames = append(frames, mem.SliceBuffer(flat[:n]))
+		flat = flat[n:]
+	}
+	got := &querypb.QueryResult{}
+	require.NoError(t, c.Unmarshal(frames, got))
+	assert.True(t, proto.Equal(msg, got))
+}
