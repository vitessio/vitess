+++ b/perf-findings/V5-scripts/abcopy.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+# A/B VStream copy: for each round, for each arm (base=/home/vt/bin, X=/home/vt/bin-V5X; "X+batch" adds
+# -batch-copy), restart vtgate+vttablets with that arm (outside the lock), then copy under the lock.
+# Usage: abcopy.sh TAG ROUNDS "ARMS" [vsclient flags...]
+set -uo pipefail
+TAG=$1; R=$2; ARMS=$3; shift 3
+O=/home/vt/perf/V5/out
+for r in $(seq 1 "$R"); do
+  for arm in $ARMS; do
+    extra=()
+    a=${arm%+batch}
+    [[ $arm == *+batch ]] && extra=(-batch-copy)
+    if [[ $a == base ]]; then B=/home/vt/bin; else B=/home/vt/bin-V5$a; fi
+    [[ -x $B/vttablet ]] || { echo "no binaries in $B" >&2; exit 1; }
+    BIN=$B /home/vt/perf/V5/c.sh restart >/dev/null 2>&1
+    sleep 3
+    echo "=== $TAG arm=$arm round=$r flags=[$* ${extra[*]}]" | tee -a "$O/abcopy.$TAG.txt"
+    flock -o /home/vt/perf/bench.lock /home/vt/perf/V5/copy.sh "$arm" "$@" "${extra[@]}" | tee -a "$O/abcopy.$TAG.txt"
+  done
+done
