+#!/bin/bash
+# Create N small tables many_1..many_N (ROWS rows each, on every shard) for the many-tables copy test.
+set -euo pipefail
+N=${1:-40}; ROWS=${2:-1000}
+sql=""
+for i in $(seq 1 "$N"); do
+  sql+="CREATE TABLE IF NOT EXISTS many_$i (id INT NOT NULL, k INT NOT NULL DEFAULT 0, c CHAR(60) NOT NULL DEFAULT '', PRIMARY KEY (id)) ENGINE=InnoDB;"
+done
+/home/vt/perf/V5/c.sh vtctldclient ApplySchema --sql "$sql" sbtest >/dev/null
+for s in /home/vt/perf/c30000/vt_*/mysql.sock; do
+  for i in $(seq 1 "$N"); do
+    mysql -S "$s" -u vt_dba vt_sbtest -e "INSERT INTO many_$i (id, k, c) SELECT seq, seq, 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' FROM (WITH RECURSIVE r(seq) AS (SELECT 1 UNION ALL SELECT seq+1 FROM r WHERE seq < $ROWS) SELECT seq FROM r) t"
+  done
+done
