+set -uo pipefail
+NAME=$1; R=$2; ARMS=$3; TAGS=$4; N=$5; shift 5
+O=/home/vt/perf/V5/out
+for r in $(seq 1 "$R"); do
+  for arm in $ARMS; do
+    if [[ $arm == base ]]; then B=/home/vt/bin; else B=/home/vt/bin-V5$arm; fi
+    [[ -x $B/vttablet ]] || { echo "no binaries in $B" >&2; exit 1; }
+    BIN=$B /home/vt/perf/V5/c.sh restart >/dev/null 2>&1
+    sleep 3
+    for tag in $TAGS; do
+      echo "=== $tag arm=$arm round=$r flags=[$*]" >> "$O/abm.$NAME.$tag.log"
+      flock -o /home/vt/perf/bench.lock /home/vt/perf/V5/drain.sh "$arm" "$O/$tag.start" "$O/$tag.stop" "$N" "$@" >> "$O/abm.$NAME.$tag.log" 2>&1
+    done
+  done
+done
