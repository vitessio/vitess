 	"google.golang.org/grpc/encoding"
 	"google.golang.org/grpc/mem"
 
@@ -40,7 +43,65 @@ type Codec struct {
 
 func (Codec) Name() string { return Name }
 
-var defaultBufferPool = mem.DefaultBufferPool()
+// defaultBufferPool holds the buffers that messages are marshaled into and received
+// messages are assembled in. Both overwrite the whole requested length, so the buffers are
+// not zeroed. gRPC's default pool zeroes each buffer's whole capacity on every Get, and
+// only has tiers of 32KB and 1MB above 16KB: every message between 32KB and 1MB (e.g. every
+// full vstreamer packet or copy batch) cleared a 1MB buffer on both sides.
+var defaultBufferPool mem.BufferPool = newCodecBufferPool()
+
+const (
+	codecBufferPoolMinExponent = 8  // 256B
+	codecBufferPoolMaxExponent = 24 // 16MB
+)
+
+// codecBufferPool is a mem.BufferPool with a sub-pool for each power of two between
+// 2^codecBufferPoolMinExponent and 2^codecBufferPoolMaxExponent bytes, that returns
+// buffers without zeroing them. Larger buffers are allocated and dropped.
+type codecBufferPool struct {
+	pools [codecBufferPoolMaxExponent + 1]sync.Pool
+}
+
+func newCodecBufferPool() *codecBufferPool {
+	return &codecBufferPool{}
+}
+
+// exponent returns the exponent of the smallest pooled power of two >= size.
+func codecBufferExponent(size int) int {
+	if size <= 1<<codecBufferPoolMinExponent {
+		return codecBufferPoolMinExponent
+	}
+	return bits.Len(uint(size - 1))
+}
+
+// Get implements mem.BufferPool.
+func (p *codecBufferPool) Get(length int) *[]byte {
+	exp := codecBufferExponent(length)
+	if exp > codecBufferPoolMaxExponent {
+		buf := make([]byte, length)
+		return &buf
+	}
+	if buf, ok := p.pools[exp].Get().(*[]byte); ok {
+		*buf = (*buf)[:length]
+		return buf
+	}
+	buf := make([]byte, length, 1<<exp)
+	return &buf
+}
+
+// Put implements mem.BufferPool.
+func (p *codecBufferPool) Put(buf *[]byte) {
+	c := cap(*buf)
+	if c < 1<<codecBufferPoolMinExponent {
+		return
+	}
+	// The largest power of two <= c: a buffer only goes to a pool whose Get it can serve.
+	exp := bits.Len(uint(c)) - 1
+	if exp > codecBufferPoolMaxExponent {
+		return
+	}
+	p.pools[exp].Put(buf)
+}
 
