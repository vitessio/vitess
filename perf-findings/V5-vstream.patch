+#!/bin/bash
+# Full-table-copy via vtgate VStream (empty GTID), timed until the final COPY_COMPLETED.
+# Usage: copy.sh LABEL [vsclient flags...]
+set -uo pipefail
+L=$1; shift
+C=/home/vt/perf/V5/c.sh
+before=$($C cpu | tr '\n' ' ')
+t0=$(date +%s.%N)
+/home/vt/perf/V5/bin/vsclient -mode copy -label "$L" -quiet -timeout 20m "$@"
+t1=$(date +%s.%N)
+after=$($C cpu | tr '\n' ' ')
+python3 /home/vt/perf/V5/cpudiff.py "$before" "$after" "$t0" "$t1"
+echo "uptime: $(uptime)"
diff --git a/perf-findings/V5-scripts/cpudiff.py b/perf-findings/V5-scripts/cpudiff.py
new file mode 100644
index 0000000000..016eccd2d5
--- /dev/null
+++ b/perf-findings/V5-scripts/cpudiff.py
@@ -0,0 +1,12 @@
+import sys
+
+b = sys.argv[1].split()
+a = sys.argv[2].split()
+bd = dict(zip(b[0::2], map(float, b[1::2])))
+ad = dict(zip(a[0::2], map(float, a[1::2])))
+d = {k: ad[k] - bd.get(k, 0) for k in ad}
+vtt = sum(v for k, v in d.items() if k.startswith('vttablet'))
+my = sum(v for k, v in d.items() if k.startswith('mysqld'))
+print("cpu wall=%.2fs vtgate=%.2f vttablets=%.2f mysqlds=%.2f  %s" % (
+    float(sys.argv[4]) - float(sys.argv[3]), d.get('vtgate', 0), vtt, my,
+    ' '.join('%s=%.2f' % (k, v) for k, v in sorted(d.items()))))
