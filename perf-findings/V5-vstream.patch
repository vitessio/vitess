+const (
+	// vstreamEventQueueSize is the number of event batches (usually one transaction each) that the
+	// shard streams can queue for the goroutine that sends them to the client.
+	vstreamEventQueueSize = 16
+	// maxCoalescedSendBytes bounds the (approximate) size of the events that coalesceQueuedEvents
+	// merges into one send to the client.
+	maxCoalescedSendBytes = 256 * 1024
+	// coalescedEventOverheadBytes approximates the size of an event without its row values.
+	coalescedEventOverheadBytes = 64
+)
+
+// coalesceQueuedEvents appends the event batches that are already queued in eventCh to evs, so
+// that they are sent to the client in one message rather than one message (and usually one
+// write syscall) per transaction, when the client allows it (VStreamFlags.CoalesceTransactions).
+// It never waits for more events, so it adds no latency. It
+// returns true if it found eventCh closed.
+func (vs *vstream) coalesceQueuedEvents(evs []*binlogdatapb.VEvent) ([]*binlogdatapb.VEvent, bool) {
+	if !vs.flags.GetCoalesceTransactions() || cap(vs.eventCh) == 0 {
+		return evs, false
+	}
+	size := approxEventsSize(evs)
+	merged := false
+	for size < maxCoalescedSendBytes {
+		select {
+		case more, ok := <-vs.eventCh:
+			if !ok {
+				return evs, true
+			}
+			if !merged {
+				// Don't append to the caller's slice.
+				evs = append(make([]*binlogdatapb.VEvent, 0, 2*(len(evs)+len(more))), evs...)
+				merged = true
+			}
+			evs = append(evs, more...)
+			size += approxEventsSize(more)
+		default:
+			return evs, false
+		}
+	}
+	return evs, false
+}
+
+// approxEventsSize is a cheap estimate of the serialized size of events: the row values plus a
+// fixed overhead per event.
+func approxEventsSize(evs []*binlogdatapb.VEvent) int {
+	size := 0
+	for _, ev := range evs {
+		size += coalescedEventOverheadBytes
+		if ev.RowEvent != nil {
+			for _, rc := range ev.RowEvent.RowChanges {
+				size += len(rc.Before.GetValues()) + len(rc.After.GetValues())
+			}
+		}
+	}
+	return size
+}
