+// minStreamWorkers is the default lower bound on the number of gRPC stream
+// workers. A worker is busy for the whole lifetime of the stream it serves,
+// and long-lived streams (StreamHealth from every vtgate, VStream, and so on)
+// would otherwise take all GOMAXPROCS workers: every unary RPC would then run
+// on a newly started goroutine, which also has to grow its stack for the deep
+// query path. Idle workers only cost a parked goroutine each.
+const minStreamWorkers = 64
+
+// numStreamWorkers returns the number of gRPC stream workers to start.
+func numStreamWorkers() int {
+	if gRPCNumStreamWorkers > 0 {
+		return gRPCNumStreamWorkers
+	}
+	return max(runtime.GOMAXPROCS(0), minStreamWorkers)
