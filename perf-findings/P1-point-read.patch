new file mode 100644
index 0000000..9755922
--- /dev/null
+++ b/perf-findings/harness/P1-agg.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Aggregate bench.sh lines from ab.sh output files: mean (and min..max) per config/mode/threads."""
+import re
+import sys
+from collections import defaultdict
+
+rows = defaultdict(list)
+order = []
+for path in sys.argv[1:]:
+    for line in open(path):
+        m = re.match(r'(r\d+-)?(\S+)\s+(\S+)\s+thr=(\d+)\s+qps=(\S+)\s+avg=(\S+)\s+p95=(\S+)\s+p99=(\S+)\s+vtgate=(\d+) tablets=(\d+) mysqld=(\d+) load=(\S+)', line)
+        if not m:
+            continue
+        cfg, mode, thr = m.group(2), m.group(3), int(m.group(4))
+        vals = [float(m.group(i)) for i in range(5, 13)]
+        key = (mode, thr, cfg)
+        if key not in rows:
+            order.append(key)
+        rows[key].append(vals)
+
+names = ['qps', 'avg', 'p95', 'p99', 'vtgate', 'tablets', 'mysqld', 'load']
+base = {}
+print(f"| mode | thr | config | n | QPS | avg ms | p95 ms | p99 ms | vtgate µs/q | tablets µs/q | mysqld µs/q | load |")
+print("|---|---|---|---|---|---|---|---|---|---|---|---|")
+for key in sorted(order, key=lambda k: (k[0], k[1], order.index(k))):
+    v = rows[key]
+    n = len(v)
+    mean = [sum(x[i] for x in v) / n for i in range(8)]
+    lo = [min(x[i] for x in v) for i in range(8)]
+    hi = [max(x[i] for x in v) for i in range(8)]
+    mode, thr, cfg = key
+    if (mode, thr) not in base:
+        base[(mode, thr)] = mean
+    b = base[(mode, thr)]
+
+    def fmt(i, prec):
+        s = f"{mean[i]:.{prec}f}"
+        if b is not mean and b[i]:
+            s += f" ({(mean[i] / b[i] - 1) * 100:+.1f}%)"
+        return s + f" [{lo[i]:.{prec}f}–{hi[i]:.{prec}f}]" if i in (4, 5) else s
+    print(f"| {mode} | {thr} | {cfg} | {n} | {fmt(0,0)} | {fmt(1,2)} | {fmt(2,2)} | {fmt(3,2)} | {fmt(4,0)} | {fmt(5,0)} | {fmt(6,0)} | {mean[7]:.1f} |")
diff --git a/perf-findings/harness/P1-bench.sh b/perf-findings/harness/P1-bench.sh
new file mode 100755
index 0000000..8e3089a
--- /dev/null
+++ b/perf-findings/harness/P1-bench.sh
@@ -0,0 +1,27 @@
+#!/bin/bash
+# bench.sh MODE THREADS TIME [LABEL]
+#   MODE: ps (prepared, --db-ps-mode=auto) | text (--db-ps-mode=disable)
+# Prints one line: label mode threads qps avg p95 p99 cpu_us/query per process (vtgate, tablets sum, mysqld sum) + load
+set -u
+MODE=$1; THREADS=$2; TIME=$3; LABEL=${4:-run}
+C=/home/vt/perf/P1/c.sh
+if [[ $MODE == ps ]]; then PSM=auto; else PSM=disable; fi
+before=$($C cpu)
+out=$($C sb oltp_point_select --threads="$THREADS" --time="$TIME" --db-ps-mode=$PSM --histogram=on --report-interval=0 run 2>&1)
+after=$($C cpu)
+load=$(cut -d' ' -f1 /proc/loadavg)
+q=$(echo "$out" | awk '/queries:/ && /per sec/ {gsub(/[()]/,""); print $2; exit}')
+qps=$(echo "$out" | awk '/queries:/ && /per sec/ {gsub(/[()]/,""); print $3; exit}')
+avg=$(echo "$out" | awk '/avg:/ {print $2; exit}')
+# percentiles from histogram: lines "   value |  ***  count"
+pcts=$(echo "$out" | awk '
+  /Latency histogram/ {h=1; next}
+  h && /\|/ { v=$1; c=$NF; if (c ~ /^[0-9]+$/) { vals[n]=v; cnt[n]=c; tot+=c; n++ } }
+  h && /^$/ && n>0 {h=0}
+  END { s=0; p95=""; p99="";
+        for (i=0;i<n;i++){ s+=cnt[i]; if (p95=="" && s>=0.95*tot) p95=vals[i]; if (p99=="" && s>=0.99*tot) p99=vals[i]; }
+        printf "%s %s", p95, p99 }')
+cpu=$(paste <(echo "$before") <(echo "$after") | awk -v q="$q" '
+  { d=($4-$2)*1e6/q; if ($1 ~ /^vtgate/) g=d; else if ($1 ~ /^vttablet/) t+=d; else if ($1 ~ /^mysqld/) m+=d }
+  END { printf "vtgate=%.0f tablets=%.0f mysqld=%.0f", g, t, m }')
+printf "%-12s %-4s thr=%-3s qps=%-8s avg=%-5s p95=%-6s p99=%-6s %s load=%s\n" "$LABEL" "$MODE" "$THREADS" "$qps" "$avg" $pcts "$cpu" "$load"
