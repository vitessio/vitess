+// BenchmarkBufferedWriteRows writes 1000 small rows through the buffered
+// writer, which is the path used for every result set sent by a server.
+func BenchmarkBufferedWriteRows(b *testing.B) {
+	rc := &recordingConn{}
+	c := newConn(rc, DefaultFlushDelay, 0)
+	row := []sqltypes.Value{sqltypes.NewInt64(12345), sqltypes.NewVarChar("some short value")}
+	b.ReportAllocs()
+	for b.Loop() {
+		c.startWriterBuffering()
+		for range 1000 {
+			if err := c.writeRow(row); err != nil {
+				b.Fatal(err)
+			}
+		}
+		if err := c.endWriterBuffering(); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+// BenchmarkBufferedWriteRowsParallel is BenchmarkBufferedWriteRows with one
+// connection per goroutine, to include contention on the runtime timers.
+func BenchmarkBufferedWriteRowsParallel(b *testing.B) {
+	row := []sqltypes.Value{sqltypes.NewInt64(12345), sqltypes.NewVarChar("some short value")}
+	b.RunParallel(func(pb *testing.PB) {
+		c := newConn(&recordingConn{}, DefaultFlushDelay, 0)
+		for pb.Next() {
+			c.startWriterBuffering()
+			for range 1000 {
+				if err := c.writeRow(row); err != nil {
+					b.Error(err)
+					return
+				}
+			}
+			if err := c.endWriterBuffering(); err != nil {
+				b.Error(err)
+				return
+			}
+		}
+	})
+}
