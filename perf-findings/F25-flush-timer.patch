+// onFlushTimer runs when the flush timer fires.
+func (c *Conn) onFlushTimer() {
+	c.bufMu.Lock()
+	defer c.bufMu.Unlock()
+
+	c.flushPending = false
+	if c.bufferedWriter == nil {
+		return
+	}
+	c.bufferedWriter.Flush()
+}
+
+// stopFlushTimer disarms the flush timer before an explicit flush.
+// It must be called while holding lock on bufMu.
+func (c *Conn) stopFlushTimer() {
+	c.flushPending = false
+	if c.flushTimer != nil {
+		c.flushTimer.Stop()
+	}
+}
