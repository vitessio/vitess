+		b.Run(bc.name, func(b *testing.B) {
+			b.SetBytes(int64(len(s)))
+			for b.Loop() {
+				var buf strings.Builder
+				legacyBufEncodeStringSQL(&buf, s)
+				_ = buf.String()
+			}
+		})
+	}
+}
