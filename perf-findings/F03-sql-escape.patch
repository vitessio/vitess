+package sqltypes
+
+import (
+	"strings"
+
+	"vitess.io/vitess/go/bytes2"
+)
+
+// The functions in this file are the byte-at-a-time SQL string escapers that
+// the run-copying escapers in value.go replaced. They are kept as the reference
+// implementation for the equivalence fuzz tests and the benchmarks.
+
+func legacyEncodeBytesSQL(val []byte, b BinWriter) {
+	buf := &bytes2.Buffer{}
+	legacyEncodeBytesSQLBytes2(val, buf)
+	b.Write(buf.Bytes())
+}
+
+func legacyEncodeBytesSQLBytes2(val []byte, buf *bytes2.Buffer) {
+	buf.WriteByte('\'')
+	for idx, ch := range val {
+		if ch == '\\' && idx+1 < len(val) && (val[idx+1] == '%' || val[idx+1] == '_') {
+			buf.WriteByte(ch)
+			continue
+		}
+		if encodedChar := SQLEncodeMap[ch]; encodedChar == DontEscape {
+			buf.WriteByte(ch)
+		} else {
+			buf.WriteByte('\\')
+			buf.WriteByte(encodedChar)
+		}
+	}
+	buf.WriteByte('\'')
+}
+
+func legacyEncodeBytesSQLStringBuilder(val []byte, buf *strings.Builder) {
+	buf.WriteByte('\'')
+	for idx, ch := range val {
+		if ch == '\\' && idx+1 < len(val) && (val[idx+1] == '%' || val[idx+1] == '_') {
+			buf.WriteByte(ch)
+			continue
+		}
+		if encodedChar := SQLEncodeMap[ch]; encodedChar == DontEscape {
+			buf.WriteByte(ch)
+		} else {
+			buf.WriteByte('\\')
+			buf.WriteByte(encodedChar)
+		}
+	}
+	buf.WriteByte('\'')
+}
+
+func legacyBufEncodeStringSQL(buf *strings.Builder, val string) {
+	buf.WriteByte('\'')
+	for idx, ch := range val {
+		if ch > 255 {
+			buf.WriteRune(ch)
+			continue
+		}
+		if ch == '\\' && idx+1 < len(val) && (val[idx+1] == '%' || val[idx+1] == '_') {
+			buf.WriteRune(ch)
+			continue
+		}
+		if encodedChar := SQLEncodeMap[ch]; encodedChar == DontEscape {
+			buf.WriteRune(ch)
+		} else {
+			buf.WriteByte('\\')
+			buf.WriteByte(encodedChar)
+		}
+	}
+	buf.WriteByte('\'')
+}
