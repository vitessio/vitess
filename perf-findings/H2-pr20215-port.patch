+		3*(mysql.PacketHeaderSize+len(makeTestRowPayload("a", "b"))) + // 3 rows
+		(mysql.PacketHeaderSize + len(eofPayload())) // terminal EOF
+	assert.Equal(t, expectedSize, totalBytes)
