 	}
 
+	if i := searchShardForKeyspaceID(allShards, keyspaceID); i >= 0 {
+		return allShards[i].Name, nil
+	}
+
+	// Fall back to a linear scan. This handles shard lists that are not
+	// sorted by KeyRange start, and produces the error below when no shard
+	// contains the keyspace id.
 	for _, shardReference := range allShards {
 		if KeyRangeContains(shardReference.KeyRange, keyspaceID) {
