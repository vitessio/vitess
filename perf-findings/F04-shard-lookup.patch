@@ -227,6 +235,41 @@ func GetShardForKeyspaceID(allShards []*topodatapb.ShardReference, keyspaceID []
 	return "", vterrors.Errorf(vtrpcpb.Code_INVALID_ARGUMENT, "KeyspaceId %v didn't match any shards %+v", hex.EncodeToString(keyspaceID), allShards)
 }
 
+// searchShardForKeyspaceID returns the index of a shard in allShards whose
+// KeyRange contains keyspaceID, or -1 if it can't find one quickly.
+//
+// It binary searches allShards on the assumption that the shards are sorted
+// by KeyRange start, which is how topo.OrderAndCheckPartitions leaves every
+// rebuilt SrvKeyspace partition. The candidate is always verified with
+// KeyRangeContains, so an unsorted or gapped shard list can only cause a miss
+// (-1) and never a wrong answer. When the shard KeyRanges are disjoint (which
+// OrderAndCheckPartitions enforces), at most one shard can contain
+// keyspaceID, so the result is the same one a linear scan would find.
+func searchShardForKeyspaceID(allShards []*topodatapb.ShardReference, keyspaceID []byte) int {
+	// A linear scan returns the first shard when it matches. This also covers
+	// the unsharded and custom-sharded cases, where KeyRanges are nil.
+	if KeyRangeContains(allShards[0].KeyRange, keyspaceID) {
+		return 0
+	}
+
+	// Find the first shard after allShards[0] whose start is greater than
+	// keyspaceID; the candidate is the shard just before it.
+	id := Normalize(keyspaceID)
+	lo, hi := 1, len(allShards)
+	for lo < hi {
+		mid := int(uint(lo+hi) >> 1)
+		if bytes.Compare(Normalize(allShards[mid].GetKeyRange().GetStart()), id) <= 0 {
+			lo = mid + 1
+		} else {
+			hi = mid
+		}
+	}
+	if c := lo - 1; c > 0 && KeyRangeContains(allShards[c].KeyRange, keyspaceID) {
+		return c
+	}
+	return -1
+}
