+
+// rowDestinations returns a destination for every non-nil keyspace id, along
+// with its row index encoded as a decimal querypb.Value, so that the row
+// indexes can be recovered per shard from ResolveDestinations. The values
+// and their bytes are carved out of shared backing arrays to avoid several
+// allocations per row.
+func rowDestinations(keyspaceIDs [][]byte) ([]*querypb.Value, []key.ShardDestination) {
+	n := 0
+	for _, ksid := range keyspaceIDs {
+		if ksid != nil {
+			n++
+		}
+	}
+	if n == 0 {
+		return nil, nil
+	}
+	values := make([]querypb.Value, n)
+	indexes := make([]*querypb.Value, n)
+	destinations := make([]key.ShardDestination, n)
+	// Every index has at most as many digits as the largest one.
+	buf := make([]byte, 0, n*len(strconv.Itoa(len(keyspaceIDs)-1)))
+	j := 0
+	for i, ksid := range keyspaceIDs {
+		if ksid == nil {
+			continue
+		}
+		start := len(buf)
+		buf = strconv.AppendInt(buf, int64(i), 10)
+		values[j].Value = buf[start:len(buf):len(buf)]
+		indexes[j] = &values[j]
+		destinations[j] = key.DestinationKeyspaceID(ksid)
+		j++
+	}
+	return indexes, destinations
+}
