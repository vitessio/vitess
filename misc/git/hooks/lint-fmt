# golangci-lint is version-pinned in its own module; `go tool` builds and
# caches the pinned version on demand.
GOLANGCI_LINT_MODFILE="$(git rev-parse --show-toplevel)/tools/golangci-lint/go.mod"

# List the staged .go files to lint. While committing a merge, the index differs
# from HEAD in everything the other parents brought in, which was already linted
# on their own branches. Only the files with hunks that match none of the
# parents (conflict resolutions and the like) hold something the merge itself
# introduced, so only those are linted. Whenever that selection cannot be
# computed, fall back to every staged file: linting too much beats skipping lint.
#
# File names are read NUL-terminated, since git quotes unusual names otherwise.
staged_go_files() {
  local merge_head_file tree files
  merge_head_file=$(git rev-parse --git-path MERGE_HEAD)
  # shellcheck disable=SC2046
  if [ -f "$merge_head_file" ] && tree=$(git write-tree) \
    && files=$(merge_go_files "$tree" HEAD $(cat "$merge_head_file")); then
    echo "$files"
    return
  fi

  git diff --cached --name-only -z --diff-filter=ACMR -- '*.go' | tr '\0' '\n'
}

# Print the .go files of the merge result (the first tree) that have a hunk
# matching none of the parents (the other trees). -c --name-only lists the files
# that differ from every parent, which includes files that merged cleanly with
# changes from both sides. Only the --cc patch drops those, so keep a file when
# its --cc patch is not empty. --no-ext-diff and --no-textconv make that patch
# compare the actual blobs whatever the user's config says.
merge_go_files() (
  set -o pipefail
  git diff --name-only -z -c "$@" -- '*.go' \
    | while IFS= read -r -d '' file; do
        [ -f "$file" ] || continue
        patch=$(git diff --no-color --no-ext-diff --no-textconv --cc "$@" -- ":(literal)$file") || exit 1
        if [ -n "$patch" ]; then
          echo "$file"
        fi
      done
)

# Lint only changed packages. Packages in nested Go modules
# are skipped: golangci-lint can only typecheck belonging
# to the module it runs in, and CI doesn't lint them either.
staged_files=$(staged_go_files)
if [ -z "$staged_files" ]; then
  echo "No staged .go files, skipping lint."
  exit 0
fi

changed_pkgs=$(echo "$staged_files" \
  | while IFS= read -r file; do dirname -- "$file"; done \
  | sort -u \
  | while read -r dir; do
      mod_dir=$dir
      while [ "$mod_dir" != "." ] && [ ! -f "$mod_dir/go.mod" ]; do
        mod_dir=$(dirname "$mod_dir")
      done
      if [ "$mod_dir" = "." ]; then
        echo "$dir/..."
      else
        echo "skipping $dir (nested module $mod_dir)" >&2
      fi
    done)

if [ -z "$changed_pkgs" ]; then
  echo "No staged .go files, skipping lint."
  exit 0
fi

echo "Linting staged changes..."
go tool -modfile="$GOLANGCI_LINT_MODFILE" golangci-lint run --new-from-rev=HEAD $changed_pkgs
