+package sqlancer.mysql.vitess;
+
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.sql.Statement;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+import sqlancer.IgnoreMeException;
+import sqlancer.SQLConnection;
+import sqlancer.common.oracle.TestOracle;
+import sqlancer.common.query.ExpectedErrors;
+import sqlancer.mysql.MySQLErrors;
+import sqlancer.mysql.MySQLGlobalState;
+
+/**
+ * Runs the same query on vtgate and on the reference MySQL database and compares the results. Problems are recorded
+ * with {@link VitessFindings} instead of stopping the run:
+ *
+ * <ul>
+ * <li>unsupported: vtgate fails, MySQL does not.</li>
+ * <li>mismatch: different rows (as multisets).</li>
+ * <li>precision: the same rows, except for numbers that differ by a rounding error or in their formatting.</li>
+ * <li>order: the same rows in a different order, for a query that orders by all its (numeric) columns.</li>
+ * <li>mysql-error: MySQL fails, vtgate does not.</li>
+ * <li>connection-lost: vtgate closed the connection, usually because it panicked.</li>
+ * </ul>
+ */
+public class MySQLVitessDiffOracle implements TestOracle<MySQLGlobalState> {
+
+    private static final double RELATIVE_TOLERANCE = 1e-9;
+    private static final int CANARY_INTERVAL = 200;
+    private static final String CANARY_QUERY = "SELECT FALSE, TRUE, NULL IS TRUE";
+
+    private final MySQLGlobalState state;
+    private final ExpectedErrors errors;
+    private String lastQuery;
+    private int checks;
+
+    public MySQLVitessDiffOracle(MySQLGlobalState state) {
+        this.state = state;
+        this.errors = ExpectedErrors.newErrors().with(MySQLErrors.getExpressionErrors())
+                .withRegex(MySQLErrors.getExpressionRegexErrors()).build();
+    }
+
+    @Override
+    public void check() throws Exception {
+        VitessReference reference = state.getVitessReference();
+        if (reference == null) {
+            throw new AssertionError("the VITESS_DIFF oracle needs --vitess-reference-url");
+        }
+        VitessQueryGenerator generator = new VitessQueryGenerator(state);
+        String query = generator.generate();
+        lastQuery = query;
+        state.getState().getLocalState().log(query);
+        SQLConnection vtgateConnection = state.getConnection();
+        Connection mysqlConnection = reference.getConnection();
+        Result vtgate;
+        Result mysql;
+        if (state.getDbmsSpecificOptions().vitessPrepared) {
+            // vtgate runs the query as a server-side prepared statement, with its literals as typed parameters.
+            // vtgate executes a prepared statement by putting the parameter values back into the query, so the result
+            // must be that of the query with the literals. MySQL's own prepared statements are not the reference:
+            // MySQL derives a type for each parameter from its context (for example DOUBLE for "-?"), which gives
+            // other result types than the literals.
+            VitessParameters prepared = VitessParameters.parameterize(query);
+            mysql = run(mysqlConnection::createStatement, query);
+            query = prepared.toString();
+            lastQuery = query;
+            vtgate = runPrepared(sql -> (PreparedStatement) vtgateConnection.prepareStatement(sql), prepared);
+        } else {
+            vtgate = run(vtgateConnection::createStatement, query);
+            mysql = run(mysqlConnection::createStatement, query);
+        }
+        if (++checks % CANARY_INTERVAL == 0) {
+            checkCanary(vtgateConnection, query);
+        }
+
+        if (vtgate.error != null && mysql.error != null) {
+            throw new IgnoreMeException();
+        }
+        if (vtgate.error != null) {
+            if (vtgate.error.contains("No operations allowed after connection closed")) {
+                // Already reported as connection-lost; the remaining queries of this database are skipped.
+                throw new IgnoreMeException();
+            }
+            if (vtgate.error.contains("Communications link failure")) {
+                // vtgate closed the connection, usually after a panic.
+                VitessFindings.report(state, new VitessFindings.Finding("connection-lost",
+                        "vtgate closed the connection", query, "vtgate: " + vtgate.error));
+                throw new IgnoreMeException();
+            }
+            if (!errors.errorIsExpected(vtgate.error)) {
+                VitessFindings.report(state, new VitessFindings.Finding("unsupported",
+                        VitessFindings.normalize(vtgate.error), query, "vtgate: " + vtgate.error));
+            }
+            throw new IgnoreMeException();
+        }
+        if (mysql.error != null) {
+            if (!errors.errorIsExpected(mysql.error)) {
+                VitessFindings.report(state,
+                        new VitessFindings.Finding("mysql-error", VitessFindings.normalize(mysql.error), query,
+                                "MySQL: " + mysql.error + "\nvtgate returned " + vtgate.rows));
+            }
+            throw new IgnoreMeException();
+        }
+        String features = VitessQueryGenerator.describe(query)
+                + (state.getDbmsSpecificOptions().vitessPrepared ? ",prepared" : "");
+        String details = "vtgate: " + vtgate.rows + "\nMySQL:  " + mysql.rows;
+        if (vtgate.columns != mysql.columns) {
+            VitessFindings.report(state,
+                    new VitessFindings.Finding("mismatch", "column count " + features, query, details));
+            return;
+        }
+        List<List<String>> v = sorted(vtgate.rows);
+        List<List<String>> m = sorted(mysql.rows);
+        if (!v.equals(m)) {
+            boolean close = v.size() == m.size();
+            for (int i = 0; close && i < v.size(); i++) {
+                close = approximatelyEqual(v.get(i), m.get(i));
+            }
+            VitessFindings.report(state,
+                    new VitessFindings.Finding(close ? "precision" : "mismatch", features, query, details));
+            return;
+        }
+        if (generator.isOrdered() && allNumeric(vtgate.rows) && !vtgate.rows.equals(mysql.rows)) {
+            VitessFindings.report(state, new VitessFindings.Finding("order", features, query, details));
+        }
+    }
+
+    // A query can corrupt state that vtgate shares between sessions (for example its TRUE and FALSE values), which
+    // would make every later comparison of this vtgate meaningless.
+    private void checkCanary(SQLConnection vtgate, String query) {
+        Result canary = run(vtgate::createStatement, CANARY_QUERY);
+        if (canary.error == null && !canary.rows.equals(List.of(List.of("0", "1", "0")))) {
+            VitessFindings.report(state,
+                    new VitessFindings.Finding("vtgate-corrupted", CANARY_QUERY + " returned " + canary.rows, query,
+                            "vtgate returned " + canary.rows + " for " + CANARY_QUERY + " after the last "
+                                    + CANARY_INTERVAL
+                                    + " queries; this is the last of them. Restart vtgate before further runs."));
+            throw new AssertionError("vtgate state is corrupted: " + CANARY_QUERY + " returned " + canary.rows);
+        }
+    }
+
+    @Override
+    public String getLastQueryString() {
+        return lastQuery;
+    }
+
+    private static final class Result {
+        private String error;
+        private int columns;
+        private final List<List<String>> rows = new ArrayList<>();
+    }
+
+    private static Result run(VitessReference.StatementFactory factory, String query) {
+        Result r = new Result();
+        try (Statement s = factory.create(); ResultSet rs = s.executeQuery(query)) {
+            r.columns = rs.getMetaData().getColumnCount();
+            while (rs.next()) {
+                List<String> row = new ArrayList<>(r.columns);
+                for (int i = 1; i <= r.columns; i++) {
+                    row.add(rs.getString(i));
+                }
+                r.rows.add(row);
+            }
+        } catch (SQLException e) {
+            r.error = e.getMessage() == null ? e.toString() : e.getMessage();
+        }
+        return r;
+    }
+
+    private interface Preparer {
+        PreparedStatement prepare(String sql) throws SQLException;
+    }
+
+    private static Result runPrepared(Preparer preparer, VitessParameters prepared) {
+        Result r = new Result();
+        try (PreparedStatement s = preparer.prepare(prepared.getSql())) {
+            prepared.bind(s);
+            try (ResultSet rs = s.executeQuery()) {
+                r.columns = rs.getMetaData().getColumnCount();
+                while (rs.next()) {
+                    List<String> row = new ArrayList<>(r.columns);
+                    for (int i = 1; i <= r.columns; i++) {
+                        row.add(rs.getString(i));
+                    }
+                    r.rows.add(row);
+                }
+            }
+        } catch (SQLException e) {
+            r.error = e.getMessage() == null ? e.toString() : e.getMessage();
+        }
+        return r;
+    }
+
+    private static List<List<String>> sorted(List<List<String>> rows) {
+        List<List<String>> copy = new ArrayList<>(rows);
+        Collections.sort(copy, (a, b) -> String.valueOf(a).compareTo(String.valueOf(b)));
+        return copy;
+    }
+
+    private static boolean approximatelyEqual(List<String> a, List<String> b) {
+        for (int i = 0; i < a.size(); i++) {
+            String x = a.get(i);
+            String y = b.get(i);
+            if (x == null || y == null) {
+                if (x != y) {
+                    return false;
+                }
+                continue;
+            }
+            if (x.equals(y)) {
+                continue;
+            }
+            try {
+                double dx = Double.parseDouble(x);
+                double dy = Double.parseDouble(y);
+                if (Math.abs(dx - dy) > RELATIVE_TOLERANCE * Math.max(Math.abs(dx), Math.abs(dy))) {
+                    return false;
+                }
+            } catch (NumberFormatException e) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean allNumeric(List<List<String>> rows) {
+        for (List<String> row : rows) {
+            for (String value : row) {
+                if (value != null && !value.matches("-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?")) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+}
diff --git a/src/sqlancer/mysql/vitess/VitessFindings.java b/src/sqlancer/mysql/vitess/VitessFindings.java
new file mode 100644
index 0000000..73ad357
--- /dev/null
+++ b/src/sqlancer/mysql/vitess/VitessFindings.java
@@ -0,0 +1,141 @@
+package sqlancer.mysql.vitess;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.nio.file.StandardOpenOption;
+import java.util.HashMap;
+import java.util.Map;
+
+import sqlancer.common.query.Query;
+import sqlancer.mysql.MySQLGlobalState;
+
+/**
+ * Records problems found by the Vitess oracles without stopping the run. Every finding is a line in
+ * logs/vitess/findings.jsonl; the first findings of each kind also get a reproduction file with the statements that
+ * created the database state.
+ */
+public final class VitessFindings {
+
+    private static final int REPRODUCTIONS_PER_SIGNATURE = 3;
+    private static final Map<String, Integer> COUNTS = new HashMap<>();
+    private static final ThreadLocal<String> DIVERGING_STATEMENT = new ThreadLocal<>();
+
+    private VitessFindings() {
+    }
+
+    static void setDivergingStatement(String sql) {
+        DIVERGING_STATEMENT.set(sql);
+    }
+
+    // Normalizes an error message so that errors that differ only in values are grouped together.
+    public static String normalize(String message) {
+        String m = message.replaceAll("'[^']*'", "'?'").replaceAll("\"[^\"]*\"", "\"?\"").replaceAll("\\d+", "N")
+                .replaceAll("\\s+", " ").trim();
+        return m.length() > 200 ? m.substring(0, 200) : m;
+    }
+
+    // A problem found by an oracle. The query is null for problems in the database state.
+    public static final class Finding {
+        private final String category;
+        private final String signature;
+        private final String query;
+        private final String details;
+
+        public Finding(String category, String signature, String query, String details) {
+            this.category = category;
+            this.signature = signature;
+            this.query = query;
+            this.details = details;
+        }
+    }
+
+    public static synchronized void report(MySQLGlobalState state, Finding f) {
+        String category = f.category;
+        String signature = f.signature;
+        String query = f.query;
+        String details = f.details;
+        String key = category + "|" + signature;
+        int count = COUNTS.merge(key, 1, Integer::sum);
+        try {
+            Path dir = Paths.get("logs", "vitess");
+            Files.createDirectories(dir);
+            String repro = "";
+            if (count <= REPRODUCTIONS_PER_SIGNATURE) {
+                repro = category + "-" + Integer.toHexString(key.hashCode()) + "-" + count + ".sql";
+                Files.write(dir.resolve(repro),
+                        reproduction(state, category, signature, query, details).getBytes(StandardCharsets.UTF_8));
+            }
+            String line = "{\"category\":" + json(category) + ",\"signature\":" + json(signature) + ",\"keyspace\":"
+                    + json(state.getDatabaseName()) + ",\"query\":" + json(query) + ",\"details\":" + json(details)
+                    + ",\"repro\":" + json(repro) + "}\n";
+            Files.write(dir.resolve("findings.jsonl"), line.getBytes(StandardCharsets.UTF_8), StandardOpenOption.CREATE,
+                    StandardOpenOption.APPEND);
+        } catch (IOException e) {
+            throw new AssertionError(e);
+        }
+    }
+
+    private static String reproduction(MySQLGlobalState state, String category, String signature, String query,
+            String details) {
+        StringBuilder sb = new StringBuilder();
+        sb.append("-- category: ").append(category).append('\n');
+        sb.append("-- signature: ").append(signature).append('\n');
+        for (String line : details.split("\n")) {
+            sb.append("-- ").append(line).append('\n');
+        }
+        sb.append("-- Run on vtgate (keyspace ").append(state.getDatabaseName())
+                .append(") and on a MySQL database; ALTER VSCHEMA only applies to vtgate.\n");
+        for (Query<?> q : state.getState().getStatements()) {
+            String sql = q.getQueryString().trim();
+            sb.append(sql).append(sql.endsWith(";") ? "\n" : ";\n");
+        }
+        String diverging = DIVERGING_STATEMENT.get();
+        if (diverging != null && query == null) {
+            sb.append("-- first statement that failed only on MySQL:\n").append(diverging).append(";\n");
+        }
+        if (query != null) {
+            sb.append(query).append(";\n");
+        }
+        return sb.toString();
+    }
+
+    static void clearDivergingStatement() {
+        DIVERGING_STATEMENT.remove();
+    }
+
+    private static String json(String s) {
+        if (s == null) {
+            return "null";
+        }
+        StringBuilder sb = new StringBuilder("\"");
+        for (char c : s.toCharArray()) {
+            switch (c) {
+            case '"':
+                sb.append("\\\"");
+                break;
+            case '\\':
+                sb.append("\\\\");
+                break;
+            case '\n':
+                sb.append("\\n");
+                break;
+            case '\r':
+                sb.append("\\r");
+                break;
+            case '\t':
+                sb.append("\\t");
+                break;
+            default:
+                if (c < 0x20) {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+        }
+        return sb.append('"').toString();
+    }
+}
diff --git a/src/sqlancer/mysql/vitess/VitessParameters.java b/src/sqlancer/mysql/vitess/VitessParameters.java
new file mode 100644
index 0000000..89fe978
--- /dev/null
+++ b/src/sqlancer/mysql/vitess/VitessParameters.java
@@ -0,0 +1,318 @@
+package sqlancer.mysql.vitess;
+
+import java.math.BigDecimal;
+import java.sql.PreparedStatement;
+import java.sql.SQLException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+/**
+ * Turns the literals of a query into parameters of a prepared statement, so that vtgate receives them as typed values
+ * through the binary protocol instead of as SQL text.
+ *
+ * <p>
+ * Each parameter gets the type that MySQL gives the literal: an integer that fits into a {@code BIGINT} becomes a
+ * {@code long}, an exact decimal (or a larger integer) a {@link BigDecimal}, a literal with an exponent a
+ * {@code double}, and a quoted string a {@code String}. Literals that cannot be parameters stay as they are: column
+ * positions in {@code ORDER BY} and {@code GROUP BY}, the length and precision of a type, and strings with a character
+ * set introducer.
+ */
+public final class VitessParameters {
+
+    private static final Set<String> TYPES = Set.of("DECIMAL", "CHAR", "BINARY", "VARCHAR", "FLOAT", "DOUBLE",
+            "DATETIME", "TIME", "TIMESTAMP", "NUMERIC", "DEC");
+
+    private final String sql;
+    private final List<Parameter> parameters;
+    private boolean groupByParameter;
+
+    public enum Kind {
+        LONG, DECIMAL, DOUBLE, STRING
+    }
+
+    public static final class Parameter {
+        private final Kind kind;
+        private final String literal;
+        private final Object value;
+
+        Parameter(Kind kind, String literal, Object value) {
+            this.kind = kind;
+            this.literal = literal;
+            this.value = value;
+        }
+
+        public Kind getKind() {
+            return kind;
+        }
+
+        public Object getValue() {
+            return value;
+        }
+
+        @Override
+        public String toString() {
+            return kind.name().toLowerCase(Locale.ROOT) + " " + literal;
+        }
+    }
+
+    private VitessParameters(String sql, List<Parameter> parameters) {
+        this.sql = sql;
+        this.parameters = parameters;
+    }
+
+    public String getSql() {
+        return sql;
+    }
+
+    public List<Parameter> getParameters() {
+        return parameters;
+    }
+
+    public void bind(PreparedStatement s) throws SQLException {
+        for (int i = 0; i < parameters.size(); i++) {
+            Parameter p = parameters.get(i);
+            switch (p.kind) {
+            case LONG:
+                s.setLong(i + 1, (Long) p.value);
+                break;
+            case DECIMAL:
+                s.setBigDecimal(i + 1, (BigDecimal) p.value);
+                break;
+            case DOUBLE:
+                s.setDouble(i + 1, (Double) p.value);
+                break;
+            default:
+                s.setString(i + 1, (String) p.value);
+                break;
+            }
+        }
+    }
+
+    @Override
+    public String toString() {
+        return sql + "\n-- parameters: " + parameters;
+    }
+
+    public static VitessParameters parameterize(String query) {
+        // MySQL does not match "f(?)" in the select list with "f(?)" in GROUP BY, so when a GROUP BY expression has a
+        // literal, the literals of select lists and GROUP BY clauses stay as they are.
+        VitessParameters all = parameterize(query, false);
+        return all.groupByParameter ? parameterize(query, true) : all;
+    }
+
+    private static String effective(List<String> clause) {
+        for (int i = clause.size() - 1; i >= 0; i--) {
+            if (!clause.get(i).isEmpty()) {
+                return clause.get(i);
+            }
+        }
+        return "";
+    }
+
+    private static VitessParameters parameterize(String query, boolean keepGrouped) {
+        boolean groupByParameter = false;
+        StringBuilder out = new StringBuilder();
+        List<Parameter> params = new ArrayList<>();
+        // The previous two significant tokens (upper case), and the keyword clause we are in per parenthesis depth.
+        String prev = "";
+        String prev2 = "";
+        List<String> clause = new ArrayList<>();
+        clause.add("");
+        List<Boolean> typeArgs = new ArrayList<>();
+        typeArgs.add(false);
+        int i = 0;
+        int n = query.length();
+        while (i < n) {
+            char c = query.charAt(i);
+            if (Character.isWhitespace(c)) {
+                out.append(c);
+                i++;
+                continue;
+            }
+            if (c == '\'' || c == '"') {
+                int end = endOfString(query, i);
+                String literal = query.substring(i, end);
+                String eff = effective(clause);
+                if (prev.startsWith("_") || prev.equals("ESCAPE") || typeArgs.get(typeArgs.size() - 1)
+                        || keepGrouped && (eff.equals("SELECT") || eff.equals("GROUP BY"))) {
+                    out.append(literal);
+                } else {
+                    params.add(new Parameter(Kind.STRING, literal, unquote(literal)));
+                    out.append('?');
+                    groupByParameter |= eff.equals("GROUP BY");
+                }
+                prev2 = prev;
+                prev = "'";
+                i = end;
+                continue;
+            }
+            if (Character.isDigit(c) || c == '.' && i + 1 < n && Character.isDigit(query.charAt(i + 1))) {
+                int end = i;
+                boolean exponent = false;
+                boolean point = false;
+                while (end < n) {
+                    char d = query.charAt(end);
+                    if (Character.isDigit(d)) {
+                        end++;
+                    } else if (d == '.' && !point && !exponent) {
+                        point = true;
+                        end++;
+                    } else if ((d == 'e' || d == 'E') && !exponent && end + 1 < n
+                            && (Character.isDigit(query.charAt(end + 1))
+                                    || (query.charAt(end + 1) == '-' || query.charAt(end + 1) == '+') && end + 2 < n
+                                            && Character.isDigit(query.charAt(end + 2)))) {
+                        exponent = true;
+                        end += 2;
+                    } else {
+                        break;
+                    }
+                }
+                if (end < n && (Character.isLetter(query.charAt(end)) || query.charAt(end) == '_')) {
+                    // Part of an identifier or a hexadecimal literal.
+                    while (end < n && (Character.isLetterOrDigit(query.charAt(end)) || query.charAt(end) == '_')) {
+                        end++;
+                    }
+                    out.append(query, i, end);
+                    prev2 = prev;
+                    prev = query.substring(i, end).toUpperCase(Locale.ROOT);
+                    i = end;
+                    continue;
+                }
+                String literal = query.substring(i, end);
+                String cl = clause.get(clause.size() - 1);
+                boolean position = (cl.equals("ORDER BY") || cl.equals("GROUP BY"))
+                        && (prev.equals("BY") || prev.equals(",")) && !exponent && !point;
+                String eff = effective(clause);
+                if (position || typeArgs.get(typeArgs.size() - 1)
+                        || keepGrouped && (eff.equals("SELECT") || eff.equals("GROUP BY"))) {
+                    out.append(literal);
+                } else {
+                    params.add(number(literal, exponent, point));
+                    out.append('?');
+                    groupByParameter |= eff.equals("GROUP BY");
+                }
+                prev2 = prev;
+                prev = "0";
+                i = end;
+                continue;
+            }
+            if (Character.isLetter(c) || c == '_' || c == '`' || c == '@') {
+                int end = i + 1;
+                if (c == '`') {
+                    end = query.indexOf('`', i + 1) + 1;
+                } else {
+                    while (end < n && (Character.isLetterOrDigit(query.charAt(end)) || query.charAt(end) == '_'
+                            || query.charAt(end) == '@')) {
+                        end++;
+                    }
+                }
+                String word = query.substring(i, end).toUpperCase(Locale.ROOT);
+                out.append(query, i, end);
+                if (word.equals("BY") && (prev.equals("ORDER") || prev.equals("GROUP"))) {
+                    clause.set(clause.size() - 1, prev + " BY");
+                } else if (Set.of("SELECT", "FROM", "WHERE", "HAVING", "LIMIT", "UNION", "ON", "OFFSET")
+                        .contains(word)) {
+                    clause.set(clause.size() - 1, word);
+                }
+                prev2 = prev;
+                prev = word;
+                i = end;
+                continue;
+            }
+            out.append(c);
+            if (c == '(') {
+                clause.add("");
+                typeArgs.add(TYPES.contains(prev) && prev2.equals("AS") || TYPES.contains(prev) && prev2.equals(","));
+            } else if (c == ')' && clause.size() > 1) {
+                clause.remove(clause.size() - 1);
+                typeArgs.remove(typeArgs.size() - 1);
+            }
+            prev2 = prev;
+            prev = String.valueOf(c);
+            i++;
+        }
+        VitessParameters result = new VitessParameters(out.toString(), params);
+        result.groupByParameter = groupByParameter;
+        return result;
+    }
+
+    private static Parameter number(String literal, boolean exponent, boolean point) {
+        if (exponent) {
+            return new Parameter(Kind.DOUBLE, literal, Double.parseDouble(literal));
+        }
+        if (!point) {
+            try {
+                return new Parameter(Kind.LONG, literal, Long.parseLong(literal));
+            } catch (NumberFormatException e) {
+                // larger than a BIGINT: MySQL treats it as a DECIMAL
+            }
+        }
+        return new Parameter(Kind.DECIMAL, literal, new BigDecimal(literal));
+    }
+
+    private static int endOfString(String s, int start) {
+        char quote = s.charAt(start);
+        int i = start + 1;
+        while (i < s.length()) {
+            char c = s.charAt(i);
+            if (c == '\\') {
+                i += 2;
+            } else if (c == quote) {
+                if (i + 1 < s.length() && s.charAt(i + 1) == quote) {
+                    i += 2;
+                } else {
+                    return i + 1;
+                }
+            } else {
+                i++;
+            }
+        }
+        return s.length();
+    }
+
+    private static String unquote(String literal) {
+        char quote = literal.charAt(0);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 1; i < literal.length() - 1; i++) {
+            char c = literal.charAt(i);
+            if (c == '\\' && i + 1 < literal.length() - 1) {
+                char e = literal.charAt(++i);
+                switch (e) {
+                case 'n':
+                    sb.append('\n');
+                    break;
+                case 't':
+                    sb.append('\t');
+                    break;
+                case 'r':
+                    sb.append('\r');
+                    break;
+                case '0':
+                    sb.append('\0');
+                    break;
+                case 'b':
+                    sb.append('\b');
+                    break;
+                case 'Z':
+                    sb.append('\032');
+                    break;
+                default:
+                    // \%, \_ keep the backslash in MySQL
+                    if (e == '%' || e == '_') {
+                        sb.append('\\');
+                    }
+                    sb.append(e);
+                    break;
+                }
+            } else if (c == quote && i + 1 < literal.length() - 1 && literal.charAt(i + 1) == quote) {
+                sb.append(quote);
+                i++;
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.toString();
+    }
+}
diff --git a/src/sqlancer/mysql/vitess/VitessQueryGenerator.java b/src/sqlancer/mysql/vitess/VitessQueryGenerator.java
new file mode 100644
index 0000000..801f73d
--- /dev/null
+++ b/src/sqlancer/mysql/vitess/VitessQueryGenerator.java
@@ -0,0 +1,332 @@
+package sqlancer.mysql.vitess;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import sqlancer.Randomly;
+import sqlancer.mysql.MySQLGlobalState;
+import sqlancer.mysql.MySQLSchema.MySQLColumn;
+import sqlancer.mysql.MySQLSchema.MySQLTable;
+import sqlancer.mysql.MySQLSchema.MySQLTables;
+import sqlancer.mysql.MySQLVisitor;
+import sqlancer.mysql.gen.MySQLExpressionGenerator;
+
+/**
+ * Generates SELECT statements with the features that vtgate has to plan across shards: joins, aggregation, grouping,
+ * DISTINCT, ordering with LIMIT, subqueries, UNION and derived tables.
+ */
+public class VitessQueryGenerator {
+
+    private static final int MAX_TABLES = 3;
+
+    private final MySQLGlobalState state;
+    private final List<MySQLTable> allTables;
+    // In a sharded keyspace, the generator avoids query shapes that hit known Vitess bugs (see
+    // tools/sqlancer/README.md in the Vitess repository), so that they do not drown new findings.
+    private final boolean sharded;
+    private boolean ordered;
+    private boolean colocatedOnly;
+    private boolean inUnion;
+
+    public VitessQueryGenerator(MySQLGlobalState state) {
+        this.state = state;
+        this.allTables = state.getSchema().getDatabaseTables();
+        this.sharded = state.getDbmsSpecificOptions().vitessSharded;
+    }
+
+    // Whether the last generated query orders all its output columns.
+    public boolean isOrdered() {
+        return ordered;
+    }
+
+    public String generate() {
+        ordered = false;
+        int kind = (int) Randomly.getNotCachedInteger(0, 10);
+        // UNIONs are left out with the OLAP workload for now.
+        if (kind == 0 && !"olap".equalsIgnoreCase(state.getDbmsSpecificOptions().vitessWorkload)) {
+            return union();
+        }
+        if (kind == 1) {
+            return derived();
+        }
+        return select(Randomly.fromOptions(Mode.values()), true, -1);
+    }
+
+    private enum Mode {
+        PLAIN, AGGREGATE, GROUP_BY
+    }
+
+    // Generates a SELECT. If width is not negative, the query is a plain projection with that many output columns.
+    private String select(Mode mode, boolean allowOrderBy, int width) {
+        List<MySQLTable> tables = new ArrayList<>(Randomly.nonEmptySubset(allTables));
+        Collections.shuffle(tables, new java.util.Random(state.getRandomly().getInteger()));
+        if (tables.size() > MAX_TABLES) {
+            tables = tables.subList(0, MAX_TABLES);
+        }
+        StringBuilder sb = new StringBuilder("SELECT ");
+        List<String> items = new ArrayList<>();
+        List<String> groupBy = new ArrayList<>();
+        Mode m = width >= 0 ? Mode.PLAIN : mode;
+        switch (m) {
+        case PLAIN:
+            if (Randomly.getBooleanWithRatherLowProbability()) {
+                sb.append("DISTINCT ");
+            }
+            int n = width >= 0 ? width : 1 + Randomly.smallNumber() % 3;
+            for (int i = 0; i < n; i++) {
+                items.add(valueExpression(tables));
+            }
+            break;
+        case AGGREGATE:
+            int nrAggregates = 1 + Randomly.smallNumber() % 3;
+            for (int i = 0; i < nrAggregates; i++) {
+                items.add(aggregate(tables));
+            }
+            break;
+        case GROUP_BY:
+            int nrGroupBy = 1 + Randomly.smallNumber() % 2;
+            for (int i = 0; i < nrGroupBy; i++) {
+                groupBy.add(valueExpression(tables));
+            }
+            items.addAll(groupBy);
+            int nrGroupAggregates = 1 + Randomly.smallNumber() % 2;
+            for (int i = 0; i < nrGroupAggregates; i++) {
+                items.add(aggregate(tables));
+            }
+            break;
+        default:
+            throw new AssertionError(m);
+        }
+        for (int i = 0; i < items.size(); i++) {
+            sb.append(i == 0 ? "" : ", ").append(items.get(i)).append(" AS a").append(i);
+        }
+        // Known Vitess bugs: aggregation over a cross-shard join, and derived tables over one, give wrong results or
+        // fail. Joins on the sharding key are pushed down to the shards.
+        sb.append(" FROM ").append(from(tables, sharded && (m != Mode.PLAIN || colocatedOnly)));
+        String where = where(tables);
+        if (where != null) {
+            sb.append(" WHERE ").append(where);
+        }
+        if (!groupBy.isEmpty()) {
+            sb.append(" GROUP BY ").append(String.join(", ", groupBy));
+            if (Randomly.getBoolean()) {
+                sb.append(" HAVING ").append(aggregate(tables)).append(' ').append(comparison()).append(' ')
+                        .append(Randomly.getBoolean() ? aggregate(tables) : constant());
+            }
+        }
+        // Known Vitess bug: vtgate pushes a LIMIT below a scalar aggregation.
+        if (allowOrderBy && !(sharded && m == Mode.AGGREGATE)) {
+            appendOrderByAndLimit(sb, items.size(), false);
+        }
+        return sb.toString();
+    }
+
+    private void appendOrderByAndLimit(StringBuilder sb, int columns, boolean byAlias) {
+        appendOrderByAndLimit(sb, columns, byAlias, true);
+    }
+
+    private void appendOrderByAndLimit(StringBuilder sb, int columns, boolean byAlias, boolean allowLimit) {
+        if (Randomly.getBoolean()) {
+            return;
+        }
+        ordered = true;
+        sb.append(" ORDER BY ");
+        for (int i = 1; i <= columns; i++) {
+            sb.append(i == 1 ? "" : ", ").append(byAlias ? "a" + (i - 1) : String.valueOf(i))
+                    .append(Randomly.getBoolean() ? " ASC" : " DESC");
+        }
+        if (allowLimit && Randomly.getBoolean()) {
+            sb.append(" LIMIT ").append(Randomly.smallNumber() + 1);
+            if (Randomly.getBooleanWithRatherLowProbability()) {
+                sb.append(" OFFSET ").append(Randomly.smallNumber());
+            }
+        }
+    }
+
+    private String from(List<MySQLTable> tables, boolean colocated) {
+        StringBuilder sb = new StringBuilder(tables.get(0).getName());
+        for (int i = 1; i < tables.size(); i++) {
+            MySQLTable t = tables.get(i);
+            if (colocated) {
+                sb.append(Randomly.fromOptions(" JOIN ", " STRAIGHT_JOIN ")).append(t.getName()).append(" ON ")
+                        .append(tables.get(0).getName()).append(".c0 = ").append(t.getName()).append(".c0");
+                continue;
+            }
+            List<MySQLTable> scope = tables.subList(0, i + 1);
+            String join = Randomly.fromOptions(",", "CROSS JOIN", "JOIN", "LEFT JOIN", "RIGHT JOIN", "STRAIGHT_JOIN");
+            // Known Vitess bug: an outer join of a reference table and a sharded table returns the NULL-extended
+            // rows of the reference table once per shard.
+            if (join.endsWith("LEFT JOIN") || join.endsWith("RIGHT JOIN")) {
+                boolean reference = false;
+                for (MySQLTable s : tables.subList(0, i + 1)) {
+                    reference |= VitessTopology.isReferenceTable(state.getDatabaseName(), s.getName());
+                }
+                if (reference) {
+                    join = "JOIN";
+                }
+            }
+            sb.append(join.equals(",") ? ", " : " " + join + " ").append(t.getName());
+            if (!join.equals(",") && !join.equals("CROSS JOIN")) {
+                sb.append(" ON ").append(joinCondition(tables.subList(0, i), t, scope));
+            }
+        }
+        return sb.toString();
+    }
+
+    private String joinCondition(List<MySQLTable> left, MySQLTable right, List<MySQLTable> scope) {
+        MySQLTable other = Randomly.fromList(left);
+        String condition;
+        int kind = (int) Randomly.getNotCachedInteger(0, 10);
+        if (kind < 4) {
+            // On the sharding key: in a sharded keyspace, vtgate can push such a join down to the shards.
+            condition = other.getName() + ".c0 = " + right.getName() + ".c0";
+        } else if (kind < 7) {
+            condition = column(other) + " = " + column(right);
+        } else {
+            condition = expression(scope);
+        }
+        if (Randomly.getBooleanWithRatherLowProbability()) {
+            condition = "(" + condition + ") AND (" + expression(scope) + ")";
+        }
+        return condition;
+    }
+
+    private String where(List<MySQLTable> tables) {
+        String where = Randomly.getBoolean() ? expression(tables) : null;
+        if (Randomly.getBooleanWithRatherLowProbability() || where == null && Randomly.getBoolean()) {
+            String subquery = subqueryPredicate(tables);
+            // Known Vitess bug: in a cross-shard join, a predicate with a subquery and columns of several tables goes
+            // to the wrong side. AND keeps the subquery predicate separate.
+            String connective = sharded && tables.size() > 1 ? "AND" : Randomly.fromOptions("AND", "OR");
+            where = where == null ? subquery : "(" + where + ") " + connective + " (" + subquery + ")";
+        }
+        return where;
+    }
+
+    private String subqueryPredicate(List<MySQLTable> outer) {
+        MySQLTable inner = Randomly.fromList(allTables);
+        MySQLColumn innerColumn = Randomly.fromList(inner.getColumns());
+        String outerColumn = column(Randomly.fromList(outer));
+        String innerRef = "sq." + innerColumn.getName();
+        // Known Vitess bug: a COUNT subquery that routes to no shard (for example c0 = '') returns NULL instead of 0.
+        String innerConstant = sharded && innerColumn.getName().equals("c0")
+                ? String.valueOf((int) state.getRandomly().getInteger()) : constant();
+        String innerWhere = Randomly.getBoolean() ? ""
+                : " WHERE " + innerRef + " " + comparison() + " " + innerConstant;
+        // Known Vitess bugs: vtgate evaluates ANY and ALL per shard, and a correlated EXISTS in a UNION makes vtgate
+        // panic.
+        int kind;
+        do {
+            kind = (int) Randomly.getNotCachedInteger(0, sharded ? 3 : 4);
+        } while (sharded && inUnion && kind == 1);
+        switch (kind) {
+        case 0:
+            // Known Vitess bug: vtgate restricts the outer query to the shards of a NOT IN subquery.
+            return outerColumn + (sharded || Randomly.getBoolean() ? " IN " : " NOT IN ") + "(SELECT " + innerRef
+                    + " FROM " + inner.getName() + " AS sq" + innerWhere + ")";
+        case 1:
+            return (Randomly.getBoolean() ? "" : "NOT ") + "EXISTS (SELECT 1 FROM " + inner.getName() + " AS sq WHERE "
+                    + innerRef + " = " + outerColumn + ")";
+        case 2:
+            return outerColumn + " " + comparison() + " (SELECT " + Randomly.fromOptions("MIN", "MAX", "COUNT") + "("
+                    + innerRef + ") FROM " + inner.getName() + " AS sq" + innerWhere + ")";
+        default:
+            return outerColumn + " " + comparison() + " " + Randomly.fromOptions("ANY", "ALL") + " (SELECT " + innerRef
+                    + " FROM " + inner.getName() + " AS sq" + innerWhere + ")";
+        }
+    }
+
+    private String union() {
+        int width = 1 + Randomly.smallNumber() % 2;
+        inUnion = true;
+        String sb = "(" + select(Mode.PLAIN, false, width) + ") " + Randomly.fromOptions("UNION", "UNION ALL") + " ("
+                + select(Mode.PLAIN, false, width) + ")";
+        inUnion = false;
+        StringBuilder result = new StringBuilder(sb);
+        // Known Vitess bugs: in a sharded keyspace, vtgate ignores a positional ORDER BY on a UNION, and pushes the
+        // LIMIT of a UNION into the shards without the ORDER BY.
+        appendOrderByAndLimit(result, width, sharded, !sharded);
+        return result.toString();
+    }
+
+    private String derived() {
+        colocatedOnly = true;
+        String inner = select(Randomly.fromOptions(Mode.PLAIN, Mode.GROUP_BY), false, -1);
+        colocatedOnly = false;
+        switch ((int) Randomly.getNotCachedInteger(0, 3)) {
+        case 0:
+            return "SELECT COUNT(*), COUNT(DISTINCT d.a0), MIN(d.a0), MAX(d.a0) FROM (" + inner + ") AS d";
+        case 1:
+            StringBuilder sb = new StringBuilder("SELECT d.a0, COUNT(*) FROM (").append(inner)
+                    .append(") AS d GROUP BY d.a0");
+            appendOrderByAndLimit(sb, 2, false);
+            return sb.toString();
+        default:
+            StringBuilder all = new StringBuilder("SELECT d.a0 FROM (").append(inner)
+                    .append(") AS d WHERE d.a0 IS NOT NULL");
+            appendOrderByAndLimit(all, 1, false);
+            return all.toString();
+        }
+    }
+
+    private String aggregate(List<MySQLTable> tables) {
+        String arg = Randomly.getBoolean() ? column(Randomly.fromList(tables)) : expression(tables);
+        return Randomly.fromOptions("COUNT(*)", "COUNT(" + arg + ")", "COUNT(DISTINCT " + arg + ")", "SUM(" + arg + ")",
+                "SUM(DISTINCT " + arg + ")", "MIN(" + arg + ")", "MAX(" + arg + ")", "AVG(" + arg + ")",
+                "AVG(DISTINCT " + arg + ")", "BIT_AND(" + arg + ")", "BIT_OR(" + arg + ")", "BIT_XOR(" + arg + ")");
+    }
+
+    private String valueExpression(List<MySQLTable> tables) {
+        // Known Vitess bug: when vtgate combines UNION branches itself, it converts the values to the type of a
+        // decimal literal in another branch and clamps them.
+        if (sharded && inUnion) {
+            return column(Randomly.fromList(tables));
+        }
+        return Randomly.getBoolean() ? column(Randomly.fromList(tables)) : expression(tables);
+    }
+
+    private static String column(MySQLTable table) {
+        return table.getName() + "." + Randomly.fromList(table.getColumns()).getName();
+    }
+
+    private String expression(List<MySQLTable> tables) {
+        MySQLExpressionGenerator gen = new MySQLExpressionGenerator(state).setTablesAndColumns(new MySQLTables(tables));
+        String expression = MySQLVisitor.asString(gen.generateExpression());
+        // Known Vitess bugs: in a sharded keyspace, subqueries without a table (EXISTS (SELECT 1 ...)) make vtgate
+        // drop predicates, empty whole queries, ignore DISTINCT and HAVING, panic, or crash.
+        for (int i = 0; i < 10 && sharded && expression.contains("EXISTS (SELECT 1"); i++) {
+            expression = MySQLVisitor.asString(gen.generateExpression());
+        }
+        return expression;
+    }
+
+    private static String comparison() {
+        return Randomly.fromOptions("=", "<>", "<", "<=", ">", ">=", "<=>");
+    }
+
+    private String constant() {
+        MySQLExpressionGenerator gen = new MySQLExpressionGenerator(state);
+        return MySQLVisitor.asString(gen.generateConstant());
+    }
+
+    static String describe(String query) {
+        String q = query.toUpperCase(java.util.Locale.ROOT);
+        List<String> features = new ArrayList<>();
+        String[][] checks = { { " JOIN ", "join" }, { "STRAIGHT_JOIN", "join" }, { "FROM T", "" },
+                { "GROUP BY", "group-by" }, { "HAVING", "having" }, { "DISTINCT", "distinct" },
+                { "ORDER BY", "order-by" }, { "LIMIT", "limit" }, { "UNION", "union" }, { "(SELECT", "subquery" },
+                { "COUNT(", "aggregate" }, { "SUM(", "aggregate" }, { "MIN(", "aggregate" }, { "MAX(", "aggregate" },
+                { "AVG(", "aggregate" }, { "BIT_", "aggregate" } };
+        for (String[] check : checks) {
+            if (!check[1].isEmpty() && q.contains(check[0]) && !features.contains(check[1])) {
+                features.add(check[1]);
+            }
+        }
+        if (q.matches(".*FROM T\\d+, T\\d+.*")) {
+            features.add(0, "join");
+        }
+        return features.stream().distinct().collect(Collectors.joining(","));
+    }
+}
diff --git a/src/sqlancer/mysql/vitess/VitessReference.java b/src/sqlancer/mysql/vitess/VitessReference.java
new file mode 100644
index 0000000..1cd0578
--- /dev/null
+++ b/src/sqlancer/mysql/vitess/VitessReference.java
@@ -0,0 +1,142 @@
+package sqlancer.mysql.vitess;
+
+import java.sql.Connection;
+import java.sql.DriverManager;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.sql.Statement;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+
+import sqlancer.SQLConnection;
+
+/**
+ * A plain MySQL database that receives every statement that succeeded on vtgate, so that the results of vtgate can be
+ * compared with those of MySQL.
+ */
+public final class VitessReference implements AutoCloseable {
+
+    // JDBC options for --vitess-prepared: prepare on the server, and fail instead of falling back to client-side
+    // prepared statements when the server cannot prepare a statement.
+    public static final String PREPARED_PARAMS = "useServerPrepStmts=true&emulateUnsupportedPstmts=false";
+
+    private static final ThreadLocal<VitessReference> CURRENT = new ThreadLocal<>();
+
+    private final Connection con;
+    private String divergence;
+
+    private VitessReference(Connection con) {
+        this.con = con;
+    }
+
+    // Creates the empty reference database ref_KEYSPACE, and closes the reference of the previous database of the
+    // current thread.
+    public static VitessReference create(String url, String keyspace) throws SQLException {
+        VitessReference previous = CURRENT.get();
+        if (previous != null) {
+            previous.close();
+        }
+        Connection con = DriverManager.getConnection(url);
+        String database = "ref_" + keyspace.replaceAll("[^A-Za-z0-9_]", "_");
+        try (Statement s = con.createStatement()) {
+            s.execute("DROP DATABASE IF EXISTS " + database);
+            s.execute("CREATE DATABASE " + database);
+            s.execute("USE " + database);
+        }
+        VitessReference ref = new VitessReference(con);
+        CURRENT.set(ref);
+        return ref;
+    }
+
+    public Connection getConnection() {
+        return con;
+    }
+
+    // Runs a statement that succeeded on vtgate.
+    public void mirror(String sql) {
+        String lower = sql.trim().toLowerCase(Locale.ROOT);
+        if (lower.startsWith("alter vschema") || lower.startsWith("select") || lower.startsWith("show")) {
+            return;
+        }
+        try (Statement s = con.createStatement()) {
+            s.execute(sql);
+        } catch (SQLException e) {
+            if (divergence == null) {
+                divergence = "succeeded on vtgate but failed on MySQL with: " + e.getMessage();
+                VitessFindings.setDivergingStatement(sql);
+            }
+        }
+    }
+
+    // Returns why vtgate and MySQL differ after the statements so far, or null if they do not.
+    public String findDivergence(SQLConnection vtgate, List<String> tables, boolean sharded) throws SQLException {
+        if (divergence != null) {
+            return divergence;
+        }
+        for (String table : tables) {
+            String vtgateSchema = showCreateTable(vtgate::createStatement, table);
+            String mysqlSchema = showCreateTable(con::createStatement, table);
+            if (!vtgateSchema.equals(mysqlSchema)) {
+                return "different schema for " + table + ": vtgate has\n" + vtgateSchema + "\nMySQL has\n"
+                        + mysqlSchema;
+            }
+            List<String> vtgateRows = sortedRows(vtgate::createStatement, "SELECT * FROM " + table);
+            List<String> mysqlRows = sortedRows(con::createStatement, "SELECT * FROM " + table);
+            if (!vtgateRows.equals(mysqlRows)) {
+                return "different rows in " + table + ": vtgate has " + vtgateRows + ", MySQL has " + mysqlRows;
+            }
+            if (sharded) {
+                // vtgate groups by the primary vindex column on each shard, so rows that are on the wrong shard
+                // show up as several groups.
+                String query = "SELECT c0, COUNT(*) FROM " + table + " GROUP BY c0";
+                List<String> vtgateGroups = sortedRows(vtgate::createStatement, query);
+                List<String> mysqlGroups = sortedRows(con::createStatement, query);
+                if (!vtgateGroups.equals(mysqlGroups)) {
+                    return "rows on the wrong shard in " + table + ": vtgate groups " + vtgateGroups + ", MySQL groups "
+                            + mysqlGroups;
+                }
+            }
+        }
+        return null;
+    }
+
+    // Creates a statement on vtgate or on MySQL.
+    @FunctionalInterface
+    interface StatementFactory {
+        Statement create() throws SQLException;
+    }
+
+    private static String showCreateTable(StatementFactory c, String table) throws SQLException {
+        try (Statement s = c.create(); ResultSet rs = s.executeQuery("SHOW CREATE TABLE " + table)) {
+            rs.next();
+            // The AUTO_INCREMENT counter depends on the shard.
+            return rs.getString(2).replaceAll(" AUTO_INCREMENT=\\d+", "");
+        }
+    }
+
+    private static List<String> sortedRows(StatementFactory c, String query) throws SQLException {
+        List<String> rows = new ArrayList<>();
+        try (Statement s = c.create(); ResultSet rs = s.executeQuery(query)) {
+            int n = rs.getMetaData().getColumnCount();
+            while (rs.next()) {
+                StringBuilder sb = new StringBuilder();
+                for (int i = 1; i <= n; i++) {
+                    sb.append(i == 1 ? "" : ", ").append(rs.getString(i));
+                }
+                rows.add(sb.toString());
+            }
+        }
+        Collections.sort(rows);
+        return rows;
+    }
+
+    @Override
+    public void close() throws SQLException {
+        if (CURRENT.get() == this) {
+            CURRENT.remove();
+        }
+        con.close();
+    }
+}
diff --git a/src/sqlancer/mysql/vitess/VitessTopology.java b/src/sqlancer/mysql/vitess/VitessTopology.java
new file mode 100644
index 0000000..74163eb
--- /dev/null
+++ b/src/sqlancer/mysql/vitess/VitessTopology.java
@@ -0,0 +1,204 @@
+package sqlancer.mysql.vitess;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.sql.Connection;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.sql.Statement;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.TimeUnit;
+
+import sqlancer.Randomly;
+import sqlancer.SQLConnection;
+import sqlancer.common.query.SQLQueryAdapter;
+import sqlancer.mysql.MySQLGlobalState;
+import sqlancer.mysql.MySQLOptions;
+import sqlancer.mysql.MySQLVisitor;
+import sqlancer.mysql.gen.MySQLExpressionGenerator;
+
+/**
+ * Sets up the vschema of the tables of a sharded keyspace: a primary vindex on c0, optionally a lookup vindex on c1, or
+ * a reference table.
+ */
+public final class VitessTopology {
+
+    private static final int MAX_REFERENCE_ROWS = 8;
+    private static final java.util.Map<String, java.util.Set<String>> REFERENCE_TABLES = new java.util.concurrent.ConcurrentHashMap<>();
+
+    private VitessTopology() {
+    }
+
+    // Whether the table of the current round of the keyspace is a reference table.
+    public static boolean isReferenceTable(String keyspace, String table) {
+        return REFERENCE_TABLES.getOrDefault(keyspace, java.util.Set.of()).contains(table);
+    }
+
+    // Drops the lookup tables of a keyspace's previous round from the lookup keyspace.
+    public static void cleanUp(Connection vtgate, MySQLOptions o, String keyspace) throws SQLException {
+        REFERENCE_TABLES.remove(keyspace);
+        if (o.vitessLookupKeyspace == null) {
+            return;
+        }
+        List<String> tables = new ArrayList<>();
+        try (Statement s = vtgate.createStatement();
+                ResultSet rs = s.executeQuery("SHOW TABLES FROM " + o.vitessLookupKeyspace)) {
+            while (rs.next()) {
+                if (rs.getString(1).startsWith(lookupTablePrefix(keyspace))) {
+                    tables.add(rs.getString(1));
+                }
+            }
+        }
+        for (String t : tables) {
+            try (Statement s = vtgate.createStatement()) {
+                s.execute("DROP TABLE IF EXISTS " + o.vitessLookupKeyspace + "." + t);
+            }
+        }
+    }
+
+    // Gives a new table its vschema. Returns whether the table is a reference table.
+    public static boolean setUpTable(MySQLGlobalState state, String table) throws Exception {
+        MySQLOptions o = state.getDbmsSpecificOptions();
+        if (o.vitessReferenceTables && Randomly.getBooleanWithRatherLowProbability()) {
+            makeReferenceTable(state, table);
+            REFERENCE_TABLES
+                    .computeIfAbsent(state.getDatabaseName(), k -> java.util.concurrent.ConcurrentHashMap.newKeySet())
+                    .add(table);
+            return true;
+        }
+        state.executeStatement(
+                new SQLQueryAdapter("ALTER VSCHEMA ON " + table + " ADD VINDEX " + o.vitessVindex + "(c0)", true));
+        if (o.vitessLookupKeyspace != null && Randomly.getBoolean()) {
+            addLookupVindex(state, table);
+        }
+        return false;
+    }
+
+    private static String lookupTablePrefix(String keyspace) {
+        return "lk_" + keyspace.replaceAll("[^A-Za-z0-9_]", "_") + "_";
+    }
+
+    // A consistent_lookup vindex on c1, owned by the table, whose lookup table is in the lookup keyspace.
+    private static void addLookupVindex(MySQLGlobalState state, String table) throws Exception {
+        MySQLOptions o = state.getDbmsSpecificOptions();
+        String type = columnType(state.getConnection(), state.getDatabaseName(), table, "c1");
+        if (type == null || !isLookupColumnType(type)) {
+            return;
+        }
+        String lookupTable = lookupTablePrefix(state.getDatabaseName()) + table + "_c1";
+        String create = "CREATE TABLE " + o.vitessLookupKeyspace + "." + lookupTable + " (c1 " + type
+                + ", keyspace_id VARBINARY(128), PRIMARY KEY (c1, keyspace_id))";
+        // Not through executeStatement: the lookup keyspace does not exist on the reference MySQL server.
+        try (Statement s = state.getConnection().createStatement()) {
+            s.execute(create);
+        }
+        state.getState().logStatement(create);
+        state.executeStatement(new SQLQueryAdapter("ALTER VSCHEMA ON " + table + " ADD VINDEX lk_" + table
+                + "_c1(c1) USING consistent_lookup WITH owner=" + table + ", table=" + o.vitessLookupKeyspace + "."
+                + lookupTable + ", from=c1, to=keyspace_id, ignore_nulls=true", true));
+    }
+
+    private static boolean isLookupColumnType(String type) {
+        String t = type.toLowerCase(Locale.ROOT);
+        return t.contains("int") || t.startsWith("decimal") || t.startsWith("double") || t.startsWith("float")
+                || t.startsWith("varchar");
+    }
+
+    private static String columnType(SQLConnection con, String keyspace, String table, String column)
+            throws SQLException {
+        try (Statement s = con.createStatement();
+                ResultSet rs = s
+                        .executeQuery("SELECT column_type FROM information_schema.columns WHERE table_schema = '"
+                                + keyspace + "' AND table_name = '" + table + "' AND column_name = '" + column + "'")) {
+            return rs.next() ? rs.getString(1) : null;
+        }
+    }
+
+    // vtgate does not support DML on a reference table without a source in a sharded keyspace, so the harness
+    // writes the same rows directly to the table on every shard and on the reference MySQL server.
+    private static void makeReferenceTable(MySQLGlobalState state, String table) throws Exception {
+        MySQLOptions o = state.getDbmsSpecificOptions();
+        if (state.getVitessReference() == null) {
+            throw new AssertionError("--vitess-reference-tables needs --vitess-reference-url");
+        }
+        String keyspace = state.getDatabaseName();
+        String vschema = vtctld(o, "GetVSchema", keyspace);
+        int tables = vschema.indexOf("\"tables\": {");
+        if (tables < 0) {
+            throw new AssertionError("unexpected vschema: " + vschema);
+        }
+        int insert = tables + "\"tables\": {".length();
+        boolean empty = vschema.substring(insert).trim().startsWith("}");
+        String entry = "\"" + table + "\": {\"type\": \"reference\"}" + (empty ? "" : ",");
+        vtctld(o, "ApplyVSchema", "--vschema", vschema.substring(0, insert) + entry + vschema.substring(insert),
+                keyspace);
+        state.getState().logStatement("-- vtctldclient ApplyVSchema: " + table + " is a reference table");
+
+        List<String> columns = new ArrayList<>();
+        try (Statement s = state.getConnection().createStatement();
+                ResultSet rs = s
+                        .executeQuery("SELECT column_name FROM information_schema.columns WHERE table_schema = '"
+                                + keyspace + "' AND table_name = '" + table + "' ORDER BY ordinal_position")) {
+            while (rs.next()) {
+                columns.add(rs.getString(1));
+            }
+        }
+        int rows = (int) Randomly.getNotCachedInteger(0, MAX_REFERENCE_ROWS + 1);
+        if (rows == 0) {
+            return;
+        }
+        MySQLExpressionGenerator gen = new MySQLExpressionGenerator(state);
+        StringBuilder values = new StringBuilder();
+        for (int r = 0; r < rows; r++) {
+            values.append(r == 0 ? "(" : ", (");
+            for (int c = 0; c < columns.size(); c++) {
+                values.append(c == 0 ? "" : ", ").append(MySQLVisitor.asString(gen.generateConstant()));
+            }
+            values.append(')');
+        }
+        String into = " (" + String.join(", ", columns) + ") VALUES " + values;
+        Connection mysql = state.getVitessReference().getConnection();
+        for (String shard : shards(state.getConnection(), keyspace)) {
+            try (Statement s = mysql.createStatement()) {
+                s.execute("INSERT IGNORE INTO `vt_" + keyspace + "_" + shard + "`." + table + into);
+            }
+        }
+        try (Statement s = mysql.createStatement()) {
+            s.execute("INSERT IGNORE INTO " + table + into);
+        }
+        state.getState().logStatement("-- directly on every shard and on MySQL: INSERT IGNORE INTO " + table + into);
+    }
+
+    private static List<String> shards(SQLConnection vtgate, String keyspace) throws SQLException {
+        List<String> shards = new ArrayList<>();
+        try (Statement s = vtgate.createStatement(); ResultSet rs = s.executeQuery("SHOW VITESS_SHARDS")) {
+            while (rs.next()) {
+                String name = rs.getString(1);
+                if (name.startsWith(keyspace + "/")) {
+                    shards.add(name.substring(keyspace.length() + 1));
+                }
+            }
+        }
+        return shards;
+    }
+
+    private static String vtctld(MySQLOptions o, String... args) throws IOException, InterruptedException {
+        if (o.vitessVtctld == null || o.vitessVtctldclient == null) {
+            throw new AssertionError("--vitess-reference-tables needs --vitess-vtctld and --vitess-vtctldclient");
+        }
+        List<String> command = new ArrayList<>();
+        command.add(o.vitessVtctldclient);
+        command.add("--server");
+        command.add(o.vitessVtctld);
+        command.addAll(List.of(args));
+        Process p = new ProcessBuilder(command).redirectErrorStream(false).start();
+        String out = new String(p.getInputStream().readAllBytes(), StandardCharsets.UTF_8);
+        String err = new String(p.getErrorStream().readAllBytes(), StandardCharsets.UTF_8);
+        if (!p.waitFor(60, TimeUnit.SECONDS) || p.exitValue() != 0) {
+            throw new AssertionError("vtctldclient " + String.join(" ", args) + " failed: " + err);
+        }
+        return out;
+    }
+}
