+    private static synchronized void loadVitessIgnoredErrors(MySQLOptions o) {
+        if (o.vitessIgnoreErrorsFile == null || !ExpectedErrors.GLOBAL_REGEXES.isEmpty()) {
+            return;
+        }
+        try {
+            for (String line : java.nio.file.Files.readAllLines(java.nio.file.Paths.get(o.vitessIgnoreErrorsFile))) {
+                line = line.trim();
+                if (!line.isEmpty() && !line.startsWith("#")) {
+                    ExpectedErrors.GLOBAL_REGEXES.add(java.util.regex.Pattern.compile(line));
+                }
+            }
+        } catch (java.io.IOException e) {
+            throw new AssertionError(e);
+        }
+    }
+
+    private static final java.util.Map<Thread, String> VITESS_KEYSPACE_BY_THREAD = new java.util.HashMap<>();
+
+    // SQLancer creates a new database name for every try; Vitess keyspaces are fixed, so each worker thread gets its
+    // own keyspace.
+    private static synchronized String vitessKeyspaceForThread(MySQLOptions o) {
+        String ks = VITESS_KEYSPACE_BY_THREAD.get(Thread.currentThread());
+        if (ks == null) {
+            String[] all = o.vitessKeyspaces.split(",");
+            if (VITESS_KEYSPACE_BY_THREAD.size() >= all.length) {
+                throw new AssertionError("more SQLancer threads than --vitess-keyspaces");
+            }
+            ks = all[VITESS_KEYSPACE_BY_THREAD.size()].trim();
+            VITESS_KEYSPACE_BY_THREAD.put(Thread.currentThread(), ks);
+        }
+        return ks;
+    }
+
+    // Vitess cannot CREATE DATABASE without a dbddl plugin, so we reuse an existing keyspace and empty it.
+    private SQLConnection createVitessDatabase(MySQLGlobalState globalState, String host, int port, String username,
+            String password, String keyspace) throws SQLException {
+        MySQLOptions o = globalState.getDbmsSpecificOptions();
+        loadVitessIgnoredErrors(o);
+        if (o.vitessKeyspaces != null) {
+            keyspace = vitessKeyspaceForThread(o);
+            globalState.setDatabaseName(keyspace);
+        }
+        String url = String.format(
+                "jdbc:mysql://%s:%d/%s?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true", host, port,
+                keyspace);
+        Connection con = DriverManager.getConnection(url, username, password);
+        List<String> tables = new java.util.ArrayList<>();
+        try (Statement s = con.createStatement(); java.sql.ResultSet rs = s.executeQuery("SHOW TABLES")) {
+            while (rs.next()) {
+                tables.add(rs.getString(1));
+            }
+        }
+        for (String t : tables) {
+            try (Statement s = con.createStatement()) {
+                s.execute("DROP TABLE IF EXISTS " + t);
+            }
+            if (o.vitessSharded) {
+                try (Statement s = con.createStatement()) {
+                    s.execute("ALTER VSCHEMA DROP TABLE " + t);
+                } catch (SQLException e) {
+                    // the table might not have had a vschema entry
+                }
+            }
+        }
+        globalState.getState().logStatement("-- Vitess keyspace " + keyspace + (o.vitessSharded ? " (sharded)" : ""));
+        globalState.getState().logStatement("USE " + keyspace);
+        return new SQLConnection(con);
+    }
+
+    private static void addVitessVindex(MySQLGlobalState globalState, String tableName) throws Exception {
+        MySQLOptions o = globalState.getDbmsSpecificOptions();
+        globalState.executeStatement(new SQLQueryAdapter(
+                "ALTER VSCHEMA ON " + tableName + " ADD VINDEX " + o.vitessVindex + "(c0)", true));
+        // Wait until vtgate's schema tracker knows the current definition of the table. Star expansion in a
+        // cross-shard join uses the tracked columns, which may still be those of a dropped table with the same name.
+        List<String> expected = new java.util.ArrayList<>();
+        try (Statement s = globalState.getConnection().createStatement();
+                java.sql.ResultSet rs = s.executeQuery("SELECT column_name FROM information_schema.columns"
+                        + " WHERE table_schema = '" + globalState.getDatabaseName() + "' AND table_name = '"
+                        + tableName + "' ORDER BY ordinal_position")) {
+            while (rs.next()) {
+                expected.add(rs.getString(1).toLowerCase());
+            }
+        }
+        long deadline = System.currentTimeMillis() + 90_000;
+        int attempts = 0;
+        while (true) {
+            try (Statement s = globalState.getConnection().createStatement();
+                    java.sql.ResultSet rs = s.executeQuery(
+                            "SELECT a.* FROM " + tableName + " AS a, " + tableName + " AS b WHERE 1 != 1")) {
+                List<String> actual = new java.util.ArrayList<>();
+                for (int i = 1; i <= rs.getMetaData().getColumnCount(); i++) {
+                    actual.add(rs.getMetaData().getColumnLabel(i).toLowerCase());
+                }
+                if (actual.equals(expected)) {
+                    return;
+                }
+                throw new SQLException("vtgate tracks columns " + actual + ", expected " + expected);
+            } catch (SQLException e) {
+                if (System.currentTimeMillis() > deadline) {
+                    throw new AssertionError("schema tracking did not pick up " + tableName, e);
+                }
+                if (++attempts % 40 == 0) {
+                    // vttestserver runs all tablets on one mysqld, so concurrent schema reloads can deadlock on the
+                    // shared sidecar tables and the change is never signalled; a harmless DDL triggers a new reload.
+                    try (Statement s = globalState.getConnection().createStatement()) {
+                        s.execute("ALTER TABLE " + tableName + " COMMENT 'vitess schema reload'");
+                    } catch (SQLException ignored) {
+                        // retried on the next round
+                    }
+                }
+                Thread.sleep(250);
+            }
+        }
+    }
